/* utm.axx -- axx ミニ言語による万能チューリング機械
/*
/* ソース 1 行:  TM <規則>,<入力>
/*   <規則>  q+s+w+m+n を 5 個 1 組で '+' でつないだもの
/*           状態 q で記号 s を読んだら w を書き、m=0 なら左・m=1 なら右へ動き、状態 n へ
/*           開始状態は 1、停止状態は 0、記号 0 は空白。規則の無い (q,s) でも停止
/*   <入力>  '+' でつないだ記号の列（ヘッドは先頭の記号の上から始まる）。空白だけなら 0
/* 出力:    停止したときのテープの、空白でない最左のセルから最右のセルまで（1 セル 1 ワード）

TM !d,!x :: .call utm(.exp(d),.exp(x))

/* "12+0+7" -> [12, 0, 7]
.func nums(s)
a=[]
n=0
v=0
i=0
.while(i<.len(s))
c=s[i]
.if c>=48 && c<=57 .then
v=v*10+(c-48)
.elif c==43 .then
a[n]=v
n=n+1
v=0
.else
.raise 1
.return a
.endif
i=i+1
.endwhile
a[n]=v
.return a
.endfunc

.func utm(d,x)
rules=.call nums(d)
inp=.call nums(x)
nr=.len(rules)/5
rt=[]
lt=[]
.for i in range(.len(inp))
rt[i]=inp[i]
.next
q=1
h=0
.while(q!=0)
.if h>=0 .then
c=rt[h]
.else
c=lt[-h-1]
.endif
f=-1
k=0
.while(k<nr)
.if rules[5*k]==q && rules[5*k+1]==c .then
f=k
.break
.endif
k=k+1
.endwhile
.if f<0 .then
.break
.endif
.if h>=0 .then
rt[h]=rules[5*f+2]
.else
lt[-h-1]=rules[5*f+2]
.endif
.if rules[5*f+3]==0 .then
h=h-1
.else
h=h+1
.endif
q=rules[5*f+4]
.endwhile
tape=[]
n=0
j=.len(lt)-1
.while(j>=0)
tape[n]=lt[j]
n=n+1
j=j-1
.endwhile
.for i in range(.len(rt))
tape[n]=rt[i]
n=n+1
.next
a=0
.while(a<n && tape[a]==0)
a=a+1
.endwhile
b=n
.while(b>a && tape[b-1]==0)
b=b-1
.endwhile
.return tape[a:b]
.endfunc
