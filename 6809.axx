CMPS !e,PCR :: :: 0x11,0xAC,(t:=((e-$$-4)>=-128&&(e-$$-4)<=127)?1:2)*0+((t==1)?0x8C:0x8D),;(t==1)?(0x100|((e-$$-4)&0xff)):0,;(t==2)?(0x100|(((e-$$-5)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-5)&0xff)):0
CMPS [!e,PCR] :: :: 0x11,0xAC,(t:=((e-$$-4)>=-128&&(e-$$-4)<=127)?1:2)*0+((t==1)?0x9C:0x9D),;(t==1)?(0x100|((e-$$-4)&0xff)):0,;(t==2)?(0x100|(((e-$$-5)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-5)&0xff)):0
CMPS [!v] :: :: 0x11,0xAC,0x9F,(v>>8)&0xff,v&0xff

/* ---------- assembler pseudo-ops for data definition ---------- */
/* single value per line only -- deliberately NOT using the
   comma-optional-group trick used for PSHS/PULS above, because a
   real data byte/word of value 0 must never be suppressed, and the
   suppression idiom cannot distinguish "slot absent" from "slot
   present with value 0" for an arbitrary data list. */
FCB !v :: :: v&0xff
FDB !v :: :: (v>>8)&0xff,v&0xff

