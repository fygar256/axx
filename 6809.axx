/* =====================================================================
/*  6809.axx -- Motorola MC6809 full pattern file for axx
/*
/*  Covers the complete official MC6809 instruction set: all inherent,
/*  immediate, direct, extended, indexed (all 5 basic types x indirect,
/*  every register combination) and relative-branch encodings, plus
/*  PSHS/PULS/PSHU/PULU register lists, TFR/EXG, and the page-1 (0x10)
/*  and page-2 (0x11) prefixed instructions.  Undocumented/illegal
/*  opcodes (e.g. the reset-vector-only 0x3E) are intentionally not
/*  included, matching the existing 6502.axx house convention.
/*
/*  ============================= SYNTAX =============================
/*
/*  Direct/extended addressing (assumes direct page register DP=0x00,
/*  i.e. direct-page addressing is only auto-selected for addresses
/*  0x0000-0x00FF -- the overwhelmingly common convention when DP is
/*  left at its reset value; there is no DP-tracking in this file):
/*
/*     LDA $10            direct (auto: chosen because value <= 0xFF)
/*     LDA $1000          extended (auto: chosen because value > 0xFF)
/*     LDA <$10           force direct   (error if operand > 0xFF)
/*     LDA >$10           force extended (always 2-byte address)
/*
/*  Indexed addressing.  r stands for one of X, Y, U, S:
/*
/*     LDA ,r             zero offset               LDA [,r]    indirect
/*     LDA ,r+            post-increment by 1        (no indirect form)
/*     LDA ,r++           post-increment by 2        LDA [,r++]  indirect
/*     LDA ,-r            pre-decrement by 1          (no indirect form)
/*     LDA ,--r           pre-decrement by 2         LDA [,--r]  indirect
/*     LDA A,r / B,r / D,r     accumulator offset     [A,r] / [B,r] / [D,r] indirect
/*     LDA n,r            constant offset, auto-picks the shortest of
/*                        5-bit (-16..15, no extra byte) / 8-bit
/*                        (-128..127, +1 byte) / 16-bit (+2 bytes)
/*     LDA [n,r]          indirect constant offset, auto 8-bit/16-bit
/*                        (indirect has no 5-bit form on real hardware)
/*     LDA <n,r           force 5-bit offset   (error if out of range)
/*     LDA >n,r           force 8-bit offset   (error if out of range)
/*     LDA >>n,r          force 16-bit offset
/*     LDA [>n,r] / [>>n,r]   force 8-bit / 16-bit indirect offset
/*     LDA n,PCR          8-bit-or-16-bit auto PC-relative offset
/*     LDA <n,PCR / >n,PCR    force 8-bit / 16-bit PC-relative
/*     LDA [n,PCR] / [<n,PCR] / [>n,PCR]     indirect PC-relative forms
/*     LDA [$1234]        extended indirect (fixed 2-byte address)
/*
/*  Numbers use axx expression syntax (0x10 / 16 / 0b10000), not $10.
/*
/*  Register lists for PSHS/PULS/PSHU/PULU accept any of the 8 valid
/*  register names in any order and any combination, e.g.:
/*     PSHS A,B,X,Y       PULU CC,D,U is invalid (U can't appear on
/*                        its own U-stack; use PULU CC,D,S instead)
/*
/*  Error codes raised by this file
/*     2  Address out of range (forced addressing mode operand too big)
/*     3  Value out of range   (immediate operand too big)
/* ===================================================================== */

/* ---------- inherent (no operand) ---------- */
NOP :: 0x12
SYNC :: 0x13
DAA :: 0x19
SEX :: 0x1D
RTS :: 0x39
ABX :: 0x3A
RTI :: 0x3B
MUL :: 0x3D
SWI :: 0x3F
NEGA :: 0x40
COMA :: 0x43
LSRA :: 0x44
RORA :: 0x46
ASRA :: 0x47
ASLA :: 0x48
LSLA :: 0x48
ROLA :: 0x49
DECA :: 0x4A
INCA :: 0x4C
TSTA :: 0x4D
CLRA :: 0x4F
NEGB :: 0x50
COMB :: 0x53
LSRB :: 0x54
RORB :: 0x56
ASRB :: 0x57
ASLB :: 0x58
LSLB :: 0x58
ROLB :: 0x59
DECB :: 0x5A
INCB :: 0x5C
TSTB :: 0x5D
CLRB :: 0x5F
SWI2 :: 0x10,0x3F
SWI3 :: 0x11,0x3F

/* ---------- register transfer / exchange ---------- */
.setsym::D::0
.setsym::X::1
.setsym::Y::2
.setsym::U::3
.setsym::S::4
.setsym::PC::5
.setsym::A::8
.setsym::B::9
.setsym::CC::10
.setsym::DP::11
.check::p::D,X,Y,U,S,PC,A,B,CC,DP
.check::q::D,X,Y,U,S,PC,A,B,CC,DP
TFR p,q :: 0x1F,(p<<4)|q
EXG p,q :: 0x1E,(p<<4)|q
.clrcheck::p
.clrcheck::q

/* ---------- stack (S) push/pull -- any combination, any order ---------- */
.setsym::CC::0x01
.setsym::A::0x02
.setsym::B::0x04
.setsym::DP::0x08
.setsym::X::0x10
.setsym::Y::0x20
.setsym::U::0x40
.setsym::PC::0x80
.check::a::CC,A,B,DP,X,Y,U,PC
.check::b::CC,A,B,DP,X,Y,U,PC
.check::c::CC,A,B,DP,X,Y,U,PC
.check::d::CC,A,B,DP,X,Y,U,PC
.check::e::CC,A,B,DP,X,Y,U,PC
.check::f::CC,A,B,DP,X,Y,U,PC
.check::g::CC,A,B,DP,X,Y,U,PC
.check::h::CC,A,B,DP,X,Y,U,PC
PSHS a[[,b]][[,c]][[,d]][[,e]][[,f]][[,g]][[,h]] :: :: 0x34,a|b|c|d|e|f|g|h
PULS a[[,b]][[,c]][[,d]][[,e]][[,f]][[,g]][[,h]] :: :: 0x35,a|b|c|d|e|f|g|h
.clrcheck::a
.clrcheck::b
.clrcheck::c
.clrcheck::d
.clrcheck::e
.clrcheck::f
.clrcheck::g
.clrcheck::h

/* ---------- stack (U) push/pull -- any combination, any order ---------- */
.setsym::CC::0x01
.setsym::A::0x02
.setsym::B::0x04
.setsym::DP::0x08
.setsym::X::0x10
.setsym::Y::0x20
.setsym::S::0x40
.setsym::PC::0x80
.check::a::CC,A,B,DP,X,Y,S,PC
.check::b::CC,A,B,DP,X,Y,S,PC
.check::c::CC,A,B,DP,X,Y,S,PC
.check::d::CC,A,B,DP,X,Y,S,PC
.check::e::CC,A,B,DP,X,Y,S,PC
.check::f::CC,A,B,DP,X,Y,S,PC
.check::g::CC,A,B,DP,X,Y,S,PC
.check::h::CC,A,B,DP,X,Y,S,PC
PSHU a[[,b]][[,c]][[,d]][[,e]][[,f]][[,g]][[,h]] :: :: 0x36,a|b|c|d|e|f|g|h
PULU a[[,b]][[,c]][[,d]][[,e]][[,f]][[,g]][[,h]] :: :: 0x37,a|b|c|d|e|f|g|h
.clrcheck::a
.clrcheck::b
.clrcheck::c
.clrcheck::d
.clrcheck::e
.clrcheck::f
.clrcheck::g
.clrcheck::h

/* ---------- condition-code / wait immediate ---------- */
ORCC #!v :: v>0xff;3 :: 0x1A,v
ANDCC #!v :: v>0xff;3 :: 0x1C,v
CWAI #!v :: v>0xff;3 :: 0x3C,v

/* ---------- short (8-bit) relative branches ---------- */
BRA !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x20,(e-$$-2)&0xff
BRN !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x21,(e-$$-2)&0xff
BHI !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x22,(e-$$-2)&0xff
BLS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x23,(e-$$-2)&0xff
BHS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x24,(e-$$-2)&0xff
BCC !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x24,(e-$$-2)&0xff
BLO !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x25,(e-$$-2)&0xff
BCS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x25,(e-$$-2)&0xff
BNE !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x26,(e-$$-2)&0xff
BEQ !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x27,(e-$$-2)&0xff
BVC !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x28,(e-$$-2)&0xff
BVS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x29,(e-$$-2)&0xff
BPL !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2A,(e-$$-2)&0xff
BMI !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2B,(e-$$-2)&0xff
BGE !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2C,(e-$$-2)&0xff
BLT !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2D,(e-$$-2)&0xff
BGT !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2E,(e-$$-2)&0xff
BLE !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2F,(e-$$-2)&0xff
BSR !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x8D,(e-$$-2)&0xff

/* ---------- long (16-bit) relative branches ---------- */
LBRN !e :: :: 0x10,0x21,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBHI !e :: :: 0x10,0x22,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBLS !e :: :: 0x10,0x23,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBHS !e :: :: 0x10,0x24,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBCC !e :: :: 0x10,0x24,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBLO !e :: :: 0x10,0x25,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBCS !e :: :: 0x10,0x25,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBNE !e :: :: 0x10,0x26,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBEQ !e :: :: 0x10,0x27,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBVC !e :: :: 0x10,0x28,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBVS !e :: :: 0x10,0x29,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBPL !e :: :: 0x10,0x2A,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBMI !e :: :: 0x10,0x2B,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBGE !e :: :: 0x10,0x2C,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBLT !e :: :: 0x10,0x2D,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBGT !e :: :: 0x10,0x2E,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBLE !e :: :: 0x10,0x2F,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LBRA !e :: :: 0x16,((e-$$-3)>>8)&0xff,(e-$$-3)&0xff
LBSR !e :: :: 0x17,((e-$$-3)>>8)&0xff,(e-$$-3)&0xff

/* ---------- index register symbol for all indexed addressing below ---------- */
.setsym::X::0
.setsym::Y::1
.setsym::U::2
.setsym::S::3
.check::r::X,Y,U,S

/* ---------- load effective address (indexed addressing only) ---------- */
LEAX ,r :: :: 0x30,0x84|(r<<5)
LEAX [,r] :: :: 0x30,0x94|(r<<5)
LEAX ,r+ :: :: 0x30,0x80|(r<<5)
LEAX ,r++ :: :: 0x30,0x81|(r<<5)
LEAX [,r++] :: :: 0x30,0x91|(r<<5)
LEAX ,-r :: :: 0x30,0x82|(r<<5)
LEAX ,--r :: :: 0x30,0x83|(r<<5)
LEAX [,--r] :: :: 0x30,0x93|(r<<5)
LEAX A,r :: :: 0x30,0x86|(r<<5)
LEAX [A,r] :: :: 0x30,0x96|(r<<5)
LEAX B,r :: :: 0x30,0x85|(r<<5)
LEAX [B,r] :: :: 0x30,0x95|(r<<5)
LEAX D,r :: :: 0x30,0x8B|(r<<5)
LEAX [D,r] :: :: 0x30,0x9B|(r<<5)
LEAX <!v,r :: v<-16||v>15;2 :: 0x30,(r<<5)|(v&0x1f)
LEAX >!v,r :: v<-128||v>127;2 :: 0x30,0x88|(r<<5),v&0xff
LEAX [>!v,r] :: v<-128||v>127;2 :: 0x30,0x98|(r<<5),v&0xff
LEAX >>!v,r :: :: 0x30,0x89|(r<<5),(v>>8)&0xff,v&0xff
LEAX [>>!v,r] :: :: 0x30,0x99|(r<<5),(v>>8)&0xff,v&0xff
LEAX <!e,PCR :: (e-$$-3)<-128||(e-$$-3)>127;2 :: 0x30,0x8C,(e-$$-3)&0xff
LEAX [<!e,PCR] :: (e-$$-3)<-128||(e-$$-3)>127;2 :: 0x30,0x9C,(e-$$-3)&0xff
LEAX >!e,PCR :: :: 0x30,0x8D,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LEAX [>!e,PCR] :: :: 0x30,0x9D,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LEAX !v,r :: :: 0x30,(t:=(v>=-16&&v<=15)?0:(v>=-128&&v<=127)?1:2)*0+((t==0)?((r<<5)|(v&0x1f)):(t==1)?(0x88|(r<<5)):(0x89|(r<<5))),;(t==1)?(0x100|(v&0xff)):0,;(t==2)?(0x100|((v>>8)&0xff)):0,;(t==2)?(0x100|(v&0xff)):0
LEAX [!v,r] :: :: 0x30,(t:=(v>=-128&&v<=127)?1:2)*0+((t==1)?(0x98|(r<<5)):(0x99|(r<<5))),;(t==1)?(0x100|(v&0xff)):0,;(t==2)?(0x100|((v>>8)&0xff)):0,;(t==2)?(0x100|(v&0xff)):0
LEAX !e,PCR :: :: 0x30,(t:=((e-$$-3)>=-128&&(e-$$-3)<=127)?1:2)*0+((t==1)?0x8C:0x8D),;(t==1)?(0x100|((e-$$-3)&0xff)):0,;(t==2)?(0x100|(((e-$$-4)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-4)&0xff)):0
LEAX [!e,PCR] :: :: 0x30,(t:=((e-$$-3)>=-128&&(e-$$-3)<=127)?1:2)*0+((t==1)?0x9C:0x9D),;(t==1)?(0x100|((e-$$-3)&0xff)):0,;(t==2)?(0x100|(((e-$$-4)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-4)&0xff)):0
LEAX [!v] :: :: 0x30,0x9F,(v>>8)&0xff,v&0xff
LEAY ,r :: :: 0x31,0x84|(r<<5)
LEAY [,r] :: :: 0x31,0x94|(r<<5)
LEAY ,r+ :: :: 0x31,0x80|(r<<5)
LEAY ,r++ :: :: 0x31,0x81|(r<<5)
LEAY [,r++] :: :: 0x31,0x91|(r<<5)
LEAY ,-r :: :: 0x31,0x82|(r<<5)
LEAY ,--r :: :: 0x31,0x83|(r<<5)
LEAY [,--r] :: :: 0x31,0x93|(r<<5)
LEAY A,r :: :: 0x31,0x86|(r<<5)
LEAY [A,r] :: :: 0x31,0x96|(r<<5)
LEAY B,r :: :: 0x31,0x85|(r<<5)
LEAY [B,r] :: :: 0x31,0x95|(r<<5)
LEAY D,r :: :: 0x31,0x8B|(r<<5)
LEAY [D,r] :: :: 0x31,0x9B|(r<<5)
LEAY <!v,r :: v<-16||v>15;2 :: 0x31,(r<<5)|(v&0x1f)
LEAY >!v,r :: v<-128||v>127;2 :: 0x31,0x88|(r<<5),v&0xff
LEAY [>!v,r] :: v<-128||v>127;2 :: 0x31,0x98|(r<<5),v&0xff
LEAY >>!v,r :: :: 0x31,0x89|(r<<5),(v>>8)&0xff,v&0xff
LEAY [>>!v,r] :: :: 0x31,0x99|(r<<5),(v>>8)&0xff,v&0xff
LEAY <!e,PCR :: (e-$$-3)<-128||(e-$$-3)>127;2 :: 0x31,0x8C,(e-$$-3)&0xff
LEAY [<!e,PCR] :: (e-$$-3)<-128||(e-$$-3)>127;2 :: 0x31,0x9C,(e-$$-3)&0xff
LEAY >!e,PCR :: :: 0x31,0x8D,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LEAY [>!e,PCR] :: :: 0x31,0x9D,((e-$$-4)>>8)&0xff,(e-$$-4)&0xff
LEAY !v,r :: :: 0x31,(t:=(v>=-16&&v<=15)?0:(v>=-128&&v<=127)?1:2)*0+((t==0)?((r<<5)|(v&0x1f)):(t==1)?(0x88|(r<<5)):(0x89|(r<<5))),;(t==1)?(0x100|(v&0xff)):0,;(t==2)?(0x100|((v>>8)&0xff)):0,;(t==2)?(0x100|(v&0xff)):0
LEAY [!v,r] :: :: 0x31,(t:=(v>=-128&&v<=127)?1:2)*0+((t==1)?(0x98|(r<<5)):(0x99|(r<<5))),;(t==1)?(0x100|(v&0xff)):0,;(t==2)?(0x100|((v>>8)&0xff)):0,;(t==2)?(0x100|(v&0xff)):0
LEAY !e,PCR :: :: 0x31,(t:=((e-$$-3)>=-128&&(e-$$-3)<=127)?1:2)*0+((t==1)?0x8C:0x8D),;(t==1)?(0x100|((e-$$-3)&0xff)):0,;(t==2)?(0x100|(((e-$$-4)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-4)&0xff)):0
LEAY [!e,PCR] :: :: 0x31,(t:=((e-$$-3)>=-128&&(e-$$-3)<=127)?1:2)*0+((t==1)?0x9C:0x9D),;(t==1)?(0x100|((e-$$-3)&0xff)):0,;(t==2)?(0x100|(((e-$$-4)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-4)&0xff)):0
LEAY [!v] :: :: 0x31,0x9F,(v>>8)&0xff,v&0xff
LEAS ,r :: :: 0x32,0x84|(r<<5)
