LEAS [!v,r] :: :: 0x32,(t:=(v>=-128&&v<=127)?1:2)*0+((t==1)?(0x98|(r<<5)):(0x99|(r<<5))),;(t==1)?(0x100|(v&0xff)):0,;(t==2)?(0x100|((v>>8)&0xff)):0,;(t==2)?(0x100|(v&0xff)):0
LEAS !e,PCR :: :: 0x32,(t:=((e-$$-3)>=-128&&(e-$$-3)<=127)?1:2)*0+((t==1)?0x8C:0x8D),;(t==1)?(0x100|((e-$$-3)&0xff)):0,;(t==2)?(0x100|(((e-$$-4)>>8)&0xff)):0,;(t==2)?(0x100|((e-$$-4)&0xff)):0
