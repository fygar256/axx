/*  ==================================================================
/*  textmode.axx -- .textmode と !L / {{.exp()}} のテスト
/*
/*  Technical_Manual 3.18 のテスト。テキスト置換モードで
/*    - `!L<変数>` が式・ラベルを「書かれていたままの文字」で拾うこと
/*    - `{{.exp(<変数>)}}` がその文字をそのまま出すこと
/*    - 行頭の `label:` がそのまま出力の先頭に付くこと
/*    - まだ定義されていないラベルを拾ってもエラーにならないこと
/*    - マッチしない行が素通しされ、1行が1行として出ること（.passthru/.eol）
/*    - 組み込みディレクティブの行（.org/.section/.align/.resb/.ascii/.equ …）が
/*      テキストとしてそのまま出ること
/*  を確かめる。paxx と caxx が同じバイト列を出すことも確かめる。
/*  ==================================================================

.bits::8
.textmode

.map::r::B,C,D,E,H,L,A
.setsym::rn::[B,C,D,E,H,L,A]
.setsym::HP::"0x"

/*  値ではなく綴りが要るオペランド（アドレス・ラベル）は !L で拾う。 */
LXI H,!La   :: "LD HL,{{.exp(a)}}"
LDA  !La    :: "LD A,({{.exp(a)}})"
JMP  !La    :: "JP {{.exp(a)}}"
CALL !La    :: "CALL {{.exp(a)}}"

/*  同じ行で、拾った文字と、その値の16進の両方を使う。 */
JMPC !La    :: "JP {{.exp(a)}}  ; = {{HP}}{{.hex(a)}}"

/*  値が要るオペランドは今までどおり式で拾う。 */
MVI r,!i    :: i>0xff;3 :: "LD {{rn[r]}},{{HP}}{{.hex(i)}}"
MOV r,r2    :: "LD {{rn[r]}},{{rn[r2]}}"

NOP         :: "NOP"
RET         :: "RET"
