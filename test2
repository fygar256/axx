#!/bin/sh

# パターンファイルとアセンブリソースの置き場。リポジトリでは patfile/ と
# asmsrc/ に分かれ、作業場ではどちらも同じ階層にある。どちらでもそのまま
# 走るようにここで決める（パスを手で書き換えると組を落としやすい）。
P=patfile; [ -d "$P" ] || P=.
S=asmsrc;  [ -d "$S" ] || S=.

caxx $P/4004.axx $S/4004.s -b b0
caxx $P/z80.axx $S/z80.s -b b1
caxx $P/6502.axx $S/6502.s -b b2
caxx $P/6800.axx $S/6800.s -b b3
caxx $P/6809.axx $S/6809.s -b b4
caxx $P/8080.axx $S/8080.s -b b5
caxx $P/8048.axx $S/8048.s -b b6
caxx $P/8051.axx $S/8051.s -b b7
caxx $P/68000.axx $S/68000.s -b b8
caxx $P/vliw.axx $S/vliw.s -b b9
caxx $P/itanium.axx $S/vliw.s -b b10
caxx $P/x86_64.axx $S/hello.s -b b11
caxx $P/x86_64m.axx $S/hello.s -b b12
caxx $P/aarch64_logical_mini.axx $S/aarch64_logical_mini_demo.s -b b13
caxx $P/bf.axx $S/bf.s -b b14
caxx $P/arrindex.axx $S/arrindex.s -b b15
caxx $P/passthru.axx $S/passthru.s -b b16
caxx $P/textmode.axx $S/textmode.s -b b17
caxx $P/8080toz80.axx $S/hello8080.s -b b18
caxx $P/textmode.axx $S/textmode.s -V > b19
caxx $P/8080toz80.axx $S/hello8080.s -V > b20
caxx $P/aarch64.axx $S/aarch64.s -b b21
caxx $P/elftype.axx $S/elftype.s -o b22 -m 62
caxx $P/elfgen.axx $S/elfgen.s -o b23
caxx $P/symcap.axx $S/symcap.s -b b24
caxx $P/echo.axx $S/echo.s -b b25 2>&1 | grep -v '^raw: wrote ' > b25e
caxx $P/elfprio.axx $S/elfprio.s -o b26
caxx $P/elfsec.axx $S/elfsec.s -o b27
caxx $P/endsub.axx $S/endsub.s -b b28
caxx $P/intel2att.axx $S/intel2att.s -b b29
caxx $P/intel2att.axx $S/intel2att.s -V > b30
# 番号が飛んでいるのは、下の 31〜110 を付け替えずに後から足したためである。
caxx $P/elfsym.axx $S/elfsym.s -o b111
caxx $P/riscv64.axx $S/riscv64.s -o b112
caxx $P/elfrel.axx $S/elfrel.s -o b113
caxx $P/aarch64.axx -m 183 --elfdesc > b114
caxx $P/elfpair.axx $S/elfpair.s -o b115
caxx $P/elfmips.axx $S/elfmips.s -o b116
caxx $P/elfmips64.axx $S/elfmips64.s -o b117
caxx $P/elfword.axx $S/elfword.s -o b118
caxx $P/elfpair.axx --elfdesc > b119
caxx $P/elfcfi.axx $S/elfcfi.s -o b120
caxx $P/elfcfi.axx $S/elfcfi.s -m 3 -f 32 -o b121
# MIPS 4 種（mips_isa.axx を共有する前置きファイル）で mips.s の全行を組む。
caxx $P/mips.axx $S/mips.s -b b122
caxx $P/mipsel.axx $S/mips.s -b b123
caxx $P/mips64.axx $S/mips.s -b b124
caxx $P/mips64el.axx $S/mips.s -b b125
caxx $P/mips.axx $S/mips.s -o b126
caxx $P/mipsel.axx $S/mips.s -o b127
caxx $P/mips64.axx $S/mips.s -o b128
caxx $P/mips64el.axx $S/mips.s -o b129
# 拡張（DSP・MSA・MT・VZ・EVA ほか）を mips_ase.s で、Release 6 を R6 の前置き
# ファイル 4 種と mipsr6.s で組む。
caxx $P/mips.axx $S/mips_ase.s -b b130
caxx $P/mipsel.axx $S/mips_ase.s -b b131
caxx $P/mips64.axx $S/mips_ase.s -b b132
caxx $P/mips64el.axx $S/mips_ase.s -b b133
caxx $P/mips.axx $S/mips_ase.s -o b134
caxx $P/mipsel.axx $S/mips_ase.s -o b135
caxx $P/mips64.axx $S/mips_ase.s -o b136
caxx $P/mips64el.axx $S/mips_ase.s -o b137
caxx $P/mipsr6.axx $S/mipsr6.s -b b138
caxx $P/mipsr6el.axx $S/mipsr6.s -b b139
caxx $P/mips64r6.axx $S/mipsr6.s -b b140
caxx $P/mips64r6el.axx $S/mipsr6.s -b b141
caxx $P/mipsr6.axx $S/mipsr6.s -o b142
caxx $P/mipsr6el.axx $S/mipsr6.s -o b143
caxx $P/mips64r6.axx $S/mipsr6.s -o b144
caxx $P/mips64r6el.axx $S/mipsr6.s -o b145
caxx $P/unordered.axx $S/unordered.s -b b146
caxx $P/a64tox64_axx.axx $S/bf_aarch64.s -V > b147
caxx $P/a64tox64_axx.axx $S/bf_aarch64.s -b b148
caxx $P/expcap.axx $S/expcap.s -V -b b149 > b149t
caxx $P/ministr.axx $S/ministr.s -b b150 2>&1 | grep -v '^raw: wrote ' > b150e
# 差分ファジングで見つけて直した食い違いの回帰テスト。正常系は -V のテキスト、
# エラー系は標準エラーの診断を比べる（エラーなので出力ファイルは書かれない）。
caxx $P/regress.axx $S/regress.s -V > b151
caxx $P/regress.axx $S/regresserr.s -b b152 2>&1 | grep -v '^raw: wrote ' > b152e
# SPARC: sparc_test.s の全行、sparc_reloc.s のリロケーション、bf_sparc.s の ELF
caxx $P/sparc.axx $S/sparc_test.s -b b153
caxx $P/sparc.axx $S/sparc_reloc.s -o b154
caxx $P/sparc.axx $S/bf_sparc.s -o b155 2>/dev/null
# 回帰テストの続き: -o では .org を後ろへ戻せない（標準エラーの診断で比べる）、
# 改行が CR だけのファイルと UTF-8 でないバイトを含む行の -v の一覧
caxx $P/z80.axx $S/regresself.s -o b156 2>&1 | grep -v '^elf: ' > b156e
caxx $P/regress.axx $S/regresscr.s -v > b157
# PowerPC64: DS / DQ 形式の欄（.reloc の第 4 欄）と、label-$$ と書いた PC 相対の
# データ（.elfpcguess）。-o の ELF で比べる。両方のバイト順。
caxx $P/ppc64.axx $S/ppc64_reloc2.s -o b158
caxx $P/ppc64le.axx $S/ppc64_reloc2.s -o b159
# RISC-V: la / lla と大域ロード・ストアの PCREL の対（.reloc の第 5・6 欄とアンカー）、
# label-$$ と書いた PC 相対のデータ、セクションをまたぐラベル差（.elfrelax::0）。
caxx $P/riscv64full.axx $S/riscv64full_reloc2.s -o b160
caxx $P/riscv64.axx $S/riscv64_reloc2.s -o b161
# MIPS: la / dla の追加の再配置（HI16+LO16、HIGHEST+HIGHER+HI16+LO16）と PC 相対の
# データ（R_MIPS_PC32 ほか）。o32 REL ビッグエンディアンと n64 RELA リトルエンディアン。
caxx $P/mips.axx $S/mips_reloc2.s -o b162
caxx $P/mips64el.axx $S/mips64_reloc2.s -o b163
# SPARC: ラベルの set / setx（.islabel と追加の再配置）、セクション内の分岐の解決
# （.elfresolve）、PC 相対のデータ（R_SPARC_DISP*）。
caxx $P/sparc.axx $S/sparc_reloc2.s -o b164
# -b で、先頭でないセクション（入り直した後も）にある分岐の変位。
caxx $P/x86_64.axx $S/bsection.s -b b165
# AArch64: 命令とデータの再配置、セクション内の分岐の解決（.elfresolve / .elfencode）。
caxx $P/aarch64.axx $S/aarch64_reloc.s -o b166
# x86-64: CALL / JMP / Jcc の近い形と短い形、RIP 相対の参照、絶対アドレッシングの
# MOV ストア。セクション内の局所ラベルは解決し、外部・大域は PLT32 / PC32 / PC8
# を持つ（.elfresolve）。両パターンファイルで確かめる。
caxx $P/x86_64.axx $S/x86_64_reloc.s -o b167
caxx $P/x86_64m.axx $S/x86_64_reloc.s -o b168
# 式・因子のあるべきところに式・因子が無い行は当たらず、.passthru で素通しされる。
caxx $P/exprmiss.axx $S/exprmiss.s -V -b b169 > b169t
# --elfdesc の .elfanchor と .elfresolve の並び（RISC-V は両方を宣言する）。
caxx $P/riscv64full.axx --elfdesc > b170
# x86-64: R8-R15 の REX（[disp+index]・CR / DR・VMREAD / VMWRITE・PEXTR*・MOVDG / MOVQG）。
# 両パターンファイルで。
caxx $P/x86_64.axx $S/x86_64_rex.s -b b171
caxx $P/x86_64m.axx $S/x86_64_rex.s -b b172
# x86-64: VEX / EVEX の全命令名（llvm-mc 19 と照合した抜粋）と [[rep]] の文字列命令。
caxx $P/x86_64.axx $S/x86_64_avx.s -b b173
caxx $P/x86_64m.axx $S/x86_64_avx.s -b b174
# x86-64: 範囲外の即値と、REX の要る行の AH / CH / DH / BH はエラー（標準エラーの診断で比べる）。
caxx $P/x86_64.axx $S/x86_64_err.s -b b175 2>&1 | grep -v '^raw: wrote ' > b175e
caxx $P/x86_64m.axx $S/x86_64_err.s -b b176 2>&1 | grep -v '^raw: wrote ' > b176e
caxx $P/68000.axx $S/68000_reloc.s -o b177
caxx $P/68000.axx $S/68000_err.s -b b178 2>&1 | grep -v '^raw: wrote ' > b178e
caxx $P/z80.axx $S/z80_err.s -b b179 2>&1 | grep -v '^raw: wrote ' > b179e
caxx $P/6502.axx $S/6502_err.s -b b180 2>&1 | grep -v '^raw: wrote ' > b180e
caxx $P/6800.axx $S/6800_err.s -b b181 2>&1 | grep -v '^raw: wrote ' > b181e
caxx $P/6809.axx $S/6809_err.s -b b182 2>&1 | grep -v '^raw: wrote ' > b182e
caxx $P/8080.axx $S/8080_err.s -b b183 2>&1 | grep -v '^raw: wrote ' > b183e
caxx $P/8051.axx $S/8051_err.s -b b184 2>&1 | grep -v '^raw: wrote ' > b184e
caxx $P/8048.axx $S/8048_err.s -b b185 2>&1 | grep -v '^raw: wrote ' > b185e
# 8 ビット系の範囲の境目（負の番地・即値の下限・強制形）と、8048 / 4004 の条件分岐の
# ページ（8048 は 2 バイト目、4004 は次の命令のページ）。外部の照合（capstone・ucsim・MAME）で見つけたもの。
caxx $P/6502.axx $S/6502_edge.s -b b186
caxx $P/6800.axx $S/6800_edge.s -b b187
caxx $P/6809.axx $S/6809_edge.s -b b188
caxx $P/8048.axx $S/8048_edge.s -b b189
caxx $P/4004.axx $S/4004_edge.s -b b190
caxx $P/4004.axx $S/4004_err.s -b b191 2>&1 | grep -v '^raw: wrote ' > b191e
# -i のインポートファイルの値（符号・0x・前後の空白・64 ビット超え、読めない値は行ごと捨てる）。
caxx $P/z80.axx $S/import_test.s -i $S/import_test.tsv -b b192
caxx $P/z80.axx $S/import_test_err.s -i $S/import_test_err.tsv -b b193 2>&1 | grep -v '^raw: wrote ' > b193e
# -v の一覧で .include の行と include 先の行が分かれること、.section を書かないときの
# -o の .text が末尾の .org まで届くこと。
caxx $P/z80.axx $S/listinc.s -v > b194
caxx $P/z80.axx $S/listinc.s -o b195
# AArch64 / RISC-V の範囲の境目（llvm-mc 19 と照合）: 4 の倍数でない PC 相対と ADRP の範囲、
# SVE の DUP / MOV / MUL / SMAX の即値、c.lui の -32 / 0xfffe0。
caxx $P/aarch64.axx $S/aarch64_edge.s -b b196
caxx $P/aarch64.axx $S/aarch64_err.s -b b197 2>&1 | grep -v '^raw: wrote ' > b197e
caxx $P/riscv64full.axx $S/riscv64full_edge.s -b b198
# データ定義（db / half / word / quad など）の範囲。以前は検査が無く黙って切り詰めた。
caxx $P/riscv64full.axx $S/riscv64full_err.s -b b199 2>&1 | grep -v '^raw: wrote ' > b199e
caxx $P/mips.axx $S/mips_err.s -b b200 2>&1 | grep -v '^raw: wrote ' > b200e
caxx $P/sparc.axx $S/sparc_err.s -b b201 2>&1 | grep -v '^raw: wrote ' > b201e
# 前方参照の .equ が 16 段を超える連鎖（-d の収束の回数も比べる）と、連鎖で延びた反復の
# 中での振動の報告。行末の \ の継続が !include 先でもつながること、./ を含むパスで渡した
# ソースの .include / !include 先の名前。標準出力へ書けないときの報告（/dev/full）。
caxx $P/z80.axx $S/relaxchain.s -d -b b202 2>&1 | grep -v '^raw: wrote ' > b202e
caxx $P/6502.axx $S/relaxosc_err.s -b b203 2>&1 | grep -v '^raw: wrote ' > b203e
caxx $P/z80.axx ./$S/contin.s -v > b204
caxx $P/z80.axx $S/z80.s -v > /dev/full 2> b205e
caxx $P/z80.axx $S/z80.s -P > /dev/full 2>> b205e
caxx $P/elfcfi.axx $S/cfiptr.s -o b206
caxx $P/regress.axx stdin -v < $S/regresscr.s > b207
caxx $P/x86_64.axx $S/reloctype.s -o b208
caxx $P/z80.axx $S/labelc_err.s -b b209 2>&1 | grep -v '^raw: wrote ' > b209e
caxx $P/vliw.axx $S/vliw_err.s -b b210 2>&1 | grep -v '^raw: wrote ' > b210e
caxx $P/z80.axx $S/dirjunk_err.s -b b211 2>&1 | grep -v '^raw: wrote ' > b211e
caxx $P/datadir.axx $S/datadir.s -v > b212
caxx $P/datadirbe.axx $S/datadir.s -v > b213
caxx $P/datadirw.axx $S/datadir.s -v > b214
caxx $P/datadir.axx $S/datadir.s -o b215
caxx $P/datadir.axx $S/datadir_err.s -b b216 2>&1 | grep -v '^raw: wrote ' > b216e

# 中核 16 組を他のオプションでも突き合わせる。-b だけでは ELF 出力・DWARF・
# リスティング・テキスト出力の経路が一度も比較されない。
# 注意: -g は DWARF の comp_dir にカレントディレクトリを埋めるので、caxx 側と
# paxx 側を必ず同じディレクトリで走らせること。別の場所で走らせると中身が
# 同じでも食い違う。
caxx $P/4004.axx $S/4004.s -o b31
caxx $P/z80.axx $S/z80.s -o b32
caxx $P/6502.axx $S/6502.s -o b33
caxx $P/6800.axx $S/6800.s -o b34
caxx $P/6809.axx $S/6809.s -o b35
caxx $P/8080.axx $S/8080.s -o b36
caxx $P/8048.axx $S/8048.s -o b37
caxx $P/8051.axx $S/8051.s -o b38
caxx $P/68000.axx $S/68000.s -o b39
caxx $P/vliw.axx $S/vliw.s -o b40
caxx $P/itanium.axx $S/vliw.s -o b41
caxx $P/x86_64.axx $S/hello.s -o b42
caxx $P/x86_64m.axx $S/hello.s -o b43
caxx $P/bf.axx $S/bf.s -o b44
caxx $P/8080toz80.axx $S/hello8080.s -o b45
caxx $P/aarch64.axx $S/aarch64.s -o b46

caxx $P/4004.axx $S/4004.s -m 3 -f 32 -o b47
caxx $P/z80.axx $S/z80.s -m 3 -f 32 -o b48
caxx $P/6502.axx $S/6502.s -m 3 -f 32 -o b49
caxx $P/6800.axx $S/6800.s -m 3 -f 32 -o b50
caxx $P/6809.axx $S/6809.s -m 3 -f 32 -o b51
caxx $P/8080.axx $S/8080.s -m 3 -f 32 -o b52
caxx $P/8048.axx $S/8048.s -m 3 -f 32 -o b53
caxx $P/8051.axx $S/8051.s -m 3 -f 32 -o b54
caxx $P/68000.axx $S/68000.s -m 3 -f 32 -o b55
caxx $P/vliw.axx $S/vliw.s -m 3 -f 32 -o b56
caxx $P/itanium.axx $S/vliw.s -m 3 -f 32 -o b57
caxx $P/x86_64.axx $S/hello.s -m 3 -f 32 -o b58
caxx $P/x86_64m.axx $S/hello.s -m 3 -f 32 -o b59
caxx $P/bf.axx $S/bf.s -m 3 -f 32 -o b60
caxx $P/8080toz80.axx $S/hello8080.s -m 3 -f 32 -o b61
caxx $P/aarch64.axx $S/aarch64.s -m 183 -f 64 -o b62

caxx $P/4004.axx $S/4004.s -g -o b63
caxx $P/z80.axx $S/z80.s -g -o b64
caxx $P/6502.axx $S/6502.s -g -o b65
caxx $P/6800.axx $S/6800.s -g -o b66
caxx $P/6809.axx $S/6809.s -g -o b67
caxx $P/8080.axx $S/8080.s -g -o b68
caxx $P/8048.axx $S/8048.s -g -o b69
caxx $P/8051.axx $S/8051.s -g -o b70
caxx $P/68000.axx $S/68000.s -g -o b71
caxx $P/vliw.axx $S/vliw.s -g -o b72
caxx $P/itanium.axx $S/vliw.s -g -o b73
caxx $P/x86_64.axx $S/hello.s -g -o b74
caxx $P/x86_64m.axx $S/hello.s -g -o b75
caxx $P/bf.axx $S/bf.s -g -o b76
caxx $P/8080toz80.axx $S/hello8080.s -g -o b77
caxx $P/aarch64.axx $S/aarch64.s -g -o b78

caxx $P/4004.axx $S/4004.s -v -b b79 > b79v
caxx $P/z80.axx $S/z80.s -v -b b80 > b80v
caxx $P/6502.axx $S/6502.s -v -b b81 > b81v
caxx $P/6800.axx $S/6800.s -v -b b82 > b82v
caxx $P/6809.axx $S/6809.s -v -b b83 > b83v
caxx $P/8080.axx $S/8080.s -v -b b84 > b84v
caxx $P/8048.axx $S/8048.s -v -b b85 > b85v
caxx $P/8051.axx $S/8051.s -v -b b86 > b86v
caxx $P/68000.axx $S/68000.s -v -b b87 > b87v
caxx $P/vliw.axx $S/vliw.s -v -b b88 > b88v
caxx $P/itanium.axx $S/vliw.s -v -b b89 > b89v
caxx $P/x86_64.axx $S/hello.s -v -b b90 > b90v
caxx $P/x86_64m.axx $S/hello.s -v -b b91 > b91v
caxx $P/bf.axx $S/bf.s -v -b b92 > b92v
caxx $P/8080toz80.axx $S/hello8080.s -v -b b93 > b93v
caxx $P/aarch64.axx $S/aarch64.s -v -b b94 > b94v

caxx $P/4004.axx $S/4004.s -V -b b95 > b95t
caxx $P/z80.axx $S/z80.s -V -b b96 > b96t
caxx $P/6502.axx $S/6502.s -V -b b97 > b97t
