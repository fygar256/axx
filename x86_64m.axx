/* ===== FFREE (スタック解放) DD C0+i ===== */
FFREE ST0      ::  ::  0xdd,0xc0
FFREE ST1      ::  ::  0xdd,0xc1
FFREE ST2      ::  ::  0xdd,0xc2
FFREE ST3      ::  ::  0xdd,0xc3
