PINSRW x,d,!i            ::  ::  0x66,;(((x|d)&8)?(0x40|((x&8)>>1)|((d&8)>>3)):0),0x0f,0xc4,0xc0|((x&7)<<3)|(d&7),(i&0xff)
PEXTRW d,x,!i            ::  ::  0x66,;(((d|x)&8)?(0x40|((d&8)>>1)|((x&8)>>3)):0),0x0f,0xc5,0xc0|((d&7)<<3)|(x&7),(i&0xff)
PMOVMSKB d,x             ::  ::  0x66,;(((d|x)&8)?(0x40|((d&8)>>1)|((x&8)>>3)):0),0x0f,0xd7,0xc0|((d&7)<<3)|(x&7)
