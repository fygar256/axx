REP_SCASQ               ::  ::  0xf3,0x48,0xaf
STOSB                    ::  ::  0xaa
STOSW                    ::  ::  0x66,0xab
STOSD                    ::  ::  0xab
STOSQ                    ::  ::  0x48,0xab
REP_STOSB               ::  ::  0xf3,0xaa
REP_STOSW               ::  ::  0xf3,0x66,0xab
REP_STOSD               ::  ::  0xf3,0xab
REP_STOSQ               ::  ::  0xf3,0x48,0xab
LODSB                    ::  ::  0xac
LODSW                    ::  ::  0x66,0xad
LODSD                    ::  ::  0xad
LODSQ                    ::  ::  0x48,0xad
REP_LODSB               ::  ::  0xf3,0xac
REP_LODSW               ::  ::  0xf3,0x66,0xad
REP_LODSD               ::  ::  0xf3,0xad
REP_LODSQ               ::  ::  0xf3,0x48,0xad
REPE_CMPSB              ::  ::  0xf3,0xa6
