/* ===================== BMI1 / BMI2 ===================== */
/* Regenerated from GNU as ground truth.  32-bit and 64-bit operand
   forms are separated by .check so that VEX.W is chosen correctly;
   q (64-bit) and v (32-bit) are declared here and cleared below. */
.check::q::RAX,RCX,RDX,RBX,RSP,RBP,RSI,RDI,R8,R9,R10,R11,R12,R13,R14,R15
.check::v::EAX,ECX,EDX,EBX,ESP,EBP,ESI,EDI,R8D,R9D,R10D,R11D,R12D,R13D,R14D,R15D
/* --- ANDN --- */
/* ANDN : 64-bit operands */
!x_andn("ANDN", 0xf2, 0x80)
/* ANDN : 32-bit operands */
/* --- BEXTR --- */
/* BEXTR : 64-bit operands */
!x_bextr("BEXTR", 0xf7, 0x80)
/* BEXTR : 32-bit operands */
/* --- BLSI --- */
/* BLSI : 64-bit operands */
