!x_vmovdqa32_512("VMOVDQU32_512", 0x7e)
!x_vmovdqa32_512("VMOVDQU64_512", 0xfe)

/* ====================== EVEX 浮動小数点算術 (512-bit PS/PD) ====================== */
!x_vaddps512("VADDPS512", 0x58)
!x_vaddpd512("VADDPD512", 0x01, 0x58)
!x_vaddps512("VSUBPS512", 0x5c)
!x_vaddpd512("VSUBPD512", 0x01, 0x5c)
!x_vaddps512("VMULPS512", 0x59)
!x_vaddpd512("VMULPD512", 0x01, 0x59)
