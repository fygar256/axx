REPNE_SCASQ             ::  ::  0xf2,0x48,0xaf

/* ====================== x87 FPU ====================== */

/* =========================================================
   v9.0 追加: x87 FPU 完全版 (D8-DF エスケープ)
   変数 d: ST インデックス (ST0-ST7 = 0-7)
   SIZE: DWORD=m32  QWORD=m64  TBYTE=m80  WORD=m16
   ========================================================= */

/* ===== FLD (浮動小数点ロード) ===== */
!x_fld("FLD", 0x00, 0xd9, 0x28)

/* ===== FST / FSTP (浮動小数点ストア) ===== */
FST ST0        ::  ::  0xdd,0xd0
FST ST1        ::  ::  0xdd,0xd1
FST ST2        ::  ::  0xdd,0xd2
FST ST3        ::  ::  0xdd,0xd3
FST ST4        ::  ::  0xdd,0xd4
FST ST5        ::  ::  0xdd,0xd5
FST ST6        ::  ::  0xdd,0xd6
FST ST7        ::  ::  0xdd,0xd7
!x_fld("FSTP", 0x18, 0xdd, 0x38)
FST DWORD [b]      ::  ::  ;((b&8)?0x41:0),0xd9,(((b&7)==5)?0x40:0)|0x10|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
FST DWORD [b+!o]B  :: o>127;3,o<-128;3  ::  ;((b&8)?0x41:0),0xd9,0x50|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
FST DWORD [b+r*1]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,(((b&7)==5)?0x40:0)|0x04|0x10,(0x00|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST DWORD [b+r*2]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,(((b&7)==5)?0x40:0)|0x04|0x10,(0x40|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST DWORD [b+r*4]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,(((b&7)==5)?0x40:0)|0x04|0x10,(0x80|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST DWORD [b+r*8]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,(((b&7)==5)?0x40:0)|0x04|0x10,(0xc0|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST DWORD [b+r*1+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x50|0x04,(0x00|((r&7)<<3)|(b&7)),(o&0xff)
FST DWORD [b+r*2+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x50|0x04,(0x40|((r&7)<<3)|(b&7)),(o&0xff)
FST DWORD [b+r*4+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x50|0x04,(0x80|((r&7)<<3)|(b&7)),(o&0xff)
FST DWORD [b+r*8+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x50|0x04,(0xc0|((r&7)<<3)|(b&7)),(o&0xff)
FST DWORD [b+r*1+!o]   ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x90|0x04,(0x00|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
FST DWORD [b+r*2+!o]   ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x90|0x04,(0x40|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
FST DWORD [b+r*4+!o]   ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x90|0x04,(0x80|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
FST DWORD [b+r*8+!o]   ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xd9,0x90|0x04,(0xc0|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
FST DWORD [b+!o]   ::  ::  ;((b&8)?0x41:0),0xd9,0x90|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]
FST QWORD [b]      ::  ::  ;((b&8)?0x41:0),0xdd,(((b&7)==5)?0x40:0)|0x10|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
FST QWORD [b+!o]B  :: o>127;3,o<-128;3  ::  ;((b&8)?0x41:0),0xdd,0x50|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
FST QWORD [b+r*1]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,(((b&7)==5)?0x40:0)|0x04|0x10,(0x00|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST QWORD [b+r*2]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,(((b&7)==5)?0x40:0)|0x04|0x10,(0x40|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST QWORD [b+r*4]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,(((b&7)==5)?0x40:0)|0x04|0x10,(0x80|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST QWORD [b+r*8]      ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,(((b&7)==5)?0x40:0)|0x04|0x10,(0xc0|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
FST QWORD [b+r*1+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,0x50|0x04,(0x00|((r&7)<<3)|(b&7)),(o&0xff)
FST QWORD [b+r*2+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,0x50|0x04,(0x40|((r&7)<<3)|(b&7)),(o&0xff)
FST QWORD [b+r*4+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,0x50|0x04,(0x80|((r&7)<<3)|(b&7)),(o&0xff)
FST QWORD [b+r*8+!o]B  :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,0x50|0x04,(0xc0|((r&7)<<3)|(b&7)),(o&0xff)
FST QWORD [b+r*1+!o]   ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,0x90|0x04,(0x00|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
FST QWORD [b+r*2+!o]   ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0xdd,0x90|0x04,(0x40|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
