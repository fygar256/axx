/* === E [v10簡約]: SIZE修飾語廃止 + qword check 追加 ===
   BYTE  → j(dst),k(src): AL,CL,DL,BL,SPL,BPL,SIL,DIL,R8B-R15B,AH,CH,DH,BH
   WORD  → n(dst),m(src): AX,CX,DX,BX,SP,BP,SI,DI,R8W-R15W
   DWORD → f(dst),t(src): EAX,ECX,EDX,EBX,ESP,EBP,ESI,EDI,R8D-R15D
   QWORD → d(dst),s(src): RAX,RCX,RDX,RBX,RSP,RBP,RSI,RDI,R8-R15
   ★ 評価順序: d,s はqword専用に制限。32bitはf,t、16bitはn,m、8bitはj,k が先にマッチ ★
   ============================================================= */
.check::j::AL,CL,DL,BL,R8B,R9B,R10B,R11B,R12B,R13B,R14B,R15B,AH,CH,DH,BH
.check::k::AL,CL,DL,BL,R8B,R9B,R10B,R11B,R12B,R13B,R14B,R15B,AH,CH,DH,BH
.check::u::SPL,BPL,SIL,DIL
.check::w::SPL,BPL,SIL,DIL
.check::n::AX,CX,DX,BX,SP,BP,SI,DI,R8W,R9W,R10W,R11W,R12W,R13W,R14W,R15W
.check::m::AX,CX,DX,BX,SP,BP,SI,DI,R8W,R9W,R10W,R11W,R12W,R13W,R14W,R15W
.check::f::EAX,ECX,EDX,EBX,ESP,EBP,ESI,EDI,R8D,R9D,R10D,R11D,R12D,R13D,R14D,R15D
.check::t::EAX,ECX,EDX,EBX,ESP,EBP,ESI,EDI,R8D,R9D,R10D,R11D,R12D,R13D,R14D,R15D
.check::d::RAX,RCX,RDX,RBX,RSP,RBP,RSI,RDI,R8,R9,R10,R11,R12,R13,R14,R15
.check::s::RAX,RCX,RDX,RBX,RSP,RBP,RSI,RDI,R8,R9,R10,R11,R12,R13,R14,R15

/* ====================== データ定義 ====================== */
DB !e  ::  ::  e
DW !e  ::  ::  @@[2,*(e,%%)]
DD !e  ::  ::  @@[4,*(e,%%)]
DQ !e  ::  ::  @@[8,*(e,%%)]

/* ====================== [symbol+reg] SIBアドレッシング ====================== */
/*
   disp32 + index*1 (base なし) アドレッシング。
   s を「symbol: .equ addr::abs32」で定義すると、
   4バイトフィールドに R_X86_64_32 リロケーションが生成される。

   符号化:
     REX  : ;((r&8)?0x42:0)  ← REX.X bit のみ (index が r8-r15 のとき)
     opcode: 0xFE / 0x80 など
     ModRM : mod=00, /op, r/m=4(SIB)
     SIB   : scale=00, index=(r&7), base=101(disp32のみ) → ((r&7)<<3)|5
     disp32: @@[4,*(s,%%)]
*/
!x_inc("INC", 0x00)
!x_inc("DEC", 0x08)
CMP BYTE [!s\+r],!i   ::  ::  ;((r&8)?0x42:0),0x80,0x3c,((r&7)<<3)|5,@@[4,*(s,%%)],(i&0xff)
MOV  j,[!s\+r]    ::  ::  ;((r&8)?0x42:0),0x8a,0x04|((j&7)<<3),((r&7)<<3)|5,@@[4,*(s,%%)]
MOV  u,[!s\+r]    ::  ::0x40,0x8a,0x04|((u&7)<<3),((r&7)<<3)|5,@@[4,*(s,%%)]
MOV  [!s\+r],j    ::  ::  ;((r&8)?0x42:0),0x88,0x04|((j&7)<<3),((r&7)<<3)|5,@@[4,*(s,%%)]
MOV  [!s\+r],u    ::  ::0x40,0x88,0x04|((u&7)<<3),((r&7)<<3)|5,@@[4,*(s,%%)]


/* ====================== MOV セグメントレジスタ ← メモリ (0x8E /r) ====================== */
/* ★ 順序重要: MOV d,[RSP] など汎用パターンより前に配置 ★
   64ビットモードでも全セグメントレジスタへのメモリロードは有効。
   RIP相対、RSP/R12(SIB必須)、RBP/R13(mod=01,disp8=0) 特殊形含む。
   モジュロ: ModRM.reg = sreg番号 (ES=0,CS=1,SS=2,DS=3,FS=4,GS=5)   */

/* === A-1 [v10簡約]: MOV sreg←mem  72→12パターン (.check::g 統合) === */
.check::g::ES,CS,SS,DS,FS,GS
MOV g,[RIP+!a]   ::  ::  0x8e,(g<<3)|0x05,@@[4,*(a-$.,%%)]
MOV g,[b]        ::  ::  ;((b&8)?0x41:0),0x8e,(((b&7)==5)?0x40:0)|(g<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
MOV g,[b+!o]B    :: o>127;3,o<-128;3  ::  ;((b&8)?0x41:0),0x8e,0x40|(g<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
MOV g,[b+r*1]        ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,(((b&7)==5)?0x40:0)|0x04|(g<<3),(0x00|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV g,[b+r*2]        ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,(((b&7)==5)?0x40:0)|0x04|(g<<3),(0x40|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV g,[b+r*4]        ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,(((b&7)==5)?0x40:0)|0x04|(g<<3),(0x80|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV g,[b+r*8]        ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,(((b&7)==5)?0x40:0)|0x04|(g<<3),(0xc0|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV g,[b+r*1+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x40|(g<<3)|0x04,(0x00|((r&7)<<3)|(b&7)),(o&0xff)
MOV g,[b+r*2+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x40|(g<<3)|0x04,(0x40|((r&7)<<3)|(b&7)),(o&0xff)
MOV g,[b+r*4+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x40|(g<<3)|0x04,(0x80|((r&7)<<3)|(b&7)),(o&0xff)
MOV g,[b+r*8+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x40|(g<<3)|0x04,(0xc0|((r&7)<<3)|(b&7)),(o&0xff)
MOV g,[b+r*1+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x80|(g<<3)|0x04,(0x00|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV g,[b+r*2+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x80|(g<<3)|0x04,(0x40|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV g,[b+r*4+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x80|(g<<3)|0x04,(0x80|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV g,[b+r*8+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x8e,0x80|(g<<3)|0x04,(0xc0|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV g,[b+!o]     ::  ::  ;((b&8)?0x41:0),0x8e,0x80|(g<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]
.clrcheck::g

/* ====================== RSP/R12 ベース: SIB=0x24 必要 ====================== */
/* RSP(4)/R12(12) が rm=100 のとき CPU は SIB バイトを期待する。
   SIB=0x24: scale=00, index=100(none), base=100(RSP/R12)
   R12: REX.B=1 で base=100 → R12 を指す。                            */
/* 64bit load */
MOV d,[b+r*!!h]           ::  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,(((b&7)==5)?0x40:0)|0x04|((d&7)<<3),((@h-1)<<6|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV d,[b+r*1+!o]        ::  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,[b+r*2+!o]        ::  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((2-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,[b+r*4+!o]        ::  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((3-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,[b+r*8+!o]        ::  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((4-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,[b+r*1+!o]B       :: o>127;3,o<-128;3  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,[b+r*2+!o]B       :: o>127;3,o<-128;3  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((2-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,[b+r*4+!o]B       :: o>127;3,o<-128;3  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((3-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,[b+r*8+!o]B       :: o>127;3,o<-128;3  ::  0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((4-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
/* 64bit store */
MOV [b+r*!!h],s           ::  ::  0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,(((b&7)==5)?0x40:0)|0x04|((s&7)<<3),((@h-1)<<6|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV [b+r*1+!o],s        ::  ::  0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x84|((s&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
