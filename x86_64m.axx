/* PDEP : 32-bit operands */
/* --- PEXT --- */
/* PEXT : 64-bit operands */
!x_andn("PEXT", 0xf5, 0x82)
/* PEXT : 32-bit operands */
/* --- RORX --- */
/* RORX : 64-bit operands */
RORX d,s,!i  ::  ::  0xc4,(0x43|((~(d)>>3&1)<<7)|((~(s)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0xc0|((d&7)<<3)|(s&7),(i&0xff)
RORX d,[b],!i  ::  ::  0xc4,(0x43|((~(d)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,(((b&7)==5)?0x40:0)|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00],(i&0xff)
RORX d,[b+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x43|((~(d)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x40|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff),(i&0xff)
RORX d,[b+!o],!i  ::  ::  0xc4,(0x43|((~(d)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x80|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)],(i&0xff)
RORX d,[b+r*!!h],!i  ::  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,(((b&7)==5)?0x40:0)|0x04|((d&7)<<3),((@h-1)<<6|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00],(i&0xff)
RORX d,[b+r*1+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x44|((d&7)<<3),((0)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX d,[b+r*1+!o],!i  ::  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x84|((d&7)<<3),((0)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
RORX d,[b+r*2+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x44|((d&7)<<3),((1)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX d,[b+r*2+!o],!i  ::  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x84|((d&7)<<3),((1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
RORX d,[b+r*4+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x44|((d&7)<<3),((2)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX d,[b+r*4+!o],!i  ::  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x84|((d&7)<<3),((2)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
RORX d,[b+r*8+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x44|((d&7)<<3),((3)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX d,[b+r*8+!o],!i  ::  ::  0xc4,(0x03|((~(d)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x83|(0xf<<3))&0xff,0xf0,0x84|((d&7)<<3),((3)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
/* RORX : 32-bit operands */
RORX f,t,!i  ::  ::  0xc4,(0x43|((~(f)>>3&1)<<7)|((~(t)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0xc0|((f&7)<<3)|(t&7),(i&0xff)
RORX f,[b],!i  ::  ::  0xc4,(0x43|((~(f)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,(((b&7)==5)?0x40:0)|((f&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00],(i&0xff)
