/* ====================== PUSH / POP ====================== */
PUSHFQ                  ::  ::  0x9c
POPFQ                   ::  ::  0x9d
PUSHFW                  ::  ::  0x66,0x9c
PUSHF                   ::  ::  0x9c
POPFW                   ::  ::  0x66,0x9d
POPF                    ::  ::  0x9d
/* PUSH/POP セグメントレジスタ (64ビットモードでは FS/GS のみ有効) */
/* ★ 順序重要: PUSH d より前に配置 ★
   PUSH FS: 0F A0  PUSH GS: 0F A8
   POP  FS: 0F A1  POP  GS: 0F A9
   CS/DS/SS/ES の PUSH/POP は 64ビットモードでは無効 (UD例外)       */
PUSH FS      ::  ::  0x0f,0xa0
PUSH GS      ::  ::  0x0f,0xa8
POP  FS      ::  ::  0x0f,0xa1
POP  GS      ::  ::  0x0f,0xa9

PUSH d                  ::  ::  ;((d&8)?0x41:0),0x50|(d&7)
POP  d                  ::  ::  ;((d&8)?0x41:0),0x58|(d&7)
PUSH !e                 ::  ::  0x68,@@[4,*(e,%%)]
PUSH8 !e                :: e>127;3,e<-128;3  ::  0x6a,(e&0xff)
