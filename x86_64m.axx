/* ====================== オペレーションマスク (K レジスタ, VEXエンコード) ====================== */
/* K レジスタ 0-7 を x,y,z に使用。VEX 3バイト (0xC4) で符号化 */
/* --- KMOV : mask <-> general purpose register (opcode 92/93) --- */
.check::x::K0,K1,K2,K3,K4,K5,K6,K7
.check::y::K0,K1,K2,K3,K4,K5,K6,K7
!x_kmovw("KMOVW", 0x78)
!x_kmovw("KMOVB", 0x79)
!x_kmovw("KMOVD", 0x7b)
KMOVQ x,d  ::  x>=0x100;5  ::  0xc4,(0xc1|((~(d)>>3&1)<<5))&0xff,0xfb,0x92,0xc0|((x&7)<<3)|(d&7)
