/* ===== FLDENV / FNSTENV / FSTENV (FPU環境) ===== */
!x_fldcw("FLDENV", 0xd9, 0x20)
!x_fldcw("FNSTENV", 0xd9, 0x30)
!x_fstcw("FSTENV", 0xd9, 0x30)

/* ===== FNSAVE / FSAVE / FRSTOR (FPU状態保存) ===== */
!x_fldcw("FNSAVE", 0xdd, 0x30)
!x_fldcw("FRSTOR", 0xdd, 0x20)
!x_fstcw("FSAVE", 0xdd, 0x30)

/* ===== FBLD / FBSTP (BCD) ===== */
!x_fbld("FBLD", 0x20)
!x_fbld("FBSTP", 0x30)

/* ===== オペランドなし命令 (D9 mod=11 など) ===== */
FWAIT    ::  ::  0x9b               /* FPU/CPU 同期 */
FNOP     ::  ::  0xd9,0xd0
FCHS     ::  ::  0xd9,0xe0          /* ST(0) 符号反転 */
FABS     ::  ::  0xd9,0xe1          /* ST(0) 絶対値 */
FTST     ::  ::  0xd9,0xe4          /* ST(0) と +0.0 比較 */
FXAM     ::  ::  0xd9,0xe5          /* ST(0) クラス検査 */
FLD1     ::  ::  0xd9,0xe8          /* ST(0) ← +1.0 */
FLDL2T   ::  ::  0xd9,0xe9          /* ST(0) ← log2(10) */
FLDL2E   ::  ::  0xd9,0xea          /* ST(0) ← log2(e) */
