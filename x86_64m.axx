RDPMC                   ::  ::  0x0f,0x33
XGETBV                  ::  ::  0x0f,0x01,0xd0
XSETBV                  ::  ::  0x0f,0x01,0xd1
UD2                     ::  ::  0x0f,0x0b
WBINVD                  ::  ::  0x0f,0x09
INVD                    ::  ::  0x0f,0x08
SWAPGS                  ::  ::  0x0f,0x01,0xf8
MONITOR                 ::  ::  0x0f,0x01,0xc8
MWAIT                   ::  ::  0x0f,0x01,0xc9
VMCALL                  ::  ::  0x0f,0x01,0xc1
VMLAUNCH                ::  ::  0x0f,0x01,0xc2
VMRESUME                ::  ::  0x0f,0x01,0xc3
VMXOFF                  ::  ::  0x0f,0x01,0xc4

/* ====================== メモリバリア ====================== */
LFENCE                  ::  ::  0x0f,0xae,0xe8
MFENCE                  ::  ::  0x0f,0xae,0xf0
SFENCE                  ::  ::  0x0f,0xae,0xf8
!x_cmpxchg8b("CLFLUSH", 0xae, 0x38)
!x_clflushopt("CLFLUSHOPT", 0xae, 0x38)
!x_cmpxchg8b("PREFETCHT0", 0x18, 0x08)
!x_cmpxchg8b("PREFETCHT1", 0x18, 0x10)
!x_cmpxchg8b("PREFETCHT2", 0x18, 0x18)
!x_cmpxchg8b("PREFETCHNTA", 0x18, 0x00)

/* ====================== IN / OUT ====================== */
IN AL,DX                ::  ::  0xec
IN AX,DX                ::  ::  0x66,0xed
IN EAX,DX               ::  ::  0xed
IN AL,!i                ::  ::  0xe4,(i&0xff)
IN EAX,!i               ::  ::  0xe5,(i&0xff)
OUT DX,AL               ::  ::  0xee
OUT DX,EAX              ::  ::  0xef
OUT !i,AL               ::  ::  0xe6,(i&0xff)
OUT !i,EAX              ::  ::  0xe7,(i&0xff)

/* ====================== セグメント / CR / DR ====================== */
MOV FS,d                ::  ::  ;((d&8)?0x41:0),0x8e,0xe0|(d&7)
MOV GS,d                ::  ::  ;((d&8)?0x41:0),0x8e,0xe8|(d&7)
MOV d,FS                ::  ::  ;((d&8)?0x41:0),0x8c,0xe0|(d&7)
MOV d,GS                ::  ::  ;((d&8)?0x41:0),0x8c,0xe8|(d&7)
MOV CR0,d             ::  ::  0x0f,0x22,0xc0|(d&7)
MOV d,CR0             ::  ::  0x0f,0x20,0xc0|(d&7)
MOV CR2,d             ::  ::  0x0f,0x22,0xd0|(d&7)
MOV d,CR2             ::  ::  0x0f,0x20,0xd0|(d&7)
MOV CR3,d             ::  ::  0x0f,0x22,0xd8|(d&7)
MOV d,CR3             ::  ::  0x0f,0x20,0xd8|(d&7)
MOV CR4,d             ::  ::  0x0f,0x22,0xe0|(d&7)
MOV d,CR4             ::  ::  0x0f,0x20,0xe0|(d&7)
MOV DR0,d             ::  ::  0x0f,0x23,0xc0|(d&7)
MOV d,DR0             ::  ::  0x0f,0x21,0xc0|(d&7)
MOV DR1,d             ::  ::  0x0f,0x23,0xc8|(d&7)
MOV d,DR1             ::  ::  0x0f,0x21,0xc8|(d&7)
MOV DR2,d             ::  ::  0x0f,0x23,0xd0|(d&7)
MOV d,DR2             ::  ::  0x0f,0x21,0xd0|(d&7)
MOV DR3,d             ::  ::  0x0f,0x23,0xd8|(d&7)
MOV d,DR3             ::  ::  0x0f,0x21,0xd8|(d&7)
MOV DR6,d             ::  ::  0x0f,0x23,0xf0|(d&7)
MOV d,DR6             ::  ::  0x0f,0x21,0xf0|(d&7)
MOV DR7,d             ::  ::  0x0f,0x23,0xf8|(d&7)
MOV d,DR7             ::  ::  0x0f,0x21,0xf8|(d&7)
!x_cmpxchg8b("INVLPG", 0x01, 0x38)
!x_cmpxchg8b("LGDT", 0x01, 0x10)
!x_cmpxchg8b("LIDT", 0x01, 0x18)
!x_cmpxchg8b("SGDT", 0x01, 0x00)
!x_cmpxchg8b("SIDT", 0x01, 0x08)
LLDT d                  ::  ::  ;((d&8)?0x41:0),0x0f,0x00,0xd0|(d&7)
SLDT d                  ::  ::  ;((d&8)?0x41:0),0x0f,0x00,0xc0|(d&7)
LTR d                   ::  ::  ;((d&8)?0x41:0),0x0f,0x00,0xd8|(d&7)
!x_cmpxchg8b("FXSAVE", 0xae, 0x00)
!x_cmpxchg8b("FXRSTOR", 0xae, 0x08)
!x_cmpxchg8b("XSAVE", 0xae, 0x20)
!x_cmpxchg8b("XRSTOR", 0xae, 0x28)
VMREAD d,s              ::  ::  0x0f,0x78,0xc0|(d&7)|((s&7)<<3)
VMWRITE d,s             ::  ::  0x0f,0x79,0xc0|((d&7)<<3)|(s&7)
!x_cmpxchg8b("VMPTRLD", 0xc7, 0x30)
!x_clflushopt("VMCLEAR", 0xc7, 0x30)


/* ====================== REP/REPE/REPNE プレフィクス構文 ====================== */
/* axxはプレフィクスを独立命令として扱う */
REP MOVSB               ::  ::  0xf3,0xa4
REP MOVSW               ::  ::  0xf3,0x66,0xa5
REP MOVSD               ::  ::  0xf3,0xa5
REP MOVSQ               ::  ::  0xf3,0x48,0xa5
REP STOSB               ::  ::  0xf3,0xaa
REP STOSW               ::  ::  0xf3,0x66,0xab
REP STOSD               ::  ::  0xf3,0xab
REP STOSQ               ::  ::  0xf3,0x48,0xab
REP LODSB               ::  ::  0xf3,0xac
REP LODSW               ::  ::  0xf3,0x66,0xad
REP LODSD               ::  ::  0xf3,0xad
REP LODSQ               ::  ::  0xf3,0x48,0xad
!x_repe("REPE", 0xf3)
!x_repe("REPNE", 0xf2)

/* ====================== PUSHF/POPF ====================== */

/* ====================== SETcc バイトレジスタ直接指定 (REX省略版) ====================== */
/* 'd' はレジスタ番号を受け取るが al/cl/dl/bl=0-3 は REX不要 */

/* ====================== CRC32 ====================== */

/* ====================== RDRAND / RDSEED ====================== */
RDRAND n           ::  ::  0x66,;((n&8)?0x41:0),0x0f,0xc7,0xf0|(n&7)
RDRAND f          ::  ::  ;((f&8)?0x41:0),0x0f,0xc7,0xf0|(f&7)
RDRAND d                ::  ::  0x48|((d&8)>>3),0x0f,0xc7,0xf0|(d&7)
RDSEED n           ::  ::  0x66,;((n&8)?0x41:0),0x0f,0xc7,0xf8|(n&7)

/* ====================== MOVBE ====================== */
RDSEED f          ::  ::  ;((f&8)?0x41:0),0x0f,0xc7,0xf8|(f&7)
RDSEED d                ::  ::  0x48|((d&8)>>3),0x0f,0xc7,0xf8|(d&7)
!x_addsubpd("ADDSUBPD", 0x66, 0xd0)
!x_addsubpd("ADDSUBPS", 0xf2, 0xd0)
!x_addsubpd("HADDPD", 0x66, 0x7c)
!x_addsubpd("HADDPS", 0xf2, 0x7c)
!x_addsubpd("HSUBPD", 0x66, 0x7d)
!x_addsubpd("HSUBPS", 0xf2, 0x7d)
!x_addsubpd("MOVDDUP", 0xf2, 0x12)
!x_addsubpd("MOVSLDUP", 0xf3, 0x12)
!x_addsubpd("MOVSHDUP", 0xf3, 0x16)
LDDQU x,[b+r*!!h]             ::  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,(((b&7)==5)?0x40:0)|0x04|((x&7)<<3),(@h-1)<<6|((r&7)<<3)|(b&7),@@[((b&7)==5),0x00]
LDDQU x,[b+r*1+!o]             ::  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x84|((x&7)<<3),(1-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LDDQU x,[b+r*2+!o]             ::  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x84|((x&7)<<3),(2-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LDDQU x,[b+r*4+!o]             ::  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x84|((x&7)<<3),(3-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LDDQU x,[b+r*8+!o]             ::  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x84|((x&7)<<3),(4-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LDDQU x,[b]             ::  ::  0xf2,;(((x|b)&8)?(0x40|((x&8)>>1)|((b&8)>>3)):0),0x0f,0xf0,(((b&7)==5)?0x40:0)|((x&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
LDDQU x,[b+r*1+!o]B             :: o>127;3,o<-128;3  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x44|((x&7)<<3),(1-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LDDQU x,[b+r*2+!o]B             :: o>127;3,o<-128;3  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x44|((x&7)<<3),(2-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LDDQU x,[b+r*4+!o]B             :: o>127;3,o<-128;3  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x44|((x&7)<<3),(3-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LDDQU x,[b+r*8+!o]B             :: o>127;3,o<-128;3  ::  0xf2,;(((x|b|r)&8)?(0x40|((x&8)>>1)|((r&8)>>2)|((b&8)>>3)):0),0x0f,0xf0,0x44|((x&7)<<3),(4-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LDDQU x,[b+!o]B         :: o>127;3,o<-128;3  ::  0xf2,;(((x|b)&8)?(0x40|((x&8)>>1)|((b&8)>>3)):0),0x0f,0xf0,0x40|((x&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
LDDQU x,[b+!o]          ::  ::  0xf2,;(((x|b)&8)?(0x40|((x&8)>>1)|((b&8)>>3)):0),0x0f,0xf0,0x80|((x&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]
/* ====================== 文字列命令 ====================== */
MOVSB                    ::  ::  0xa4
MOVSW                    ::  ::  0x66,0xa5
MOVSD                    ::  ::  0xa5
MOVSQ                    ::  ::  0x48,0xa5
REP_MOVSB               ::  ::  0xf3,0xa4
REP_MOVSW               ::  ::  0xf3,0x66,0xa5
REP_MOVSD               ::  ::  0xf3,0xa5
REP_MOVSQ               ::  ::  0xf3,0x48,0xa5
CMPSB                    ::  ::  0xa6
CMPSW                    ::  ::  0x66,0xa7
CMPSD                    ::  ::  0xa7
CMPSQ                    ::  ::  0x48,0xa7
REP_CMPSB               ::  ::  0xf3,0xa6
REP_CMPSW               ::  ::  0xf3,0x66,0xa7
REP_CMPSD               ::  ::  0xf3,0xa7
REP_CMPSQ               ::  ::  0xf3,0x48,0xa7
SCASB                    ::  ::  0xae
SCASW                    ::  ::  0x66,0xaf
SCASD                    ::  ::  0xaf
