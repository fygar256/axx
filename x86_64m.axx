FPREM    ::  ::  0xd9,0xf8          /* 余剰 (8087互換) */
FYL2XP1  ::  ::  0xd9,0xf9          /* ST(1)*log2(ST(0)+1) */
FSQRT    ::  ::  0xd9,0xfa          /* √ST(0) */
FSINCOS  ::  ::  0xd9,0xfb          /* sin/cos 同時計算 */
FRNDINT  ::  ::  0xd9,0xfc          /* 整数に丸め */
FSCALE   ::  ::  0xd9,0xfd          /* ST(0)*2^⌊ST(1)⌋ */
FSIN     ::  ::  0xd9,0xfe          /* sin(ST(0)) */
FCOS     ::  ::  0xd9,0xff          /* cos(ST(0)) */
FNCLEX   ::  ::  0xdb,0xe2          /* 例外クリア (no-wait) */
FCLEX    ::  ::  0x9b,0xdb,0xe2     /* 例外クリア */
FNINIT   ::  ::  0xdb,0xe3          /* FPU初期化 (no-wait) */
