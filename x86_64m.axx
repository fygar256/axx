VPSHUFD x,y,!i           ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(y)>>3&1)<<5))&0xff,((0xf)<<3|1)&0xff,0x70,0xc0|((x&7)<<3)|(y&7),(i&0xff)
VPSHUFHW x,y,!i          ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(y)>>3&1)<<5))&0xff,((0xf)<<3|3)&0xff,0x70,0xc0|((x&7)<<3)|(y&7),(i&0xff)
VPSHUFLW x,y,!i          ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(y)>>3&1)<<5))&0xff,((0xf)<<3|2)&0xff,0x70,0xc0|((x&7)<<3)|(y&7),(i&0xff)
!x_vcmpsd("VPALIGNR", 0x01, 0x0f, 0x03)
!x_vcmpsd("VPBLENDW", 0x01, 0x0e, 0x03)
!x_vinsertf128("VINSERTF128", 0x18)
VEXTRACTF128 z,x,!i      ::  z+x>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(z)>>3&1)<<5))&0xff,((0xf)<<3|(1<<2)|1)&0xff,0x19,0xc0|((x&7)<<3)|(z&7),(i&0xff)
!x_vinsertf128("VPERM2F128", 0x06)
/* 修正: VPERMILPD/VPERMILPS のレジスタ形式 (x,y,z) が y には .check 制約がなく、
   !i は式評価でレジスタ名シンボル(z等)も解決してしまうため、遠く離れた位置にある
   レジスタ形式に先んじて誤マッチしていた。即値形式は対応するレジスタ形式の直後
   （AVX 整数3op節ではなく VPERMILPD/VPERMILPS 本体の直後）に移動する。 */

