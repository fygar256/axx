/* ====================== AVX-512 (EVEX プリフィックス) v7.0 ====================== */

/* EVEXプリフィックス構造 (4バイト: 0x62, P1, P2, P3):
   P1: R̄[7] X̄[6] B̄[5] R'̄[4] mm[3:2] 00[1:0]
       R̄=NOT(reg[3])  X̄=NOT(rm[4])(reg-reg) / 1(mem,SIBなし)
       B̄=NOT(rm[3])   R'̄=NOT(reg[4])
       mm: 0x04→0F  0x08→0F38  0x0C→0F3A
   P2: W[7] ~vvvv[6:3] 1[2] pp[1:0]
       pp: 00→NP  01→66  10→F3  11→F2   W: 0→dword/float  1→qword/double
   P3: z[7] L'L[6:5] b[4] ~V'[3] aaa[2:0]
       L'L=10→512bit  ~V'=NOT(vvvv[4])  aaa=000(マスクなし)

   命名規則: 末尾512 = ZMM 512-bit EVEX形式
     x = dest ZMM/rm  y = src ZMM / vvvv  z = 2nd-src ZMM/rm
     b = base GP reg  s = store-src ZMM   d = NDD dest (vvvv)  */

/* ====================== EVEX MOV (512-bit ZMM) ====================== */
!x_vmovaps512("VMOVAPS512", 0x7c, 0x29)
!x_vmovaps512("VMOVAPD512", 0xfd, 0x29)
!x_vmovaps512("VMOVUPS512", 0x7c, 0x11)
!x_vmovaps512("VMOVUPD512", 0xfd, 0x11)
!x_vmovdqa32_512("VMOVDQA32_512", 0x7d)
