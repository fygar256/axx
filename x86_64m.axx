RORX f,[b+!o],!i  ::  ::  0xc4,(0x43|((~(f)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x80|((f&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)],(i&0xff)
RORX f,[b+r*!!h],!i  ::  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,(((b&7)==5)?0x40:0)|0x04|((f&7)<<3),((@h-1)<<6|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00],(i&0xff)
RORX f,[b+r*1+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x44|((f&7)<<3),((0)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX f,[b+r*1+!o],!i  ::  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x84|((f&7)<<3),((0)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
RORX f,[b+r*2+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x44|((f&7)<<3),((1)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX f,[b+r*2+!o],!i  ::  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x84|((f&7)<<3),((1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
RORX f,[b+r*4+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x44|((f&7)<<3),((2)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
RORX f,[b+r*4+!o],!i  ::  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x84|((f&7)<<3),((2)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)],(i&0xff)
RORX f,[b+r*8+!o]B,!i  :: o>127;3,o<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,(0x03|(0xf<<3))&0xff,0xf0,0x44|((f&7)<<3),((3)<<6|((r&7)<<3)|(b&7)),(o&0xff),(i&0xff)
