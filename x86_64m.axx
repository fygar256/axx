/* BLSMSK : 64-bit operands */
!x_blsi("BLSMSK", 0x02)
/* BLSMSK : 32-bit operands */
/* --- BLSR --- */
/* BLSR : 64-bit operands */
!x_blsi("BLSR", 0x01)
/* BLSR : 32-bit operands */
/* --- BZHI --- */
/* BZHI : 64-bit operands */
!x_bextr("BZHI", 0xf5, 0x80)
/* BZHI : 32-bit operands */
