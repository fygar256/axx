VPSLLQ512 x,y,z  ::  ::  0x62,(((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4)|0x01)&0xff,((~(y)&0xf)<<3|5)&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xf3,0xc0|((x&7)<<3)|(z&7)
