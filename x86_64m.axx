/* --- register-direct (register-to-register) forms, all sizes ---
   Real x86-64 XADD supports r/m,r for BYTE/WORD/DWORD/QWORD alike;
   only the QWORD case (XADD d,s) existed here previously. Added to
   match the register-direct coverage every other size already has
   in the memory-operand forms above (k/w=BYTE, t=DWORD, s=QWORD),
   plus the WORD (n,m) case that was missing even for memory operands. */
XADD j,k            ::  ::  ;(((k|j)&8)?(0x40|((k&8)>>1)|((j&8)>>3)):0),0x0f,0xc0,0xc0|(j&7)|((k&7)<<3)
XADD u,k            ::  ::(0x40|((k&8)>>1)|((u&8)>>3)),0x0f,0xc0,0xc0|(u&7)|((k&7)<<3)
XADD j,w            ::  ::(0x40|((w&8)>>1)|((j&8)>>3)),0x0f,0xc0,0xc0|(j&7)|((w&7)<<3)
XADD u,w            ::  ::(0x40|((w&8)>>1)|((u&8)>>3)),0x0f,0xc0,0xc0|(u&7)|((w&7)<<3)
XADD n,m            ::  ::  0x66,;(((m|n)&8)?(0x40|((m&8)>>1)|((n&8)>>3)):0),0x0f,0xc1,0xc0|(n&7)|((m&7)<<3)
XADD f,t           ::  ::  ;(((t|f)&8)?(0x40|((t&8)>>1)|((f&8)>>3)):0),0x0f,0xc1,0xc0|(f&7)|((t&7)<<3)
XADD d,s                ::  ::  0x48|((s&8)>>1)|((d&8)>>3),0x0f,0xc1,0xc0|(d&7)|((s&7)<<3)
XADD [b],s              ::  ::  0x48|((s&8)>>1)|((b&8)>>3),0x0f,0xc1,(((b&7)==5)?0x40:0)|((s&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
