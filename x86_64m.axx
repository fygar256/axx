/* SSE2 シフト */
/* 修正: レジスタ形式 (x,y) を即値形式 (x,!i) より先に評価する。
   y には .check 制約がなく、!i は式評価でレジスタ名シンボル(xmm1等)も解決してしまうため、
   x,!i が先だと "psllw xmm0,xmm1" のようなレジスタ形式が即値形式として誤マッチしていた。 */
PSLLW x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xf1,0xc0|((x&7)<<3)|(y&7)
PSLLD x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xf2,0xc0|((x&7)<<3)|(y&7)
PSLLQ x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xf3,0xc0|((x&7)<<3)|(y&7)
PSRLW x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xd1,0xc0|((x&7)<<3)|(y&7)
PSRLD x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xd2,0xc0|((x&7)<<3)|(y&7)
PSRLQ x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xd3,0xc0|((x&7)<<3)|(y&7)
PSRAW x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xe1,0xc0|((x&7)<<3)|(y&7)
PSRAD x,y               ::  ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xe2,0xc0|((x&7)<<3)|(y&7)
PSLLW x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x71,0xf0|(x&7),(i&0xff)
PSLLD x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x72,0xf0|(x&7),(i&0xff)
PSLLQ x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x73,0xf0|(x&7),(i&0xff)
PSRLW x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x71,0xd0|(x&7),(i&0xff)
PSRLD x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x72,0xd0|(x&7),(i&0xff)
PSRLQ x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x73,0xd0|(x&7),(i&0xff)
PSRAW x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x71,0xe0|(x&7),(i&0xff)
PSRAD x,!i              ::  ::  0x66,;((x&8)?0x41:0),0x0f,0x72,0xe0|(x&7),(i&0xff)

