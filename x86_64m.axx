/* ====================== シフト / ローテート (全アドレッシングモード) ====================== */
/* ROL */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("ROL", 0x00)

/* ROR */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("ROR", 0x08)

/* RCL */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("RCL", 0x10)

/* RCR */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("RCR", 0x18)

/* SHL */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("SHL", 0x20)

/* SHR */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("SHR", 0x28)

/* SAR */
/* CLを!iより先に定義 (CLの番号=1がimm8にマッチするため) */
!x_rol("SAR", 0x38)

/* SHLD / SHRD (全モード) */
!x_shld("SHLD", 0xa5)

!x_shld("SHRD", 0xad)

/* ====================== ビット操作 BT/BTS/BTR/BTC (全アドレッシングモード) ====================== */
/* BT */
!x_bt("BT", 0xa3)

/* BTS */
!x_bt("BTS", 0xab)

/* BTR */
!x_bt("BTR", 0xb3)

/* BTC */
!x_bt("BTC", 0xbb)

/* [修正済] BT/BTS/BTR/BTC のimm版メモリ形式は上で直接修正済 */
/* BSF / BSR / POPCNT / LZCNT / TZCNT */
!x_bsf("BSF", 0xbc)

!x_bsf("BSR", 0xbd)

