/* AVX 変換/比較 */
VCVTSI2SD x,y,d          ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(d)>>3&1)<<5))&0xff,((~(y)&0xf)<<3|2)&0xff,0x2a,0xc0|((x&7)<<3)|(d&7)
VCVTSI2SS x,y,d          ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(d)>>3&1)<<5))&0xff,((~(y)&0xf)<<3|3)&0xff,0x2a,0xc0|((x&7)<<3)|(d&7)
VCVTSD2SS x,y,z          ::  x+y+z>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(z)>>3&1)<<5))&0xff,((~(y)&0xf)<<3|0x03)&0xff,0x5a,0xc0|((x&7)<<3)|(z&7)
VCVTSS2SD x,y,z          ::  x+y+z>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(z)>>3&1)<<5))&0xff,((~(y)&0xf)<<3|0x02)&0xff,0x5a,0xc0|((x&7)<<3)|(z&7)
VUCOMISD x,y             ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(y)>>3&1)<<5))&0xff,((0xf)<<3|0x01)&0xff,0x2e,0xc0|((x&7)<<3)|(y&7)
VUCOMISS x,y             ::  x+y>=0x100;5  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(y)>>3&1)<<5))&0xff,((0xf)<<3|0x00)&0xff,0x2e,0xc0|((x&7)<<3)|(y&7)
!x_vcmpsd("VCMPSD", 0x03, 0xc2, 0x01)
!x_vcmpsd("VCMPSS", 0x02, 0xc2, 0x01)
!x_vcmppd("VCMPPD", 0x01)
!x_vcmppd("VCMPPS", 0x00)

/* AVX シャッフル/レーン */
