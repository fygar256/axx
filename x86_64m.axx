FFREE ST5      ::  ::  0xdd,0xc5
FFREE ST6      ::  ::  0xdd,0xc6
FFREE ST7      ::  ::  0xdd,0xc7

/* ===== FADD / FADDP (加算) ===== */
!x_fadd("FADD", 0x00, 0xc1)
FADDP            ::  ::  0xde,0xc1
FADDP ST0,ST0  ::  ::  0xde,0xc0
FADDP ST1,ST0  ::  ::  0xde,0xc1
FADDP ST2,ST0  ::  ::  0xde,0xc2
FADDP ST3,ST0  ::  ::  0xde,0xc3
