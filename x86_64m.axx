FADDP ST6,ST0  ::  ::  0xde,0xc6
FADDP ST7,ST0  ::  ::  0xde,0xc7
!x_fiadd("FIADD", 0x00)

/* ===== FSUB / FSUBR / FSUBP / FSUBRP (減算) ===== */
