XADD [b+r*2],s              ::  ::0x48|((s&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xc1,(((b&7)==5)?0x40:0)|0x04|((s&7)<<3),(0x40|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
