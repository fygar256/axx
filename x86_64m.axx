/* 64bit immediate */

/* ====================== RBP/R13 ベース: mod=00 は RIP相対になるので mod=01,disp8=0 を使う ====================== */
/* mod=00, rm=101 → disp32(RIP相対)。RBP/R13 間接参照は mod=01, disp8=0x00 が正しい。 */

/* ====================== SIBスケールドアドレッシング [base+index*scale] ====================== */
/* scale=2(01)/4(10)/8(11), SIB = (ss<<6)|((r&7)<<3)|(b&7)
   mod=00: disp なし, mod=01: disp8, mod=10: disp32
   REX: W=1固定, R=d>>3, X=r>>3(index), B=b>>3(base)                  */


/* --- [b+r*1] scale=1, SIB.ss=00 --- */

/* --- ALU store [b+r*scale] (store方向: 64bit) --- */
/* --- MOV 64bit load [b+r*scale] --- */

/* --- MOV 64bit store [b+r*scale] --- */

/* --- LEA SIBスケールド --- */

/* --- ADD/SUB/CMP/AND/OR/XOR SIBスケールド (64bit) --- */

/* --- PUSH/POP/CALL/JMP RSP ベース SIB=0x24 --- */

/* ====================== MOVABS: RAX/EAX/AX/AL ← moffs64 ====================== */
/* 64ビットアドレス空間の絶対アドレスアクセス (moffs形式) */
MOVABS AL,!a            ::  ::  0xa0,@@[8,*(a,%%)]
MOVABS AX,!a            ::  ::  0x66,0xa1,@@[8,*(a,%%)]
MOVABS EAX,!a           ::  ::  0xa1,@@[8,*(a,%%)]
MOVABS RAX,!a           ::  ::  0x48,0xa1,@@[8,*(a,%%)]
MOVABS !a,AL            ::  ::  0xa2,@@[8,*(a,%%)]
MOVABS !a,AX            ::  ::  0x66,0xa3,@@[8,*(a,%%)]
MOVABS !a,EAX           ::  ::  0xa3,@@[8,*(a,%%)]
MOVABS !a,RAX           ::  ::  0x48,0xa3,@@[8,*(a,%%)]

/* ====================== MOV (全アドレッシングモード) ====================== */
/* --- 64bit --- */
/* RIP相対 */
MOV d,[RIP+!a]          ::  ::  0x48|((d&8)>>1),0x8b,((d&7)<<3)|0x05,@@[4,*(a-$.,%%)]
MOV [RIP+!a],s          ::  ::  0x48|((s&8)>>1),0x89,((s&7)<<3)|0x05,@@[4,*(a-$.,%%)]
/* ====================== MOV セグメントレジスタ ↔ 汎用レジスタ ====================== */
/* ★ 順序重要: MOV d,s (汎用 r64←r64) より前に配置 ★
   MOV sreg,r  : 0x8E /r  ModRM = 11 sreg_num reg
   MOV r,sreg  : 0x8C /r  ModRM = 11 sreg_num reg
   d>=8 (R8-R15) の場合は REX.B=1 (0x41) が必要。                   */

/* === A-2 [v10簡約]: MOV sreg↔r64  12→2パターン (.check::g 統合) === */
.check::g::ES,CS,SS,DS,FS,GS
MOV g,d  ::  ::  ;((d&8)?0x41:0),0x8e,0xc0|(g<<3)|(d&7)
MOV d,g  ::  ::  ;((d&8)?0x41:0),0x8c,0xc0|(g<<3)|(d&7)
.clrcheck::g

