/* ====================== CBW / CWDE / CDQE / CWD / CDQ / CQO ====================== */
CBW                     ::  ::  0x66,0x98
CWDE                    ::  ::  0x98
CDQE                    ::  ::  0x48,0x98
CWD                     ::  ::  0x66,0x99
CDQ                     ::  ::  0x99
CQO                     ::  ::  0x48,0x99

