/* ===================================================================
/* AArch64 (A64) instruction set -- pattern file for axx
/*
/* Grown from aarch64_logical_mini.axx, which covered the logical
/* (immediate) group alone. The bitmask-immediate encoder from that
/* file is kept here unchanged in spirit (highbit / find_e / pack_rs),
/* with an added validity test so that an immediate which is not a
/* legal repeating run is rejected instead of silently encoded.
/*
/* Coverage -- the A64 instruction set:
/*   - Data processing (immediate): PC-rel, add/sub, logical, move
/*     wide, bitfield, extract, and their aliases
/*   - Data processing (register): logical/arith shifted and extended
/*     register, add/sub with carry, conditional compare, conditional
/*     select, 1/2/3-source, CRC32, and their aliases
/*   - Branches, exception generation, hints, barriers, system
/*     registers, SYS/SYSL/IC/DC/AT/TLBI
/*   - Loads and stores: literal, register (scaled / unscaled / pre /
/*     post / register offset), pair, exclusive, acquire-release,
/*     LSE atomics, RCpc and RCpc2, PRFM
/*   - Scalar floating point: H/S/D data processing, compare,
/*     conditional select/compare, integer and fixed-point
/*     conversions, FMOV immediate, and FP loads and stores
/*   - Advanced SIMD, vector and scalar: three same (integer, logical
/*     and floating point), two-register miscellaneous, three
/*     different, across lanes, by element, shift by immediate,
/*     widening and narrowing, copy, permute, extract, table lookup,
/*     modified immediate, pairwise, and the LD1-LD4 / ST1-ST4
/*     structure loads and stores in all their addressing forms
/*   - Cryptography: AES, SHA1, SHA2, SHA3, SHA512, SM3, SM4, PMULL
/*   - The GNU-style relocation modifiers an assembler can resolve on
/*     its own: :lo12: on ADD and on every load and store, :pg_hi21:
/*     on ADRP, and :abs_g0: through :abs_g3: and :prel_g0: through
/*     :prel_g3: (with their _nc forms) on MOVZ/MOVK/MOVN
/*   - The scalar extensions: pointer authentication (FEAT_PAuth),
/*     memory tagging (FEAT_MTE), memory copy and set (FEAT_MOPS),
/*     complex arithmetic (FEAT_FCMA), dot product, FP16 multiply-long,
/*     BFloat16, the integer matrix-multiply instructions, LS64,
/*     FJCVTZS, RNDR, and the flag-manipulation instructions
/*
/* Not covered, and said so rather than half-done:
/*   SVE, SVE2 and SME. Those are a separate register file (Z and P
/*   registers), a predication model and an addressing model of their
/*   own, and describing them properly is a second pattern file rather
/*   than an appendix to this one. Everything else in A64 is here.
/*
/*   The named system registers stop at the common set defined below,
/*   but every register, named or not, is still reachable through the
/*   generic S<op0>_<op1>_C<Cn>_C<Cm>_<op2> spelling, which is
/*   complete. The same holds for IC/DC/AT/TLBI, whose named
/*   operations are the common ones and whose general form is SYS.
/*
/* The macro layer (Technical_Manual.md section 7) generates the rows
/* that differ only in an opcode constant, and the mini language
/* (section 3.15) computes the four encodings that no fixed
/* expression can express: the logical bitmask immediate, the MOV
/* immediate alias choice, the scaled/unscaled load-store offset
/* choice, and the 8-bit floating-point immediate.
/*
/* A note on the escape: in the generic system-register spelling
/* S<op0>_<op1>_C<Cn>_C<Cm>_<op2>, each separating underscore is
/* written "\_". A bare "_" placed right after a capture would be
/* read as part of the variable name, because "_" is a variable-name
/* character, and the separator would be lost. The same applies to an
/* expression capture, where "!v_!w" reads "3_5" as the single number
/* 35 -- "!v\_!w" reads it as 3 and 5.
/*
/* A note on names: every register, condition code, shift kind, extend
/* kind, barrier option, prefetch operation, system register and
/* cache/TLB operation below is a pattern-file symbol, and axx does not
/* let an assembly-source label share a name with one. So a label
/* called "pl", "sy" or "x0" is rejected; give labels names that no
/* operand spelling uses.
/*
/* Verified byte-for-byte against llvm-mc -triple=aarch64 over about
/* 15,700 encodings -- among them every valid 32- and 64-bit logical
/* bitmask immediate, every MOV-immediate form, all 256 encodable
/* floating-point immediates, every condition code on every
/* conditional instruction, every addressing mode of every access
/* size, every arrangement of every SIMD operation that has one, all
/* 16 MOPS option suffixes, and the load/store offsets either side of
/* the scaled / unscaled boundary. The relocation-modifier rows are
/* checked the same way for their opcode bits, and their computed
/* slices against independently worked-out values. Paxx and Caxx
/* agree byte for byte on all of it.
/* ===================================================================

/* ===================================================================
/* Registers
/* =================================================================== */
!def gpr(p, n) {
!local i = 0
!while i <= n {
.setsym::!{p}!{i}::!{i}
!set i = i + 1
}
}
!def rset(nm, p, n) {
!local s = p + "0"
!local i = 1
!while i <= n {
!set s = s + "," + p + str(i)
!set i = i + 1
}
.setsym::!{nm}::!{s}
}

!gpr("X", 30)
!gpr("W", 30)
.setsym::XZR::31
.setsym::WZR::31
.setsym::SP::31
.setsym::WSP::31

!gpr("B", 31)
!gpr("H", 31)
!gpr("S", 31)
!gpr("D", 31)
!gpr("Q", 31)

!rset("XR", "X", 30)
!rset("WR", "W", 30)
!rset("BR", "B", 31)
!rset("HR", "H", 31)
!rset("SR", "S", 31)
!rset("DR", "D", 31)
!rset("QR", "Q", 31)

/* Variable roles. Every one is positional (.check, section 3.7) and
/* is set once here, so a nonsensical operand is rejected instead of
/* assembling into wrong bytes.
/*   x* / w*  general registers reading 31 as the zero register
/*   xs / ws  general registers reading 31 as SP / WSP
/*   xb       memory base register, reads 31 as SP
/*   f*       scalar floating-point registers */
