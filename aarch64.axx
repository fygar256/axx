/* ===================================================================
/* Error messages (section 3.14)
/* =================================================================== */
.error::2::"branch target out of range"
.error::3::"immediate value out of range"
.error::5::"register out of range"
.error::7::"immediate is not a valid logical bitmask"
.error::8::"memory offset not encodable"
.error::9::"immediate not representable as an 8-bit floating-point value"
.error::10::"shift or extend amount out of range"
.error::11::"immediate not encodable as a move-wide or bitmask value"
.error::12::"condition AL and NV cannot be used with this alias"
.error::13::"every byte of a 64-bit MOVI immediate must be 0x00 or 0xff"

/* ===================================================================
/* Mini-language encoders (Technical_Manual.md section 3.15)
/*
/* Four things in A64 cannot be written as a fixed binary_list
/* expression. Each is one function here; every pattern line that
/* needs one calls it and emits its returned four bytes.
/* =================================================================== */

/* w4(z): the little-endian bytes of a 32-bit instruction word. Every
/* function below hands its result back through this one. */
.func::w4::z
.return [z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff]
.endfunc

/* highbit(x): position of the highest set bit of x, counted from the
/* right -- the mini language's equivalent of the pattern layer's "@"
/* operator, which the mini language does not itself provide. */
.func::highbit::x
p = 1
.while(x > 1)
x = x >> 1
p = p + 1
.endwhile
.return p
.endfunc

/* isrun(y,e): 1 when the low e bits of y are a single run of set bits,
/* possibly rotated, and are neither all-zero nor all-one -- exactly
/* the condition ARM's DecodeBitMasks can invert. This is the test the
/* original aarch64_logical_mini.axx left out, so that #0x5 is now
/* rejected instead of encoding to something wrong. */
.func::isrun::y,e
m = (1 << e) - 1
y = y & m
.if y == 0 .then
.return 0
.endif
.if y == m .then
.return 0
.endif
i = 0
.while(i < e)
.if (y & 1) == 1 .then
.if ((y >> (e - 1)) & 1) == 0 .then
.if ((y + 1) & y) == 0 .then
.return 1
.endif
.return 0
.endif
.endif
y = ((y >> 1) | ((y & 1) << (e - 1))) & m
i = i + 1
.endwhile
.return 0
.endfunc

/* find_e(v,maxw): the smallest element size e in {2,4,8,...,maxw}
/* such that v is exactly v's low e bits repeated across all of the
/* low maxw bits; falls back to maxw itself (a single non-repeating
/* run spanning the whole register) if no smaller size fits. */
.func::find_e::v,maxw
e = 2
.while(e < maxw)
mask = (1 << e) - 1
low = v & mask
rep = low
cw = e
.while(cw < maxw)
rep = rep | (rep << cw)
cw = cw * 2
.endwhile
.if rep == v .then
.return e
.endif
e = e * 2
.endwhile
.return maxw
.endfunc

/* pack_rs(v,e): given the element size e found by find_e, locates the
/* single run of set bits within one element and returns [r, s] --
/* the rotation (immr) and the combined size-code/run-length byte
/* whose bit 6 (inverted) is the instruction's N bit and whose low 6
/* bits are imms. */
.func::pack_rs::v,e
m = (1 << e) - 1
y = v & m
h = .call highbit(y ^ (y - 1))
t = h - 1
u = y >> t
.if (y ^ m) == 0 .then
w = 1
.else
w = y ^ m
.endif
h2 = .call highbit(w ^ (w - 1))
p = h2 - 1
q = w >> p
.if ((u + 1) & u) == 0 .then
c = 1
.else
c = 0
.endif
hq = .call highbit(q)
.if c == 1 .then
hu = .call highbit(u)
b = hu
r = (e - t) & (e - 1)
.else
b = e - hq
r = (e - (p + hq)) & (e - 1)
.endif
s = ((-2 * e) & 0x7f) | (b - 1)
.return [r, s]
.endfunc

/* logical(v,sf,opc,rn,rd,maxw): the finished logical-immediate word.
/* opc is 0=AND 1=ORR 2=EOR 3=ANDS; maxw is 64 or 32 to match sf. */
.func::logical::v,sf,opc,rn,rd,maxw
m = (1 << maxw) - 1
v = v & m
e = .call find_e(v, maxw)
.if .call isrun(v, e) == 0 .then
.raise 7
.return [0, 0, 0, 0]
.endif
rs = .call pack_rs(v, e)
r = rs[0]
s = rs[1]
nbit = ((s >> 6) & 1) ^ 1
.return .call w4((sf << 31) | (opc << 29) | (0x24 << 23) | (nbit << 22) | (r << 16) | ((s & 0x3f) << 10) | (rn << 5) | rd)
.endfunc

/* movwide(v,sf,rd,maxw): the MOV (immediate) alias. A64 spells one
/* mnemonic over three encodings, and which one applies depends on the
/* value: MOVZ when the value is a 16-bit field shifted into place,
/* MOVN when its inverse is, and ORR with a bitmask immediate
/* otherwise. That decision is a search, so it lives here. */
.func::movwide::v,sf,rd,maxw
m = (1 << maxw) - 1
v = v & m
nh = maxw / 16
i = 0
.while(i < nh)
f = 0xffff << (16 * i)
.if (v & (m ^ f)) == 0 .then
.return .call w4((sf << 31) | (2 << 29) | (0x25 << 23) | (i << 21) | (((v >> (16 * i)) & 0xffff) << 5) | rd)
.endif
i = i + 1
.endwhile
nv = (~v) & m
i = 0
.while(i < nh)
f = 0xffff << (16 * i)
.if (nv & (m ^ f)) == 0 .then
.return .call w4((sf << 31) | (0x25 << 23) | (i << 21) | (((nv >> (16 * i)) & 0xffff) << 5) | rd)
.endif
i = i + 1
.endwhile
e = .call find_e(v, maxw)
.if .call isrun(v, e) == 1 .then
.return .call logical(v, sf, 1, 31, rd, maxw)
.endif
.raise 11
.return [0, 0, 0, 0]
.endfunc

/* lsoff(size,vb,opc,imm,rn,rt,scale): a load or store with an
/* immediate offset. A64 has two encodings for it -- a scaled
/* unsigned offset reaching 4095*size, and an unscaled signed one
/* reaching +-256 -- and the assembler picks whichever fits, so that
/* choice is a function rather than a pattern. */
.func::lsoff::size,vb,opc,imm,rn,rt,scale
sc = 1 << scale
.if imm >= 0 .then
.if (imm % sc) == 0 .then
.if (imm >> scale) <= 4095 .then
.return .call w4((size << 30) | (7 << 27) | (vb << 26) | (1 << 24) | (opc << 22) | ((imm >> scale) << 10) | (rn << 5) | rt)
.endif
.endif
.endif
.if imm >= -256 .then
.if imm <= 255 .then
.return .call w4((size << 30) | (7 << 27) | (vb << 26) | (opc << 22) | ((imm & 0x1ff) << 12) | (rn << 5) | rt)
.endif
.endif
.raise 8
.return [0, 0, 0, 0]
.endfunc

/* fpimm8(v): the 8-bit floating-point immediate field for a binary64
/* bit pattern, or -1 when the value is not one of the 256 that A64
/* can spell. The exponent has to be the 1:b:bbbbbbbb:xx shape that
/* VFPExpandImm produces, and the mantissa has to fit four bits. */
.func::fpimm8::v
sg = (v >> 63) & 1
ex = (v >> 52) & 0x7ff
fr = v & 0xfffffffffffff
.if (fr & 0xffffffffffff) != 0 .then
.return -1
.endif
e2 = ex >> 2
.if e2 == 0x100 .then
b = 0
.elif e2 == 0xff .then
b = 1
.else
.return -1
.endif
.return (sg << 7) | (b << 6) | ((ex & 3) << 4) | (fr >> 48)
.endfunc

.func::fmovi::v,ptype,rd
i8 = .call fpimm8(v)
.if i8 < 0 .then
.raise 9
.return [0, 0, 0, 0]
.endif
.return .call w4((0x1e << 24) | (ptype << 22) | (1 << 21) | (i8 << 13) | (4 << 10) | rd)
.endfunc

/* ===================================================================
/* Data processing -- immediate
/* =================================================================== */

/* PC-relative addressing */
.reloc::t::adr_prel_lo21
ADR xd,!t ::((t-$$)<-1048576)||((t-$$)>1048575);2 :: .call w4((((t-$$)&3)<<29)|(0x10<<24)|((((t-$$)>>2)&0x7ffff)<<5)|xd)
.reloc::t::adr_prel_pg_hi21
ADRP xd,!t :: .call w4((1<<31)|((((t>>12)-($$>>12))&3)<<29)|(0x10<<24)|(((((t>>12)-($$>>12))>>2)&0x7ffff)<<5)|xd)
.clrreloc::t

/* Add/subtract (immediate). sh selects the LSL #12 form. */
!def asi(nm, op, s, rd, rn, sf) {
!{nm} !{rd},!{rn},#!v ::v<0;3,v>0xfff;3 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x11<<24)|(v<<10)|(!{rn}<<5)|!{rd})
!{nm} !{rd},!{rn},#!v,LSL #!h ::v<0;3,v>0xfff;3,(h!=0)&&(h!=12);10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x11<<24)|((h==12?1:0)<<22)|(v<<10)|(!{rn}<<5)|!{rd})
}
!asi("ADD", 0, 0, "xs", "xe", 1)
!asi("ADD", 0, 0, "ws", "we", 0)
!asi("ADDS", 0, 1, "xd", "xe", 1)
!asi("ADDS", 0, 1, "wd", "we", 0)
!asi("SUB", 1, 0, "xs", "xe", 1)
!asi("SUB", 1, 0, "ws", "we", 0)
!asi("SUBS", 1, 1, "xd", "xe", 1)
!asi("SUBS", 1, 1, "wd", "we", 0)

!def cmpi(nm, op, rn, sf) {
!{nm} !{rn},#!v ::v<0;3,v>0xfff;3 :: .call w4((!{sf}<<31)|(!{op}<<30)|(1<<29)|(0x11<<24)|(v<<10)|(!{rn}<<5)|31)
!{nm} !{rn},#!v,LSL #!h ::v<0;3,v>0xfff;3,(h!=0)&&(h!=12);10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(1<<29)|(0x11<<24)|((h==12?1:0)<<22)|(v<<10)|(!{rn}<<5)|31)
}
!cmpi("CMN", 0, "xe", 1)
!cmpi("CMN", 0, "we", 0)
!cmpi("CMP", 1, "xe", 1)
!cmpi("CMP", 1, "we", 0)

/* MOV to or from SP is ADD #0. The shifted-register MOV further down
/* cannot take its place, because its .check lists hold XZR and not SP. */
MOV SP,xe :: .call w4((1<<31)|(0x11<<24)|(xe<<5)|31)
MOV xs,SP :: .call w4((1<<31)|(0x11<<24)|(31<<5)|xs)
MOV WSP,we :: .call w4((0x11<<24)|(we<<5)|31)
MOV ws,WSP :: .call w4((0x11<<24)|(31<<5)|ws)

/* Logical (immediate) */
!def logi(nm, opc, rd, rn, sf, mx) {
!{nm} !{rd},!{rn},#!v :: .call logical(v,!{sf},!{opc},!{rn},!{rd},!{mx})
}
!logi("AND", 0, "xs", "xn", 1, 64)
!logi("AND", 0, "ws", "wn", 0, 32)
!logi("ORR", 1, "xs", "xn", 1, 64)
!logi("ORR", 1, "ws", "wn", 0, 32)
!logi("EOR", 2, "xs", "xn", 1, 64)
!logi("EOR", 2, "ws", "wn", 0, 32)
!logi("ANDS", 3, "xd", "xn", 1, 64)
!logi("ANDS", 3, "wd", "wn", 0, 32)
TST xn,#!v :: .call logical(v,1,3,xn,31,64)
TST wn,#!v :: .call logical(v,0,3,wn,31,32)

/* Move wide (immediate) */
!def movw(nm, opc, rd, sf, mx) {
!{nm} !{rd},#!v[[,LSL #!h]] ::v<0;3,v>0xffff;3,(h&15)!=0;10,h>!{mx};10 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|((h>>4)<<21)|(v<<5)|!{rd})
}
!movw("MOVZ", 2, "xd", 1, 48)
!movw("MOVZ", 2, "wd", 0, 16)
!movw("MOVN", 0, "xd", 1, 48)
!movw("MOVN", 0, "wd", 0, 16)
!movw("MOVK", 3, "xd", 1, 48)
!movw("MOVK", 3, "wd", 0, 16)

/* MOV (immediate): MOVZ, MOVN or ORR, decided by the value. */
MOV xd,#!v :: .call movwide(v,1,xd,64)
MOV wd,#!v ::v<-2147483648;3,v>0xffffffff;3 :: .call movwide(v,0,wd,32)

/* Bitfield move and its aliases */
!def bfmraw(nm, opc, rd, rn, sf, mx) {
!{nm} !{rd},!{rn},#!r,#!s ::r<0;3,r>!{mx};3,s<0;3,s>!{mx};3 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x26<<23)|(!{sf}<<22)|(r<<16)|(s<<10)|(!{rn}<<5)|!{rd})
}
!bfmraw("SBFM", 0, "xd", "xn", 1, 63)
!bfmraw("SBFM", 0, "wd", "wn", 0, 31)
!bfmraw("BFM", 1, "xd", "xn", 1, 63)
!bfmraw("BFM", 1, "wd", "wn", 0, 31)
!bfmraw("UBFM", 2, "xd", "xn", 1, 63)
!bfmraw("UBFM", 2, "wd", "wn", 0, 31)

/* Insert form: immr = -lsb mod regsize, imms = width-1 */
!def bfiz(nm, opc, rd, rn, sf, mx) {
!{nm} !{rd},!{rn},#!l,#!c ::l<0;3,l>!{mx};3,c<1;3,(l+c)>!{mx+1};3 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x26<<23)|(!{sf}<<22)|(((-l)&!{mx})<<16)|((c-1)<<10)|(!{rn}<<5)|!{rd})
}
!bfiz("SBFIZ", 0, "xd", "xn", 1, 63)
!bfiz("SBFIZ", 0, "wd", "wn", 0, 31)
!bfiz("BFI", 1, "xd", "xn", 1, 63)
!bfiz("BFI", 1, "wd", "wn", 0, 31)
!bfiz("UBFIZ", 2, "xd", "xn", 1, 63)
!bfiz("UBFIZ", 2, "wd", "wn", 0, 31)

/* Extract form: immr = lsb, imms = lsb+width-1 */
!def bfx(nm, opc, rd, rn, sf, mx) {
!{nm} !{rd},!{rn},#!l,#!c ::l<0;3,l>!{mx};3,c<1;3,(l+c)>!{mx+1};3 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x26<<23)|(!{sf}<<22)|(l<<16)|((l+c-1)<<10)|(!{rn}<<5)|!{rd})
}
!bfx("SBFX", 0, "xd", "xn", 1, 63)
!bfx("SBFX", 0, "wd", "wn", 0, 31)
!bfx("BFXIL", 1, "xd", "xn", 1, 63)
!bfx("BFXIL", 1, "wd", "wn", 0, 31)
!bfx("UBFX", 2, "xd", "xn", 1, 63)
!bfx("UBFX", 2, "wd", "wn", 0, 31)

/* BFC is BFI with the zero register as the source */
BFC xd,#!l,#!c ::l<0;3,l>63;3,c<1;3,(l+c)>64;3 :: .call w4((1<<31)|(1<<29)|(0x26<<23)|(1<<22)|(((-l)&63)<<16)|((c-1)<<10)|(31<<5)|xd)
BFC wd,#!l,#!c ::l<0;3,l>31;3,c<1;3,(l+c)>32;3 :: .call w4((1<<29)|(0x26<<23)|(((-l)&31)<<16)|((c-1)<<10)|(31<<5)|wd)

/* Shift by a constant: aliases of SBFM and UBFM */
ASR xd,xn,#!s ::s<0;3,s>63;3 :: .call w4((1<<31)|(0x26<<23)|(1<<22)|(s<<16)|(63<<10)|(xn<<5)|xd)
ASR wd,wn,#!s ::s<0;3,s>31;3 :: .call w4((0x26<<23)|(s<<16)|(31<<10)|(wn<<5)|wd)
LSR xd,xn,#!s ::s<0;3,s>63;3 :: .call w4((1<<31)|(2<<29)|(0x26<<23)|(1<<22)|(s<<16)|(63<<10)|(xn<<5)|xd)
LSR wd,wn,#!s ::s<0;3,s>31;3 :: .call w4((2<<29)|(0x26<<23)|(s<<16)|(31<<10)|(wn<<5)|wd)
LSL xd,xn,#!s ::s<0;3,s>63;3 :: .call w4((1<<31)|(2<<29)|(0x26<<23)|(1<<22)|(((-s)&63)<<16)|((63-s)<<10)|(xn<<5)|xd)
LSL wd,wn,#!s ::s<0;3,s>31;3 :: .call w4((2<<29)|(0x26<<23)|(((-s)&31)<<16)|((31-s)<<10)|(wn<<5)|wd)

/* Sign and zero extension: aliases of SBFM and UBFM */
SXTB xd,wn :: .call w4((1<<31)|(0x26<<23)|(1<<22)|(7<<10)|(wn<<5)|xd)
SXTB wd,wn :: .call w4((0x26<<23)|(7<<10)|(wn<<5)|wd)
SXTH xd,wn :: .call w4((1<<31)|(0x26<<23)|(1<<22)|(15<<10)|(wn<<5)|xd)
SXTH wd,wn :: .call w4((0x26<<23)|(15<<10)|(wn<<5)|wd)
SXTW xd,wn :: .call w4((1<<31)|(0x26<<23)|(1<<22)|(31<<10)|(wn<<5)|xd)
UXTB wd,wn :: .call w4((2<<29)|(0x26<<23)|(7<<10)|(wn<<5)|wd)
UXTH wd,wn :: .call w4((2<<29)|(0x26<<23)|(15<<10)|(wn<<5)|wd)

/* Extract register, and the ROR alias that reads one register twice */
EXTR xd,xn,xm,#!s ::s<0;3,s>63;3 :: .call w4((1<<31)|(0x27<<23)|(1<<22)|(xm<<16)|(s<<10)|(xn<<5)|xd)
EXTR wd,wn,wm,#!s ::s<0;3,s>31;3 :: .call w4((0x27<<23)|(wm<<16)|(s<<10)|(wn<<5)|wd)
ROR xd,xn,#!s ::s<0;3,s>63;3 :: .call w4((1<<31)|(0x27<<23)|(1<<22)|(xn<<16)|(s<<10)|(xn<<5)|xd)
ROR wd,wn,#!s ::s<0;3,s>31;3 :: .call w4((0x27<<23)|(wn<<16)|(s<<10)|(wn<<5)|wd)

/* ===================================================================
/* Data processing -- register
/* =================================================================== */

/* Logical (shifted register). The optional part carries both the
/* shift kind and its amount, so one row covers "AND x0,x1,x2" and
/* "AND x0,x1,x2,LSR #7" alike -- an absent optional operand reads 0,
/* which is LSL #0. */
!def logr(nm, opc, n, rd, rn, rm, sf, mx) {
!{nm} !{rd},!{rn},!{rm}[[,sht #!a]] ::a<0;10,a>!{mx};10 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x0a<<24)|(sht<<22)|(!{n}<<21)|(!{rm}<<16)|(a<<10)|(!{rn}<<5)|!{rd})
}
!logr("AND", 0, 0, "xd", "xn", "xm", 1, 63)
!logr("AND", 0, 0, "wd", "wn", "wm", 0, 31)
!logr("BIC", 0, 1, "xd", "xn", "xm", 1, 63)
!logr("BIC", 0, 1, "wd", "wn", "wm", 0, 31)
!logr("ORR", 1, 0, "xd", "xn", "xm", 1, 63)
!logr("ORR", 1, 0, "wd", "wn", "wm", 0, 31)
!logr("ORN", 1, 1, "xd", "xn", "xm", 1, 63)
!logr("ORN", 1, 1, "wd", "wn", "wm", 0, 31)
!logr("EOR", 2, 0, "xd", "xn", "xm", 1, 63)
!logr("EOR", 2, 0, "wd", "wn", "wm", 0, 31)
!logr("EON", 2, 1, "xd", "xn", "xm", 1, 63)
!logr("EON", 2, 1, "wd", "wn", "wm", 0, 31)
!logr("ANDS", 3, 0, "xd", "xn", "xm", 1, 63)
!logr("ANDS", 3, 0, "wd", "wn", "wm", 0, 31)
!logr("BICS", 3, 1, "xd", "xn", "xm", 1, 63)
!logr("BICS", 3, 1, "wd", "wn", "wm", 0, 31)

/* Aliases that fix one operand to the zero register */
!def logr2(nm, opc, n, rd, rm, sf, mx) {
!{nm} !{rd},!{rm}[[,sht #!a]] ::a<0;10,a>!{mx};10 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x0a<<24)|(sht<<22)|(!{n}<<21)|(!{rm}<<16)|(a<<10)|(31<<5)|!{rd})
}
!logr2("MOV", 1, 0, "xd", "xm", 1, 63)
!logr2("MOV", 1, 0, "wd", "wm", 0, 31)
!logr2("MVN", 1, 1, "xd", "xm", 1, 63)
!logr2("MVN", 1, 1, "wd", "wm", 0, 31)
TST xn,xm[[,sht #!a]] ::a<0;10,a>63;10 :: .call w4((1<<31)|(3<<29)|(0x0a<<24)|(sht<<22)|(xm<<16)|(a<<10)|(xn<<5)|31)
TST wn,wm[[,sht #!a]] ::a<0;10,a>31;10 :: .call w4((3<<29)|(0x0a<<24)|(sht<<22)|(wm<<16)|(a<<10)|(wn<<5)|31)

/* Add/subtract (shifted register). Only LSL, LSR and ASR are legal
/* here, which is what the .check list on "sha" enforces. */
!def asr3(nm, op, s, rd, rn, rm, sf, mx) {
!{nm} !{rd},!{rn},!{rm}[[,sha #!a]] ::a<0;10,a>!{mx};10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(sha<<22)|(!{rm}<<16)|(a<<10)|(!{rn}<<5)|!{rd})
}
!asr3("ADD", 0, 0, "xd", "xn", "xm", 1, 63)
!asr3("ADD", 0, 0, "wd", "wn", "wm", 0, 31)
!asr3("ADDS", 0, 1, "xd", "xn", "xm", 1, 63)
!asr3("ADDS", 0, 1, "wd", "wn", "wm", 0, 31)
!asr3("SUB", 1, 0, "xd", "xn", "xm", 1, 63)
!asr3("SUB", 1, 0, "wd", "wn", "wm", 0, 31)
!asr3("SUBS", 1, 1, "xd", "xn", "xm", 1, 63)
!asr3("SUBS", 1, 1, "wd", "wn", "wm", 0, 31)

!def asr2(nm, op, s, rd, rm, sf, mx) {
!{nm} !{rd},!{rm}[[,sha #!a]] ::a<0;10,a>!{mx};10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(sha<<22)|(!{rm}<<16)|(a<<10)|(31<<5)|!{rd})
}
!asr2("NEG", 1, 0, "xd", "xm", 1, 63)
!asr2("NEG", 1, 0, "wd", "wm", 0, 31)
!asr2("NEGS", 1, 1, "xd", "xm", 1, 63)
!asr2("NEGS", 1, 1, "wd", "wm", 0, 31)
CMN xn,xm[[,sha #!a]] ::a<0;10,a>63;10 :: .call w4((1<<31)|(1<<29)|(0x0b<<24)|(sha<<22)|(xm<<16)|(a<<10)|(xn<<5)|31)
CMN wn,wm[[,sha #!a]] ::a<0;10,a>31;10 :: .call w4((1<<29)|(0x0b<<24)|(sha<<22)|(wm<<16)|(a<<10)|(wn<<5)|31)
CMP xn,xm[[,sha #!a]] ::a<0;10,a>63;10 :: .call w4((1<<31)|(1<<30)|(1<<29)|(0x0b<<24)|(sha<<22)|(xm<<16)|(a<<10)|(xn<<5)|31)
CMP wn,wm[[,sha #!a]] ::a<0;10,a>31;10 :: .call w4((1<<30)|(1<<29)|(0x0b<<24)|(sha<<22)|(wm<<16)|(a<<10)|(wn<<5)|31)

/* Add/subtract (extended register). Written with the extend keyword
/* it is unambiguous; written without one it only arises where SP is
/* an operand, so those rows name SP literally and never collide with
/* the shifted-register rows above, whose .check lists hold XZR. */
!def aer(nm, op, s, rd, rn, sf) {
!{nm} !{rd},!{rn},wm,exw[[ #!a]] ::a<0;10,a>4;10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(exw<<13)|(a<<10)|(!{rn}<<5)|!{rd})
!{nm} !{rd},!{rn},xm,UXTX[[ #!a]] ::a<0;10,a>4;10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(1<<21)|(xm<<16)|(3<<13)|(a<<10)|(!{rn}<<5)|!{rd})
!{nm} !{rd},!{rn},xm,SXTX[[ #!a]] ::a<0;10,a>4;10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(1<<21)|(xm<<16)|(7<<13)|(a<<10)|(!{rn}<<5)|!{rd})
}
!aer("ADD", 0, 0, "xs", "xe", 1)
!aer("ADDS", 0, 1, "xd", "xe", 1)
!aer("SUB", 1, 0, "xs", "xe", 1)
!aer("SUBS", 1, 1, "xd", "xe", 1)
CMN xe,wm,exw[[ #!a]] ::a<0;10,a>4;10 :: .call w4((1<<31)|(1<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(exw<<13)|(a<<10)|(xe<<5)|31)
CMP xe,wm,exw[[ #!a]] ::a<0;10,a>4;10 :: .call w4((1<<31)|(1<<30)|(1<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(exw<<13)|(a<<10)|(xe<<5)|31)
CMN xe,xm,UXTX[[ #!a]] ::a<0;10,a>4;10 :: .call w4((1<<31)|(1<<29)|(0x0b<<24)|(1<<21)|(xm<<16)|(3<<13)|(a<<10)|(xe<<5)|31)
CMP xe,xm,UXTX[[ #!a]] ::a<0;10,a>4;10 :: .call w4((1<<31)|(1<<30)|(1<<29)|(0x0b<<24)|(1<<21)|(xm<<16)|(3<<13)|(a<<10)|(xe<<5)|31)

!def aerw(nm, op, s, rd, rn) {
!{nm} !{rd},!{rn},wm,exw[[ #!a]] ::a<0;10,a>4;10 :: .call w4((!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(exw<<13)|(a<<10)|(!{rn}<<5)|!{rd})
}
!aerw("ADD", 0, 0, "ws", "we")
!aerw("ADDS", 0, 1, "wd", "we")
!aerw("SUB", 1, 0, "ws", "we")
!aerw("SUBS", 1, 1, "wd", "we")
CMN we,wm,exw[[ #!a]] ::a<0;10,a>4;10 :: .call w4((1<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(exw<<13)|(a<<10)|(we<<5)|31)
CMP we,wm,exw[[ #!a]] ::a<0;10,a>4;10 :: .call w4((1<<30)|(1<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(exw<<13)|(a<<10)|(we<<5)|31)

/* The SP forms written without an extend keyword. Each row is given
/* the pattern text and the encoded number for Rd and Rn separately,
/* because "SP" written in a binary_list expression would be read as a
/* label rather than as register 31. */
!def aesp(nm, op, s, pd, ed, pn, en, sf, wl) {
!{nm} !{pd},!{pn},!{wl}m[[,LSL #!a]] ::a<0;10,a>4;10 :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0x0b<<24)|(1<<21)|(!{wl}m<<16)|(!{sf==1?3:2}<<13)|(a<<10)|(!{en}<<5)|!{ed})
}
!aesp("ADD", 0, 0, "xs", "xs", "SP", "31", 1, "x")
!aesp("ADD", 0, 0, "SP", "31", "xe", "xe", 1, "x")
!aesp("ADDS", 0, 1, "xd", "xd", "SP", "31", 1, "x")
!aesp("SUB", 1, 0, "xs", "xs", "SP", "31", 1, "x")
!aesp("SUB", 1, 0, "SP", "31", "xe", "xe", 1, "x")
!aesp("SUBS", 1, 1, "xd", "xd", "SP", "31", 1, "x")
!aesp("ADD", 0, 0, "ws", "ws", "WSP", "31", 0, "w")
!aesp("ADD", 0, 0, "WSP", "31", "we", "we", 0, "w")
!aesp("ADDS", 0, 1, "wd", "wd", "WSP", "31", 0, "w")
!aesp("SUB", 1, 0, "ws", "ws", "WSP", "31", 0, "w")
!aesp("SUB", 1, 0, "WSP", "31", "we", "we", 0, "w")
!aesp("SUBS", 1, 1, "wd", "wd", "WSP", "31", 0, "w")
CMN SP,xm[[,LSL #!a]] ::a<0;10,a>4;10 :: .call w4((1<<31)|(1<<29)|(0x0b<<24)|(1<<21)|(xm<<16)|(3<<13)|(a<<10)|(31<<5)|31)
CMP SP,xm[[,LSL #!a]] ::a<0;10,a>4;10 :: .call w4((1<<31)|(1<<30)|(1<<29)|(0x0b<<24)|(1<<21)|(xm<<16)|(3<<13)|(a<<10)|(31<<5)|31)
CMN WSP,wm[[,LSL #!a]] ::a<0;10,a>4;10 :: .call w4((1<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(2<<13)|(a<<10)|(31<<5)|31)
CMP WSP,wm[[,LSL #!a]] ::a<0;10,a>4;10 :: .call w4((1<<30)|(1<<29)|(0x0b<<24)|(1<<21)|(wm<<16)|(2<<13)|(a<<10)|(31<<5)|31)

/* Add/subtract with carry */
!def adc(nm, op, s, rd, rn, rm, sf) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((!{sf}<<31)|(!{op}<<30)|(!{s}<<29)|(0xd0<<21)|(!{rm}<<16)|(!{rn}<<5)|!{rd})
}
!adc("ADC", 0, 0, "xd", "xn", "xm", 1)
!adc("ADC", 0, 0, "wd", "wn", "wm", 0)
!adc("ADCS", 0, 1, "xd", "xn", "xm", 1)
!adc("ADCS", 0, 1, "wd", "wn", "wm", 0)
!adc("SBC", 1, 0, "xd", "xn", "xm", 1)
!adc("SBC", 1, 0, "wd", "wn", "wm", 0)
!adc("SBCS", 1, 1, "xd", "xn", "xm", 1)
!adc("SBCS", 1, 1, "wd", "wn", "wm", 0)
!def ngc(nm, s, rd, rm, sf) {
!{nm} !{rd},!{rm} :: .call w4((!{sf}<<31)|(1<<30)|(!{s}<<29)|(0xd0<<21)|(!{rm}<<16)|(31<<5)|!{rd})
}
!ngc("NGC", 0, "xd", "xm", 1)
!ngc("NGC", 0, "wd", "wm", 0)
!ngc("NGCS", 1, "xd", "xm", 1)
!ngc("NGCS", 1, "wd", "wm", 0)

/* Conditional compare */
!def ccmp(nm, op, rn, rm, sf) {
!{nm} !{rn},!{rm},#!f,cnd ::f<0;3,f>15;3 :: .call w4((!{sf}<<31)|(!{op}<<30)|(1<<29)|(0xd2<<21)|(!{rm}<<16)|(cnd<<12)|(!{rn}<<5)|f)
!{nm} !{rn},#!i,#!f,cnd ::i<0;3,i>31;3,f<0;3,f>15;3 :: .call w4((!{sf}<<31)|(!{op}<<30)|(1<<29)|(0xd2<<21)|(i<<16)|(cnd<<12)|(1<<11)|(!{rn}<<5)|f)
}
!ccmp("CCMN", 0, "xn", "xm", 1)
!ccmp("CCMN", 0, "wn", "wm", 0)
!ccmp("CCMP", 1, "xn", "xm", 1)
!ccmp("CCMP", 1, "wn", "wm", 0)

/* Conditional select, and the aliases that invert the condition */
!def csel(nm, op, o2, rd, rn, rm, sf) {
!{nm} !{rd},!{rn},!{rm},cnd :: .call w4((!{sf}<<31)|(!{op}<<30)|(0xd4<<21)|(!{rm}<<16)|(cnd<<12)|(!{o2}<<10)|(!{rn}<<5)|!{rd})
}
!csel("CSEL", 0, 0, "xd", "xn", "xm", 1)
!csel("CSEL", 0, 0, "wd", "wn", "wm", 0)
!csel("CSINC", 0, 1, "xd", "xn", "xm", 1)
!csel("CSINC", 0, 1, "wd", "wn", "wm", 0)
!csel("CSINV", 1, 0, "xd", "xn", "xm", 1)
!csel("CSINV", 1, 0, "wd", "wn", "wm", 0)
!csel("CSNEG", 1, 1, "xd", "xn", "xm", 1)
!csel("CSNEG", 1, 1, "wd", "wn", "wm", 0)

/* CINC, CINV, CNEG, CSET and CSETM encode the inverted condition, so
/* AL and NV are not available to them: the inverse would be NV or AL,
/* which those encodings do not allow. */
!def cinc(nm, op, o2, rd, rn, sf) {
!{nm} !{rd},!{rn},cnd ::(cnd==14)||(cnd==15);12 :: .call w4((!{sf}<<31)|(!{op}<<30)|(0xd4<<21)|(!{rn}<<16)|((cnd^1)<<12)|(!{o2}<<10)|(!{rn}<<5)|!{rd})
}
!cinc("CINC", 0, 1, "xd", "xn", 1)
!cinc("CINC", 0, 1, "wd", "wn", 0)
!cinc("CINV", 1, 0, "xd", "xn", 1)
!cinc("CINV", 1, 0, "wd", "wn", 0)
!cinc("CNEG", 1, 1, "xd", "xn", 1)
!cinc("CNEG", 1, 1, "wd", "wn", 0)

!def cset(nm, op, o2, rd, sf) {
!{nm} !{rd},cnd ::(cnd==14)||(cnd==15);12 :: .call w4((!{sf}<<31)|(!{op}<<30)|(0xd4<<21)|(31<<16)|((cnd^1)<<12)|(!{o2}<<10)|(31<<5)|!{rd})
}
!cset("CSET", 0, 1, "xd", 1)
!cset("CSET", 0, 1, "wd", 0)
!cset("CSETM", 1, 0, "xd", 1)
!cset("CSETM", 1, 0, "wd", 0)

/* Data processing (3 source) */
!def dp3(nm, o31, o0, rd, rn, rm, ra, sf) {
!{nm} !{rd},!{rn},!{rm},!{ra} :: .call w4((!{sf}<<31)|(0x1b<<24)|(!{o31}<<21)|(!{rm}<<16)|(!{o0}<<15)|(!{ra}<<10)|(!{rn}<<5)|!{rd})
}
!dp3("MADD", 0, 0, "xd", "xn", "xm", "xa", 1)
!dp3("MADD", 0, 0, "wd", "wn", "wm", "wa", 0)
!dp3("MSUB", 0, 1, "xd", "xn", "xm", "xa", 1)
!dp3("MSUB", 0, 1, "wd", "wn", "wm", "wa", 0)
!dp3("SMADDL", 1, 0, "xd", "wn", "wm", "xa", 1)
!dp3("SMSUBL", 1, 1, "xd", "wn", "wm", "xa", 1)
!dp3("UMADDL", 5, 0, "xd", "wn", "wm", "xa", 1)
!dp3("UMSUBL", 5, 1, "xd", "wn", "wm", "xa", 1)

!def dp3z(nm, o31, o0, rd, rn, rm, sf) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((!{sf}<<31)|(0x1b<<24)|(!{o31}<<21)|(!{rm}<<16)|(!{o0}<<15)|(31<<10)|(!{rn}<<5)|!{rd})
}
!dp3z("MUL", 0, 0, "xd", "xn", "xm", 1)
!dp3z("MUL", 0, 0, "wd", "wn", "wm", 0)
!dp3z("MNEG", 0, 1, "xd", "xn", "xm", 1)
!dp3z("MNEG", 0, 1, "wd", "wn", "wm", 0)
!dp3z("SMULL", 1, 0, "xd", "wn", "wm", 1)
!dp3z("SMNEGL", 1, 1, "xd", "wn", "wm", 1)
!dp3z("UMULL", 5, 0, "xd", "wn", "wm", 1)
!dp3z("UMNEGL", 5, 1, "xd", "wn", "wm", 1)
!dp3z("SMULH", 2, 0, "xd", "xn", "xm", 1)
!dp3z("UMULH", 6, 0, "xd", "xn", "xm", 1)

/* Data processing (2 source) */
!def dp2(nm, opc, rd, rn, rm, sf) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((!{sf}<<31)|(0xd6<<21)|(!{rm}<<16)|(!{opc}<<10)|(!{rn}<<5)|!{rd})
}
!dp2("UDIV", 2, "xd", "xn", "xm", 1)
!dp2("UDIV", 2, "wd", "wn", "wm", 0)
!dp2("SDIV", 3, "xd", "xn", "xm", 1)
!dp2("SDIV", 3, "wd", "wn", "wm", 0)
!dp2("LSLV", 8, "xd", "xn", "xm", 1)
!dp2("LSLV", 8, "wd", "wn", "wm", 0)
!dp2("LSRV", 9, "xd", "xn", "xm", 1)
!dp2("LSRV", 9, "wd", "wn", "wm", 0)
!dp2("ASRV", 10, "xd", "xn", "xm", 1)
!dp2("ASRV", 10, "wd", "wn", "wm", 0)
!dp2("RORV", 11, "xd", "xn", "xm", 1)
!dp2("RORV", 11, "wd", "wn", "wm", 0)
!dp2("LSL", 8, "xd", "xn", "xm", 1)
!dp2("LSL", 8, "wd", "wn", "wm", 0)
!dp2("LSR", 9, "xd", "xn", "xm", 1)
!dp2("LSR", 9, "wd", "wn", "wm", 0)
!dp2("ASR", 10, "xd", "xn", "xm", 1)
!dp2("ASR", 10, "wd", "wn", "wm", 0)
!dp2("ROR", 11, "xd", "xn", "xm", 1)
!dp2("ROR", 11, "wd", "wn", "wm", 0)
!dp2("CRC32B", 0x10, "wd", "wn", "wm", 0)
!dp2("CRC32H", 0x11, "wd", "wn", "wm", 0)
!dp2("CRC32W", 0x12, "wd", "wn", "wm", 0)
!dp2("CRC32X", 0x13, "wd", "wn", "xm", 1)
!dp2("CRC32CB", 0x14, "wd", "wn", "wm", 0)
!dp2("CRC32CH", 0x15, "wd", "wn", "wm", 0)
!dp2("CRC32CW", 0x16, "wd", "wn", "wm", 0)
!dp2("CRC32CX", 0x17, "wd", "wn", "xm", 1)

/* Data processing (1 source) */
!def dp1(nm, opc, rd, rn, sf) {
!{nm} !{rd},!{rn} :: .call w4((!{sf}<<31)|(1<<30)|(0xd6<<21)|(!{opc}<<10)|(!{rn}<<5)|!{rd})
}
!dp1("RBIT", 0, "xd", "xn", 1)
!dp1("RBIT", 0, "wd", "wn", 0)
!dp1("REV16", 1, "xd", "xn", 1)
!dp1("REV16", 1, "wd", "wn", 0)
!dp1("REV32", 2, "xd", "xn", 1)
!dp1("REV", 3, "xd", "xn", 1)
!dp1("REV", 2, "wd", "wn", 0)
!dp1("CLZ", 4, "xd", "xn", 1)
!dp1("CLZ", 4, "wd", "wn", 0)
!dp1("CLS", 5, "xd", "xn", 1)
!dp1("CLS", 5, "wd", "wn", 0)

/* ===================================================================
/* Branches, exception generation, hints, barriers and system
/* =================================================================== */

/* Unconditional branch (immediate) */
.reloc::t::jump26
B !t ::((t-$$)<-134217728)||((t-$$)>134217724);2 :: .call w4(0x14000000|(((t-$$)>>2)&0x3ffffff))
.reloc::t::call26
BL !t ::((t-$$)<-134217728)||((t-$$)>134217724);2 :: .call w4(0x94000000|(((t-$$)>>2)&0x3ffffff))
.clrreloc::t

/* Conditional branch */
.reloc::t::condbr19
B.cnd !t ::((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4(0x54000000|((((t-$$)>>2)&0x7ffff)<<5)|cnd)
.clrreloc::t

/* Compare and branch */
!def cb(nm, op, rt, sf) {
.reloc::t::condbr19
!{nm} !{rt},!t ::((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4((!{sf}<<31)|(0x1a<<25)|(!{op}<<24)|((((t-$$)>>2)&0x7ffff)<<5)|!{rt})
.clrreloc::t
}
!cb("CBZ", 0, "xt", 1)
!cb("CBZ", 0, "wt", 0)
!cb("CBNZ", 1, "xt", 1)
!cb("CBNZ", 1, "wt", 0)

/* Test bit and branch */
!def tb(nm, op, rt, mx) {
.reloc::t::tstbr14
!{nm} !{rt},#!b,!t ::b<0;3,b>!{mx};3,((t-$$)<-32768)||((t-$$)>32764);2 :: .call w4(((b>>5)<<31)|(0x1b<<25)|(!{op}<<24)|((b&31)<<19)|((((t-$$)>>2)&0x3fff)<<5)|!{rt})
.clrreloc::t
}
!tb("TBZ", 0, "xt", 63)
!tb("TBZ", 0, "wt", 31)
!tb("TBNZ", 1, "xt", 63)
!tb("TBNZ", 1, "wt", 31)

/* Unconditional branch (register) */
BR xn :: .call w4(0xd61f0000|(xn<<5))
BLR xn :: .call w4(0xd63f0000|(xn<<5))
RET :: .call w4(0xd65f0000|(30<<5))
RET xn :: .call w4(0xd65f0000|(xn<<5))
ERET :: .call w4(0xd69f03e0)
DRPS :: .call w4(0xd6bf03e0)

/* Exception generation */
!def exc(nm, opc, ll) {
!{nm} #!v ::v<0;3,v>0xffff;3 :: .call w4(0xd4000000|(!{opc}<<21)|(v<<5)|!{ll})
}
!exc("SVC", 0, 1)
!exc("HVC", 0, 2)
!exc("SMC", 0, 3)
!exc("BRK", 1, 0)
!exc("HLT", 2, 0)
/* The DCPS immediate is optional and defaults to 0 */
!def dcps(nm, ll) {
!{nm}[[ #!v]] ::v<0;3,v>0xffff;3 :: .call w4(0xd4000000|(5<<21)|(v<<5)|!{ll})
}
!dcps("DCPS1", 1)
!dcps("DCPS2", 2)
!dcps("DCPS3", 3)

/* Hints. All of them are one encoding with CRm and op2 varying. */
!def hint(nm, crm, op2) {
!{nm} :: .call w4(0xd503201f|(!{crm}<<8)|(!{op2}<<5))
}
!hint("NOP", 0, 0)
!hint("YIELD", 0, 1)
!hint("WFE", 0, 2)
!hint("WFI", 0, 3)
!hint("SEV", 0, 4)
!hint("SEVL", 0, 5)
!hint("DGH", 0, 6)
!hint("XPACLRI", 0, 7)
!hint("PACIA1716", 1, 0)
!hint("PACIB1716", 1, 2)
!hint("AUTIA1716", 1, 4)
!hint("AUTIB1716", 1, 6)
!hint("ESB", 2, 0)
!hint("PSB CSYNC", 2, 1)
!hint("TSB CSYNC", 2, 2)
!hint("CSDB", 2, 4)
!hint("PACIAZ", 3, 0)
!hint("PACIASP", 3, 1)
!hint("PACIBZ", 3, 2)
!hint("PACIBSP", 3, 3)
!hint("AUTIAZ", 3, 4)
!hint("AUTIASP", 3, 5)
!hint("AUTIBZ", 3, 6)
!hint("AUTIBSP", 3, 7)
!hint("BTI", 4, 0)
!hint("BTI C", 4, 2)
!hint("BTI J", 4, 4)
!hint("BTI JC", 4, 6)
HINT #!v ::v<0;3,v>127;3 :: .call w4(0xd503201f|((v>>3)<<8)|((v&7)<<5))

/* Barriers */
CLREX :: .call w4(0xd503305f|(15<<8))
CLREX #!v ::v<0;3,v>15;3 :: .call w4(0xd503305f|(v<<8))
DSB bar :: .call w4(0xd503309f|(bar<<8))
DSB #!v ::v<0;3,v>15;3 :: .call w4(0xd503309f|(v<<8))
DMB bar :: .call w4(0xd50330bf|(bar<<8))
DMB #!v ::v<0;3,v>15;3 :: .call w4(0xd50330bf|(v<<8))
ISB :: .call w4(0xd50330df|(15<<8))
ISB bar :: .call w4(0xd50330df|(bar<<8))
ISB #!v ::v<0;3,v>15;3 :: .call w4(0xd50330df|(v<<8))
SB :: .call w4(0xd50330ff)

/* PSTATE (MSR immediate) */
!def pstate(nm, op1, op2) {
MSR !{nm},#!v ::v<0;3,v>15;3 :: .call w4(0xd500401f|(!{op1}<<16)|(v<<8)|(!{op2}<<5))
}
!pstate("SPSEL", 0, 5)
!pstate("DAIFSET", 3, 6)
!pstate("DAIFCLR", 3, 7)
!pstate("UAO", 0, 3)
!pstate("PAN", 0, 4)
!pstate("DIT", 3, 2)
!pstate("SSBS", 3, 1)
!pstate("TCO", 3, 4)
CFINV :: .call w4(0xd500401f)

/* System register access. The named registers below are the common
/* ones; every other register, named or not, is reachable through the
/* generic S<op0>_<op1>_C<Cn>_C<Cm>_<op2> form underneath, whose digits
/* are matched by the small .sub tables at the end of this section. */
/* rw: 0 read-only, 1 write-only, 2 read/write. MRS and MSR get their
/* own .check lists from it, so writing to a read-only register is
/* rejected rather than quietly encoded. */
!set SRR = ""
!set SRW = ""
!def sr(nm, o0, op1, crn, crm, op2, rw) {
.setsym::!{nm}::!{((o0 - 2) << 14) | (op1 << 11) | (crn << 7) | (crm << 3) | op2}
!if rw != 1 !then {
!if SRR == "" !then {
!set SRR = nm
} !else {
!set SRR = SRR + "," + nm
}
}
!if rw != 0 !then {
!if SRW == "" !then {
!set SRW = nm
} !else {
!set SRW = SRW + "," + nm
}
}
}
!sr("NZCV", 3, 3, 4, 2, 0, 2)
!sr("DAIF", 3, 3, 4, 2, 1, 2)
!sr("FPCR", 3, 3, 4, 4, 0, 2)
!sr("FPSR", 3, 3, 4, 4, 1, 2)
!sr("SPSEL", 3, 0, 4, 2, 0, 2)
!sr("CURRENTEL", 3, 0, 4, 2, 2, 0)
