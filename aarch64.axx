/* Replicate: one element broadcast to every lane */
!def lsr1(nm, r, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar}},[xb] :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<22)|(!{r}<<21)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar}},[xb],#!o ::o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar}},[xb],xm :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
}
!def lsr2(nm, r, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar},va.!{ar}},[xb] ::va!=((vn+1)&31);5 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<22)|(!{r}<<21)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar}},[xb],#!o ::va!=((vn+1)&31);5,o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar}},[xb],xm ::va!=((vn+1)&31);5 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
}
!def lsr3(nm, r, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar},va.!{ar},vb.!{ar}},[xb] ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<22)|(!{r}<<21)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar}},[xb],#!o ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar}},[xb],xm ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
}
!def lsr4(nm, r, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar},va.!{ar},vb.!{ar},vc.!{ar}},[xb] ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<22)|(!{r}<<21)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar},vc.!{ar}},[xb],#!o ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5,o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar},vc.!{ar}},[xb],xm ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4((!{q}<<30)|(0x0d<<24)|(1<<23)|(1<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|(!{sz}<<10)|(xb<<5)|vn)
}
