!sv2w("UABALB", 0x32)
!sv2w("UABALT", 0x33)
/* The 128-bit polynomial multiply has no size field */
PMULLB zd.Q,zn.D,zm.D :: .call w4(0x45006800|(zm<<16)|(zn<<5)|zd)
PMULLT zd.Q,zn.D,zm.D :: .call w4(0x45006c00|(zm<<16)|(zn<<5)|zd)
/* Wide forms take one operand already widened */
!def sv2ww1(nm, opc, el, sel, sz) {
!{nm} zd.!{el},zn.!{el},zm.!{sel} :: .call w4(0x45000000|(!{sz}<<22)|(zm<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
