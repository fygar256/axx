!sr("ELR_EL1", 3, 0, 4, 0, 1, 2)
!sr("SP_EL0", 3, 0, 4, 1, 0, 2)
!sr("SP_EL1", 3, 4, 4, 1, 0, 2)
!sr("ESR_EL1", 3, 0, 5, 2, 0, 2)
!sr("FAR_EL1", 3, 0, 6, 0, 0, 2)
!sr("PAR_EL1", 3, 0, 7, 4, 0, 2)
!sr("MAIR_EL1", 3, 0, 10, 2, 0, 2)
!sr("AMAIR_EL1", 3, 0, 10, 3, 0, 2)
!sr("VBAR_EL1", 3, 0, 12, 0, 0, 2)
!sr("CONTEXTIDR_EL1", 3, 0, 13, 0, 1, 2)
!sr("TPIDR_EL1", 3, 0, 13, 0, 4, 2)
!sr("TPIDR_EL0", 3, 3, 13, 0, 2, 2)
!sr("TPIDRRO_EL0", 3, 3, 13, 0, 3, 2)
!sr("CNTFRQ_EL0", 3, 3, 14, 0, 0, 2)
!sr("CNTPCT_EL0", 3, 3, 14, 0, 1, 0)
!sr("CNTVCT_EL0", 3, 3, 14, 0, 2, 0)
!sr("CNTKCTL_EL1", 3, 0, 14, 1, 0, 2)
!sr("CNTP_TVAL_EL0", 3, 3, 14, 2, 0, 2)
!sr("CNTP_CTL_EL0", 3, 3, 14, 2, 1, 2)
!sr("CNTP_CVAL_EL0", 3, 3, 14, 2, 2, 2)
!sr("CNTV_TVAL_EL0", 3, 3, 14, 3, 0, 2)
!sr("CNTV_CTL_EL0", 3, 3, 14, 3, 1, 2)
!sr("CNTV_CVAL_EL0", 3, 3, 14, 3, 2, 2)
!sr("HCR_EL2", 3, 4, 1, 1, 0, 2)
!sr("SCTLR_EL2", 3, 4, 1, 0, 0, 2)
!sr("TTBR0_EL2", 3, 4, 2, 0, 0, 2)
!sr("TCR_EL2", 3, 4, 2, 0, 2, 2)
!sr("VTTBR_EL2", 3, 4, 2, 1, 0, 2)
!sr("SPSR_EL2", 3, 4, 4, 0, 0, 2)
!sr("ELR_EL2", 3, 4, 4, 0, 1, 2)
!sr("ESR_EL2", 3, 4, 5, 2, 0, 2)
!sr("FAR_EL2", 3, 4, 6, 0, 0, 2)
!sr("MAIR_EL2", 3, 4, 10, 2, 0, 2)
!sr("VBAR_EL2", 3, 4, 12, 0, 0, 2)
!sr("SCTLR_EL3", 3, 6, 1, 0, 0, 2)
!sr("SCR_EL3", 3, 6, 1, 1, 0, 2)
!sr("SPSR_EL3", 3, 6, 4, 0, 0, 2)
!sr("ELR_EL3", 3, 6, 4, 0, 1, 2)
!sr("VBAR_EL3", 3, 6, 12, 0, 0, 2)
