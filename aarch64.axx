/* ===================================================================
/* Remaining scalar extensions
/* =================================================================== */
FJCVTZS wd,fdn :: .call w4(0x1e7e0000|(fdn<<5)|wd)
LD64B xt,[xb] :: .call w4(0xf83fd000|(xb<<5)|xt)
ST64B xt,[xb] :: .call w4(0xf83f9000|(xb<<5)|xt)
ST64BV xd,xt,[xb] :: .call w4(0xf820b000|(xd<<16)|(xb<<5)|xt)
ST64BV0 xd,xt,[xb] :: .call w4(0xf820a000|(xd<<16)|(xb<<5)|xt)
CHKFEAT X16 :: .call w4(0xd503251f)
RMIF xn,#!s,#!m ::s<0;3,s>63;3,m<0;3,m>15;3 :: .call w4(0xba000400|(s<<15)|(xn<<5)|m)
SETF8 wn :: .call w4(0x3a00080d|(wn<<5))
SETF16 wn :: .call w4(0x3a00480d|(wn<<5))
AXFLAG :: .call w4(0xd500405f)
XAFLAG :: .call w4(0xd500403f)
CFP RCTX,xt :: .call w4(0xd50b7380|xt)
DVP RCTX,xt :: .call w4(0xd50b73a0|xt)
CPP RCTX,xt :: .call w4(0xd50b73e0|xt)

/* ===================================================================
/* Relocation modifiers
/*
/* GNU-style AArch64 source writes a symbol through a modifier that
/* says which slice of it the instruction field holds:
/*
/*     adrp    x0, msg
/*     add     x0, x0, :lo12:msg
/*     ldr     x1, [x0, :lo12:msg]
/*     movz    x2, #:abs_g0_nc:msg
/*
/* The modifier is literal text in the pattern -- ":" is an ordinary
/* character there, and only "::" separates the three fields -- so
/* each one is a row that computes its own slice.
/*
/* What axx does with it differs from a linker-targeted assembler.
/* GNU as and llvm-mc leave the field zero and emit a relocation;
/* axx resolves the symbol itself and fills the field in, which is
/* the same thing it already does for "B label" and every other
/* symbol reference in this file. So the output is finished code,
/* correct whenever the symbol's address is known at assembly time --
/* which is the case for "-b", and for "-o" when the symbol is
/* defined in the same source. For a symbol the linker has to place,
/* axx cannot express these relocations: its relocation tracking
/* follows label references through binary_list words, and the words
/* here come out of a mini-language .call, which it does not follow.
/* The modifiers below are therefore about accepting and computing
/* the syntax, not about deferring it to a linker.
/*
/* :got: and :got_lo12: need a word of their own. To a linker they
/* name the GOT entry it builds for the symbol, and axx builds no
/* GOT. What axx does instead is take the symbol you name as being
/* the GOT slot itself -- which is what you write anyway when there
/* is no linker and the table is yours:
/*
/*     adrp    x0, :got:printf_slot
/*     ldr     x0, [x0, :got_lo12:printf_slot]
/*     ...
/*     printf_slot:
/*         .zero 8              /* filled in at run time */
/*
/* So :got: is the ADRP page of that slot and :got_lo12: is its low
/* 12 bits scaled by 8, which is exactly the arithmetic the two
/* relocations stand for once the slot has an address. Point them at
/* the symbol itself, the way linker-targeted source does, and the
/* result is the address of the symbol rather than of a slot holding
/* it -- that indirection is the linker's, and axx cannot supply it.
/*
/* :tlsdesc:, :gottprel: and the TLS :tprel_* / :dtprel_* family are
/* still left out: those name offsets a linker and a thread-local
/* storage layout decide together, and no reading of the symbol makes
/* them computable here.
/*
/* The "#" before the modifier is optional wherever an assembler
/* accepts it, so each form is written both ways.
/* =================================================================== */

/* ADD (immediate). Only ADD takes :lo12:, because the relocation it
/* stands for (ADD_ABS_LO12_NC) is defined for ADD alone. */
!def addlo12(rd, rn, sf) {
ADD !{rd},!{rn},:LO12:!t :: .call w4((!{sf}<<31)|(0x11<<24)|((t&0xfff)<<10)|(!{rn}<<5)|!{rd})
ADD !{rd},!{rn},#:LO12:!t :: .call w4((!{sf}<<31)|(0x11<<24)|((t&0xfff)<<10)|(!{rn}<<5)|!{rd})
}
!addlo12("xs", "xe", 1)
!addlo12("ws", "we", 0)

/* Loads and stores. The low 12 bits are scaled by the access size,
/* which is also what makes the alignment check below meaningful. */
!def lslo12(mn, rt, size, v, opc, scale) {
!{mn} !{rt},[xb,:LO12:!t] ::(t&!{(1<<scale)-1})!=0;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(1<<24)|(!{opc}<<22)|(((t&0xfff)>>!{scale})<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,#:LO12:!t] ::(t&!{(1<<scale)-1})!=0;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(1<<24)|(!{opc}<<22)|(((t&0xfff)>>!{scale})<<10)|(xb<<5)|!{rt})
}
!lslo12("STRB", "wt", 0, 0, 0, 0)
!lslo12("LDRB", "wt", 0, 0, 1, 0)
!lslo12("LDRSB", "xt", 0, 0, 2, 0)
!lslo12("LDRSB", "wt", 0, 0, 3, 0)
!lslo12("STRH", "wt", 1, 0, 0, 1)
!lslo12("LDRH", "wt", 1, 0, 1, 1)
!lslo12("LDRSH", "xt", 1, 0, 2, 1)
!lslo12("LDRSH", "wt", 1, 0, 3, 1)
!lslo12("STR", "wt", 2, 0, 0, 2)
!lslo12("LDR", "wt", 2, 0, 1, 2)
!lslo12("LDRSW", "xt", 2, 0, 2, 2)
!lslo12("STR", "xt", 3, 0, 0, 3)
!lslo12("LDR", "xt", 3, 0, 1, 3)
!lslo12("PRFM", "prf", 3, 0, 2, 3)
!lslo12("STR", "fb", 0, 1, 0, 0)
!lslo12("LDR", "fb", 0, 1, 1, 0)
!lslo12("STR", "fq", 0, 1, 2, 4)
!lslo12("LDR", "fq", 0, 1, 3, 4)
!lslo12("STR", "fh", 1, 1, 0, 1)
!lslo12("LDR", "fh", 1, 1, 1, 1)
!lslo12("STR", "fs", 2, 1, 0, 2)
!lslo12("LDR", "fs", 2, 1, 1, 2)
!lslo12("STR", "ff", 3, 1, 0, 3)
!lslo12("LDR", "ff", 3, 1, 1, 3)
PRFM #!p,[xb,:LO12:!t] ::p<0;3,p>31;3,(t&7)!=0;8 :: .call w4((3<<30)|(7<<27)|(1<<24)|(2<<22)|(((t&0xfff)>>3)<<10)|(xb<<5)|p)
PRFM #!p,[xb,#:LO12:!t] ::p<0;3,p>31;3,(t&7)!=0;8 :: .call w4((3<<30)|(7<<27)|(1<<24)|(2<<22)|(((t&0xfff)>>3)<<10)|(xb<<5)|p)

/* ADRP. :pg_hi21: is the explicit spelling of what a bare symbol
/* already means there, so it encodes identically to the plain row
/* further up. GNU as takes this spelling; llvm-mc does not. */
ADRP xd,:PG_HI21:!t :: .call w4((1<<31)|((((t>>12)-($$>>12))&3)<<29)|(0x10<<24)|(((((t>>12)-($$>>12))>>2)&0x7ffff)<<5)|xd)

/* The GOT pair. :got: is the page of the slot, :got_lo12: its low
/* 12 bits scaled by 8 -- the slot holds a 64-bit address, so it is
/* the LDR (64-bit) form that takes it, and the slot has to be
/* 8-aligned for the offset to be representable. */
ADRP xd,:GOT:!t :: .call w4((1<<31)|((((t>>12)-($$>>12))&3)<<29)|(0x10<<24)|(((((t>>12)-($$>>12))>>2)&0x7ffff)<<5)|xd)
ADRP xd,#:GOT:!t :: .call w4((1<<31)|((((t>>12)-($$>>12))&3)<<29)|(0x10<<24)|(((((t>>12)-($$>>12))>>2)&0x7ffff)<<5)|xd)
LDR xt,[xb,:GOT_LO12:!t] ::(t&7)!=0;8 :: .call w4((3<<30)|(7<<27)|(1<<24)|(1<<22)|(((t&0xfff)>>3)<<10)|(xb<<5)|xt)
LDR xt,[xb,#:GOT_LO12:!t] ::(t&7)!=0;8 :: .call w4((3<<30)|(7<<27)|(1<<24)|(1<<22)|(((t&0xfff)>>3)<<10)|(xb<<5)|xt)

/* Move wide. The modifier names which 16-bit slice of the symbol the
/* field holds, and that also fixes hw. The checked forms report an
/* error when the symbol does not fit below the slice they name; the
/* _nc forms are the same encoding without that check. */
!def movwabs(nm, opc, rd, sf, g, nc, mx) {
!if nc !then {
!{nm} !{rd},#:ABS_G!{g}_NC:!t :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|(((t>>!{g * 16})&0xffff)<<5)|!{rd})
!{nm} !{rd},:ABS_G!{g}_NC:!t :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|(((t>>!{g * 16})&0xffff)<<5)|!{rd})
} !else {
!{nm} !{rd},#:ABS_G!{g}:!t ::(t>>!{(g + 1) * 16})!=0;3 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|(((t>>!{g * 16})&0xffff)<<5)|!{rd})
!{nm} !{rd},:ABS_G!{g}:!t ::(t>>!{(g + 1) * 16})!=0;3 :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|(((t>>!{g * 16})&0xffff)<<5)|!{rd})
}
}
!def movwabsall(nm, opc) {
!movwabs(nm, opc, "xd", 1, 0, 0, 0)
!movwabs(nm, opc, "xd", 1, 0, 1, 0)
!movwabs(nm, opc, "xd", 1, 1, 0, 0)
!movwabs(nm, opc, "xd", 1, 1, 1, 0)
!movwabs(nm, opc, "xd", 1, 2, 0, 0)
!movwabs(nm, opc, "xd", 1, 2, 1, 0)
!movwabs(nm, opc, "xd", 1, 3, 0, 0)
!movwabs(nm, opc, "wd", 0, 0, 0, 0)
!movwabs(nm, opc, "wd", 0, 0, 1, 0)
!movwabs(nm, opc, "wd", 0, 1, 0, 0)
!movwabs(nm, opc, "wd", 0, 1, 1, 0)
}
!movwabsall("MOVZ", 2)
!movwabsall("MOVK", 3)
!movwabsall("MOVN", 0)

/* The PC-relative slices, which the assembler can also work out */
!def movwprel(nm, opc, rd, sf, g, nc) {
!if nc !then {
!{nm} !{rd},#:PREL_G!{g}_NC:!t :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|((((t-$$)>>!{g * 16})&0xffff)<<5)|!{rd})
!{nm} !{rd},:PREL_G!{g}_NC:!t :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|((((t-$$)>>!{g * 16})&0xffff)<<5)|!{rd})
} !else {
!{nm} !{rd},#:PREL_G!{g}:!t :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|((((t-$$)>>!{g * 16})&0xffff)<<5)|!{rd})
!{nm} !{rd},:PREL_G!{g}:!t :: .call w4((!{sf}<<31)|(!{opc}<<29)|(0x25<<23)|(!{g}<<21)|((((t-$$)>>!{g * 16})&0xffff)<<5)|!{rd})
}
}
!def movwprelall(nm, opc) {
!movwprel(nm, opc, "xd", 1, 0, 0)
!movwprel(nm, opc, "xd", 1, 0, 1)
!movwprel(nm, opc, "xd", 1, 1, 0)
!movwprel(nm, opc, "xd", 1, 1, 1)
!movwprel(nm, opc, "xd", 1, 2, 0)
!movwprel(nm, opc, "xd", 1, 2, 1)
!movwprel(nm, opc, "xd", 1, 3, 0)
!movwprel(nm, opc, "wd", 0, 0, 0)
!movwprel(nm, opc, "wd", 0, 0, 1)
!movwprel(nm, opc, "wd", 0, 1, 0)
!movwprel(nm, opc, "wd", 0, 1, 1)
}
!movwprelall("MOVZ", 2)
!movwprelall("MOVK", 3)
!movwprelall("MOVN", 0)

/* ===================================================================
/* SVE and SVE2
/*
/* A second register file: Z0-Z31 vectors of unknown length, P0-P15
/* predicates. The element size is written after the register, the
/* same way an Advanced SIMD arrangement is, so the matcher stops at
/* the "." on its own and one row per element size is all it takes.
/* A governing predicate is "Pg/M" or "Pg/Z", and "/" is an ordinary
/* character in an instruction field, so that needs nothing special
/* either.
/*
/* Element size codes are 0=B 1=H 2=S 3=D throughout.
/* =================================================================== */
!gpr("Z", 31)
!gpr("P", 15)
!rset("ZR", "Z", 31)
!rset("PR", "P", 15)
.setsym::PLO::P0,P1,P2,P3,P4,P5,P6,P7
.check::zd::ZR
.check::zn::ZR
.check::zm::ZR
.check::zk::ZR
.check::zi::ZR
.check::zj::ZR
.check::zl::ZR
/* pg is the three-bit governing predicate, so P0-P7 only; pv is the
/* four-bit one, and pd/pn/pm are ordinary predicate operands. */
.check::pg::PLO
.check::pv::PR
.check::pd::PR
.check::pn::PR
.check::pm::PR

/* Integer binary, unpredicated.
/*   00000100 size 1 Zm 000 opc Zn Zd */
!def sv3u1(nm, opc, el, sz) {
!{nm} zd.!{el},zn.!{el},zm.!{el} :: .call w4(0x04200000|(!{sz}<<22)|(zm<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!def sv3u(nm, opc) {
!sv3u1(nm, opc, "B", 0)
!sv3u1(nm, opc, "H", 1)
!sv3u1(nm, opc, "S", 2)
!sv3u1(nm, opc, "D", 3)
}
!sv3u("ADD", 0)
!sv3u("SUB", 1)
!sv3u("SQADD", 4)
!sv3u("UQADD", 5)
!sv3u("SQSUB", 6)
!sv3u("UQSUB", 7)

/* Integer binary, predicated. The destination is also the first
/* source, which is why these are written Zdn twice.
/*   00000100 size 0 opc 000 Pg Zm Zdn */
!def sv3p1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.!{el} :: .call w4(0x04000000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
}
!def sv3p(nm, opc, lo) {
!if lo == 0 !then {
!sv3p1(nm, opc, "B", 0)
!sv3p1(nm, opc, "H", 1)
}
!sv3p1(nm, opc, "S", 2)
!sv3p1(nm, opc, "D", 3)
}
!sv3p("ADD", 0x00, 0)
!sv3p("SUB", 0x01, 0)
!sv3p("SUBR", 0x03, 0)
!sv3p("SMAX", 0x08, 0)
!sv3p("UMAX", 0x09, 0)
!sv3p("SMIN", 0x0a, 0)
!sv3p("UMIN", 0x0b, 0)
!sv3p("SABD", 0x0c, 0)
!sv3p("UABD", 0x0d, 0)
!sv3p("MUL", 0x10, 0)
!sv3p("SMULH", 0x12, 0)
!sv3p("UMULH", 0x13, 0)
!sv3p("AND", 0x1a, 0)
!sv3p("ORR", 0x18, 0)
!sv3p("EOR", 0x19, 0)
!sv3p("BIC", 0x1b, 0)
/* Divide is defined for the 32- and 64-bit element sizes only */
!sv3p("SDIV", 0x14, 1)
!sv3p("UDIV", 0x15, 1)
!sv3p("SDIVR", 0x16, 1)
!sv3p("UDIVR", 0x17, 1)

/* Bitwise logical, unpredicated. These have no element size of their
/* own; the operands are written .D by convention.
/*   00000100 opc 1 Zm 001100 Zn Zd */
!def svlu(nm, opc) {
!{nm} zd.D,zn.D,zm.D :: .call w4(0x04203000|(!{opc}<<22)|(zm<<16)|(zn<<5)|zd)
}
!svlu("AND", 0)
!svlu("ORR", 1)
!svlu("EOR", 2)
!svlu("BIC", 3)

/* Unary predicated.
/*   00000100 size 010 opc 101 Pg Zn Zd */
!def sv2p1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el} :: .call w4(0x0400a000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|zd)
}
!def sv2p(nm, opc, lo) {
!if lo <= 0 !then {
!sv2p1(nm, opc, "B", 0)
}
!if lo <= 1 !then {
!sv2p1(nm, opc, "H", 1)
}
!if lo <= 2 !then {
!sv2p1(nm, opc, "S", 2)
}
!sv2p1(nm, opc, "D", 3)
}
!sv2p("SXTB", 0x10, 1)
!sv2p("UXTB", 0x11, 1)
!sv2p("SXTH", 0x12, 2)
!sv2p("UXTH", 0x13, 2)
!sv2p("SXTW", 0x14, 3)
!sv2p("UXTW", 0x15, 3)
!sv2p("ABS", 0x16, 0)
!sv2p("NEG", 0x17, 0)
!sv2p("CLS", 0x18, 0)
!sv2p("CLZ", 0x19, 0)
!sv2p("CNT", 0x1a, 0)
!sv2p("CNOT", 0x1b, 0)
!sv2p("FABS", 0x1c, 1)
!sv2p("FNEG", 0x1d, 1)
!sv2p("NOT", 0x1e, 0)

/* Reverse bits and bytes sit in their own block.
/*   00000101 size 1001 opc 100 Pg Zn Zd */
!def svrev1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el} :: .call w4(0x05248000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|zd)
}
!def svrevp(nm, opc, lo) {
!if lo <= 0 !then {
!svrev1(nm, opc, "B", 0)
}
!if lo <= 1 !then {
!svrev1(nm, opc, "H", 1)
}
!if lo <= 2 !then {
!svrev1(nm, opc, "S", 2)
}
!svrev1(nm, opc, "D", 3)
}
!svrevp("REVB", 0, 1)
!svrevp("REVH", 1, 2)
!svrevp("REVW", 2, 3)
!svrevp("RBIT", 3, 0)

/* Shift by immediate, predicated. tszh:tszl:imm3 is one field split
/* across bits 23:22 and 9:5, holding 2*esize-amount for a right
/* shift and esize+amount for a left one -- the same convention
/* Advanced SIMD uses. */
!def svshpr(nm, opc, el, sz, es) {
!{nm} zd.!{el},pg/M,zd.!{el},#!s ::s<1;3,s>!{es};3 :: .call w4(0x04008000|(!{opc}<<16)|(((((!{es}*2)-s)>>5)&3)<<22)|(pg<<10)|((((!{es}*2)-s)&0x1f)<<5)|zd)
}
!def svshpl(nm, opc, el, sz, es) {
!{nm} zd.!{el},pg/M,zd.!{el},#!s ::s<0;3,s>!{es-1};3 :: .call w4(0x04008000|(!{opc}<<16)|((((!{es}+s)>>5)&3)<<22)|(pg<<10)|(((!{es}+s)&0x1f)<<5)|zd)
}
!def svshp(nm, opc, right) {
!if right !then {
!svshpr(nm, opc, "B", 0, 8)
!svshpr(nm, opc, "H", 1, 16)
!svshpr(nm, opc, "S", 2, 32)
!svshpr(nm, opc, "D", 3, 64)
} !else {
!svshpl(nm, opc, "B", 0, 8)
!svshpl(nm, opc, "H", 1, 16)
!svshpl(nm, opc, "S", 2, 32)
!svshpl(nm, opc, "D", 3, 64)
}
}
!svshp("ASR", 0, 1)
!svshp("LSR", 1, 1)
!svshp("LSL", 3, 0)
!svshp("ASRD", 4, 1)

/* Shift by immediate, unpredicated.
/*   00000100 tszh 1 tszl imm3 100 opc Zn Zd */
!def svshur(nm, opc, el, sz, es) {
!{nm} zd.!{el},zn.!{el},#!s ::s<1;3,s>!{es};3 :: .call w4(0x04209000|(((((!{es}*2)-s)>>5)&3)<<22)|((((!{es}*2)-s)&0x1f)<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!def svshul(nm, opc, el, sz, es) {
!{nm} zd.!{el},zn.!{el},#!s ::s<0;3,s>!{es-1};3 :: .call w4(0x04209000|((((!{es}+s)>>5)&3)<<22)|(((!{es}+s)&0x1f)<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!def svshu(nm, opc, right) {
!if right !then {
!svshur(nm, opc, "B", 0, 8)
!svshur(nm, opc, "H", 1, 16)
!svshur(nm, opc, "S", 2, 32)
!svshur(nm, opc, "D", 3, 64)
} !else {
!svshul(nm, opc, "B", 0, 8)
!svshul(nm, opc, "H", 1, 16)
!svshul(nm, opc, "S", 2, 32)
!svshul(nm, opc, "D", 3, 64)
}
}
!svshu("ASR", 0, 1)
!svshu("LSR", 1, 1)
!svshu("LSL", 3, 0)

/* Shift by vector, predicated, and the wide forms whose shift amount
/* is always a .D vector. */
!def svshr1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.!{el} :: .call w4(0x04008000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
}
!def svshr(nm, opc) {
!svshr1(nm, opc, "B", 0)
!svshr1(nm, opc, "H", 1)
!svshr1(nm, opc, "S", 2)
!svshr1(nm, opc, "D", 3)
}
!svshr("ASR", 0x10)
!svshr("LSR", 0x11)
!svshr("LSL", 0x13)
!svshr("ASRR", 0x14)
!svshr("LSRR", 0x15)
!svshr("LSLR", 0x17)
!def svshw1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.D :: .call w4(0x04008000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
!{nm} zd.!{el},zn.!{el},zm.D :: .call w4(0x04208000|(!{sz}<<22)|(zm<<16)|(!{opc-0x18}<<10)|(zn<<5)|zd)
}
!def svshw(nm, opc) {
!svshw1(nm, opc, "B", 0)
!svshw1(nm, opc, "H", 1)
!svshw1(nm, opc, "S", 2)
}
!svshw("ASR", 0x18)
!svshw("LSR", 0x19)
!svshw("LSL", 0x1b)

/* Integer binary with an immediate.
/*   00100101 size opc 11 sh imm8 Zdn
/* The shifted form multiplies the byte by 256; only the wrapping
/* arithmetic operations have it. */
!def svimm1(nm, opc, el, sz, sg, sh8) {
!{nm} zd.!{el},zd.!{el},#!v :: .call svai(0x2500c000|(!{sz}<<22)|(!{opc}<<16),v,!{sg},255,!{sh8},zd)
!if sh8 !then {
!{nm} zd.!{el},zd.!{el},#!v,LSL #!h ::v<!{sg};3,v>255;3,h!=8;10 :: .call w4(0x2500e000|(!{sz}<<22)|(!{opc}<<16)|((v&0xff)<<5)|zd)
}
}
/* The shifted form has no byte version: a byte element has nowhere
/* to put the top half. */
!def svimm(nm, opc, sg, sh8) {
!svimm1(nm, opc, "B", 0, sg, 0)
!svimm1(nm, opc, "H", 1, sg, sh8)
!svimm1(nm, opc, "S", 2, sg, sh8)
!svimm1(nm, opc, "D", 3, sg, sh8)
}
!svimm("ADD", 0x20, 0, 1)
!svimm("SUB", 0x21, 0, 1)
!svimm("SUBR", 0x23, 0, 1)
!svimm("SQADD", 0x24, 0, 1)
!svimm("UQADD", 0x25, 0, 1)
!svimm("SQSUB", 0x26, 0, 1)
!svimm("UQSUB", 0x27, 0, 1)
!svimm("SMAX", 0x28, -128, 0)
!svimm("SMIN", 0x2a, -128, 0)
!svimm("UMAX", 0x29, 0, 0)
!svimm("UMIN", 0x2b, 0, 0)
!svimm("MUL", 0x30, -128, 0)
/* DUP with an immediate, and its MOV spelling */
!def svdupi(nm, el, sz, sh8, bm) {
!if bm !then {
!{nm} zd.!{el},#!v :: .call svaim(0x2538c000|(!{sz}<<22),v,-128,255,!{sh8},!{bm},zd)
} !else {
!{nm} zd.!{el},#!v :: .call svai(0x2538c000|(!{sz}<<22),v,-128,255,!{sh8},zd)
}
!if sh8 !then {
!{nm} zd.!{el},#!v,LSL #!h ::v<-128;3,v>255;3,h!=8;10 :: .call w4(0x2538e000|(!{sz}<<22)|((v&0xff)<<5)|zd)
}
}
!svdupi("DUP", "B", 0, 0, 0)
!svdupi("DUP", "H", 1, 1, 0)
!svdupi("DUP", "S", 2, 1, 0)
!svdupi("DUP", "D", 3, 1, 0)
!svdupi("MOV", "B", 0, 0, 8)
!svdupi("MOV", "H", 1, 1, 16)
!svdupi("MOV", "S", 2, 1, 32)
!svdupi("MOV", "D", 3, 1, 64)

/* Multiply-accumulate. MLA and MLS accumulate into Zda; MAD and MSB
/* accumulate into the destination, so their operands read the other
/* way round. */
!def svmla1(nm, base, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el},zm.!{el} :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(pg<<10)|(zn<<5)|zd)
}
!def svmad1(nm, base, el, sz) {
!{nm} zd.!{el},pg/M,zm.!{el},zk.!{el} :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(pg<<10)|(zk<<5)|zd)
}
!def svmla(nm, base) {
!svmla1(nm, base, "B", 0)
!svmla1(nm, base, "H", 1)
!svmla1(nm, base, "S", 2)
!svmla1(nm, base, "D", 3)
}
!def svmad(nm, base) {
!svmad1(nm, base, "B", 0)
!svmad1(nm, base, "H", 1)
!svmad1(nm, base, "S", 2)
!svmad1(nm, base, "D", 3)
}
!svmla("MLA", 0x04004000)
!svmla("MLS", 0x04006000)
!svmad("MAD", 0x0400c000)
!svmad("MSB", 0x0400e000)

/* Integer compare, vector. The result is a predicate, so the
/* destination carries the element size and the sources give the
/* operands. CMPLT/CMPLE/CMPLO/CMPLS are CMPGT/CMPGE/CMPHI/CMPHS with
/* the two vectors exchanged, which is how an assembler spells them.
/*   00100100 size 0 Zm op Pg Zn ne Pd */
!def svcmp1(nm, op, ne, el, sz, swap) {
!if swap !then {
!{nm} pd.!{el},pg/Z,zn.!{el},zm.!{el} :: .call w4(0x24000000|(!{sz}<<22)|(zn<<16)|(!{op}<<13)|(pg<<10)|(zm<<5)|(!{ne}<<4)|pd)
} !else {
!{nm} pd.!{el},pg/Z,zn.!{el},zm.!{el} :: .call w4(0x24000000|(!{sz}<<22)|(zm<<16)|(!{op}<<13)|(pg<<10)|(zn<<5)|(!{ne}<<4)|pd)
}
}
!def svcmp(nm, op, ne, swap) {
!svcmp1(nm, op, ne, "B", 0, swap)
!svcmp1(nm, op, ne, "H", 1, swap)
!svcmp1(nm, op, ne, "S", 2, swap)
!svcmp1(nm, op, ne, "D", 3, swap)
}
!svcmp("CMPEQ", 5, 0, 0)
!svcmp("CMPNE", 5, 1, 0)
!svcmp("CMPGE", 4, 0, 0)
!svcmp("CMPGT", 4, 1, 0)
!svcmp("CMPLE", 4, 0, 1)
!svcmp("CMPLT", 4, 1, 1)
!svcmp("CMPHS", 0, 0, 0)
!svcmp("CMPHI", 0, 1, 0)
!svcmp("CMPLS", 0, 0, 1)
!svcmp("CMPLO", 0, 1, 1)

/* Integer compare against a .D vector of wide elements */
!def svcmpw1(nm, op, ne, el, sz) {
!{nm} pd.!{el},pg/Z,zn.!{el},zm.D :: .call w4(0x24000000|(!{sz}<<22)|(zm<<16)|(!{op}<<13)|(pg<<10)|(zn<<5)|(!{ne}<<4)|pd)
}
!def svcmpw(nm, op, ne) {
!svcmpw1(nm, op, ne, "B", 0)
!svcmpw1(nm, op, ne, "H", 1)
!svcmpw1(nm, op, ne, "S", 2)
}
!svcmpw("CMPEQ", 1, 0)
!svcmpw("CMPNE", 1, 1)
!svcmpw("CMPGE", 2, 0)
!svcmpw("CMPGT", 2, 1)
!svcmpw("CMPLT", 3, 0)
!svcmpw("CMPLE", 3, 1)
!svcmpw("CMPHS", 6, 0)
!svcmpw("CMPHI", 6, 1)
!svcmpw("CMPLO", 7, 0)
!svcmpw("CMPLS", 7, 1)

/* Integer compare against an immediate: signed operations take a
/* five-bit signed value, unsigned ones a seven-bit unsigned value,
/* and they sit in different blocks. */
!def svcmpi1(nm, op, ne, el, sz) {
!{nm} pd.!{el},pg/Z,zn.!{el},#!v ::v<-16;3,v>15;3 :: .call w4(0x25000000|(!{sz}<<22)|((v&0x1f)<<16)|(!{op}<<13)|(pg<<10)|(zn<<5)|(!{ne}<<4)|pd)
}
!def svcmpu1(nm, op, ne, el, sz) {
!{nm} pd.!{el},pg/Z,zn.!{el},#!v ::v<0;3,v>127;3 :: .call w4(0x24200000|(!{sz}<<22)|((v&0x7f)<<14)|(!{op}<<13)|(pg<<10)|(zn<<5)|(!{ne}<<4)|pd)
}
!def svcmpi(nm, op, ne) {
!svcmpi1(nm, op, ne, "B", 0)
!svcmpi1(nm, op, ne, "H", 1)
!svcmpi1(nm, op, ne, "S", 2)
!svcmpi1(nm, op, ne, "D", 3)
}
!def svcmpu(nm, op, ne) {
!svcmpu1(nm, op, ne, "B", 0)
!svcmpu1(nm, op, ne, "H", 1)
!svcmpu1(nm, op, ne, "S", 2)
!svcmpu1(nm, op, ne, "D", 3)
}
!svcmpi("CMPEQ", 4, 0)
!svcmpi("CMPNE", 4, 1)
!svcmpi("CMPGE", 0, 0)
!svcmpi("CMPGT", 0, 1)
!svcmpi("CMPLT", 1, 0)
!svcmpi("CMPLE", 1, 1)
!svcmpu("CMPHS", 0, 0)
!svcmpu("CMPHI", 0, 1)
!svcmpu("CMPLO", 1, 0)
!svcmpu("CMPLS", 1, 1)

/* Predicate logical.
/*   00100101 op S 00 Pm 01 Pg b Pn o2 Pd */
!def svplog(nm, op, s, b9, o2) {
!{nm} pd.B,pv/Z,pn.B,pm.B :: .call w4(0x25004000|(!{op}<<23)|(!{s}<<22)|(pm<<16)|(pv<<10)|(!{b9}<<9)|(pn<<5)|(!{o2}<<4)|pd)
}
!svplog("AND", 0, 0, 0, 0)
!svplog("BIC", 0, 0, 0, 1)
!svplog("EOR", 0, 0, 1, 0)
!svplog("ORR", 1, 0, 0, 0)
!svplog("ORN", 1, 0, 0, 1)
!svplog("NOR", 1, 0, 1, 0)
!svplog("NAND", 1, 0, 1, 1)
!svplog("ANDS", 0, 1, 0, 0)
!svplog("BICS", 0, 1, 0, 1)
!svplog("EORS", 0, 1, 1, 0)
!svplog("ORRS", 1, 1, 0, 0)
!svplog("ORNS", 1, 1, 0, 1)
!svplog("NORS", 1, 1, 1, 0)
!svplog("NANDS", 1, 1, 1, 1)
/* SEL takes its governing predicate unqualified */
SEL pd.B,pv,pn.B,pm.B :: .call w4(0x25004210|(pm<<16)|(pv<<10)|(pn<<5)|pd)
/* MOV and MOVS are ORR and ORRS with one predicate used three times */
MOV pd.B,pn.B :: .call w4(0x25804000|(pn<<16)|(pn<<10)|(pn<<5)|pd)
MOVS pd.B,pn.B :: .call w4(0x25c04000|(pn<<16)|(pn<<10)|(pn<<5)|pd)
/* The predicated spelling is AND rather than ORR, so that inactive
/* elements come out zero. */
MOV pd.B,pv/Z,pn.B :: .call w4(0x25004000|(pn<<16)|(pv<<10)|(pn<<5)|pd)
MOVS pd.B,pv/Z,pn.B :: .call w4(0x25404000|(pn<<16)|(pv<<10)|(pn<<5)|pd)

/* Predicate patterns for PTRUE and the element-count instructions */
.setsym::POW2::0
.setsym::VL1::1
.setsym::VL2::2
.setsym::VL3::3
.setsym::VL4::4
.setsym::VL5::5
.setsym::VL6::6
.setsym::VL7::7
.setsym::VL8::8
.setsym::VL16::9
.setsym::VL32::10
.setsym::VL64::11
.setsym::VL128::12
.setsym::VL256::13
.setsym::MUL4::29
.setsym::MUL3::30
.setsym::ALL::31
.setsym::PATS::POW2,VL1,VL2,VL3,VL4,VL5,VL6,VL7,VL8,VL16,VL32,VL64,VL128,VL256,MUL4,MUL3,ALL
.check::pat::PATS

/* Predicate initialisation and tests */
!def svptrue(nm, s, el, sz) {
!{nm} pd.!{el} :: .call w4(0x2518e000|(!{sz}<<22)|(!{s}<<16)|(31<<5)|pd)
!{nm} pd.!{el},pat :: .call w4(0x2518e000|(!{sz}<<22)|(!{s}<<16)|(pat<<5)|pd)
!{nm} pd.!{el},#!p ::p<0;3,p>31;3 :: .call w4(0x2518e000|(!{sz}<<22)|(!{s}<<16)|(p<<5)|pd)
}
!svptrue("PTRUE", 0, "B", 0)
!svptrue("PTRUE", 0, "H", 1)
!svptrue("PTRUE", 0, "S", 2)
!svptrue("PTRUE", 0, "D", 3)
!svptrue("PTRUES", 1, "B", 0)
!svptrue("PTRUES", 1, "H", 1)
!svptrue("PTRUES", 1, "S", 2)
!svptrue("PTRUES", 1, "D", 3)
PFALSE pd.B :: .call w4(0x2518e400|pd)
PTEST pv,pn.B :: .call w4(0x2550c000|(pv<<10)|(pn<<5))
PFIRST pd.B,pv,pd.B :: .call w4(0x2558c000|(pv<<5)|pd)
!def svpnext(el, sz) {
PNEXT pd.!{el},pv,pd.!{el} :: .call w4(0x2519c400|(!{sz}<<22)|(pv<<5)|pd)
}
!svpnext("B", 0)
!svpnext("H", 1)
!svpnext("S", 2)
!svpnext("D", 3)

/* Break instructions */
/* The flag-setting variants have no merging form. */
!def svbrk(nm, b23, s, m) {
!{nm} pd.B,pv/Z,pn.B :: .call w4(0x25104000|(!{b23}<<23)|(!{s}<<22)|(pv<<10)|(pn<<5)|pd)
!if m !then {
!{nm} pd.B,pv/M,pn.B :: .call w4(0x25104010|(!{b23}<<23)|(!{s}<<22)|(pv<<10)|(pn<<5)|pd)
}
}
!svbrk("BRKA", 0, 0, 1)
!svbrk("BRKAS", 0, 1, 0)
!svbrk("BRKB", 1, 0, 1)
!svbrk("BRKBS", 1, 1, 0)
BRKN pd.B,pv/Z,pn.B,pd.B :: .call w4(0x25184000|(pv<<10)|(pn<<5)|pd)
BRKNS pd.B,pv/Z,pn.B,pd.B :: .call w4(0x25584000|(pv<<10)|(pn<<5)|pd)
!def svbrkp(nm, s, o2) {
!{nm} pd.B,pv/Z,pn.B,pm.B :: .call w4(0x2500c000|(!{s}<<22)|(pm<<16)|(pv<<10)|(pn<<5)|(!{o2}<<4)|pd)
}
!svbrkp("BRKPA", 0, 0)
!svbrkp("BRKPB", 0, 1)
!svbrkp("BRKPAS", 1, 0)
!svbrkp("BRKPBS", 1, 1)

/* First-fault register */
RDFFR pd.B :: .call w4(0x2519f000|pd)
RDFFRS pd.B,pv/Z :: .call w4(0x2558f000|(pv<<5)|pd)
RDFFR pd.B,pv/Z :: .call w4(0x2518f000|(pv<<5)|pd)
SETFFR :: .call w4(0x252c9000)
WRFFR pn.B :: .call w4(0x25289000|(pn<<5))

/* Count the active elements of a predicate */
!def svcntp(el, sz) {
CNTP xd,pv,pn.!{el} :: .call w4(0x25208000|(!{sz}<<22)|(pv<<10)|(pn<<5)|xd)
}
!svcntp("B", 0)
!svcntp("H", 1)
!svcntp("S", 2)
!svcntp("D", 3)

/* WHILE: build a predicate from a pair of scalars.
/*   00100101 size 1 Rm cc sf 1 Rn ne Pd */
!def svwhile1(nm, cc, ne, el, sz) {
!{nm} pd.!{el},wn,wm :: .call w4(0x25200000|(!{sz}<<22)|(wm<<16)|(!{cc}<<10)|(wn<<5)|(!{ne}<<4)|pd)
!{nm} pd.!{el},xn,xm :: .call w4(0x25201000|(!{sz}<<22)|(xm<<16)|(!{cc}<<10)|(xn<<5)|(!{ne}<<4)|pd)
}
!def svwhile(nm, cc, ne) {
!svwhile1(nm, cc, ne, "B", 0)
!svwhile1(nm, cc, ne, "H", 1)
!svwhile1(nm, cc, ne, "S", 2)
!svwhile1(nm, cc, ne, "D", 3)
}
!svwhile("WHILEGE", 0, 0)
!svwhile("WHILEGT", 0, 1)
!svwhile("WHILELT", 1, 0)
!svwhile("WHILELE", 1, 1)
!svwhile("WHILEHS", 2, 0)
!svwhile("WHILEHI", 2, 1)
!svwhile("WHILELO", 3, 0)
!svwhile("WHILELS", 3, 1)

/* Element count and increment.
/*   00000100 size 1 b20 imm4 opc pattern Rd
/* The pattern defaults to ALL and the multiplier to 1. */
!def svcnt1(nm, opc, b20, sz, rd) {
!{nm} !{rd} :: .call w4(0x04200000|(!{sz}<<22)|(!{b20}<<20)|(!{opc}<<10)|(31<<5)|!{rd})
!{nm} !{rd},pat :: .call w4(0x04200000|(!{sz}<<22)|(!{b20}<<20)|(!{opc}<<10)|(pat<<5)|!{rd})
!{nm} !{rd},pat,MUL #!c ::c<1;3,c>16;3 :: .call w4(0x04200000|(!{sz}<<22)|(!{b20}<<20)|((c-1)<<16)|(!{opc}<<10)|(pat<<5)|!{rd})
!{nm} !{rd},#!p ::p<0;3,p>31;3 :: .call w4(0x04200000|(!{sz}<<22)|(!{b20}<<20)|(!{opc}<<10)|(p<<5)|!{rd})
!{nm} !{rd},#!p,MUL #!c ::p<0;3,p>31;3,c<1;3,c>16;3 :: .call w4(0x04200000|(!{sz}<<22)|(!{b20}<<20)|((c-1)<<16)|(!{opc}<<10)|(p<<5)|!{rd})
}
!def svcntsz(nm, opc, b20, rd) {
!svcnt1(nm + "B", opc, b20, 0, rd)
!svcnt1(nm + "H", opc, b20, 1, rd)
!svcnt1(nm + "W", opc, b20, 2, rd)
!svcnt1(nm + "D", opc, b20, 3, rd)
}
!svcntsz("CNT", 0x38, 0, "xd")
!svcntsz("INC", 0x38, 1, "xd")
!svcntsz("DEC", 0x39, 1, "xd")
!svcntsz("SQINC", 0x3c, 1, "xd")
!svcntsz("UQINC", 0x3d, 1, "xd")
!svcntsz("SQDEC", 0x3e, 1, "xd")
!svcntsz("UQDEC", 0x3f, 1, "xd")
!svcntsz("UQINC", 0x3d, 0, "wd")
!svcntsz("UQDEC", 0x3f, 0, "wd")
/* The saturating increments that take a 32-bit source and a 64-bit
/* destination name both registers. */
!def svcnt2(nm, opc, sz) {
!{nm} xd,wd :: .call w4(0x04200000|(!{sz}<<22)|(!{opc}<<10)|(31<<5)|xd)
!{nm} xd,wd,pat :: .call w4(0x04200000|(!{sz}<<22)|(!{opc}<<10)|(pat<<5)|xd)
!{nm} xd,wd,pat,MUL #!c ::c<1;3,c>16;3 :: .call w4(0x04200000|(!{sz}<<22)|((c-1)<<16)|(!{opc}<<10)|(pat<<5)|xd)
!{nm} xd,wd,#!p ::p<0;3,p>31;3 :: .call w4(0x04200000|(!{sz}<<22)|(!{opc}<<10)|(p<<5)|xd)
!{nm} xd,wd,#!p,MUL #!c ::p<0;3,p>31;3,c<1;3,c>16;3 :: .call w4(0x04200000|(!{sz}<<22)|((c-1)<<16)|(!{opc}<<10)|(p<<5)|xd)
}
!def svcnt2sz(nm, opc) {
!svcnt2(nm + "B", opc, 0)
!svcnt2(nm + "H", opc, 1)
!svcnt2(nm + "W", opc, 2)
!svcnt2(nm + "D", opc, 3)
}
!svcnt2sz("SQINC", 0x3c)
!svcnt2sz("SQDEC", 0x3e)
/* The vector forms step every element; there is no byte version. */
!def svcntv1(nm, opc, b20, el, sz) {
!{nm} zd.!{el} :: .call w4(0x0420c000|(!{sz}<<22)|(!{b20}<<20)|(!{opc-0x30}<<10)|(31<<5)|zd)
!{nm} zd.!{el},pat :: .call w4(0x0420c000|(!{sz}<<22)|(!{b20}<<20)|(!{opc-0x30}<<10)|(pat<<5)|zd)
!{nm} zd.!{el},pat,MUL #!c ::c<1;3,c>16;3 :: .call w4(0x0420c000|(!{sz}<<22)|(!{b20}<<20)|((c-1)<<16)|(!{opc-0x30}<<10)|(pat<<5)|zd)
!{nm} zd.!{el},#!p ::p<0;3,p>31;3 :: .call w4(0x0420c000|(!{sz}<<22)|(!{b20}<<20)|(!{opc-0x30}<<10)|(p<<5)|zd)
!{nm} zd.!{el},#!p,MUL #!c ::p<0;3,p>31;3,c<1;3,c>16;3 :: .call w4(0x0420c000|(!{sz}<<22)|(!{b20}<<20)|((c-1)<<16)|(!{opc-0x30}<<10)|(p<<5)|zd)
}
!def svcntv(nm, opc, b20) {
!svcntv1(nm + "H", opc, b20, "H", 1)
!svcntv1(nm + "W", opc, b20, "S", 2)
!svcntv1(nm + "D", opc, b20, "D", 3)
}
!svcntv("INC", 0x30, 1)
!svcntv("DEC", 0x31, 1)
!svcntv("SQINC", 0x30, 0)
!svcntv("UQINC", 0x31, 0)
!svcntv("SQDEC", 0x32, 0)
!svcntv("UQDEC", 0x33, 0)

/* Step by the number of active predicate elements */
!def svincp1(nm, opc, b10, el, sz, rd) {
!{nm} !{rd},pn.!{el} :: .call w4(0x25008800|(!{sz}<<22)|(!{opc}<<16)|(!{b10}<<10)|(pn<<5)|!{rd})
}
!def svincp(nm, opc, b10, rd) {
!svincp1(nm, opc, b10, "B", 0, rd)
!svincp1(nm, opc, b10, "H", 1, rd)
!svincp1(nm, opc, b10, "S", 2, rd)
!svincp1(nm, opc, b10, "D", 3, rd)
}
!svincp("INCP", 0x2c, 0, "xd")
!svincp("DECP", 0x2d, 0, "xd")
!svincp("SQINCP", 0x28, 1, "xd")
!svincp("UQINCP", 0x29, 1, "xd")
!svincp("SQDECP", 0x2a, 1, "xd")
!svincp("UQDECP", 0x2b, 1, "xd")
!svincp("UQINCP", 0x29, 0, "wd")
!svincp("UQDECP", 0x2b, 0, "wd")
!def svincp2(nm, opc, el, sz) {
!{nm} xd,pn.!{el},wd :: .call w4(0x25008800|(!{sz}<<22)|(!{opc}<<16)|(pn<<5)|xd)
}
!def svincp2a(nm, opc) {
!svincp2(nm, opc, "B", 0)
!svincp2(nm, opc, "H", 1)
!svincp2(nm, opc, "S", 2)
!svincp2(nm, opc, "D", 3)
}
!svincp2a("SQINCP", 0x28)
!svincp2a("SQDECP", 0x2a)
!def svincpv1(nm, opc, el, sz) {
!{nm} zd.!{el},pn :: .call w4(0x25008000|(!{sz}<<22)|(!{opc}<<16)|(pn<<5)|zd)
!{nm} zd.!{el},pn.!{el} :: .call w4(0x25008000|(!{sz}<<22)|(!{opc}<<16)|(pn<<5)|zd)
}
!def svincpv(nm, opc) {
!svincpv1(nm, opc, "H", 1)
!svincpv1(nm, opc, "S", 2)
!svincpv1(nm, opc, "D", 3)
}
!svincpv("INCP", 0x2c)
!svincpv("DECP", 0x2d)
!svincpv("SQINCP", 0x28)
!svincpv("UQINCP", 0x29)
!svincpv("SQDECP", 0x2a)
!svincpv("UQDECP", 0x2b)

/* INDEX: a vector counting from a start by a step */
!def svindex(el, sz, rw, xr) {
INDEX zd.!{el},#!a,#!b ::a<-16;3,a>15;3,b<-16;3,b>15;3 :: .call w4(0x04204000|(!{sz}<<22)|((b&0x1f)<<16)|((a&0x1f)<<5)|zd)
INDEX zd.!{el},#!a,!{rw}m ::a<-16;3,a>15;3 :: .call w4(0x04204800|(!{sz}<<22)|(!{rw}m<<16)|((a&0x1f)<<5)|zd)
INDEX zd.!{el},!{rw}n,#!b ::b<-16;3,b>15;3 :: .call w4(0x04204400|(!{sz}<<22)|((b&0x1f)<<16)|(!{rw}n<<5)|zd)
INDEX zd.!{el},!{rw}n,!{rw}m :: .call w4(0x04204c00|(!{sz}<<22)|(!{rw}m<<16)|(!{rw}n<<5)|zd)
}
!svindex("B", 0, "w", 0)
!svindex("H", 1, "w", 0)
!svindex("S", 2, "w", 0)
!svindex("D", 3, "x", 1)

/* Vector length arithmetic */
RDVL xd,#!v ::v<-32;3,v>31;3 :: .call w4(0x04bf5000|((v&0x3f)<<5)|xd)
ADDVL xs,xe,#!v ::v<-32;3,v>31;3 :: .call w4(0x04205000|(xe<<16)|((v&0x3f)<<5)|xs)
ADDPL xs,xe,#!v ::v<-32;3,v>31;3 :: .call w4(0x04605000|(xe<<16)|((v&0x3f)<<5)|xs)

/* ADR: compute a vector of addresses */
!def svadr(el, hi, ex) {
ADR zd.!{el},[zn.!{el},zm.!{el}!{ex}] :: .call w4(0x0420a000|(!{hi}<<22)|(zm<<16)|(zn<<5)|zd)
ADR zd.!{el},[zn.!{el},zm.!{el}!{ex},LSL #!s] ::s<0;3,s>3;3 :: .call w4(0x0420a000|(!{hi}<<22)|(zm<<16)|(s<<10)|(zn<<5)|zd)
}
!svadr("S", 2, "")
!svadr("D", 3, "")
ADR zd.D,[zn.D,zm.D,UXTW] :: .call w4(0x0460a000|(zm<<16)|(zn<<5)|zd)
ADR zd.D,[zn.D,zm.D,UXTW #!s] ::s<0;3,s>3;3 :: .call w4(0x0460a000|(zm<<16)|(s<<10)|(zn<<5)|zd)
ADR zd.D,[zn.D,zm.D,SXTW] :: .call w4(0x0420a000|(zm<<16)|(zn<<5)|zd)
ADR zd.D,[zn.D,zm.D,SXTW #!s] ::s<0;3,s>3;3 :: .call w4(0x0420a000|(zm<<16)|(s<<10)|(zn<<5)|zd)

/* Permute: broadcast, insert, reverse */
/* The index field skips bit 21, so it splits into imm2 at 22 and tsz at 16. */
!def svdupx(nm, el, sh, lo, mx) {
!{nm} zd.!{el},zn.!{el}[!!i] ::i<0;3,i>!{mx};3 :: .call w4(0x05202000|(((((i<<!{sh})|!{lo}))&0x1f)<<16)|(((((i<<!{sh})|!{lo}))>>5)<<22)|(zn<<5)|zd)
}
!svdupx("DUP", "B", 1, 1, 63)
!svdupx("DUP", "H", 2, 2, 31)
!svdupx("DUP", "S", 3, 4, 15)
!svdupx("DUP", "D", 4, 8, 7)
!svdupx("DUP", "Q", 5, 16, 3)
!svdupx("MOV", "B", 1, 1, 63)
!svdupx("MOV", "H", 2, 2, 31)
!svdupx("MOV", "S", 3, 4, 15)
!svdupx("MOV", "D", 4, 8, 7)
!svdupx("MOV", "Q", 5, 16, 3)
!def svdupg(nm, el, sz, rn) {
!{nm} zd.!{el},!{rn} :: .call w4(0x05203800|(!{sz}<<22)|(!{rn}<<5)|zd)
}
!svdupg("DUP", "B", 0, "wn")
!svdupg("DUP", "H", 1, "wn")
!svdupg("DUP", "S", 2, "wn")
!svdupg("DUP", "D", 3, "xn")
!svdupg("MOV", "B", 0, "wn")
!svdupg("MOV", "H", 1, "wn")
!svdupg("MOV", "S", 2, "wn")
!svdupg("MOV", "D", 3, "xn")
!def svinsr(el, sz, rn, vn) {
INSR zd.!{el},!{rn} :: .call w4(0x05243800|(!{sz}<<22)|(!{rn}<<5)|zd)
INSR zd.!{el},!{vn} :: .call w4(0x05343800|(!{sz}<<22)|(!{vn}<<5)|zd)
}
!svinsr("B", 0, "wn", "fbn")
!svinsr("H", 1, "wn", "fhn")
!svinsr("S", 2, "wn", "fsn")
!svinsr("D", 3, "xn", "fdn")
!def svrevz(el, sz) {
REV zd.!{el},zn.!{el} :: .call w4(0x05383800|(!{sz}<<22)|(zn<<5)|zd)
REV pd.!{el},pn.!{el} :: .call w4(0x05344000|(!{sz}<<22)|(pn<<5)|pd)
}
!svrevz("B", 0)
!svrevz("H", 1)
!svrevz("S", 2)
!svrevz("D", 3)

/* Table lookup, extract, splice, compact */
!def svtbl(el, sz) {
TBL zd.!{el},{zn.!{el}},zm.!{el} :: .call w4(0x05203000|(!{sz}<<22)|(zm<<16)|(zn<<5)|zd)
}
!svtbl("B", 0)
!svtbl("H", 1)
!svtbl("S", 2)
!svtbl("D", 3)
EXT zd.B,zd.B,zm.B,#!i ::i<0;3,i>255;3 :: .call w4(0x05200000|(((i>>3)&0xff)<<16)|((i&7)<<10)|(zm<<5)|zd)
!def svsplice(el, sz) {
SPLICE zd.!{el},pv,zd.!{el},zm.!{el} :: .call w4(0x052c8000|(!{sz}<<22)|(pv<<10)|(zm<<5)|zd)
}
!svsplice("B", 0)
!svsplice("H", 1)
!svsplice("S", 2)
!svsplice("D", 3)
COMPACT zd.S,pv,zn.S :: .call w4(0x05a18000|(pv<<10)|(zn<<5)|zd)
COMPACT zd.D,pv,zn.D :: .call w4(0x05e18000|(pv<<10)|(zn<<5)|zd)

/* Extract the last element, with and without wrapping */
!def svlast(nm, b16, el, sz, rd, vd) {
!{nm} !{rd},pv,zn.!{el} :: .call w4(0x0520a000|(!{sz}<<22)|(!{b16}<<16)|(pv<<10)|(zn<<5)|!{rd})
!{nm} !{vd},pv,zn.!{el} :: .call w4(0x05228000|(!{sz}<<22)|(!{b16}<<16)|(pv<<10)|(zn<<5)|!{vd})
}
!svlast("LASTA", 0, "B", 0, "wd", "fbd")
!svlast("LASTA", 0, "H", 1, "wd", "fhd")
!svlast("LASTA", 0, "S", 2, "wd", "fsd")
!svlast("LASTA", 0, "D", 3, "xd", "fdd")
!svlast("LASTB", 1, "B", 0, "wd", "fbd")
!svlast("LASTB", 1, "H", 1, "wd", "fhd")
!svlast("LASTB", 1, "S", 2, "wd", "fsd")
!svlast("LASTB", 1, "D", 3, "xd", "fdd")
!def svclast(nm, b16, el, sz, rd, vd) {
!{nm} zd.!{el},pv,zd.!{el},zm.!{el} :: .call w4(0x05288000|(!{sz}<<22)|(!{b16}<<16)|(pv<<10)|(zm<<5)|zd)
!{nm} !{rd},pv,!{rd},zn.!{el} :: .call w4(0x0530a000|(!{sz}<<22)|(!{b16}<<16)|(pv<<10)|(zn<<5)|!{rd})
!{nm} !{vd},pv,!{vd},zn.!{el} :: .call w4(0x052a8000|(!{sz}<<22)|(!{b16}<<16)|(pv<<10)|(zn<<5)|!{vd})
}
!svclast("CLASTA", 0, "B", 0, "wd", "fbd")
!svclast("CLASTA", 0, "H", 1, "wd", "fhd")
!svclast("CLASTA", 0, "S", 2, "wd", "fsd")
