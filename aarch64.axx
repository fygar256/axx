!sysins1("DC", "dcop1")

!sysop("S1E1R", 0, 7, 8, 0)
!sysop("S1E1W", 0, 7, 8, 1)
!sysop("S1E0R", 0, 7, 8, 2)
!sysop("S1E0W", 0, 7, 8, 3)
!sysop("S1E2R", 4, 7, 8, 0)
!sysop("S1E2W", 4, 7, 8, 1)
!sysop("S12E1R", 4, 7, 8, 4)
!sysop("S12E1W", 4, 7, 8, 5)
!sysop("S12E0R", 4, 7, 8, 6)
!sysop("S12E0W", 4, 7, 8, 7)
