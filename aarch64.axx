!sr("OSDLR_EL1", 2, 0, 1, 3, 4, 2)
.check::sysr::!{SRR}
.check::sysw::!{SRW}

MRS xt,sysr :: .call w4(0xd5300000|(sysr<<5)|xt)
MSR sysw,xt :: .call w4(0xd5100000|(sysw<<5)|xt)
MRS xt,S!S{{sop0}}a!S{{sd8}}bC!S{{sd16}}cC!S{{sd16}}e!S{{sd8x}}f :: .call w4(0xd5300000|((a-2)<<19)|(b<<16)|(c<<12)|(e<<8)|(f<<5)|xt)
MSR S!S{{sop0}}a!S{{sd8}}bC!S{{sd16}}cC!S{{sd16}}e!S{{sd8x}}f,xt :: .call w4(0xd5100000|((a-2)<<19)|(b<<16)|(c<<12)|(e<<8)|(f<<5)|xt)

/* Digit tables for the generic system-register spelling. The trailing
/* "_" of each field belongs to the table entry, not to the pattern:
/* a variable name written right after a capture would otherwise eat
/* the underscore, since "_" is a variable-name character. */
!def dtab(nm, hi, suf) {
.sub::!{nm}
!local i = hi
!while i >= 0 {
!{i}!{suf}::!{i}
!set i = i - 1
}
.return
}
!dtab("sop0", 3, "_")
!dtab("sd8", 7, "_")
!dtab("sd16", 15, "_")
!dtab("sd8x", 7, "")

/* SYS, SYSL and the cache/TLB aliases built on them */
!def crreg(n) {
.setsym::C!{n}::!{n}
}
!local i = 0
!while i <= 15 {
!crreg(i)
!set i = i + 1
}
.setsym::CRS::C0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15
.check::crn::CRS
.check::crm::CRS

SYS #!p,crn,crm,#!q ::p<0;3,p>7;3,q<0;3,q>7;3 :: .call w4(0xd5080000|(p<<16)|(crn<<12)|(crm<<8)|(q<<5)|31)
SYS #!p,crn,crm,#!q,xt ::p<0;3,p>7;3,q<0;3,q>7;3 :: .call w4(0xd5080000|(p<<16)|(crn<<12)|(crm<<8)|(q<<5)|xt)
SYSL xt,#!p,crn,crm,#!q ::p<0;3,p>7;3,q<0;3,q>7;3 :: .call w4(0xd5280000|(p<<16)|(crn<<12)|(crm<<8)|(q<<5)|xt)

/* Named cache, address-translation and TLB operations. Each name
/* holds op1:CRn:CRm:op2 packed four bits per field. */
!def sysop(nm, op1, crn, crm, op2) {
.setsym::!{nm}::!{(op1 << 12) | (crn << 8) | (crm << 4) | op2}
}
/* Two forms: an operation that names an address takes Xt, one that
/* does not takes none. They are kept in separate .check lists so that
/* the wrong shape is rejected. */
!def sysins0(mn, vr) {
!{mn} !{vr} :: .call w4(0xd5080000|((!{vr}>>12)<<16)|(((!{vr}>>8)&15)<<12)|(((!{vr}>>4)&15)<<8)|((!{vr}&7)<<5)|31)
}
!def sysins1(mn, vr) {
!{mn} !{vr},xt :: .call w4(0xd5080000|((!{vr}>>12)<<16)|(((!{vr}>>8)&15)<<12)|(((!{vr}>>4)&15)<<8)|((!{vr}&7)<<5)|xt)
}
!sysop("IALLUIS", 0, 7, 1, 0)
!sysop("IALLU", 0, 7, 5, 0)
!sysop("IVAU", 3, 7, 5, 1)
.check::icop0::IALLUIS,IALLU
.check::icop1::IVAU
!sysins0("IC", "icop0")
!sysins1("IC", "icop1")

!sysop("IVAC", 0, 7, 6, 1)
!sysop("ISW", 0, 7, 6, 2)
!sysop("CSW", 0, 7, 10, 2)
!sysop("CISW", 0, 7, 14, 2)
!sysop("ZVA", 3, 7, 4, 1)
!sysop("CVAC", 3, 7, 10, 1)
!sysop("CVAU", 3, 7, 11, 1)
!sysop("CVAP", 3, 7, 12, 1)
!sysop("CIVAC", 3, 7, 14, 1)
.check::dcop1::IVAC,ISW,CSW,CISW,ZVA,CVAC,CVAU,CVAP,CIVAC
!sysins1("DC", "dcop1")

!sysop("S1E1R", 0, 7, 8, 0)
!sysop("S1E1W", 0, 7, 8, 1)
!sysop("S1E0R", 0, 7, 8, 2)
!sysop("S1E0W", 0, 7, 8, 3)
!sysop("S1E2R", 4, 7, 8, 0)
!sysop("S1E2W", 4, 7, 8, 1)
!sysop("S12E1R", 4, 7, 8, 4)
!sysop("S12E1W", 4, 7, 8, 5)
!sysop("S12E0R", 4, 7, 8, 6)
!sysop("S12E0W", 4, 7, 8, 7)
!sysop("S1E3R", 6, 7, 8, 0)
!sysop("S1E3W", 6, 7, 8, 1)
.check::atop1::S1E1R,S1E1W,S1E0R,S1E0W,S1E2R,S1E2W,S12E1R,S12E1W,S12E0R,S12E0W,S1E3R,S1E3W
!sysins1("AT", "atop1")

!sysop("VMALLE1IS", 0, 8, 3, 0)
!sysop("VAE1IS", 0, 8, 3, 1)
!sysop("ASIDE1IS", 0, 8, 3, 2)
!sysop("VAAE1IS", 0, 8, 3, 3)
!sysop("VALE1IS", 0, 8, 3, 5)
!sysop("VAALE1IS", 0, 8, 3, 7)
!sysop("VMALLE1", 0, 8, 7, 0)
!sysop("VAE1", 0, 8, 7, 1)
!sysop("ASIDE1", 0, 8, 7, 2)
!sysop("VAAE1", 0, 8, 7, 3)
!sysop("VALE1", 0, 8, 7, 5)
!sysop("VAALE1", 0, 8, 7, 7)
!sysop("ALLE1IS", 4, 8, 3, 4)
!sysop("ALLE2IS", 4, 8, 3, 0)
!sysop("ALLE3IS", 6, 8, 3, 0)
!sysop("ALLE1", 4, 8, 7, 4)
!sysop("ALLE2", 4, 8, 7, 0)
