/* Multi-vector contiguous loads and stores under a counter */
.func::lsp::a,b
.if b == a + 1 .then
.if (a & 1) != 0 .then
.raise 5
.endif
.return 0
.endif
.if b == a + 8 .then
.if (a & 8) != 0 .then
.raise 5
.endif
.return 1
.endif
.raise 5
.return 0
.endfunc
.func::lsq::a,b,c,d
.if b == a + 1 .then
.if c != a + 2 .then
.raise 5
.endif
.if d != a + 3 .then
.raise 5
.endif
.if (a & 3) != 0 .then
.raise 5
.endif
.return 0
.endif
.if b == a + 4 .then
.if c != a + 8 .then
.raise 5
.endif
.if d != a + 12 .then
.raise 5
.endif
.if (a & 12) != 0 .then
.raise 5
.endif
.return 1
.endif
.raise 5
.return 0
.endfunc
/* a comma-written pair: consecutive or strided */
.func::ls2::base,fld,rn,pn,msz,nt,a,b
s = .call lsp(a, b)
.if s == 0 .then
.return .call w4(base | (fld << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | a | nt)
.endif
z = (a & 7) | ((a >> 4) << 4)
.return .call w4(base | 0x01000000 | (fld << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | z | (nt << 3))
.endfunc
/* a comma-written quad: consecutive or strided */
.func::ls4::base,fld,rn,pn,msz,nt,a,b,c,d
s = .call lsq(a, b, c, d)
.if s == 0 .then
.return .call w4(base | 0x8000 | (fld << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | a | nt)
.endif
z = (a & 3) | ((a >> 4) << 4)
.return .call w4(base | 0x01008000 | (fld << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | z | (nt << 3))
.endfunc
/* a dash-written list: always consecutive, pair or quad */
.func::lsd::base,fld,rn,pn,msz,nt,a,b
g = .call n2q(a, b)
.return .call w4(base | (g << 15) | (fld << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | a | nt)
.endfunc
/* the same three with a vector-length-relative offset */
.func::ls2i::base,off,rn,pn,msz,nt,a,b
s = .call lsp(a, b)
q = .call divs4(off, 2)
.if s == 0 .then
.return .call w4(base | (q << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | a | nt)
.endif
z = (a & 7) | ((a >> 4) << 4)
.return .call w4(base | 0x01000000 | (q << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | z | (nt << 3))
.endfunc
.func::ls4i::base,off,rn,pn,msz,nt,a,b,c,d
s = .call lsq(a, b, c, d)
q = .call divs4(off, 4)
.if s == 0 .then
.return .call w4(base | 0x8000 | (q << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | a | nt)
.endif
z = (a & 3) | ((a >> 4) << 4)
.return .call w4(base | 0x01008000 | (q << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | z | (nt << 3))
.endfunc
.func::lsdi::base,off,rn,pn,msz,nt,a,b
g = .call n2q(a, b)
n = 2
.if g == 1 .then
n = 4
.endif
q = .call divs4(off, n)
.return .call w4(base | (g << 15) | (q << 16) | (msz << 13) | ((pn - 8) << 10) | (rn << 5) | a | nt)
.endfunc

