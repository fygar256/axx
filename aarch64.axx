!sr("ID_AA64PFR0_EL1", 3, 0, 0, 4, 0, 0)
!sr("ID_AA64PFR1_EL1", 3, 0, 0, 4, 1, 0)
!sr("ID_AA64ISAR0_EL1", 3, 0, 0, 6, 0, 0)
!sr("ID_AA64ISAR1_EL1", 3, 0, 0, 6, 1, 0)
!sr("ID_AA64MMFR0_EL1", 3, 0, 0, 7, 0, 0)
!sr("ID_AA64MMFR1_EL1", 3, 0, 0, 7, 1, 0)
!sr("SCTLR_EL1", 3, 0, 1, 0, 0, 2)
!sr("CPACR_EL1", 3, 0, 1, 0, 2, 2)
!sr("TTBR0_EL1", 3, 0, 2, 0, 0, 2)
!sr("TTBR1_EL1", 3, 0, 2, 0, 1, 2)
!sr("TCR_EL1", 3, 0, 2, 0, 2, 2)
