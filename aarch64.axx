/* Data processing (1 source) */
!def dp1(nm, opc, rd, rn, sf) {
!{nm} !{rd},!{rn} :: .call w4((!{sf}<<31)|(1<<30)|(0xd6<<21)|(!{opc}<<10)|(!{rn}<<5)|!{rd})
}
!dp1("RBIT", 0, "xd", "xn", 1)
!dp1("RBIT", 0, "wd", "wn", 0)
!dp1("REV16", 1, "xd", "xn", 1)
!dp1("REV16", 1, "wd", "wn", 0)
!dp1("REV32", 2, "xd", "xn", 1)
!dp1("REV", 3, "xd", "xn", 1)
!dp1("REV", 2, "wd", "wn", 0)
!dp1("CLZ", 4, "xd", "xn", 1)
!dp1("CLZ", 4, "wd", "wn", 0)
!dp1("CLS", 5, "xd", "xn", 1)
!dp1("CLS", 5, "wd", "wn", 0)

/* ===================================================================
/* Branches, exception generation, hints, barriers and system
/* =================================================================== */

/* Unconditional branch (immediate) */
B !t ::((t-$$)<-134217728)||((t-$$)>134217724);2 :: .call w4(0x14000000|(((t-$$)>>2)&0x3ffffff))
BL !t ::((t-$$)<-134217728)||((t-$$)>134217724);2 :: .call w4(0x94000000|(((t-$$)>>2)&0x3ffffff))

/* Conditional branch */
B.cnd !t ::((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4(0x54000000|((((t-$$)>>2)&0x7ffff)<<5)|cnd)

/* Compare and branch */
!def cb(nm, op, rt, sf) {
!{nm} !{rt},!t ::((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4((!{sf}<<31)|(0x1a<<25)|(!{op}<<24)|((((t-$$)>>2)&0x7ffff)<<5)|!{rt})
}
!cb("CBZ", 0, "xt", 1)
!cb("CBZ", 0, "wt", 0)
!cb("CBNZ", 1, "xt", 1)
!cb("CBNZ", 1, "wt", 0)

/* Test bit and branch */
!def tb(nm, op, rt, mx) {
!{nm} !{rt},#!b,!t ::b<0;3,b>!{mx};3,((t-$$)<-32768)||((t-$$)>32764);2 :: .call w4(((b>>5)<<31)|(0x1b<<25)|(!{op}<<24)|((b&31)<<19)|((((t-$$)>>2)&0x3fff)<<5)|!{rt})
}
!tb("TBZ", 0, "xt", 63)
!tb("TBZ", 0, "wt", 31)
!tb("TBNZ", 1, "xt", 63)
!tb("TBNZ", 1, "wt", 31)

/* Unconditional branch (register) */
BR xn :: .call w4(0xd61f0000|(xn<<5))
BLR xn :: .call w4(0xd63f0000|(xn<<5))
RET :: .call w4(0xd65f0000|(30<<5))
RET xn :: .call w4(0xd65f0000|(xn<<5))
ERET :: .call w4(0xd69f03e0)
DRPS :: .call w4(0xd6bf03e0)

/* Exception generation */
!def exc(nm, opc, ll) {
!{nm} #!v ::v<0;3,v>0xffff;3 :: .call w4(0xd4000000|(!{opc}<<21)|(v<<5)|!{ll})
}
!exc("SVC", 0, 1)
!exc("HVC", 0, 2)
!exc("SMC", 0, 3)
!exc("BRK", 1, 0)
!exc("HLT", 2, 0)
/* The DCPS immediate is optional and defaults to 0 */
!def dcps(nm, ll) {
!{nm}[[ #!v]] ::v<0;3,v>0xffff;3 :: .call w4(0xd4000000|(5<<21)|(v<<5)|!{ll})
}
!dcps("DCPS1", 1)
!dcps("DCPS2", 2)
!dcps("DCPS3", 3)

/* Hints. All of them are one encoding with CRm and op2 varying. */
!def hint(nm, crm, op2) {
!{nm} :: .call w4(0xd503201f|(!{crm}<<8)|(!{op2}<<5))
}
!hint("NOP", 0, 0)
!hint("YIELD", 0, 1)
!hint("WFE", 0, 2)
!hint("WFI", 0, 3)
!hint("SEV", 0, 4)
!hint("SEVL", 0, 5)
!hint("DGH", 0, 6)
!hint("XPACLRI", 0, 7)
!hint("PACIA1716", 1, 0)
!hint("PACIB1716", 1, 2)
!hint("AUTIA1716", 1, 4)
!hint("AUTIB1716", 1, 6)
!hint("ESB", 2, 0)
!hint("PSB CSYNC", 2, 1)
!hint("TSB CSYNC", 2, 2)
!hint("CSDB", 2, 4)
!hint("PACIAZ", 3, 0)
!hint("PACIASP", 3, 1)
!hint("PACIBZ", 3, 2)
!hint("PACIBSP", 3, 3)
!hint("AUTIAZ", 3, 4)
!hint("AUTIASP", 3, 5)
!hint("AUTIBZ", 3, 6)
!hint("AUTIBSP", 3, 7)
!hint("BTI", 4, 0)
!hint("BTI C", 4, 2)
!hint("BTI J", 4, 4)
!hint("BTI JC", 4, 6)
HINT #!v ::v<0;3,v>127;3 :: .call w4(0xd503201f|((v>>3)<<8)|((v&7)<<5))

/* Barriers */
CLREX :: .call w4(0xd503305f|(15<<8))
CLREX #!v ::v<0;3,v>15;3 :: .call w4(0xd503305f|(v<<8))
DSB bar :: .call w4(0xd503309f|(bar<<8))
DSB #!v ::v<0;3,v>15;3 :: .call w4(0xd503309f|(v<<8))
DMB bar :: .call w4(0xd50330bf|(bar<<8))
DMB #!v ::v<0;3,v>15;3 :: .call w4(0xd50330bf|(v<<8))
ISB :: .call w4(0xd50330df|(15<<8))
ISB bar :: .call w4(0xd50330df|(bar<<8))
ISB #!v ::v<0;3,v>15;3 :: .call w4(0xd50330df|(v<<8))
SB :: .call w4(0xd50330ff)

/* PSTATE (MSR immediate) */
!def pstate(nm, op1, op2) {
MSR !{nm},#!v ::v<0;3,v>15;3 :: .call w4(0xd500401f|(!{op1}<<16)|(v<<8)|(!{op2}<<5))
}
!pstate("SPSEL", 0, 5)
!pstate("DAIFSET", 3, 6)
!pstate("DAIFCLR", 3, 7)
!pstate("UAO", 0, 3)
!pstate("PAN", 0, 4)
!pstate("DIT", 3, 2)
!pstate("SSBS", 3, 1)
!pstate("TCO", 3, 4)
CFINV :: .call w4(0xd500401f)

/* System register access. The named registers below are the common
/* ones; every other register, named or not, is reachable through the
/* generic S<op0>_<op1>_C<Cn>_C<Cm>_<op2> form underneath, whose digits
/* are matched by the small .sub tables at the end of this section. */
/* rw: 0 read-only, 1 write-only, 2 read/write. MRS and MSR get their
/* own .check lists from it, so writing to a read-only register is
/* rejected rather than quietly encoded. */
!set SRR = ""
!set SRW = ""
!def sr(nm, o0, op1, crn, crm, op2, rw) {
.setsym::!{nm}::!{((o0 - 2) << 14) | (op1 << 11) | (crn << 7) | (crm << 3) | op2}
!if rw != 1 !then {
!if SRR == "" !then {
!set SRR = nm
} !else {
!set SRR = SRR + "," + nm
}
}
!if rw != 0 !then {
!if SRW == "" !then {
!set SRW = nm
} !else {
!set SRW = SRW + "," + nm
}
}
}
!sr("NZCV", 3, 3, 4, 2, 0, 2)
!sr("DAIF", 3, 3, 4, 2, 1, 2)
!sr("FPCR", 3, 3, 4, 4, 0, 2)
!sr("FPSR", 3, 3, 4, 4, 1, 2)
!sr("SPSEL", 3, 0, 4, 2, 0, 2)
!sr("CURRENTEL", 3, 0, 4, 2, 2, 0)
!sr("MIDR_EL1", 3, 0, 0, 0, 0, 0)
!sr("MPIDR_EL1", 3, 0, 0, 0, 5, 0)
