STNT1D {zt.D},pg,[zn.D] :: .call w4(0xe59f2000|(pg<<10)|(zn<<5)|zt)
STNT1D {zt.D},pg,[zn.D,xm] :: .call w4(0xe5802000|(xm<<16)|(pg<<10)|(zn<<5)|zt)

/* Prefetches.  SVE has no instruction-prefetch hints and numbers its
/* store hints from 8, so the base-ISA value is folded down by eight.
/* The hint may also be written as a bare number, masked to four bits
/* because that is the whole field. */
.check::svp::PLDL1KEEP,PLDL1STRM,PLDL2KEEP,PLDL2STRM,PLDL3KEEP,PLDL3STRM,PSTL1KEEP,PSTL1STRM,PSTL2KEEP,PSTL2STRM,PSTL3KEEP,PSTL3STRM
!def svprf(sfx, msz, ix, sz, opt, opv) {
PRF!{sfx} !{opt},pg,[xb] :: .call w4(0x85c00000|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[xb,#!v,MUL VL] ::v<-32;3,v>31;3 :: .call w4(0x85c00000|((v&0x3f)<<16)|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[xb,!{ix}] :: .call w4(0x8400c000|(!{msz}<<23)|(xm<<16)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[zn.S,#!v] :: .call svmem5(0x8400e000|(!{msz}<<23),v,!{sz},pg,zn,!{opv})
PRF!{sfx} !{opt},pg,[zn.S] :: .call w4(0x8400e000|(!{msz}<<23)|(pg<<10)|(zn<<5)|!{opv})
PRF!{sfx} !{opt},pg,[zn.D,#!v] :: .call svmem5(0xc400e000|(!{msz}<<23),v,!{sz},pg,zn,!{opv})
PRF!{sfx} !{opt},pg,[zn.D] :: .call w4(0xc400e000|(!{msz}<<23)|(pg<<10)|(zn<<5)|!{opv})
}
!def svprfx(sfx, msz, opt, opv) {
PRF!{sfx} !{opt},pg,[xb,zm.S,UXTW #!{msz}] :: .call w4(0x84200000|(zm<<16)|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[xb,zm.S,SXTW #!{msz}] :: .call w4(0x84600000|(zm<<16)|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[xb,zm.D,UXTW #!{msz}] :: .call w4(0xc4200000|(zm<<16)|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[xb,zm.D,SXTW #!{msz}] :: .call w4(0xc4600000|(zm<<16)|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
PRF!{sfx} !{opt},pg,[xb,zm.D,LSL #!{msz}] :: .call w4(0xc4600000|(zm<<16)|(1<<15)|(!{msz}<<13)|(pg<<10)|(xb<<5)|!{opv})
}
!def svprfb(opt, opv) {
PRFB !{opt},pg,[xb,zm.S,UXTW] :: .call w4(0x84200000|(zm<<16)|(pg<<10)|(xb<<5)|!{opv})
PRFB !{opt},pg,[xb,zm.S,SXTW] :: .call w4(0x84600000|(zm<<16)|(pg<<10)|(xb<<5)|!{opv})
PRFB !{opt},pg,[xb,zm.D,UXTW] :: .call w4(0xc4200000|(zm<<16)|(pg<<10)|(xb<<5)|!{opv})
PRFB !{opt},pg,[xb,zm.D,SXTW] :: .call w4(0xc4600000|(zm<<16)|(pg<<10)|(xb<<5)|!{opv})
PRFB !{opt},pg,[xb,zm.D] :: .call w4(0xc4608000|(zm<<16)|(pg<<10)|(xb<<5)|!{opv})
}
!def svprfall(opt, opv) {
!svprf("B", 0, "xm", 1, opt, opv)
!svprf("H", 1, "xm,LSL #1", 2, opt, opv)
!svprf("W", 2, "xm,LSL #2", 4, opt, opv)
!svprf("D", 3, "xm,LSL #3", 8, opt, opv)
!svprfx("H", 1, opt, opv)
!svprfx("W", 2, opt, opv)
!svprfx("D", 3, opt, opv)
!svprfb(opt, opv)
}
!svprfall("svp", "(svp<8?svp:svp-8)")
!svprfall("#!p", "(p&0xf)")

/* -------------------------------------------------------------------
/* SVE2.
/* ------------------------------------------------------------------- */

/* Unpredicated multiplies join the integer binary group */
!sv3u("MUL", 0x18)
!sv3u("SMULH", 0x1a)
!sv3u("UMULH", 0x1b)
!sv3u("SQDMULH", 0x1c)
!sv3u("SQRDMULH", 0x1d)
PMUL zd.B,zn.B,zm.B :: .call w4(0x04206400|(zm<<16)|(zn<<5)|zd)

/* Shift by immediate, predicated -- the SVE2 additions */
!svshp("SQSHL", 6, 0)
!svshp("UQSHL", 7, 0)
!svshp("SRSHR", 0xc, 1)
!svshp("URSHR", 0xd, 1)
!svshp("SQSHLU", 0xf, 0)

/* Integer binary, predicated and destructive.
/*   01000100 size 0 opc 100 Pg Zm Zdn */
!def sv2bp1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.!{el} :: .call w4(0x44008000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
}
