!sr("RNDRRS", 3, 3, 2, 4, 1, 0)
.check::sysr::!{SRR}
.check::sysw::!{SRW}

MRS xt,sysr :: .call w4(0xd5300000|(sysr<<5)|xt)
MSR sysw,xt :: .call w4(0xd5100000|(sysw<<5)|xt)
MRS xt,S!S{{sop0}}a\_!S{{sd8}}b\_C!S{{sd16}}c\_C!S{{sd16}}e\_!S{{sd8}}f :: .call w4(0xd5300000|((a-2)<<19)|(b<<16)|(c<<12)|(e<<8)|(f<<5)|xt)
MSR S!S{{sop0}}a\_!S{{sd8}}b\_C!S{{sd16}}c\_C!S{{sd16}}e\_!S{{sd8}}f,xt :: .call w4(0xd5100000|((a-2)<<19)|(b<<16)|(c<<12)|(e<<8)|(f<<5)|xt)

/* Digit tables for the generic system-register spelling. Each "_"
/* between the fields is written "\_" in the pattern above: a bare
/* "_" right after a capture would be taken as part of the variable
/* name, since "_" is a variable-name character, and the separator
/* would vanish. The escape ends the name and matches the underscore
/* literally (Technical_Manual.md section 3.12). */
!def dtab(nm, lo, hi) {
.sub::!{nm}
!local i = hi
!while i >= lo {
!{i}::!{i}
!set i = i - 1
}
.return
}
!dtab("sop0", 2, 3)
!dtab("sd8", 0, 7)
!dtab("sd16", 0, 15)

/* SYS, SYSL and the cache/TLB aliases built on them */
!def crreg(n) {
.setsym::C!{n}::!{n}
}
!local i = 0
!while i <= 15 {
!crreg(i)
!set i = i + 1
}
.setsym::CRS::C0,C1,C2,C3,C4,C5,C6,C7,C8,C9,C10,C11,C12,C13,C14,C15
.check::crn::CRS
.check::crm::CRS

SYS #!p,crn,crm,#!q ::p<0;3,p>7;3,q<0;3,q>7;3 :: .call w4(0xd5080000|(p<<16)|(crn<<12)|(crm<<8)|(q<<5)|31)
SYS #!p,crn,crm,#!q,xt ::p<0;3,p>7;3,q<0;3,q>7;3 :: .call w4(0xd5080000|(p<<16)|(crn<<12)|(crm<<8)|(q<<5)|xt)
SYSL xt,#!p,crn,crm,#!q ::p<0;3,p>7;3,q<0;3,q>7;3 :: .call w4(0xd5280000|(p<<16)|(crn<<12)|(crm<<8)|(q<<5)|xt)

/* Named cache, address-translation and TLB operations. Each name
/* holds op1:CRn:CRm:op2 packed four bits per field. */
!def sysop(nm, op1, crn, crm, op2) {
.setsym::!{nm}::!{(op1 << 12) | (crn << 8) | (crm << 4) | op2}
}
/* Two forms: an operation that names an address takes Xt, one that
/* does not takes none. They are kept in separate .check lists so that
/* the wrong shape is rejected. */
!def sysins0(mn, vr) {
!{mn} !{vr} :: .call w4(0xd5080000|((!{vr}>>12)<<16)|(((!{vr}>>8)&15)<<12)|(((!{vr}>>4)&15)<<8)|((!{vr}&7)<<5)|31)
}
!def sysins1(mn, vr) {
!{mn} !{vr},xt :: .call w4(0xd5080000|((!{vr}>>12)<<16)|(((!{vr}>>8)&15)<<12)|(((!{vr}>>4)&15)<<8)|((!{vr}&7)<<5)|xt)
}
!sysop("IALLUIS", 0, 7, 1, 0)
!sysop("IALLU", 0, 7, 5, 0)
!sysop("IVAU", 3, 7, 5, 1)
.check::icop0::IALLUIS,IALLU
.check::icop1::IVAU
!sysins0("IC", "icop0")
!sysins1("IC", "icop1")

!sysop("IVAC", 0, 7, 6, 1)
!sysop("ISW", 0, 7, 6, 2)
!sysop("CSW", 0, 7, 10, 2)
!sysop("CISW", 0, 7, 14, 2)
!sysop("ZVA", 3, 7, 4, 1)
!sysop("CVAC", 3, 7, 10, 1)
!sysop("CVAU", 3, 7, 11, 1)
!sysop("CVAP", 3, 7, 12, 1)
!sysop("CIVAC", 3, 7, 14, 1)
.check::dcop1::IVAC,ISW,CSW,CISW,ZVA,CVAC,CVAU,CVAP,CIVAC
!sysins1("DC", "dcop1")

!sysop("S1E1R", 0, 7, 8, 0)
!sysop("S1E1W", 0, 7, 8, 1)
!sysop("S1E0R", 0, 7, 8, 2)
!sysop("S1E0W", 0, 7, 8, 3)
!sysop("S1E2R", 4, 7, 8, 0)
!sysop("S1E2W", 4, 7, 8, 1)
!sysop("S12E1R", 4, 7, 8, 4)
!sysop("S12E1W", 4, 7, 8, 5)
!sysop("S12E0R", 4, 7, 8, 6)
!sysop("S12E0W", 4, 7, 8, 7)
!sysop("S1E3R", 6, 7, 8, 0)
!sysop("S1E3W", 6, 7, 8, 1)
.check::atop1::S1E1R,S1E1W,S1E0R,S1E0W,S1E2R,S1E2W,S12E1R,S12E1W,S12E0R,S12E0W,S1E3R,S1E3W
!sysins1("AT", "atop1")

!sysop("VMALLE1IS", 0, 8, 3, 0)
!sysop("VAE1IS", 0, 8, 3, 1)
!sysop("ASIDE1IS", 0, 8, 3, 2)
!sysop("VAAE1IS", 0, 8, 3, 3)
!sysop("VALE1IS", 0, 8, 3, 5)
!sysop("VAALE1IS", 0, 8, 3, 7)
!sysop("VMALLE1", 0, 8, 7, 0)
!sysop("VAE1", 0, 8, 7, 1)
!sysop("ASIDE1", 0, 8, 7, 2)
!sysop("VAAE1", 0, 8, 7, 3)
!sysop("VALE1", 0, 8, 7, 5)
!sysop("VAALE1", 0, 8, 7, 7)
!sysop("ALLE1IS", 4, 8, 3, 4)
!sysop("ALLE2IS", 4, 8, 3, 0)
!sysop("ALLE3IS", 6, 8, 3, 0)
!sysop("ALLE1", 4, 8, 7, 4)
!sysop("ALLE2", 4, 8, 7, 0)
!sysop("ALLE3", 6, 8, 7, 0)
!sysop("VMALLS12E1IS", 4, 8, 3, 6)
!sysop("VMALLS12E1", 4, 8, 7, 6)
.check::tlbiop0::VMALLE1IS,VMALLE1,ALLE1IS,ALLE2IS,ALLE3IS,ALLE1,ALLE2,ALLE3,VMALLS12E1IS,VMALLS12E1
.check::tlbiop1::VAE1IS,ASIDE1IS,VAAE1IS,VALE1IS,VAALE1IS,VAE1,ASIDE1,VAAE1,VALE1,VAALE1
!sysins0("TLBI", "tlbiop0")
!sysins1("TLBI", "tlbiop1")

/* ===================================================================
/* Loads and stores
/* =================================================================== */
.check::rs::WR,WZR

/* Load/store register. Eleven rows per access size cover the whole
/* addressing repertoire: base with an optional offset (the mini
/* language picks the scaled or the unscaled encoding), pre- and
/* post-index, and the four register-offset extends. The "\!" in the
/* pre-index row escapes axx's own capture sigil so that it matches a
/* literal "!". */
!def lsreg(mn, rt, size, v, opc, scale) {
!{mn} !{rt},[xb[[,#!o]]] :: .call lsoff(!{size},!{v},!{opc},o,xb,!{rt},!{scale})
!{mn} !{rt},[xb,#!o]\! ::o<-256;8,o>255;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|((o&0x1ff)<<12)|(3<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb],#!o ::o<-256;8,o>255;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|((o&0x1ff)<<12)|(1<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(3<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm,LSL #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(3<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm,SXTX] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(7<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm,SXTX #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(7<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,UXTW] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(2<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,UXTW #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(2<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,SXTW] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(6<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,SXTW #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(6<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
}
!lsreg("STRB", "wt", 0, 0, 0, 0)
!lsreg("LDRB", "wt", 0, 0, 1, 0)
!lsreg("LDRSB", "xt", 0, 0, 2, 0)
!lsreg("LDRSB", "wt", 0, 0, 3, 0)
!lsreg("STRH", "wt", 1, 0, 0, 1)
!lsreg("LDRH", "wt", 1, 0, 1, 1)
!lsreg("LDRSH", "xt", 1, 0, 2, 1)
!lsreg("LDRSH", "wt", 1, 0, 3, 1)
!lsreg("STR", "wt", 2, 0, 0, 2)
!lsreg("LDR", "wt", 2, 0, 1, 2)
!lsreg("LDRSW", "xt", 2, 0, 2, 2)
!lsreg("STR", "xt", 3, 0, 0, 3)
!lsreg("LDR", "xt", 3, 0, 1, 3)
!lsreg("PRFM", "prf", 3, 0, 2, 3)
!lsreg("STR", "fb", 0, 1, 0, 0)
!lsreg("LDR", "fb", 0, 1, 1, 0)
!lsreg("STR", "fq", 0, 1, 2, 4)
!lsreg("LDR", "fq", 0, 1, 3, 4)
!lsreg("STR", "fh", 1, 1, 0, 1)
!lsreg("LDR", "fh", 1, 1, 1, 1)
!lsreg("STR", "fs", 2, 1, 0, 2)
!lsreg("LDR", "fs", 2, 1, 1, 2)
!lsreg("STR", "ff", 3, 1, 0, 3)
!lsreg("LDR", "ff", 3, 1, 1, 3)

/* Unscaled offset: the same encoding lsoff falls back to, reached by
/* its own mnemonic so that it can be asked for explicitly. */
!def lsur(mn, rt, size, v, opc) {
!{mn} !{rt},[xb[[,#!o]]] ::o<-256;8,o>255;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|((o&0x1ff)<<12)|(xb<<5)|!{rt})
}
!lsur("STURB", "wt", 0, 0, 0)
!lsur("LDURB", "wt", 0, 0, 1)
!lsur("LDURSB", "xt", 0, 0, 2)
!lsur("LDURSB", "wt", 0, 0, 3)
!lsur("STURH", "wt", 1, 0, 0)
!lsur("LDURH", "wt", 1, 0, 1)
!lsur("LDURSH", "xt", 1, 0, 2)
!lsur("LDURSH", "wt", 1, 0, 3)
!lsur("STUR", "wt", 2, 0, 0)
!lsur("LDUR", "wt", 2, 0, 1)
!lsur("LDURSW", "xt", 2, 0, 2)
!lsur("STUR", "xt", 3, 0, 0)
!lsur("LDUR", "xt", 3, 0, 1)
!lsur("PRFUM", "prf", 3, 0, 2)
!lsur("STUR", "fb", 0, 1, 0)
!lsur("LDUR", "fb", 0, 1, 1)
!lsur("STUR", "fq", 0, 1, 2)
!lsur("LDUR", "fq", 0, 1, 3)
!lsur("STUR", "fh", 1, 1, 0)
!lsur("LDUR", "fh", 1, 1, 1)
!lsur("STUR", "fs", 2, 1, 0)
!lsur("LDUR", "fs", 2, 1, 1)
!lsur("STUR", "ff", 3, 1, 0)
!lsur("LDUR", "ff", 3, 1, 1)

/* Load register (literal) */
!def lslit(mn, rt, opc, v) {
!{mn} !{rt},!t ::((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4((!{opc}<<30)|(3<<27)|(!{v}<<26)|((((t-$$)>>2)&0x7ffff)<<5)|!{rt})
}
!lslit("LDR", "wt", 0, 0)
!lslit("LDR", "xt", 1, 0)
!lslit("LDRSW", "xt", 2, 0)
!lslit("PRFM", "prf", 3, 0)
!lslit("LDR", "fs", 0, 1)
!lslit("LDR", "ff", 1, 1)
!lslit("LDR", "fq", 2, 1)

/* PRFM also accepts the raw 5-bit prefetch operand in place of a name */
PRFM #!p,[xb[[,#!o]]] ::p<0;3,p>31;3 :: .call lsoff(3,0,2,o,xb,p,3)
PRFM #!p,[xb,xm[[,LSL #!a]]] ::p<0;3,p>31;3,(a!=0)&&(a!=3);10 :: .call w4((3<<30)|(7<<27)|(2<<22)|(1<<21)|(xm<<16)|(3<<13)|((a==3?1:0)<<12)|(2<<10)|(xb<<5)|p)
PRFM #!p,!t ::p<0;3,p>31;3,((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4((3<<30)|(3<<27)|((((t-$$)>>2)&0x7ffff)<<5)|p)
PRFUM #!p,[xb[[,#!o]]] ::p<0;3,p>31;3,o<-256;8,o>255;8 :: .call w4((3<<30)|(7<<27)|(2<<22)|((o&0x1ff)<<12)|(xb<<5)|p)

/* Load/store pair. sh is the log2 of the access size, so the scaled
/* offset is a shift rather than a division. */
!def lspair(mn, l, rt, ru, opc, v, sh) {
!{mn} !{rt},!{ru},[xb[[,#!o]]] ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(2<<23)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
!{mn} !{rt},!{ru},[xb,#!o]\! ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(3<<23)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
!{mn} !{rt},!{ru},[xb],#!o ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(1<<23)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
}
!lspair("STP", 0, "wt", "wu", 0, 0, 2)
!lspair("LDP", 1, "wt", "wu", 0, 0, 2)
!lspair("LDPSW", 1, "xt", "xu", 1, 0, 2)
!lspair("STP", 0, "xt", "xu", 2, 0, 3)
!lspair("LDP", 1, "xt", "xu", 2, 0, 3)
!lspair("STP", 0, "fs", "fsn", 0, 1, 2)
!lspair("LDP", 1, "fs", "fsn", 0, 1, 2)
!lspair("STP", 0, "ff", "fdn", 1, 1, 3)
!lspair("LDP", 1, "ff", "fdn", 1, 1, 3)
!lspair("STP", 0, "fq", "fqn", 2, 1, 4)
!lspair("LDP", 1, "fq", "fqn", 2, 1, 4)

/* Load/store no-allocate pair (offset form only) */
!def lsnp(mn, l, rt, ru, opc, v, sh) {
!{mn} !{rt},!{ru},[xb[[,#!o]]] ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
}
!lsnp("STNP", 0, "wt", "wu", 0, 0, 2)
!lsnp("LDNP", 1, "wt", "wu", 0, 0, 2)
!lsnp("STNP", 0, "xt", "xu", 2, 0, 3)
!lsnp("LDNP", 1, "xt", "xu", 2, 0, 3)
!lsnp("STNP", 0, "fs", "fsn", 0, 1, 2)
!lsnp("LDNP", 1, "fs", "fsn", 0, 1, 2)
!lsnp("STNP", 0, "ff", "fdn", 1, 1, 3)
!lsnp("LDNP", 1, "ff", "fdn", 1, 1, 3)
!lsnp("STNP", 0, "fq", "fqn", 2, 1, 4)
!lsnp("LDNP", 1, "fq", "fqn", 2, 1, 4)

/* Load/store exclusive and the acquire-release pairs */
!def stex(mn, size, o2, o0, rt) {
!{mn} rs,!{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(!{o2}<<23)|(!{o0}<<15)|(rs<<16)|(31<<10)|(xb<<5)|!{rt})
}
!def ldex(mn, size, o2, o0, rt) {
!{mn} !{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(!{o2}<<23)|(1<<22)|(31<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
}
!def strl(mn, size, o0, rt) {
!{mn} !{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<23)|(31<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
}
!def exgrp(sfx, size, rt) {
!stex("STXR" + sfx, size, 0, 0, rt)
!stex("STLXR" + sfx, size, 0, 1, rt)
!ldex("LDXR" + sfx, size, 0, 0, rt)
!ldex("LDAXR" + sfx, size, 0, 1, rt)
!strl("STLLR" + sfx, size, 0, rt)
!strl("STLR" + sfx, size, 1, rt)
!ldex("LDLAR" + sfx, size, 1, 0, rt)
!ldex("LDAR" + sfx, size, 1, 1, rt)
}
!exgrp("B", 0, "wt")
!exgrp("H", 1, "wt")
!exgrp("", 2, "wt")
!exgrp("", 3, "xt")

/* Load/store exclusive pair */
!def expair(sfx, size, rt, ru) {
STXP!{sfx} rs,!{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<21)|(rs<<16)|(!{ru}<<10)|(xb<<5)|!{rt})
STLXP!{sfx} rs,!{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<21)|(rs<<16)|(1<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
LDXP!{sfx} !{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<22)|(1<<21)|(31<<16)|(!{ru}<<10)|(xb<<5)|!{rt})
LDAXP!{sfx} !{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<22)|(1<<21)|(31<<16)|(1<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
}
!expair("", 2, "wt", "wu")
!expair("", 3, "xt", "xu")

/* Compare and swap (FEAT_LSE) */
!def casgrp(sfx, size, rt, rr) {
!local ai = 0
!local nm = ""
!local l = 0
!local o0 = 0
!while ai <= 3 {
!set nm = ai == 0 ? "CAS" : (ai == 1 ? "CASA" : (ai == 2 ? "CASL" : "CASAL"))
!set l = (ai == 1 || ai == 3) ? 1 : 0
!set o0 = (ai >= 2) ? 1 : 0
!{nm}!{sfx} !{rr},!{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<23)|(!{l}<<22)|(1<<21)|(!{rr}<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
!set ai = ai + 1
}
}
!casgrp("B", 0, "wt", "wm")
!casgrp("H", 1, "wt", "wm")
!casgrp("", 2, "wt", "wm")
!casgrp("", 3, "xt", "xm")

/* Atomic memory operations (FEAT_LSE). Four acquire/release variants
/* times four access sizes for each operation, generated rather than
/* written out. */
!def atomop(base, opc, o3) {
!local si = 0
!local sfx = ""
!local rt = ""
!local rr = ""
!local ai = 0
!local ar = ""
!local a = 0
!local r = 0
!while si <= 3 {
!set sfx = si == 0 ? "B" : (si == 1 ? "H" : "")
!set rt = si == 3 ? "xt" : "wt"
!set rr = si == 3 ? "xm" : "wm"
!set ai = 0
!while ai <= 3 {
!set ar = ai == 0 ? "" : (ai == 1 ? "A" : (ai == 2 ? "L" : "AL"))
!set a = (ai == 1 || ai == 3) ? 1 : 0
!set r = ai >= 2 ? 1 : 0
!{base}!{ar}!{sfx} !{rr},!{rt},[xb] :: .call w4((!{si}<<30)|(7<<27)|(!{a}<<23)|(!{r}<<22)|(1<<21)|(!{rr}<<16)|(!{o3}<<15)|(!{opc}<<12)|(xb<<5)|!{rt})
!set ai = ai + 1
}
!set si = si + 1
}
}
!atomop("LDADD", 0, 0)
!atomop("LDCLR", 1, 0)
!atomop("LDEOR", 2, 0)
!atomop("LDSET", 3, 0)
!atomop("LDSMAX", 4, 0)
!atomop("LDSMIN", 5, 0)
!atomop("LDUMAX", 6, 0)
!atomop("LDUMIN", 7, 0)
!atomop("SWP", 0, 1)

/* The ST<op> aliases discard the loaded value, so Rt is the zero
/* register and only the release variant exists. */
!def statomop(base, opc) {
!local si = 0
!local sfx = ""
!local rr = ""
!local ai = 0
!local ar = ""
!local r = 0
!while si <= 3 {
!set sfx = si == 0 ? "B" : (si == 1 ? "H" : "")
!set rr = si == 3 ? "xm" : "wm"
!set ai = 0
!while ai <= 1 {
!set ar = ai == 0 ? "" : "L"
!set r = ai
!{base}!{ar}!{sfx} !{rr},[xb] :: .call w4((!{si}<<30)|(7<<27)|(!{r}<<22)|(1<<21)|(!{rr}<<16)|(!{opc}<<12)|(xb<<5)|31)
!set ai = ai + 1
}
!set si = si + 1
}
}
!statomop("STADD", 0)
!statomop("STCLR", 1)
!statomop("STEOR", 2)
!statomop("STSET", 3)
!statomop("STSMAX", 4)
!statomop("STSMIN", 5)
!statomop("STUMAX", 6)
!statomop("STUMIN", 7)

/* ===================================================================
/* Scalar floating point
/*
/* ptype is 00 for single, 01 for double and 11 for half precision;
/* each group below is written once and instantiated for all three.
/* =================================================================== */

/* Data processing (1 source) */
!def fpdp1(nm, opc, pt, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{opc}<<15)|(0x10<<10)|(!{rn}<<5)|!{rd})
}
!def fp1all(nm, opc) {
!fpdp1(nm, opc, 0, "fsd", "fsn")
!fpdp1(nm, opc, 1, "fdd", "fdn")
!fpdp1(nm, opc, 3, "fhd", "fhn")
}
!fp1all("FMOV", 0)
!fp1all("FABS", 1)
!fp1all("FNEG", 2)
!fp1all("FSQRT", 3)
!fp1all("FRINTN", 8)
!fp1all("FRINTP", 9)
!fp1all("FRINTM", 10)
!fp1all("FRINTZ", 11)
!fp1all("FRINTA", 12)
!fp1all("FRINTX", 14)
!fp1all("FRINTI", 15)

/* FCVT: ptype is the source type, the opcode carries the destination */
!fpdp1("FCVT", 4, 1, "fsd", "fdn")
!fpdp1("FCVT", 4, 3, "fsd", "fhn")
!fpdp1("FCVT", 5, 0, "fdd", "fsn")
!fpdp1("FCVT", 5, 3, "fdd", "fhn")
!fpdp1("FCVT", 7, 0, "fhd", "fsn")
!fpdp1("FCVT", 7, 1, "fhd", "fdn")

/* Data processing (2 source) */
!def fpdp2(nm, opc, pt, rd, rn, rm) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(!{opc}<<12)|(2<<10)|(!{rn}<<5)|!{rd})
}
!def fp2all(nm, opc) {
!fpdp2(nm, opc, 0, "fsd", "fsn", "fsm")
!fpdp2(nm, opc, 1, "fdd", "fdn", "fdm")
!fpdp2(nm, opc, 3, "fhd", "fhn", "fhm")
}
!fp2all("FMUL", 0)
!fp2all("FDIV", 1)
!fp2all("FADD", 2)
!fp2all("FSUB", 3)
!fp2all("FMAX", 4)
!fp2all("FMIN", 5)
!fp2all("FMAXNM", 6)
!fp2all("FMINNM", 7)
!fp2all("FNMUL", 8)

/* Data processing (3 source) */
!def fpdp3(nm, o1, o0, pt, rd, rn, rm, ra) {
!{nm} !{rd},!{rn},!{rm},!{ra} :: .call w4((0x1f<<24)|(!{pt}<<22)|(!{o1}<<21)|(!{rm}<<16)|(!{o0}<<15)|(!{ra}<<10)|(!{rn}<<5)|!{rd})
}
!def fp3all(nm, o1, o0) {
!fpdp3(nm, o1, o0, 0, "fsd", "fsn", "fsm", "fsa")
!fpdp3(nm, o1, o0, 1, "fdd", "fdn", "fdm", "fda")
!fpdp3(nm, o1, o0, 3, "fhd", "fhn", "fhm", "fha")
}
!fp3all("FMADD", 0, 0)
!fp3all("FMSUB", 0, 1)
!fp3all("FNMADD", 1, 0)
!fp3all("FNMSUB", 1, 1)

/* Compare */
!def fpcmp(nm, o2, pt, rn, rm) {
!{nm} !{rn},!{rm} :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(8<<10)|(!{rn}<<5)|!{o2})
!{nm} !{rn},#0.0 :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(8<<10)|(!{rn}<<5)|!{o2+8})
!{nm} !{rn},#0 :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(8<<10)|(!{rn}<<5)|!{o2+8})
}
!fpcmp("FCMP", 0, 0, "fsn", "fsm")
!fpcmp("FCMP", 0, 1, "fdn", "fdm")
!fpcmp("FCMP", 0, 3, "fhn", "fhm")
!fpcmp("FCMPE", 16, 0, "fsn", "fsm")
!fpcmp("FCMPE", 16, 1, "fdn", "fdm")
!fpcmp("FCMPE", 16, 3, "fhn", "fhm")

/* Conditional compare and conditional select */
!def fpccmp(nm, op, pt, rn, rm) {
!{nm} !{rn},!{rm},#!f,cnd ::f<0;3,f>15;3 :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(cnd<<12)|(1<<10)|(!{rn}<<5)|(!{op}<<4)|f)
}
!fpccmp("FCCMP", 0, 0, "fsn", "fsm")
!fpccmp("FCCMP", 0, 1, "fdn", "fdm")
!fpccmp("FCCMP", 0, 3, "fhn", "fhm")
!fpccmp("FCCMPE", 1, 0, "fsn", "fsm")
!fpccmp("FCCMPE", 1, 1, "fdn", "fdm")
!fpccmp("FCCMPE", 1, 3, "fhn", "fhm")

!def fpcsel(pt, rd, rn, rm) {
FCSEL !{rd},!{rn},!{rm},cnd :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(cnd<<12)|(3<<10)|(!{rn}<<5)|!{rd})
}
!fpcsel(0, "fsd", "fsn", "fsm")
!fpcsel(1, "fdd", "fdn", "fdm")
!fpcsel(3, "fhd", "fhn", "fhm")

/* Floating point to integer */
!def f2i(nm, rmode, opc, sf, pt, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rmode}<<19)|(!{opc}<<16)|(!{rn}<<5)|!{rd})
}
!def f2iall(nm, rmode, opc) {
!f2i(nm, rmode, opc, 0, 0, "wd", "fsn")
!f2i(nm, rmode, opc, 1, 0, "xd", "fsn")
!f2i(nm, rmode, opc, 0, 1, "wd", "fdn")
!f2i(nm, rmode, opc, 1, 1, "xd", "fdn")
!f2i(nm, rmode, opc, 0, 3, "wd", "fhn")
!f2i(nm, rmode, opc, 1, 3, "xd", "fhn")
}
!f2iall("FCVTNS", 0, 0)
!f2iall("FCVTNU", 0, 1)
!f2iall("FCVTAS", 0, 4)
!f2iall("FCVTAU", 0, 5)
!f2iall("FCVTPS", 1, 0)
!f2iall("FCVTPU", 1, 1)
!f2iall("FCVTMS", 2, 0)
!f2iall("FCVTMU", 2, 1)
!f2iall("FCVTZS", 3, 0)
!f2iall("FCVTZU", 3, 1)

/* Integer to floating point */
!def i2f(nm, opc, sf, pt, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{opc}<<16)|(!{rn}<<5)|!{rd})
}
!def i2fall(nm, opc) {
!i2f(nm, opc, 0, 0, "fsd", "wn")
!i2f(nm, opc, 1, 0, "fsd", "xn")
!i2f(nm, opc, 0, 1, "fdd", "wn")
!i2f(nm, opc, 1, 1, "fdd", "xn")
!i2f(nm, opc, 0, 3, "fhd", "wn")
!i2f(nm, opc, 1, 3, "fhd", "xn")
}
!i2fall("SCVTF", 2)
!i2fall("UCVTF", 3)

/* FMOV between a general register and a floating-point register */
!f2i("FMOV", 0, 6, 0, 0, "wd", "fsn")
!i2f("FMOV", 7, 0, 0, "fsd", "wn")
!f2i("FMOV", 0, 6, 1, 1, "xd", "fdn")
!i2f("FMOV", 7, 1, 1, "fdd", "xn")
!f2i("FMOV", 0, 6, 0, 3, "wd", "fhn")
!i2f("FMOV", 7, 0, 3, "fhd", "wn")
!f2i("FMOV", 0, 6, 1, 3, "xd", "fhn")
!i2f("FMOV", 7, 1, 3, "fhd", "xn")

/* FMOV (immediate). The operand is captured as a binary64 bit
/* pattern and fmovi reduces it to the 8-bit field, reporting an
/* error for any value A64 cannot spell. */
FMOV fsd,#!Dv :: .call fmovi(v,0,fsd)
FMOV fdd,#!Dv :: .call fmovi(v,1,fdd)
FMOV fhd,#!Dv :: .call fmovi(v,3,fhd)

/* Fixed-point conversions. The same encoding as the integer ones with
/* bit 21 clear, and the scale field holding 64 minus the fraction
/* width. */
!def f2ifx(nm, rmode, opc, sf, pt, rd, rn, mx) {
!{nm} !{rd},!{rn},#!c ::c<1;3,c>!{mx};3 :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(!{rmode}<<19)|(!{opc}<<16)|((64-c)<<10)|(!{rn}<<5)|!{rd})
}
!def i2ffx(nm, opc, sf, pt, rd, rn, mx) {
!{nm} !{rd},!{rn},#!c ::c<1;3,c>!{mx};3 :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(!{opc}<<16)|((64-c)<<10)|(!{rn}<<5)|!{rd})
}
!def fxall(nm, rmode, opc, dir) {
!if dir == 0 !then {
!f2ifx(nm, rmode, opc, 0, 0, "wd", "fsn", 32)
!f2ifx(nm, rmode, opc, 1, 0, "xd", "fsn", 64)
!f2ifx(nm, rmode, opc, 0, 1, "wd", "fdn", 32)
!f2ifx(nm, rmode, opc, 1, 1, "xd", "fdn", 64)
!f2ifx(nm, rmode, opc, 0, 3, "wd", "fhn", 32)
!f2ifx(nm, rmode, opc, 1, 3, "xd", "fhn", 64)
} !else {
!i2ffx(nm, opc, 0, 0, "fsd", "wn", 32)
!i2ffx(nm, opc, 1, 0, "fsd", "xn", 64)
!i2ffx(nm, opc, 0, 1, "fdd", "wn", 32)
!i2ffx(nm, opc, 1, 1, "fdd", "xn", 64)
!i2ffx(nm, opc, 0, 3, "fhd", "wn", 32)
!i2ffx(nm, opc, 1, 3, "fhd", "xn", 64)
}
}
!fxall("FCVTZS", 3, 0, 0)
!fxall("FCVTZU", 3, 1, 0)
!fxall("SCVTF", 0, 2, 1)
!fxall("UCVTF", 0, 3, 1)

/* Load-acquire RCpc register (FEAT_LRCPC) */
!def ldapr(mn, size, rt) {
!{mn} !{rt},[xb] :: .call w4((!{size}<<30)|(7<<27)|(1<<23)|(1<<21)|(31<<16)|(1<<15)|(4<<12)|(xb<<5)|!{rt})
}
!ldapr("LDAPRB", 0, "wt")
!ldapr("LDAPRH", 1, "wt")
!ldapr("LDAPR", 2, "wt")
!ldapr("LDAPR", 3, "xt")

/* Compare and swap pair (FEAT_LSE). Rs and Rt each name the first of
/* an even-numbered pair. */
!def caspgrp(sz, rt, ru, rr, rv) {
!local ai = 0
!local nm = ""
!local l = 0
!local o0 = 0
!while ai <= 3 {
!set nm = ai == 0 ? "CASP" : (ai == 1 ? "CASPA" : (ai == 2 ? "CASPL" : "CASPAL"))
!set l = (ai == 1 || ai == 3) ? 1 : 0
!set o0 = (ai >= 2) ? 1 : 0
!{nm} !{rr},!{rv},!{rt},!{ru},[xb] ::(!{rr}&1)!=0;5,(!{rt}&1)!=0;5 :: .call w4((!{sz}<<30)|(8<<24)|(!{l}<<22)|(1<<21)|(!{rr}<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
!set ai = ai + 1
}
}
!caspgrp(0, "wt", "wu", "wm", "wn")
!caspgrp(1, "xt", "xu", "xm", "xn")

/* ===================================================================
/* Advanced SIMD -- vector registers
/*
/* A V register is written as a symbol followed by its arrangement,
/* and the arrangement is literal text in the pattern: "vd.16B" takes
/* the register number through the symbol vd and fixes Q and size
/* through the two characters after the dot. The symbol matcher stops
/* at the ".", because "." is not a symbol character, so one row per
/* arrangement is all it takes.
/* =================================================================== */
!gpr("V", 31)
!rset("VR", "V", 31)
.check::vd::VR
.check::vn::VR
.check::vm::VR
.check::va::VR

/* Three same (integer).
/*   0 Q U 01110 size 1 Rm opcode 1 Rn Rd
/* The four arrangement sets differ only in which element widths the
/* operation is defined for: "b" adds 2D, "h" is the 16/32-bit-only
/* group, and "o" is the byte-only group. */
!def v3one(nm, u, opc, ar, q, sz) {
!{nm} vd.!{ar},vn.!{ar},vm.!{ar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(1<<21)|(vm<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def v3(nm, u, opc, set) {
!if set != 2 !then {
!if set != 1 !then {
!v3one(nm, u, opc, "8B", 0, 0)
!v3one(nm, u, opc, "16B", 1, 0)
}
!v3one(nm, u, opc, "4H", 0, 1)
!v3one(nm, u, opc, "8H", 1, 1)
!v3one(nm, u, opc, "2S", 0, 2)
!v3one(nm, u, opc, "4S", 1, 2)
!if set == 3 !then {
!v3one(nm, u, opc, "2D", 1, 3)
}
} !else {
!v3one(nm, u, opc, "8B", 0, 0)
!v3one(nm, u, opc, "16B", 1, 0)
}
}
/* set: 0 = B/H/S, 1 = H/S only, 2 = B only, 3 = B/H/S/D */
!v3("SHADD", 0, 0x00, 0)
!v3("UHADD", 1, 0x00, 0)
!v3("SQADD", 0, 0x01, 3)
!v3("UQADD", 1, 0x01, 3)
!v3("SRHADD", 0, 0x02, 0)
!v3("URHADD", 1, 0x02, 0)
!v3("SHSUB", 0, 0x04, 0)
!v3("UHSUB", 1, 0x04, 0)
!v3("SQSUB", 0, 0x05, 3)
!v3("UQSUB", 1, 0x05, 3)
!v3("CMGT", 0, 0x06, 3)
!v3("CMHI", 1, 0x06, 3)
!v3("CMGE", 0, 0x07, 3)
!v3("CMHS", 1, 0x07, 3)
!v3("SSHL", 0, 0x08, 3)
!v3("USHL", 1, 0x08, 3)
!v3("SQSHL", 0, 0x09, 3)
!v3("UQSHL", 1, 0x09, 3)
!v3("SRSHL", 0, 0x0a, 3)
!v3("URSHL", 1, 0x0a, 3)
!v3("SQRSHL", 0, 0x0b, 3)
!v3("UQRSHL", 1, 0x0b, 3)
!v3("SMAX", 0, 0x0c, 0)
!v3("UMAX", 1, 0x0c, 0)
!v3("SMIN", 0, 0x0d, 0)
!v3("UMIN", 1, 0x0d, 0)
!v3("SABD", 0, 0x0e, 0)
!v3("UABD", 1, 0x0e, 0)
!v3("SABA", 0, 0x0f, 0)
!v3("UABA", 1, 0x0f, 0)
!v3("ADD", 0, 0x10, 3)
!v3("SUB", 1, 0x10, 3)
!v3("CMTST", 0, 0x11, 3)
!v3("CMEQ", 1, 0x11, 3)
!v3("MLA", 0, 0x12, 0)
!v3("MLS", 1, 0x12, 0)
!v3("MUL", 0, 0x13, 0)
!v3("PMUL", 1, 0x13, 2)
!v3("SMAXP", 0, 0x14, 0)
!v3("UMAXP", 1, 0x14, 0)
!v3("SMINP", 0, 0x15, 0)
!v3("UMINP", 1, 0x15, 0)
!v3("SQDMULH", 0, 0x16, 1)
!v3("SQRDMULH", 1, 0x16, 1)
!v3("ADDP", 0, 0x17, 3)
/* Three same extra: the same layout with bit 21 clear */
!def v3xone(nm, u, opc, ar, q, sz) {
!{nm} vd.!{ar},vn.!{ar},vm.!{ar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(vm<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def v3x(nm, u, opc) {
!v3xone(nm, u, opc, "4H", 0, 1)
!v3xone(nm, u, opc, "8H", 1, 1)
!v3xone(nm, u, opc, "2S", 0, 2)
!v3xone(nm, u, opc, "4S", 1, 2)
}
!v3x("SQRDMLAH", 1, 0x10)
!v3x("SQRDMLSH", 1, 0x11)

/* Three same (logical). The size field selects the operation rather
/* than an element width, so these are byte arrangements only. */
!def v3l(nm, u, sz) {
!v3one(nm, u, 0x03, "8B", 0, sz)
!v3one(nm, u, 0x03, "16B", 1, sz)
}
!v3l("AND", 0, 0)
!v3l("BIC", 0, 1)
!v3l("ORR", 0, 2)
!v3l("ORN", 0, 3)
!v3l("EOR", 1, 0)
!v3l("BSL", 1, 1)
!v3l("BIT", 1, 2)
!v3l("BIF", 1, 3)
/* MOV is ORR with the two source operands the same register */
MOV vd.8B,vn.8B :: .call w4((0x0e<<24)|(2<<22)|(1<<21)|(vn<<16)|(3<<11)|(1<<10)|(vn<<5)|vd)
MOV vd.16B,vn.16B :: .call w4((1<<30)|(0x0e<<24)|(2<<22)|(1<<21)|(vn<<16)|(3<<11)|(1<<10)|(vn<<5)|vd)

/* Three same (floating point). The half-precision forms share the
/* opcode's low three bits with the single/double ones; they differ
/* by setting bit 22 and clearing bit 21. */
!def v3fone(nm, u, op, opc, ar, q, sz) {
!{nm} vd.!{ar},vn.!{ar},vm.!{ar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{op}<<23)|(!{sz}<<22)|(1<<21)|(vm<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def v3hone(nm, u, op, opc, ar, q) {
!{nm} vd.!{ar},vn.!{ar},vm.!{ar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{op}<<23)|(1<<22)|(vm<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def v3f(nm, u, op, k) {
!v3hone(nm, u, op, k, "4H", 0)
!v3hone(nm, u, op, k, "8H", 1)
!v3fone(nm, u, op, 0x18 + k, "2S", 0, 0)
!v3fone(nm, u, op, 0x18 + k, "4S", 1, 0)
!v3fone(nm, u, op, 0x18 + k, "2D", 1, 1)
}
!v3f("FMAXNM", 0, 0, 0)
!v3f("FMLA", 0, 0, 1)
!v3f("FADD", 0, 0, 2)
!v3f("FMULX", 0, 0, 3)
!v3f("FCMEQ", 0, 0, 4)
!v3f("FMAX", 0, 0, 6)
!v3f("FRECPS", 0, 0, 7)
!v3f("FMINNM", 0, 1, 0)
!v3f("FMLS", 0, 1, 1)
!v3f("FSUB", 0, 1, 2)
!v3f("FMIN", 0, 1, 6)
!v3f("FRSQRTS", 0, 1, 7)
!v3f("FMAXNMP", 1, 0, 0)
!v3f("FADDP", 1, 0, 2)
!v3f("FMUL", 1, 0, 3)
!v3f("FCMGE", 1, 0, 4)
!v3f("FACGE", 1, 0, 5)
!v3f("FMAXP", 1, 0, 6)
!v3f("FDIV", 1, 0, 7)
!v3f("FMINNMP", 1, 1, 0)
!v3f("FABD", 1, 1, 2)
!v3f("FCMGT", 1, 1, 4)
!v3f("FACGT", 1, 1, 5)
!v3f("FMINP", 1, 1, 6)

/* Two-register miscellaneous.
/*   0 Q U 01110 size 10000 opcode 10 Rn Rd
/* The half-precision rows put 11100 where the others put 10000, and
/* for the floating-point groups the two "size" bits are the group
/* selector and the precision bit rather than an element width. */
!def v2one(nm, u, sz, hi, opc, ar, q) {
!{nm} vd.!{ar},vn.!{ar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(!{hi}<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|vd)
}
!def v2zone(nm, u, sz, hi, opc, ar, q) {
!{nm} vd.!{ar},vn.!{ar},#0 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(!{hi}<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|vd)
}
/* set: 0 = B/H/S, 1 = S only, 2 = B only, 3 = B/H/S/D, 4 = B/H only */
!def v2i(nm, u, opc, set) {
!if set == 1 !then {
!v2one(nm, u, 2, 0x10, opc, "2S", 0)
!v2one(nm, u, 2, 0x10, opc, "4S", 1)
} !else {
!v2one(nm, u, 0, 0x10, opc, "8B", 0)
!v2one(nm, u, 0, 0x10, opc, "16B", 1)
!if set != 2 !then {
!v2one(nm, u, 1, 0x10, opc, "4H", 0)
!v2one(nm, u, 1, 0x10, opc, "8H", 1)
!if set != 4 !then {
!v2one(nm, u, 2, 0x10, opc, "2S", 0)
!v2one(nm, u, 2, 0x10, opc, "4S", 1)
!if set == 3 !then {
!v2one(nm, u, 3, 0x10, opc, "2D", 1)
}
}
}
}
}
!def v2z(nm, u, opc) {
!v2zone(nm, u, 0, 0x10, opc, "8B", 0)
!v2zone(nm, u, 0, 0x10, opc, "16B", 1)
!v2zone(nm, u, 1, 0x10, opc, "4H", 0)
!v2zone(nm, u, 1, 0x10, opc, "8H", 1)
!v2zone(nm, u, 2, 0x10, opc, "2S", 0)
!v2zone(nm, u, 2, 0x10, opc, "4S", 1)
!v2zone(nm, u, 3, 0x10, opc, "2D", 1)
}
/* h16: 1 when the operation also has half-precision arrangements */
!def v2f(nm, u, op, opc, h16) {
!if h16 !then {
!v2one(nm, u, (op * 2) + 1, 0x1c, opc, "4H", 0)
!v2one(nm, u, (op * 2) + 1, 0x1c, opc, "8H", 1)
}
!v2one(nm, u, op * 2, 0x10, opc, "2S", 0)
!v2one(nm, u, op * 2, 0x10, opc, "4S", 1)
!v2one(nm, u, (op * 2) + 1, 0x10, opc, "2D", 1)
}
!def v2fz(nm, u, op, opc) {
!v2zone(nm, u, (op * 2) + 1, 0x1c, opc, "4H", 0)
!v2zone(nm, u, (op * 2) + 1, 0x1c, opc, "8H", 1)
!v2zone(nm, u, op * 2, 0x10, opc, "2S", 0)
!v2zone(nm, u, op * 2, 0x10, opc, "4S", 1)
!v2zone(nm, u, (op * 2) + 1, 0x10, opc, "2D", 1)
}

!v2i("REV64", 0, 0x00, 0)
!v2i("REV32", 1, 0x00, 4)
!v2i("REV16", 0, 0x01, 2)
!v2i("SUQADD", 0, 0x03, 3)
!v2i("USQADD", 1, 0x03, 3)
!v2i("CLS", 0, 0x04, 0)
!v2i("CLZ", 1, 0x04, 0)
!v2i("CNT", 0, 0x05, 2)
!v2i("SQABS", 0, 0x07, 3)
!v2i("SQNEG", 1, 0x07, 3)
!v2i("ABS", 0, 0x0b, 3)
!v2i("NEG", 1, 0x0b, 3)
!v2i("URECPE", 0, 0x1c, 1)
!v2i("URSQRTE", 1, 0x1c, 1)
/* NOT and RBIT share an opcode and are told apart by the size field */
!v2one("NOT", 1, 0, 0x10, 0x05, "8B", 0)
!v2one("NOT", 1, 0, 0x10, 0x05, "16B", 1)
!v2one("MVN", 1, 0, 0x10, 0x05, "8B", 0)
!v2one("MVN", 1, 0, 0x10, 0x05, "16B", 1)
!v2one("RBIT", 1, 1, 0x10, 0x05, "8B", 0)
!v2one("RBIT", 1, 1, 0x10, 0x05, "16B", 1)

!v2z("CMGT", 0, 0x08)
!v2z("CMGE", 1, 0x08)
!v2z("CMEQ", 0, 0x09)
!v2z("CMLE", 1, 0x09)
!v2z("CMLT", 0, 0x0a)

!v2f("FRINTN", 0, 0, 0x18, 1)
!v2f("FRINTM", 0, 0, 0x19, 1)
!v2f("FRINTA", 1, 0, 0x18, 1)
!v2f("FRINTX", 1, 0, 0x19, 1)
!v2f("FRINTP", 0, 1, 0x18, 1)
!v2f("FRINTZ", 0, 1, 0x19, 1)
!v2f("FRINTI", 1, 1, 0x19, 1)
!v2f("FCVTNS", 0, 0, 0x1a, 1)
!v2f("FCVTMS", 0, 0, 0x1b, 1)
!v2f("FCVTAS", 0, 0, 0x1c, 1)
!v2f("SCVTF", 0, 0, 0x1d, 1)
!v2f("FCVTNU", 1, 0, 0x1a, 1)
!v2f("FCVTMU", 1, 0, 0x1b, 1)
!v2f("FCVTAU", 1, 0, 0x1c, 1)
!v2f("UCVTF", 1, 0, 0x1d, 1)
!v2f("FCVTPS", 0, 1, 0x1a, 1)
!v2f("FCVTZS", 0, 1, 0x1b, 1)
!v2f("FCVTPU", 1, 1, 0x1a, 1)
!v2f("FCVTZU", 1, 1, 0x1b, 1)
!v2f("FABS", 0, 1, 0x0f, 1)
!v2f("FNEG", 1, 1, 0x0f, 1)
!v2f("FSQRT", 1, 1, 0x1f, 1)
!v2f("FRECPE", 0, 1, 0x1d, 1)
!v2f("FRSQRTE", 1, 1, 0x1d, 1)
!v2f("FRINT32Z", 0, 0, 0x1e, 0)
!v2f("FRINT32X", 1, 0, 0x1e, 0)
!v2f("FRINT64Z", 0, 0, 0x1f, 0)
!v2f("FRINT64X", 1, 0, 0x1f, 0)
!v2fz("FCMGT", 0, 1, 0x0c)
!v2fz("FCMEQ", 0, 1, 0x0d)
!v2fz("FCMLT", 0, 1, 0x0e)
!v2fz("FCMGE", 1, 1, 0x0c)
!v2fz("FCMLE", 1, 1, 0x0d)

/* Widening pairwise, narrowing and widening. These share the
/* two-register-miscellaneous encoding; only the operand arrangements
/* differ, so each row names its destination and source shapes. */
!def v2w(nm, u, opc, dar, sar, q, sz) {
!{nm} vd.!{dar},vn.!{sar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(0x10<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|vd)
}
!def vpw(nm, u, opc) {
!v2w(nm, u, opc, "4H", "8B", 0, 0)
!v2w(nm, u, opc, "8H", "16B", 1, 0)
!v2w(nm, u, opc, "2S", "4H", 0, 1)
!v2w(nm, u, opc, "4S", "8H", 1, 1)
!v2w(nm, u, opc, "1D", "2S", 0, 2)
!v2w(nm, u, opc, "2D", "4S", 1, 2)
}
!vpw("SADDLP", 0, 0x02)
!vpw("UADDLP", 1, 0x02)
!vpw("SADALP", 0, 0x06)
!vpw("UADALP", 1, 0x06)

!def vnar(nm, u, opc) {
!v2w(nm, u, opc, "8B", "8H", 0, 0)
!v2w(nm, u, opc, "4H", "4S", 0, 1)
!v2w(nm, u, opc, "2S", "2D", 0, 2)
!v2w(nm + "2", u, opc, "16B", "8H", 1, 0)
!v2w(nm + "2", u, opc, "8H", "4S", 1, 1)
!v2w(nm + "2", u, opc, "4S", "2D", 1, 2)
}
!vnar("XTN", 0, 0x12)
!vnar("SQXTN", 0, 0x14)
!vnar("UQXTN", 1, 0x14)
!vnar("SQXTUN", 1, 0x12)

!v2w("FCVTN", 0, 0x16, "4H", "4S", 0, 0)
!v2w("FCVTN", 0, 0x16, "2S", "2D", 0, 1)
!v2w("FCVTN2", 0, 0x16, "8H", "4S", 1, 0)
!v2w("FCVTN2", 0, 0x16, "4S", "2D", 1, 1)
!v2w("FCVTXN", 1, 0x16, "2S", "2D", 0, 1)
!v2w("FCVTXN2", 1, 0x16, "4S", "2D", 1, 1)
!v2w("FCVTL", 0, 0x17, "4S", "4H", 0, 0)
!v2w("FCVTL", 0, 0x17, "2D", "2S", 0, 1)
!v2w("FCVTL2", 0, 0x17, "4S", "8H", 1, 0)
!v2w("FCVTL2", 0, 0x17, "2D", "4S", 1, 1)

/* SHLL shifts the source elements left by the element width, so the
/* shift amount is fixed by the arrangement and is checked here. */
!def vshll(nm, dar, sar, q, sz, amt) {
!{nm} vd.!{dar},vn.!{sar},#!s ::s!=!{amt};3 :: .call w4((!{q}<<30)|(1<<29)|(0x0e<<24)|(!{sz}<<22)|(0x10<<17)|(0x13<<12)|(2<<10)|(vn<<5)|vd)
}
!vshll("SHLL", "8H", "8B", 0, 0, 8)
!vshll("SHLL", "4S", "4H", 0, 1, 16)
!vshll("SHLL", "2D", "2S", 0, 2, 32)
!vshll("SHLL2", "8H", "16B", 1, 0, 8)
!vshll("SHLL2", "4S", "8H", 1, 1, 16)
!vshll("SHLL2", "2D", "4S", 1, 2, 32)

/* Three different.
/*   0 Q U 01110 size 1 Rm opcode 00 Rn Rd
/* "l" widens both sources, "w" widens only the second, and "n"
/* narrows the destination. */
!def v3done(nm, u, opc, dar, nar, mar, q, sz) {
!{nm} vd.!{dar},vn.!{nar},vm.!{mar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(1<<21)|(vm<<16)|(!{opc}<<12)|(vn<<5)|vd)
}
!def v3dl(nm, u, opc, b) {
!if b !then {
!v3done(nm, u, opc, "8H", "8B", "8B", 0, 0)
!v3done(nm + "2", u, opc, "8H", "16B", "16B", 1, 0)
}
!v3done(nm, u, opc, "4S", "4H", "4H", 0, 1)
!v3done(nm + "2", u, opc, "4S", "8H", "8H", 1, 1)
!v3done(nm, u, opc, "2D", "2S", "2S", 0, 2)
!v3done(nm + "2", u, opc, "2D", "4S", "4S", 1, 2)
}
!def v3dw(nm, u, opc) {
!v3done(nm, u, opc, "8H", "8H", "8B", 0, 0)
!v3done(nm + "2", u, opc, "8H", "8H", "16B", 1, 0)
!v3done(nm, u, opc, "4S", "4S", "4H", 0, 1)
!v3done(nm + "2", u, opc, "4S", "4S", "8H", 1, 1)
!v3done(nm, u, opc, "2D", "2D", "2S", 0, 2)
!v3done(nm + "2", u, opc, "2D", "2D", "4S", 1, 2)
}
!def v3dn(nm, u, opc) {
!v3done(nm, u, opc, "8B", "8H", "8H", 0, 0)
!v3done(nm + "2", u, opc, "16B", "8H", "8H", 1, 0)
!v3done(nm, u, opc, "4H", "4S", "4S", 0, 1)
!v3done(nm + "2", u, opc, "8H", "4S", "4S", 1, 1)
!v3done(nm, u, opc, "2S", "2D", "2D", 0, 2)
!v3done(nm + "2", u, opc, "4S", "2D", "2D", 1, 2)
}
!v3dl("SADDL", 0, 0x0, 1)
!v3dl("UADDL", 1, 0x0, 1)
!v3dl("SSUBL", 0, 0x2, 1)
!v3dl("USUBL", 1, 0x2, 1)
!v3dl("SABAL", 0, 0x5, 1)
!v3dl("UABAL", 1, 0x5, 1)
!v3dl("SABDL", 0, 0x7, 1)
!v3dl("UABDL", 1, 0x7, 1)
!v3dl("SMLAL", 0, 0x8, 1)
!v3dl("UMLAL", 1, 0x8, 1)
!v3dl("SMLSL", 0, 0xa, 1)
!v3dl("UMLSL", 1, 0xa, 1)
!v3dl("SMULL", 0, 0xc, 1)
!v3dl("UMULL", 1, 0xc, 1)
!v3dl("SQDMLAL", 0, 0x9, 0)
!v3dl("SQDMLSL", 0, 0xb, 0)
!v3dl("SQDMULL", 0, 0xd, 0)
!v3dw("SADDW", 0, 0x1)
!v3dw("UADDW", 1, 0x1)
!v3dw("SSUBW", 0, 0x3)
!v3dw("USUBW", 1, 0x3)
!v3dn("ADDHN", 0, 0x4)
!v3dn("RADDHN", 1, 0x4)
!v3dn("SUBHN", 0, 0x6)
!v3dn("RSUBHN", 1, 0x6)
!v3done("PMULL", 0, 0xe, "8H", "8B", "8B", 0, 0)
!v3done("PMULL2", 0, 0xe, "8H", "16B", "16B", 1, 0)
!v3done("PMULL", 0, 0xe, "1Q", "1D", "1D", 0, 3)
!v3done("PMULL2", 0, 0xe, "1Q", "2D", "2D", 1, 3)

/* Across lanes.
/*   0 Q U 01110 size 11000 opcode 10 Rn Rd
/* The destination is a scalar of the widened element type, so each
/* row names the scalar register class it writes. */
!def vacr(nm, u, opc, rd, sar, q, sz) {
!{nm} !{rd},vn.!{sar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|!{rd})
}
!def vacri(nm, u, opc, w) {
!vacr(nm, u, opc, w == 1 ? "fhd" : "fbd", "8B", 0, 0)
!vacr(nm, u, opc, w == 1 ? "fhd" : "fbd", "16B", 1, 0)
!vacr(nm, u, opc, w == 1 ? "fsd" : "fhd", "4H", 0, 1)
!vacr(nm, u, opc, w == 1 ? "fsd" : "fhd", "8H", 1, 1)
!vacr(nm, u, opc, w == 1 ? "fdd" : "fsd", "4S", 1, 2)
}
!vacri("SADDLV", 0, 0x03, 1)
!vacri("UADDLV", 1, 0x03, 1)
!vacri("SMAXV", 0, 0x0a, 0)
!vacri("UMAXV", 1, 0x0a, 0)
!vacri("SMINV", 0, 0x1a, 0)
!vacri("UMINV", 1, 0x1a, 0)
!vacri("ADDV", 0, 0x1b, 0)
!def vacrf(nm, opc, sz) {
!vacr(nm, 0, opc, "fhd", "4H", 0, sz)
!vacr(nm, 0, opc, "fhd", "8H", 1, sz)
!vacr(nm, 1, opc, "fsd", "4S", 1, sz)
}
!vacrf("FMAXNMV", 0x0c, 0)
!vacrf("FMAXV", 0x0f, 0)
!vacrf("FMINNMV", 0x0c, 2)
!vacrf("FMINV", 0x0f, 2)

/* Permute.
/*   0 Q 001110 size 0 Rm 0 opcode 10 Rn Rd */
!def vperm1(nm, opc, ar, q, sz) {
!{nm} vd.!{ar},vn.!{ar},vm.!{ar} :: .call w4((!{q}<<30)|(0x0e<<24)|(!{sz}<<22)|(vm<<16)|(!{opc}<<12)|(2<<10)|(vn<<5)|vd)
}
!def vperm(nm, opc) {
!vperm1(nm, opc, "8B", 0, 0)
!vperm1(nm, opc, "16B", 1, 0)
!vperm1(nm, opc, "4H", 0, 1)
!vperm1(nm, opc, "8H", 1, 1)
!vperm1(nm, opc, "2S", 0, 2)
!vperm1(nm, opc, "4S", 1, 2)
!vperm1(nm, opc, "2D", 1, 3)
}
!vperm("UZP1", 1)
!vperm("TRN1", 2)
!vperm("ZIP1", 3)
!vperm("UZP2", 5)
!vperm("TRN2", 6)
!vperm("ZIP2", 7)

/* Extract.
/*   0 Q 101110 00 0 Rm 0 imm4 0 Rn Rd */
EXT vd.8B,vn.8B,vm.8B,#!i ::i<0;3,i>7;3 :: .call w4((1<<29)|(0x0e<<24)|(vm<<16)|(i<<11)|(vn<<5)|vd)
EXT vd.16B,vn.16B,vm.16B,#!i ::i<0;3,i>15;3 :: .call w4((1<<30)|(1<<29)|(0x0e<<24)|(vm<<16)|(i<<11)|(vn<<5)|vd)

/* Table lookup.
/*   0 Q 001110 000 Rm 0 len op 00 Rn Rd
/* The table is one to four consecutive V registers; only the first is
/* encoded, so the rows check that the others really do follow it. */
.check::vb::VR
.check::vc::VR
!def vtbl(nm, op, ar, q) {
!{nm} vd.!{ar},{vn.16B},vm.!{ar} :: .call w4((!{q}<<30)|(0x0e<<24)|(vm<<16)|(!{op}<<12)|(vn<<5)|vd)
!{nm} vd.!{ar},{vn.16B,va.16B},vm.!{ar} ::va!=((vn+1)&31);5 :: .call w4((!{q}<<30)|(0x0e<<24)|(vm<<16)|(1<<13)|(!{op}<<12)|(vn<<5)|vd)
!{nm} vd.!{ar},{vn.16B,va.16B,vb.16B},vm.!{ar} ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4((!{q}<<30)|(0x0e<<24)|(vm<<16)|(2<<13)|(!{op}<<12)|(vn<<5)|vd)
!{nm} vd.!{ar},{vn.16B,va.16B,vb.16B,vc.16B},vm.!{ar} ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4((!{q}<<30)|(0x0e<<24)|(vm<<16)|(3<<13)|(!{op}<<12)|(vn<<5)|vd)
}
!vtbl("TBL", 0, "8B", 0)
!vtbl("TBL", 0, "16B", 1)
!vtbl("TBX", 1, "8B", 0)
!vtbl("TBX", 1, "16B", 1)

/* Copy.
/*   0 Q op 01110000 imm5 0 imm4 1 Rn Rd
/* imm5 carries both the element size and the index: the size is the
/* lowest set bit and the index sits above it. */
!def vdupe(ar, el, q, sh, lo, mx) {
DUP vd.!{ar},vn.!{el}[!!i] ::i<0;3,i>!{mx};3 :: .call w4((!{q}<<30)|(0x0e<<24)|(((i<<!{sh})|!{lo})<<16)|(1<<10)|(vn<<5)|vd)
}
!vdupe("8B", "B", 0, 1, 1, 15)
!vdupe("16B", "B", 1, 1, 1, 15)
!vdupe("4H", "H", 0, 2, 2, 7)
!vdupe("8H", "H", 1, 2, 2, 7)
!vdupe("2S", "S", 0, 3, 4, 3)
!vdupe("4S", "S", 1, 3, 4, 3)
!vdupe("2D", "D", 1, 4, 8, 1)

!def vdupg(ar, rn, q, lo) {
DUP vd.!{ar},!{rn} :: .call w4((!{q}<<30)|(0x0e<<24)|(!{lo}<<16)|(1<<11)|(1<<10)|(!{rn}<<5)|vd)
}
!vdupg("8B", "wn", 0, 1)
!vdupg("16B", "wn", 1, 1)
!vdupg("4H", "wn", 0, 2)
!vdupg("8H", "wn", 1, 2)
!vdupg("2S", "wn", 0, 4)
!vdupg("4S", "wn", 1, 4)
!vdupg("2D", "xn", 1, 8)

/* Scalar DUP, which is also spelled MOV. This one sits in the scalar
/* copy block, so bit 28 is set where the vector rows clear it. */
!def vdups(rd, el, sh, lo, mx) {
DUP !{rd},vn.!{el}[!!i] ::i<0;3,i>!{mx};3 :: .call w4((1<<30)|(0x1e<<24)|(((i<<!{sh})|!{lo})<<16)|(1<<10)|(vn<<5)|!{rd})
MOV !{rd},vn.!{el}[!!i] ::i<0;3,i>!{mx};3 :: .call w4((1<<30)|(0x1e<<24)|(((i<<!{sh})|!{lo})<<16)|(1<<10)|(vn<<5)|!{rd})
}
!vdups("fbd", "B", 1, 1, 15)
!vdups("fhd", "H", 2, 2, 7)
!vdups("fsd", "S", 3, 4, 3)
!vdups("fdd", "D", 4, 8, 1)

!def vsmov(nm, imm4, rd, el, q, sh, lo, mx) {
!{nm} !{rd},vn.!{el}[!!i] ::i<0;3,i>!{mx};3 :: .call w4((!{q}<<30)|(0x0e<<24)|(((i<<!{sh})|!{lo})<<16)|(!{imm4}<<11)|(1<<10)|(vn<<5)|!{rd})
}
!vsmov("SMOV", 5, "wd", "B", 0, 1, 1, 15)
!vsmov("SMOV", 5, "wd", "H", 0, 2, 2, 7)
!vsmov("SMOV", 5, "xd", "B", 1, 1, 1, 15)
!vsmov("SMOV", 5, "xd", "H", 1, 2, 2, 7)
!vsmov("SMOV", 5, "xd", "S", 1, 3, 4, 3)
!vsmov("UMOV", 7, "wd", "B", 0, 1, 1, 15)
!vsmov("UMOV", 7, "wd", "H", 0, 2, 2, 7)
!vsmov("UMOV", 7, "wd", "S", 0, 3, 4, 3)
!vsmov("UMOV", 7, "xd", "D", 1, 4, 8, 1)
!vsmov("MOV", 7, "wd", "S", 0, 3, 4, 3)
!vsmov("MOV", 7, "xd", "D", 1, 4, 8, 1)

/* INS, also spelled MOV, from a general register or from a lane */
!def vinsg(nm, el, sh, lo, mx, rn) {
!{nm} vd.!{el}[!!i],!{rn} ::i<0;3,i>!{mx};3 :: .call w4((1<<30)|(0x0e<<24)|(((i<<!{sh})|!{lo})<<16)|(3<<11)|(1<<10)|(!{rn}<<5)|vd)
}
!vinsg("INS", "B", 1, 1, 15, "wn")
!vinsg("MOV", "B", 1, 1, 15, "wn")
!vinsg("INS", "H", 2, 2, 7, "wn")
!vinsg("MOV", "H", 2, 2, 7, "wn")
!vinsg("INS", "S", 3, 4, 3, "wn")
!vinsg("MOV", "S", 3, 4, 3, "wn")
!vinsg("INS", "D", 4, 8, 1, "xn")
!vinsg("MOV", "D", 4, 8, 1, "xn")
!def vinse(nm, el, sh, lo, mx, jsh) {
!{nm} vd.!{el}[!!i],vn.!{el}[!!j] ::i<0;3,i>!{mx};3,j<0;3,j>!{mx};3 :: .call w4((1<<30)|(1<<29)|(0x0e<<24)|(((i<<!{sh})|!{lo})<<16)|((j<<!{jsh})<<11)|(1<<10)|(vn<<5)|vd)
}
!vinse("INS", "B", 1, 1, 15, 0)
!vinse("MOV", "B", 1, 1, 15, 0)
!vinse("INS", "H", 2, 2, 7, 1)
!vinse("MOV", "H", 2, 2, 7, 1)
!vinse("INS", "S", 3, 4, 3, 2)
!vinse("MOV", "S", 3, 4, 3, 2)
!vinse("INS", "D", 4, 8, 1, 3)
!vinse("MOV", "D", 4, 8, 1, 3)

/* Modified immediate.
/*   0 Q op 0111100000 abc cmode o2 1 defgh Rd
/* cmode selects both the element width and the byte position the
/* 8-bit value is shifted into, so the shift amount written in the
/* source becomes part of it. */
!def vmi(nm, op, ar, q, cmode) {
!{nm} vd.!{ar},#!v ::v<0;3,v>0xff;3 :: .call w4((!{q}<<30)|(!{op}<<29)|(0x0f<<24)|(((v>>5)&7)<<16)|(!{cmode}<<12)|(1<<10)|((v&0x1f)<<5)|vd)
}
!def vmis(nm, op, ar, q, base, sh, mx) {
!{nm} vd.!{ar},#!v,LSL #!s ::v<0;3,v>0xff;3,(s&7)!=0;10,s>!{mx};10 :: .call w4((!{q}<<30)|(!{op}<<29)|(0x0f<<24)|(((v>>5)&7)<<16)|((!{base}|((s>>3)<<1))<<12)|(1<<10)|((v&0x1f)<<5)|vd)
}
!def vmim(nm, op, ar, q) {
!{nm} vd.!{ar},#!v,MSL #!s ::v<0;3,v>0xff;3,(s!=8)&&(s!=16);10 :: .call w4((!{q}<<30)|(!{op}<<29)|(0x0f<<24)|(((v>>5)&7)<<16)|((0xc|((s>>3)-1))<<12)|(1<<10)|((v&0x1f)<<5)|vd)
}
/* MOVI and MVNI */
!vmi("MOVI", 0, "8B", 0, 0xe)
!vmi("MOVI", 0, "16B", 1, 0xe)
!def vmihs(nm, op) {
!vmi(nm, op, "4H", 0, 0x8)
!vmi(nm, op, "8H", 1, 0x8)
!vmis(nm, op, "4H", 0, 0x8, 1, 8)
!vmis(nm, op, "8H", 1, 0x8, 1, 8)
!vmi(nm, op, "2S", 0, 0x0)
!vmi(nm, op, "4S", 1, 0x0)
!vmis(nm, op, "2S", 0, 0x0, 1, 24)
!vmis(nm, op, "4S", 1, 0x0, 1, 24)
!vmim(nm, op, "2S", 0)
!vmim(nm, op, "4S", 1)
}
!vmihs("MOVI", 0)
!vmihs("MVNI", 1)
/* ORR and BIC with an immediate use the odd cmode values */
!def vmiob(nm, op) {
!vmi(nm, op, "4H", 0, 0x9)
!vmi(nm, op, "8H", 1, 0x9)
!vmis(nm, op, "4H", 0, 0x9, 1, 8)
!vmis(nm, op, "8H", 1, 0x9, 1, 8)
!vmi(nm, op, "2S", 0, 0x1)
!vmi(nm, op, "4S", 1, 0x1)
!vmis(nm, op, "2S", 0, 0x1, 1, 24)
!vmis(nm, op, "4S", 1, 0x1, 1, 24)
}
!vmiob("ORR", 0)
!vmiob("BIC", 1)
/* The 64-bit MOVI takes one bit per byte, so the value has to be made
/* of 0x00 and 0xff bytes; bytemask checks that and packs it. */
MOVI vd.2D,#!v :: .call vmovi64(v,1,vd)
MOVI fdd,#!v :: .call vmovi64(v,0,fdd)
/* FMOV with a vector immediate reuses the 8-bit floating-point field */
FMOV vd.2S,#!Dv :: .call vfmovi(v,0,0,0,vd)
FMOV vd.4S,#!Dv :: .call vfmovi(v,1,0,0,vd)
FMOV vd.2D,#!Dv :: .call vfmovi(v,1,1,0,vd)
FMOV vd.4H,#!Dv :: .call vfmovi(v,0,0,1,vd)
FMOV vd.8H,#!Dv :: .call vfmovi(v,1,0,1,vd)

.func::bytemask::v
r = 0
i = 0
.while(i < 8)
b = (v >> (i * 8)) & 0xff
.if b == 0xff .then
r = r | (1 << i)
.elif b != 0 .then
.return -1
.endif
i = i + 1
.endwhile
.return r
.endfunc

.func::vmovi64::v,q,rd
m = .call bytemask(v)
.if m < 0 .then
.raise 13
.return [0, 0, 0, 0]
.endif
.return .call w4((q << 30) | (1 << 29) | (0x0f << 24) | (((m >> 5) & 7) << 16) | (0x0e << 12) | (1 << 10) | ((m & 0x1f) << 5) | rd)
.endfunc

.func::vfmovi::v,q,op,o2,rd
i8 = .call fpimm8(v)
.if i8 < 0 .then
.raise 9
.return [0, 0, 0, 0]
.endif
.return .call w4((q << 30) | (op << 29) | (0x0f << 24) | (((i8 >> 5) & 7) << 16) | (0x0f << 12) | (o2 << 11) | (1 << 10) | ((i8 & 0x1f) << 5) | rd)
.endfunc

/* Shift by immediate.
/*   0 Q U 011110 immh immb opcode 1 Rn Rd
/* immh:immb is one 7-bit field holding the element width and the
/* shift together: a right shift stores 2*esize - amount, a left
/* shift stores esize + amount. */
!def vshr(nm, u, opc, ar, q, es) {
!{nm} vd.!{ar},vn.!{ar},#!s ::s<1;3,s>!{es};3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(((!{es}*2)-s)<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def vshl(nm, u, opc, ar, q, es) {
!{nm} vd.!{ar},vn.!{ar},#!s ::s<0;3,s>!{es-1};3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|((!{es}+s)<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def vshall(nm, u, opc, right, d2) {
!if right !then {
!vshr(nm, u, opc, "8B", 0, 8)
!vshr(nm, u, opc, "16B", 1, 8)
!vshr(nm, u, opc, "4H", 0, 16)
!vshr(nm, u, opc, "8H", 1, 16)
!vshr(nm, u, opc, "2S", 0, 32)
!vshr(nm, u, opc, "4S", 1, 32)
!if d2 !then {
!vshr(nm, u, opc, "2D", 1, 64)
}
} !else {
!vshl(nm, u, opc, "8B", 0, 8)
!vshl(nm, u, opc, "16B", 1, 8)
!vshl(nm, u, opc, "4H", 0, 16)
!vshl(nm, u, opc, "8H", 1, 16)
!vshl(nm, u, opc, "2S", 0, 32)
!vshl(nm, u, opc, "4S", 1, 32)
!if d2 !then {
!vshl(nm, u, opc, "2D", 1, 64)
}
}
}
!vshall("SSHR", 0, 0x00, 1, 1)
!vshall("USHR", 1, 0x00, 1, 1)
!vshall("SSRA", 0, 0x02, 1, 1)
!vshall("USRA", 1, 0x02, 1, 1)
!vshall("SRSHR", 0, 0x04, 1, 1)
!vshall("URSHR", 1, 0x04, 1, 1)
!vshall("SRSRA", 0, 0x06, 1, 1)
!vshall("URSRA", 1, 0x06, 1, 1)
!vshall("SRI", 1, 0x08, 1, 1)
!vshall("SHL", 0, 0x0a, 0, 1)
!vshall("SLI", 1, 0x0a, 0, 1)
!vshall("SQSHL", 0, 0x0e, 0, 1)
!vshall("UQSHL", 1, 0x0e, 0, 1)
!vshall("SQSHLU", 1, 0x0c, 0, 1)

/* Narrowing shifts. The stored field counts from twice the
/* destination element width. */
!def vshrn(nm, u, opc, dar, sar, q, es) {
!{nm} vd.!{dar},vn.!{sar},#!s ::s<1;3,s>!{es};3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(((!{es}*2)-s)<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def vnshift(nm, u, opc) {
!vshrn(nm, u, opc, "8B", "8H", 0, 8)
!vshrn(nm, u, opc, "4H", "4S", 0, 16)
!vshrn(nm, u, opc, "2S", "2D", 0, 32)
!vshrn(nm + "2", u, opc, "16B", "8H", 1, 8)
!vshrn(nm + "2", u, opc, "8H", "4S", 1, 16)
!vshrn(nm + "2", u, opc, "4S", "2D", 1, 32)
}
!vnshift("SHRN", 0, 0x10)
!vnshift("RSHRN", 0, 0x11)
!vnshift("SQSHRN", 0, 0x12)
!vnshift("SQRSHRN", 0, 0x13)
!vnshift("SQSHRUN", 1, 0x10)
!vnshift("SQRSHRUN", 1, 0x11)
!vnshift("UQSHRN", 1, 0x12)
!vnshift("UQRSHRN", 1, 0x13)

/* Widening shift, and the extend aliases that are the same thing
/* with a shift of zero. */
!def vshll2(nm, u, dar, sar, q, es) {
!{nm} vd.!{dar},vn.!{sar},#!s ::s<0;3,s>!{es-1};3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|((!{es}+s)<<16)|(0x14<<11)|(1<<10)|(vn<<5)|vd)
}
!def vxtl(nm, u, dar, sar, q, es) {
!{nm} vd.!{dar},vn.!{sar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(!{es}<<16)|(0x14<<11)|(1<<10)|(vn<<5)|vd)
}
!def vwshift(nm, xn, u) {
!vshll2(nm, u, "8H", "8B", 0, 8)
!vshll2(nm, u, "4S", "4H", 0, 16)
!vshll2(nm, u, "2D", "2S", 0, 32)
!vshll2(nm + "2", u, "8H", "16B", 1, 8)
!vshll2(nm + "2", u, "4S", "8H", 1, 16)
!vshll2(nm + "2", u, "2D", "4S", 1, 32)
!vxtl(xn, u, "8H", "8B", 0, 8)
!vxtl(xn, u, "4S", "4H", 0, 16)
!vxtl(xn, u, "2D", "2S", 0, 32)
!vxtl(xn + "2", u, "8H", "16B", 1, 8)
!vxtl(xn + "2", u, "4S", "8H", 1, 16)
!vxtl(xn + "2", u, "2D", "4S", 1, 32)
}
!vwshift("SSHLL", "SXTL", 0)
!vwshift("USHLL", "UXTL", 1)

/* Vector fixed-point conversions */
!def vfx(nm, u, opc, ar, q, es) {
!{nm} vd.!{ar},vn.!{ar},#!c ::c<1;3,c>!{es};3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(((!{es}*2)-c)<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!def vfxall(nm, u, opc) {
!vfx(nm, u, opc, "4H", 0, 16)
!vfx(nm, u, opc, "8H", 1, 16)
!vfx(nm, u, opc, "2S", 0, 32)
!vfx(nm, u, opc, "4S", 1, 32)
!vfx(nm, u, opc, "2D", 1, 64)
}
!vfxall("SCVTF", 0, 0x1c)
!vfxall("UCVTF", 1, 0x1c)
!vfxall("FCVTZS", 0, 0x1f)
!vfxall("FCVTZU", 1, 0x1f)

/* By element.
/*   0 Q U 01111 size L M Rm opcode H 0 Rn Rd
/* The lane index is split across H, L and M, and how it splits
/* depends on the element width: a half-precision lane uses all three
/* and leaves only four bits for Rm, so those rows restrict the second
/* source to V0-V15. */
.setsym::VL::V0,V1,V2,V3,V4,V5,V6,V7,V8,V9,V10,V11,V12,V13,V14,V15
.check::vl::VL
!def vbeh(nm, u, opc, dar, sar, q) {
!{nm} vd.!{dar},vn.!{sar},vl.H[!!i] ::i<0;3,i>7;3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(1<<22)|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(!{opc}<<12)|(((i>>2)&1)<<11)|(vn<<5)|vd)
}
!def vbehf(nm, u, opc, dar, sar, q) {
!{nm} vd.!{dar},vn.!{sar},vl.H[!!i] ::i<0;3,i>7;3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(!{opc}<<12)|(((i>>2)&1)<<11)|(vn<<5)|vd)
}
!def vbes(nm, u, opc, dar, sar, q, sz) {
!{nm} vd.!{dar},vn.!{sar},vm.S[!!i] ::i<0;3,i>3;3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(!{sz}<<22)|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(!{opc}<<12)|(((i>>1)&1)<<11)|(vn<<5)|vd)
}
!def vbed(nm, u, opc, dar, sar, q) {
!{nm} vd.!{dar},vn.!{sar},vm.D[!!i] ::i<0;3,i>1;3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(3<<22)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(!{opc}<<12)|(i<<11)|(vn<<5)|vd)
}
/* Same-shape integer forms */
!def vbei(nm, u, opc) {
!vbeh(nm, u, opc, "4H", "4H", 0)
!vbeh(nm, u, opc, "8H", "8H", 1)
!vbes(nm, u, opc, "2S", "2S", 0, 2)
!vbes(nm, u, opc, "4S", "4S", 1, 2)
}
!vbei("MUL", 0, 0x8)
!vbei("MLA", 1, 0x0)
!vbei("MLS", 1, 0x4)
!vbei("SQDMULH", 0, 0xc)
!vbei("SQRDMULH", 0, 0xd)
!vbei("SQRDMLAH", 1, 0xd)
!vbei("SQRDMLSH", 1, 0xf)
/* Same-shape floating-point forms; the half-precision ones use size
/* 00 rather than 01. */
!def vbef(nm, u, opc) {
!vbehf(nm, u, opc, "4H", "4H", 0)
!vbehf(nm, u, opc, "8H", "8H", 1)
!vbes(nm, u, opc, "2S", "2S", 0, 2)
!vbes(nm, u, opc, "4S", "4S", 1, 2)
!vbed(nm, u, opc, "2D", "2D", 1)
}
!vbef("FMLA", 0, 0x1)
!vbef("FMLS", 0, 0x5)
!vbef("FMUL", 0, 0x9)
!vbef("FMULX", 1, 0x9)
/* Widening forms */
!def vbew(nm, u, opc) {
!vbeh(nm, u, opc, "4S", "4H", 0)
!vbeh(nm + "2", u, opc, "4S", "8H", 1)
!vbes(nm, u, opc, "2D", "2S", 0, 2)
!vbes(nm + "2", u, opc, "2D", "4S", 1, 2)
}
!vbew("SMLAL", 0, 0x2)
!vbew("SMLSL", 0, 0x6)
!vbew("SMULL", 0, 0xa)
!vbew("UMLAL", 1, 0x2)
!vbew("UMLSL", 1, 0x6)
!vbew("UMULL", 1, 0xa)
!vbew("SQDMLAL", 0, 0x3)
!vbew("SQDMLSL", 0, 0x7)
!vbew("SQDMULL", 0, 0xb)
/* Dot product by element: the lane names four bytes at a time */
!def vbedot(nm, u) {
!{nm} vd.2S,vn.8B,vm.4B[!!i] ::i<0;3,i>3;3 :: .call w4((!{u}<<29)|(0x0f<<24)|(2<<22)|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(0xe<<12)|(((i>>1)&1)<<11)|(vn<<5)|vd)
!{nm} vd.4S,vn.16B,vm.4B[!!i] ::i<0;3,i>3;3 :: .call w4((1<<30)|(!{u}<<29)|(0x0f<<24)|(2<<22)|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(0xe<<12)|(((i>>1)&1)<<11)|(vn<<5)|vd)
}
!vbedot("SDOT", 0)
!vbedot("UDOT", 1)

/* ===================================================================
/* Advanced SIMD load/store structures
/*
/* Multiple structures:
/*   0 Q 0011 0 0 0 L 000000 opcode size Rn Rt
/* Single structure and replicate:
/*   0 Q 0011 0 1 0 L R 00000 opcode S size Rn Rt
/* The post-index forms set bit 23 and put the index register in Rm,
/* with 11111 there meaning "advance by the transfer size". The list
/* is one to four consecutive V registers, and the rows check that
/* they really are consecutive.
/* =================================================================== */
!def lsm1(nm, l, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar}},[xb] :: .call w4((!{q}<<30)|(0x0c<<24)|(!{l}<<22)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar}},[xb],#!o ::o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(31<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar}},[xb],xm :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(xm<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
}
!def lsm2(nm, l, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar},va.!{ar}},[xb] ::va!=((vn+1)&31);5 :: .call w4((!{q}<<30)|(0x0c<<24)|(!{l}<<22)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar}},[xb],#!o ::va!=((vn+1)&31);5,o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(31<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar}},[xb],xm ::va!=((vn+1)&31);5 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(xm<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
}
!def lsm3(nm, l, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar},va.!{ar},vb.!{ar}},[xb] ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4((!{q}<<30)|(0x0c<<24)|(!{l}<<22)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar}},[xb],#!o ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(31<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar}},[xb],xm ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(xm<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
}
!def lsm4(nm, l, opc, ar, q, sz, nb) {
!{nm} {vn.!{ar},va.!{ar},vb.!{ar},vc.!{ar}},[xb] ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4((!{q}<<30)|(0x0c<<24)|(!{l}<<22)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar},vc.!{ar}},[xb],#!o ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5,o!=!{nb};3 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(31<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
!{nm} {vn.!{ar},va.!{ar},vb.!{ar},vc.!{ar}},[xb],xm ::va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4((!{q}<<30)|(0x0c<<24)|(1<<23)|(!{l}<<22)|(xm<<16)|(!{opc}<<12)|(!{sz}<<10)|(xb<<5)|vn)
}
/* ST1: 1 register per group */
!lsm1("ST1", 0, 0x7, "8B", 0, 0, 8)
!lsm1("ST1", 0, 0x7, "16B", 1, 0, 16)
!lsm1("ST1", 0, 0x7, "4H", 0, 1, 8)
