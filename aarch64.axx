!s2z("CMEQ", 0, 0x09)
!s2z("CMLE", 1, 0x09)
!s2z("CMLT", 0, 0x0a)
!def s2f(nm, u, op, opc) {
!s2one(nm, u, (op * 2) + 1, 0x1c, opc, "fhd", "fhn")
!s2one(nm, u, op * 2, 0x10, opc, "fsd", "fsn")
!s2one(nm, u, (op * 2) + 1, 0x10, opc, "fdd", "fdn")
}
