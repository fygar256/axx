/* Scalar narrowing */
!def s2n(nm, u, opc) {
!s2one(nm, u, 0, 0x10, opc, "fbd", "fhn")
!s2one(nm, u, 1, 0x10, opc, "fhd", "fsn")
!s2one(nm, u, 2, 0x10, opc, "fsd", "fdn")
}
!s2n("SQXTN", 0, 0x14)
!s2n("UQXTN", 1, 0x14)
!s2n("SQXTUN", 1, 0x12)
!s2one("FCVTXN", 1, 1, 0x10, 0x16, "fsd", "fdn")

/* Scalar pairwise: the source is a two-element vector */
ADDP fdd,vn.2D :: .call w4((1<<30)|(0x1e<<24)|(3<<22)|(0x18<<17)|(0x1b<<12)|(2<<10)|(vn<<5)|fdd)
!def spwf(nm, opc, sz) {
!{nm} fhd,vn.2H :: .call w4((1<<30)|(0x1e<<24)|(!{sz}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|fhd)
!{nm} fsd,vn.2S :: .call w4((1<<30)|(1<<29)|(0x1e<<24)|(!{sz}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|fsd)
!{nm} fdd,vn.2D :: .call w4((1<<30)|(1<<29)|(0x1e<<24)|(!{sz+1}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|fdd)
}
!spwf("FMAXNMP", 0x0c, 0)
!spwf("FADDP", 0x0d, 0)
!spwf("FMAXP", 0x0f, 0)
!spwf("FMINNMP", 0x0c, 2)
!spwf("FMINP", 0x0f, 2)

/* Scalar shift by immediate */
!def sshone(nm, u, opc, rd, rn, es, right) {
!if right !then {
!{nm} !{rd},!{rn},#!s ::s<1;3,s>!{es};3 :: .call w4((1<<30)|(!{u}<<29)|(0x1f<<24)|(((!{es}*2)-s)<<16)|(!{opc}<<11)|(1<<10)|(!{rn}<<5)|!{rd})
} !else {
!{nm} !{rd},!{rn},#!s ::s<0;3,s>!{es-1};3 :: .call w4((1<<30)|(!{u}<<29)|(0x1f<<24)|((!{es}+s)<<16)|(!{opc}<<11)|(1<<10)|(!{rn}<<5)|!{rd})
}
}
!def sshd(nm, u, opc, right) {
!sshone(nm, u, opc, "fdd", "fdn", 64, right)
}
!sshd("SSHR", 0, 0x00, 1)
!sshd("USHR", 1, 0x00, 1)
!sshd("SSRA", 0, 0x02, 1)
!sshd("USRA", 1, 0x02, 1)
!sshd("SRSHR", 0, 0x04, 1)
!sshd("URSHR", 1, 0x04, 1)
!sshd("SRSRA", 0, 0x06, 1)
!sshd("URSRA", 1, 0x06, 1)
!sshd("SRI", 1, 0x08, 1)
!sshd("SHL", 0, 0x0a, 0)
!sshd("SLI", 1, 0x0a, 0)
!def sshall(nm, u, opc, right) {
!sshone(nm, u, opc, "fbd", "fbn", 8, right)
!sshone(nm, u, opc, "fhd", "fhn", 16, right)
!sshone(nm, u, opc, "fsd", "fsn", 32, right)
!sshone(nm, u, opc, "fdd", "fdn", 64, right)
}
!sshall("SQSHL", 0, 0x0e, 0)
!sshall("UQSHL", 1, 0x0e, 0)
!sshall("SQSHLU", 1, 0x0c, 0)
/* Scalar narrowing shifts */
!def sshn(nm, u, opc) {
!sshone(nm, u, opc, "fbd", "fhn", 8, 1)
!sshone(nm, u, opc, "fhd", "fsn", 16, 1)
!sshone(nm, u, opc, "fsd", "fdn", 32, 1)
}
!sshn("SQSHRN", 0, 0x12)
!sshn("SQRSHRN", 0, 0x13)
!sshn("SQSHRUN", 1, 0x10)
!sshn("SQRSHRUN", 1, 0x11)
!sshn("UQSHRN", 1, 0x12)
!sshn("UQRSHRN", 1, 0x13)
/* Scalar fixed-point conversions */
!def ssfx(nm, u, opc) {
!sshone(nm, u, opc, "fhd", "fhn", 16, 1)
!sshone(nm, u, opc, "fsd", "fsn", 32, 1)
!sshone(nm, u, opc, "fdd", "fdn", 64, 1)
}
!ssfx("SCVTF", 0, 0x1c)
!ssfx("UCVTF", 1, 0x1c)
!ssfx("FCVTZS", 0, 0x1f)
!ssfx("FCVTZU", 1, 0x1f)

/* Scalar three different */
!def s3d(nm, opc) {
!{nm} fsd,fhn,fhm :: .call w4((1<<30)|(0x1e<<24)|(1<<22)|(1<<21)|(fhm<<16)|(!{opc}<<12)|(fhn<<5)|fsd)
!{nm} fdd,fsn,fsm :: .call w4((1<<30)|(0x1e<<24)|(2<<22)|(1<<21)|(fsm<<16)|(!{opc}<<12)|(fsn<<5)|fdd)
}
!s3d("SQDMLAL", 0x9)
!s3d("SQDMLSL", 0xb)
!s3d("SQDMULL", 0xd)

/* Scalar by element */
!def sbeh(nm, u, opc, rd, rn) {
!{nm} !{rd},!{rn},vl.H[!!i] ::i<0;3,i>7;3 :: .call w4((1<<30)|(!{u}<<29)|(0x1f<<24)|(1<<22)|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(!{opc}<<12)|(((i>>2)&1)<<11)|(!{rn}<<5)|!{rd})
}
!def sbehf(nm, u, opc, rd, rn) {
!{nm} !{rd},!{rn},vl.H[!!i] ::i<0;3,i>7;3 :: .call w4((1<<30)|(!{u}<<29)|(0x1f<<24)|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(!{opc}<<12)|(((i>>2)&1)<<11)|(!{rn}<<5)|!{rd})
}
!def sbes(nm, u, opc, rd, rn, sz) {
!{nm} !{rd},!{rn},vm.S[!!i] ::i<0;3,i>3;3 :: .call w4((1<<30)|(!{u}<<29)|(0x1f<<24)|(!{sz}<<22)|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(!{opc}<<12)|(((i>>1)&1)<<11)|(!{rn}<<5)|!{rd})
}
!def sbed(nm, u, opc, rd, rn) {
!{nm} !{rd},!{rn},vm.D[!!i] ::i<0;3,i>1;3 :: .call w4((1<<30)|(!{u}<<29)|(0x1f<<24)|(3<<22)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(!{opc}<<12)|(i<<11)|(!{rn}<<5)|!{rd})
}
!def sbei(nm, u, opc) {
!sbeh(nm, u, opc, "fhd", "fhn")
!sbes(nm, u, opc, "fsd", "fsn", 2)
}
!sbei("SQDMULH", 0, 0xc)
!sbei("SQRDMULH", 0, 0xd)
!sbei("SQRDMLAH", 1, 0xd)
!sbei("SQRDMLSH", 1, 0xf)
!def sbew(nm, opc) {
!sbeh(nm, 0, opc, "fsd", "fhn")
!sbes(nm, 0, opc, "fdd", "fsn", 2)
}
!sbew("SQDMLAL", 0x3)
!sbew("SQDMLSL", 0x7)
!sbew("SQDMULL", 0xb)
!def sbef(nm, u, opc) {
!sbehf(nm, u, opc, "fhd", "fhn")
!sbes(nm, u, opc, "fsd", "fsn", 2)
!sbed(nm, u, opc, "fdd", "fdn")
}
!sbef("FMLA", 0, 0x1)
!sbef("FMLS", 0, 0x5)
!sbef("FMUL", 0, 0x9)
!sbef("FMULX", 1, 0x9)

/* ===================================================================
/* Cryptographic extensions
/* =================================================================== */
/* AES: 0100 1110 0010 1000 opcode 10 Rn Rd */
!def aesop(nm, opc) {
!{nm} vd.16B,vn.16B :: .call w4(0x4e280800|(!{opc}<<12)|(vn<<5)|vd)
}
!aesop("AESE", 4)
!aesop("AESD", 5)
!aesop("AESMC", 6)
!aesop("AESIMC", 7)

/* SHA1 and SHA2 (three register) */
!def sha3r(nm, opc, rd, rn) {
!{nm} !{rd},!{rn},vm.4S :: .call w4(0x5e000000|(vm<<16)|(!{opc}<<12)|(!{rn}<<5)|!{rd})
}
!sha3r("SHA1C", 0, "fqd", "fsn")
!sha3r("SHA1P", 1, "fqd", "fsn")
!sha3r("SHA1M", 2, "fqd", "fsn")
!sha3r("SHA1SU0", 3, "vd", "vn")
!sha3r("SHA256H", 4, "fqd", "fqn")
!sha3r("SHA256H2", 5, "fqd", "fqn")
!sha3r("SHA256SU1", 6, "vd", "vn")
SHA1SU0 vd.4S,vn.4S,vm.4S :: .call w4(0x5e003000|(vm<<16)|(vn<<5)|vd)
SHA256SU1 vd.4S,vn.4S,vm.4S :: .call w4(0x5e006000|(vm<<16)|(vn<<5)|vd)
/* SHA1 and SHA2 (two register) */
SHA1H fsd,fsn :: .call w4(0x5e280800|(fsn<<5)|fsd)
SHA1SU1 vd.4S,vn.4S :: .call w4(0x5e281800|(vn<<5)|vd)
SHA256SU0 vd.4S,vn.4S :: .call w4(0x5e282800|(vn<<5)|vd)

/* SHA512, SHA3, SM3 and SM4 */
SHA512H fqd,fqn,vm.2D :: .call w4(0xce608000|(vm<<16)|(fqn<<5)|fqd)
SHA512H2 fqd,fqn,vm.2D :: .call w4(0xce608400|(vm<<16)|(fqn<<5)|fqd)
SHA512SU1 vd.2D,vn.2D,vm.2D :: .call w4(0xce608800|(vm<<16)|(vn<<5)|vd)
SHA512SU0 vd.2D,vn.2D :: .call w4(0xcec08000|(vn<<5)|vd)
RAX1 vd.2D,vn.2D,vm.2D :: .call w4(0xce608c00|(vm<<16)|(vn<<5)|vd)
EOR3 vd.16B,vn.16B,vm.16B,va.16B :: .call w4(0xce000000|(vm<<16)|(va<<10)|(vn<<5)|vd)
BCAX vd.16B,vn.16B,vm.16B,va.16B :: .call w4(0xce200000|(vm<<16)|(va<<10)|(vn<<5)|vd)
XAR vd.2D,vn.2D,vm.2D,#!i ::i<0;3,i>63;3 :: .call w4(0xce800000|(vm<<16)|(i<<10)|(vn<<5)|vd)
SM3SS1 vd.4S,vn.4S,vm.4S,va.4S :: .call w4(0xce400000|(vm<<16)|(va<<10)|(vn<<5)|vd)
!def sm3tt(nm, base) {
!{nm} vd.4S,vn.4S,vm.S[!!i] ::i<0;3,i>3;3 :: .call w4(!{base}|(vm<<16)|(i<<12)|(vn<<5)|vd)
}
!sm3tt("SM3TT1A", 0xce408000)
!sm3tt("SM3TT1B", 0xce408400)
!sm3tt("SM3TT2A", 0xce408800)
!sm3tt("SM3TT2B", 0xce408c00)
SM3PARTW1 vd.4S,vn.4S,vm.4S :: .call w4(0xce60c000|(vm<<16)|(vn<<5)|vd)
SM3PARTW2 vd.4S,vn.4S,vm.4S :: .call w4(0xce60c400|(vm<<16)|(vn<<5)|vd)
SM4EKEY vd.4S,vn.4S,vm.4S :: .call w4(0xce60c800|(vm<<16)|(vn<<5)|vd)
SM4E vd.4S,vn.4S :: .call w4(0xcec08400|(vn<<5)|vd)

/* ===================================================================
/* Complex number arithmetic (FEAT_FCMA)
/* =================================================================== */
!def fcadd(ar, q, sz) {
FCADD vd.!{ar},vn.!{ar},vm.!{ar},#!r ::(r!=90)&&(r!=270);3 :: .call w4((!{q}<<30)|(1<<29)|(0x0e<<24)|(!{sz}<<22)|(vm<<16)|((0xe|(r==270?1:0))<<12)|(1<<10)|(vn<<5)|vd)
}
!fcadd("4H", 0, 1)
!fcadd("8H", 1, 1)
!fcadd("2S", 0, 2)
!fcadd("4S", 1, 2)
!fcadd("2D", 1, 3)
!def fcmla(ar, q, sz) {
FCMLA vd.!{ar},vn.!{ar},vm.!{ar},#!r ::(r!=0)&&(r!=90)&&(r!=180)&&(r!=270);3 :: .call w4((!{q}<<30)|(1<<29)|(0x0e<<24)|(!{sz}<<22)|(vm<<16)|(0xc<<12)|((r==0?0:(r==90?1:(r==180?2:3)))<<11)|(1<<10)|(vn<<5)|vd)
}
!fcmla("4H", 0, 1)
!fcmla("8H", 1, 1)
!fcmla("2S", 0, 2)
!fcmla("4S", 1, 2)
!fcmla("2D", 1, 3)
FCMLA vd.4H,vn.4H,vl.H[!!i],#!r ::i<0;3,i>1;3,(r!=0)&&(r!=90)&&(r!=180)&&(r!=270);3 :: .call w4((1<<29)|(0x0f<<24)|(1<<22)|((i&1)<<21)|(vl<<16)|((r==0?0:(r==90?1:(r==180?2:3)))<<13)|(1<<12)|(vn<<5)|vd)
FCMLA vd.8H,vn.8H,vl.H[!!i],#!r ::i<0;3,i>3;3,(r!=0)&&(r!=90)&&(r!=180)&&(r!=270);3 :: .call w4((1<<30)|(1<<29)|(0x0f<<24)|(1<<22)|((i&1)<<21)|(vl<<16)|((r==0?0:(r==90?1:(r==180?2:3)))<<13)|(1<<12)|(((i>>1)&1)<<11)|(vn<<5)|vd)
FCMLA vd.4S,vn.4S,vm.S[!!i],#!r ::i<0;3,i>1;3,(r!=0)&&(r!=90)&&(r!=180)&&(r!=270);3 :: .call w4((1<<30)|(1<<29)|(0x0f<<24)|(2<<22)|(((vm>>4)&1)<<20)|((vm&15)<<16)|((r==0?0:(r==90?1:(r==180?2:3)))<<13)|(1<<12)|(i<<11)|(vn<<5)|vd)

/* ===================================================================
/* FP16 multiply-long, matrix multiply and BFloat16
/* =================================================================== */
!def fmlal(nm, u, sz, opc, dar, sar, q) {
!{nm} vd.!{dar},vn.!{sar},vm.!{sar} :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0e<<24)|(!{sz}<<22)|(1<<21)|(vm<<16)|(!{opc}<<11)|(1<<10)|(vn<<5)|vd)
}
!fmlal("FMLAL", 0, 0, 0x1d, "2S", "2H", 0)
!fmlal("FMLAL", 0, 0, 0x1d, "4S", "4H", 1)
!fmlal("FMLSL", 0, 2, 0x1d, "2S", "2H", 0)
!fmlal("FMLSL", 0, 2, 0x1d, "4S", "4H", 1)
!fmlal("FMLAL2", 1, 0, 0x19, "2S", "2H", 0)
!fmlal("FMLAL2", 1, 0, 0x19, "4S", "4H", 1)
!fmlal("FMLSL2", 1, 2, 0x19, "2S", "2H", 0)
!fmlal("FMLSL2", 1, 2, 0x19, "4S", "4H", 1)
!def fmlale(nm, u, opc, dar, sar, q) {
!{nm} vd.!{dar},vn.!{sar},vl.H[!!i] ::i<0;3,i>7;3 :: .call w4((!{q}<<30)|(!{u}<<29)|(0x0f<<24)|(2<<22)|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(!{opc}<<12)|(((i>>2)&1)<<11)|(vn<<5)|vd)
}
!fmlale("FMLAL", 0, 0x0, "2S", "2H", 0)
!fmlale("FMLAL", 0, 0x0, "4S", "4H", 1)
!fmlale("FMLSL", 0, 0x4, "2S", "2H", 0)
!fmlale("FMLSL", 0, 0x4, "4S", "4H", 1)
!fmlale("FMLAL2", 1, 0x8, "2S", "2H", 0)
!fmlale("FMLAL2", 1, 0x8, "4S", "4H", 1)
!fmlale("FMLSL2", 1, 0xc, "2S", "2H", 0)
!fmlale("FMLSL2", 1, 0xc, "4S", "4H", 1)

SMMLA vd.4S,vn.16B,vm.16B :: .call w4(0x4e80a400|(vm<<16)|(vn<<5)|vd)
UMMLA vd.4S,vn.16B,vm.16B :: .call w4(0x6e80a400|(vm<<16)|(vn<<5)|vd)
USMMLA vd.4S,vn.16B,vm.16B :: .call w4(0x4e80ac00|(vm<<16)|(vn<<5)|vd)
USDOT vd.2S,vn.8B,vm.8B :: .call w4(0x0e809c00|(vm<<16)|(vn<<5)|vd)
USDOT vd.4S,vn.16B,vm.16B :: .call w4(0x4e809c00|(vm<<16)|(vn<<5)|vd)
!def vusdote(nm, base, dar, sar, q) {
!{nm} vd.!{dar},vn.!{sar},vm.4B[!!i] ::i<0;3,i>3;3 :: .call w4(!{base}|(!{q}<<30)|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(((i>>1)&1)<<11)|(vn<<5)|vd)
}
!vusdote("USDOT", 0x0f80f000, "2S", "8B", 0)
!vusdote("USDOT", 0x0f80f000, "4S", "16B", 1)
!vusdote("SUDOT", 0x0f00f000, "2S", "8B", 0)
!vusdote("SUDOT", 0x0f00f000, "4S", "16B", 1)
BFDOT vd.2S,vn.4H,vm.4H :: .call w4(0x2e40fc00|(vm<<16)|(vn<<5)|vd)
BFDOT vd.4S,vn.8H,vm.8H :: .call w4(0x6e40fc00|(vm<<16)|(vn<<5)|vd)
BFDOT vd.2S,vn.4H,vm.2H[!!i] ::i<0;3,i>3;3 :: .call w4(0x0f40f000|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(((i>>1)&1)<<11)|(vn<<5)|vd)
BFDOT vd.4S,vn.8H,vm.2H[!!i] ::i<0;3,i>3;3 :: .call w4(0x4f40f000|((i&1)<<21)|(((vm>>4)&1)<<20)|((vm&15)<<16)|(((i>>1)&1)<<11)|(vn<<5)|vd)
BFMMLA vd.4S,vn.8H,vm.8H :: .call w4(0x6e40ec00|(vm<<16)|(vn<<5)|vd)
BFMLALB vd.4S,vn.8H,vm.8H :: .call w4(0x2ec0fc00|(vm<<16)|(vn<<5)|vd)
BFMLALT vd.4S,vn.8H,vm.8H :: .call w4(0x6ec0fc00|(vm<<16)|(vn<<5)|vd)
BFMLALB vd.4S,vn.8H,vl.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x0fc0f000|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(((i>>2)&1)<<11)|(vn<<5)|vd)
BFMLALT vd.4S,vn.8H,vl.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x4fc0f000|(((i>>1)&1)<<21)|((i&1)<<20)|(vl<<16)|(((i>>2)&1)<<11)|(vn<<5)|vd)
BFCVT fhd,fsn :: .call w4(0x1e634000|(fsn<<5)|fhd)
BFCVTN vd.4H,vn.4S :: .call w4(0x0ea16800|(vn<<5)|vd)
BFCVTN2 vd.8H,vn.4S :: .call w4(0x4ea16800|(vn<<5)|vd)

/* ===================================================================
/* Pointer authentication (FEAT_PAuth)
/* =================================================================== */
!def pacr(nm, opc) {
!{nm} xd,xs :: .call w4(0xdac10000|(!{opc}<<10)|(xs<<5)|xd)
}
!pacr("PACIA", 0)
!pacr("PACIB", 1)
!pacr("PACDA", 2)
!pacr("PACDB", 3)
!pacr("AUTIA", 4)
!pacr("AUTIB", 5)
!pacr("AUTDA", 6)
!pacr("AUTDB", 7)
!def pacz(nm, opc) {
!{nm} xd :: .call w4(0xdac10000|(!{opc}<<10)|(31<<5)|xd)
}
!pacz("PACIZA", 8)
!pacz("PACIZB", 9)
!pacz("PACDZA", 10)
!pacz("PACDZB", 11)
!pacz("AUTIZA", 12)
!pacz("AUTIZB", 13)
!pacz("AUTDZA", 14)
!pacz("AUTDZB", 15)
!pacz("XPACI", 16)
!pacz("XPACD", 17)
/* The SP-relative forms name SP explicitly */
!def pacsp(nm, opc) {
!{nm} xd,SP :: .call w4(0xdac10000|(!{opc}<<10)|(31<<5)|xd)
}
!pacsp("PACIA", 0)
!pacsp("PACIB", 1)
!pacsp("PACDA", 2)
!pacsp("PACDB", 3)
!pacsp("AUTIA", 4)
!pacsp("AUTIB", 5)
!pacsp("AUTDA", 6)
!pacsp("AUTDB", 7)

/* Authenticated branches */
BRAA xn,xm :: .call w4(0xd71f0800|(xn<<5)|xm)
BRAB xn,xm :: .call w4(0xd71f0c00|(xn<<5)|xm)
BLRAA xn,xm :: .call w4(0xd73f0800|(xn<<5)|xm)
BLRAB xn,xm :: .call w4(0xd73f0c00|(xn<<5)|xm)
BRAAZ xn :: .call w4(0xd61f081f|(xn<<5))
BRABZ xn :: .call w4(0xd61f0c1f|(xn<<5))
BLRAAZ xn :: .call w4(0xd63f081f|(xn<<5))
BLRABZ xn :: .call w4(0xd63f0c1f|(xn<<5))
RETAA :: .call w4(0xd65f0bff)
RETAB :: .call w4(0xd65f0fff)
ERETAA :: .call w4(0xd69f0bff)
ERETAB :: .call w4(0xd69f0fff)

/* Authenticated loads. The offset is a 10-bit signed value scaled by
/* 8, and its top bit sits at bit 22 rather than beside the rest. */
!def ldra(nm, m) {
!{nm} xt,[xb[[,#!o]]] ::(o&7)!=0;8,o<-4096;8,o>4088;8 :: .call w4(0xf8000000|(!{m}<<23)|((((o>>3)>>9)&1)<<22)|(1<<21)|(((o>>3)&0x1ff)<<12)|(1<<10)|(xb<<5)|xt)
!{nm} xt,[xb,#!o]\! ::(o&7)!=0;8,o<-4096;8,o>4088;8 :: .call w4(0xf8000000|(!{m}<<23)|((((o>>3)>>9)&1)<<22)|(1<<21)|(((o>>3)&0x1ff)<<12)|(1<<11)|(1<<10)|(xb<<5)|xt)
}
!ldra("LDRAA", 0)
!ldra("LDRAB", 1)

/* ===================================================================
/* Memory tagging (FEAT_MTE)
/* =================================================================== */
ADDG xs,xe,#!o,#!t ::(o&15)!=0;3,o<0;3,o>1008;3,t<0;3,t>15;3 :: .call w4(0x91800000|((o>>4)<<16)|(t<<10)|(xe<<5)|xs)
SUBG xs,xe,#!o,#!t ::(o&15)!=0;3,o<0;3,o>1008;3,t<0;3,t>15;3 :: .call w4(0xd1800000|((o>>4)<<16)|(t<<10)|(xe<<5)|xs)
IRG xs,xe :: .call w4(0x9ac01000|(31<<16)|(xe<<5)|xs)
IRG xs,xe,xm :: .call w4(0x9ac01000|(xm<<16)|(xe<<5)|xs)
GMI xd,xe,xm :: .call w4(0x9ac01400|(xm<<16)|(xe<<5)|xd)
SUBP xd,xe,xf :: .call w4(0x9ac00000|(xf<<16)|(xe<<5)|xd)
SUBPS xd,xe,xf :: .call w4(0xbac00000|(xf<<16)|(xe<<5)|xd)
CMPP xe,xf :: .call w4(0xbac0001f|(xf<<16)|(xe<<5))
/* Tag stores. idx 2 is the plain offset form, 3 pre-index, 1 post. */
!def stgf(nm, base) {
!{nm} xt,[xb[[,#!o]]] ::(o&15)!=0;8,o<-4096;8,o>4080;8 :: .call w4(!{base}|(((o>>4)&0x1ff)<<12)|(2<<10)|(xb<<5)|xt)
!{nm} xt,[xb,#!o]\! ::(o&15)!=0;8,o<-4096;8,o>4080;8 :: .call w4(!{base}|(((o>>4)&0x1ff)<<12)|(3<<10)|(xb<<5)|xt)
!{nm} xt,[xb],#!o ::(o&15)!=0;8,o<-4096;8,o>4080;8 :: .call w4(!{base}|(((o>>4)&0x1ff)<<12)|(1<<10)|(xb<<5)|xt)
}
!stgf("STG", 0xd9200000)
!stgf("STZG", 0xd9600000)
!stgf("ST2G", 0xd9a00000)
!stgf("STZ2G", 0xd9e00000)
LDG xt,[xb[[,#!o]]] ::(o&15)!=0;8,o<-4096;8,o>4080;8 :: .call w4(0xd9600000|(((o>>4)&0x1ff)<<12)|(xb<<5)|xt)
LDGM xt,[xb] :: .call w4(0xd9e00000|(xb<<5)|xt)
STGM xt,[xb] :: .call w4(0xd9a00000|(xb<<5)|xt)
STZGM xt,[xb] :: .call w4(0xd9200000|(xb<<5)|xt)
STGP xt,xu,[xb[[,#!o]]] ::(o&15)!=0;8,(o>>4)<-64;8,(o>>4)>63;8 :: .call w4(0x69000000|(((o>>4)&0x7f)<<15)|(xu<<10)|(xb<<5)|xt)
STGP xt,xu,[xb,#!o]\! ::(o&15)!=0;8,(o>>4)<-64;8,(o>>4)>63;8 :: .call w4(0x69800000|(((o>>4)&0x7f)<<15)|(xu<<10)|(xb<<5)|xt)
STGP xt,xu,[xb],#!o ::(o&15)!=0;8,(o>>4)<-64;8,(o>>4)>63;8 :: .call w4(0x68800000|(((o>>4)&0x7f)<<15)|(xu<<10)|(xb<<5)|xt)

/* ===================================================================
/* Load-acquire / store-release unscaled (FEAT_LRCPC2)
/* =================================================================== */
!def lrcpc2(nm, base, rt) {
!{nm} !{rt},[xb[[,#!o]]] ::o<-256;8,o>255;8 :: .call w4(!{base}|((o&0x1ff)<<12)|(xb<<5)|!{rt})
}
!lrcpc2("STLURB", 0x19000000, "wt")
!lrcpc2("LDAPURB", 0x19400000, "wt")
!lrcpc2("LDAPURSB", 0x19800000, "xt")
!lrcpc2("LDAPURSB", 0x19c00000, "wt")
!lrcpc2("STLURH", 0x59000000, "wt")
!lrcpc2("LDAPURH", 0x59400000, "wt")
!lrcpc2("LDAPURSH", 0x59800000, "xt")
!lrcpc2("LDAPURSH", 0x59c00000, "wt")
!lrcpc2("STLUR", 0x99000000, "wt")
!lrcpc2("LDAPUR", 0x99400000, "wt")
!lrcpc2("LDAPURSW", 0x99800000, "xt")
!lrcpc2("STLUR", 0xd9000000, "xt")
!lrcpc2("LDAPUR", 0xd9400000, "xt")

/* ===================================================================
/* Memory copy and set (FEAT_MOPS)
/* =================================================================== */
!def mopscpy(nm, b26, pme, opt) {
!{nm} [xd]\!,[xe]\!,xn\! :: .call w4(0x19000000|(!{b26}<<26)|(!{pme}<<22)|(xe<<16)|(!{opt}<<12)|(1<<10)|(xn<<5)|xd)
}
!def mopsset(nm, b26, pme, opt) {
!{nm} [xd]\!,xn\!,xm :: .call w4(0x19000000|(!{b26}<<26)|(3<<22)|(xm<<16)|(!{pme}<<14)|(!{opt}<<12)|(1<<10)|(xn<<5)|xd)
}
