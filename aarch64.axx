/* ===================================================================
/* Advanced SIMD scalar forms
/*
/* Every scalar block is its vector counterpart with bits 31:30 set to
/* 01 and bit 28 set, so the opcode numbers below are the same ones
/* the vector rows above use. The operands are the plain B/H/S/D
/* registers rather than an arrangement.
/* =================================================================== */
!def s3one(nm, u, opc, rd, rn, rm, sz) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((1<<30)|(!{u}<<29)|(0x1e<<24)|(!{sz}<<22)|(1<<21)|(!{rm}<<16)|(!{opc}<<11)|(1<<10)|(!{rn}<<5)|!{rd})
}
/* set 0 = D only, 1 = B/H/S/D, 2 = H/S */
!def s3i(nm, u, opc, set) {
!if set == 0 !then {
!s3one(nm, u, opc, "fdd", "fdn", "fdm", 3)
}
!if set == 1 !then {
!s3one(nm, u, opc, "fbd", "fbn", "fbm", 0)
!s3one(nm, u, opc, "fhd", "fhn", "fhm", 1)
!s3one(nm, u, opc, "fsd", "fsn", "fsm", 2)
!s3one(nm, u, opc, "fdd", "fdn", "fdm", 3)
}
!if set == 2 !then {
!s3one(nm, u, opc, "fhd", "fhn", "fhm", 1)
!s3one(nm, u, opc, "fsd", "fsn", "fsm", 2)
}
}
.check::fbm::BR
!s3i("SQADD", 0, 0x01, 1)
!s3i("UQADD", 1, 0x01, 1)
!s3i("SQSUB", 0, 0x05, 1)
!s3i("UQSUB", 1, 0x05, 1)
