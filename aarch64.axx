!lsm4("ST4", 0, 0x0, "2S", 0, 2, 32)
!lsm4("ST4", 0, 0x0, "4S", 1, 2, 64)
!lsm4("ST4", 0, 0x0, "2D", 1, 3, 64)
/* LD1: 1 register per group */
!lsm1("LD1", 1, 0x7, "8B", 0, 0, 8)
