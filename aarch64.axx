SBCLT zd.D,zn.D,zm.D :: .call w4(0x45c0d400|(zm<<16)|(zn<<5)|zd)

/* Complex integer arithmetic */
!def sv2cadd(nm, op, el, sz) {
!{nm} zd.!{el},zd.!{el},zm.!{el},#90 :: .call w4(0x4500d800|(!{sz}<<22)|(!{op}<<16)|(zm<<5)|zd)
!{nm} zd.!{el},zd.!{el},zm.!{el},#270 :: .call w4(0x4500dc00|(!{sz}<<22)|(!{op}<<16)|(zm<<5)|zd)
}
!def sv2cadda(nm, op) {
!sv2cadd(nm, op, "B", 0)
!sv2cadd(nm, op, "H", 1)
!sv2cadd(nm, op, "S", 2)
!sv2cadd(nm, op, "D", 3)
}
!sv2cadda("CADD", 0)
!sv2cadda("SQCADD", 1)
!def sv2cmla(nm, base, el, sz, r, rv) {
!{nm} zd.!{el},zn.!{el},zm.!{el},#!{r} :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(!{rv}<<10)|(zn<<5)|zd)
}
!def sv2cmlaa(nm, base, el, sz) {
!sv2cmla(nm, base, el, sz, 0, 0)
!sv2cmla(nm, base, el, sz, 90, 1)
!sv2cmla(nm, base, el, sz, 180, 2)
!sv2cmla(nm, base, el, sz, 270, 3)
}
!def sv2cmlab(nm, base) {
!sv2cmlaa(nm, base, "B", 0)
!sv2cmlaa(nm, base, "H", 1)
!sv2cmlaa(nm, base, "S", 2)
!sv2cmlaa(nm, base, "D", 3)
}
!sv2cmlab("CMLA", 0x44002000)
!sv2cmlab("SQRDCMLAH", 0x44003000)
!def sv2cmlai(nm, base, r, rv) {
!{nm} zd.H,zn.H,zy.H[!!i],#!{r} ::i<0;3,i>3;3 :: .call w4(!{base}|0x200000|(i<<19)|(zy<<16)|(!{rv}<<10)|(zn<<5)|zd)
!{nm} zd.S,zn.S,zx.S[!!i],#!{r} ::i<0;3,i>1;3 :: .call w4(!{base}|0x600000|(i<<20)|(zx<<16)|(!{rv}<<10)|(zn<<5)|zd)
}
!def sv2cmlaia(nm, base) {
!sv2cmlai(nm, base, 0, 0)
!sv2cmlai(nm, base, 90, 1)
!sv2cmlai(nm, base, 180, 2)
!sv2cmlai(nm, base, 270, 3)
}
!sv2cmlaia("CMLA", 0x44806000)
!sv2cmlaia("SQRDCMLAH", 0x44807000)
/* Complex dot product */
!def sv2cdot(r, rv) {
CDOT zd.S,zn.B,zm.B,#!{r} :: .call w4(0x44801000|(zm<<16)|(!{rv}<<10)|(zn<<5)|zd)
CDOT zd.D,zn.H,zm.H,#!{r} :: .call w4(0x44c01000|(zm<<16)|(!{rv}<<10)|(zn<<5)|zd)
CDOT zd.S,zn.B,zy.B[!!i],#!{r} ::i<0;3,i>3;3 :: .call w4(0x44a04000|(i<<19)|(zy<<16)|(!{rv}<<10)|(zn<<5)|zd)
CDOT zd.D,zn.H,zx.H[!!i],#!{r} ::i<0;3,i>1;3 :: .call w4(0x44e04000|(i<<20)|(zx<<16)|(!{rv}<<10)|(zn<<5)|zd)
}
!sv2cdot(0, 0)
!sv2cdot(90, 1)
!sv2cdot(180, 2)
!sv2cdot(270, 3)

/* Multiply by an indexed element */
!def sv2mi(nm, opc) {
!{nm} zd.H,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x44200000|((i>>2)<<22)|((i&3)<<19)|(zy<<16)|(!{opc}<<10)|(zn<<5)|zd)
!{nm} zd.S,zn.S,zy.S[!!i] ::i<0;3,i>3;3 :: .call w4(0x44a00000|(i<<19)|(zy<<16)|(!{opc}<<10)|(zn<<5)|zd)
!{nm} zd.D,zn.D,zx.D[!!i] ::i<0;3,i>1;3 :: .call w4(0x44e00000|(i<<20)|(zx<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!sv2mi("MLA", 0x02)
!sv2mi("MLS", 0x03)
!sv2mi("SQRDMLAH", 0x04)
!sv2mi("SQRDMLSH", 0x05)
!sv2mi("SQDMULH", 0x3c)
!sv2mi("SQRDMULH", 0x3d)
!sv2mi("MUL", 0x3e)
!def sv2rdml(nm, opc, el, sz) {
!{nm} zd.!{el},zn.!{el},zm.!{el} :: .call w4(0x44000000|(!{sz}<<22)|(zm<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!def sv2rdmla(nm, opc) {
!sv2rdml(nm, opc, "B", 0)
!sv2rdml(nm, opc, "H", 1)
!sv2rdml(nm, opc, "S", 2)
!sv2rdml(nm, opc, "D", 3)
}
!sv2rdmla("SQRDMLAH", 0x1c)
!sv2rdmla("SQRDMLSH", 0x1d)

/* Multiply long by an indexed element.  The index splits between bits
/* 20-19 and bit 11, and bit 10 picks the top or bottom half. */
!def sv2mli(nm, opc, tb) {
!{nm} zd.S,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x44a00000|((i>>1)<<19)|(zy<<16)|(!{opc}<<12)|((i&1)<<11)|(!{tb}<<10)|(zn<<5)|zd)
!{nm} zd.D,zn.S,zx.S[!!i] ::i<0;3,i>3;3 :: .call w4(0x44e00000|(zx<<16)|(!{opc}<<12)|((i&1)<<11)|((i>>1)<<20)|(!{tb}<<10)|(zn<<5)|zd)
}
!sv2mli("SQDMLALB", 0x2, 0)
!sv2mli("SQDMLALT", 0x2, 1)
!sv2mli("SQDMLSLB", 0x3, 0)
!sv2mli("SQDMLSLT", 0x3, 1)
!sv2mli("SMLALB", 0x8, 0)
!sv2mli("SMLALT", 0x8, 1)
!sv2mli("UMLALB", 0x9, 0)
!sv2mli("UMLALT", 0x9, 1)
!sv2mli("SMLSLB", 0xa, 0)
!sv2mli("SMLSLT", 0xa, 1)
!sv2mli("UMLSLB", 0xb, 0)
!sv2mli("UMLSLT", 0xb, 1)
!sv2mli("SMULLB", 0xc, 0)
!sv2mli("SMULLT", 0xc, 1)
!sv2mli("UMULLB", 0xd, 0)
!sv2mli("UMULLT", 0xd, 1)
!sv2mli("SQDMULLB", 0xe, 0)
!sv2mli("SQDMULLT", 0xe, 1)

/* Half-precision multiply-accumulate to single precision */
FMLALB zd.S,zn.H,zm.H :: .call w4(0x64a08000|(zm<<16)|(zn<<5)|zd)
FMLALT zd.S,zn.H,zm.H :: .call w4(0x64a08400|(zm<<16)|(zn<<5)|zd)
FMLSLB zd.S,zn.H,zm.H :: .call w4(0x64a0a000|(zm<<16)|(zn<<5)|zd)
FMLSLT zd.S,zn.H,zm.H :: .call w4(0x64a0a400|(zm<<16)|(zn<<5)|zd)
!def sv2fmlal(nm, sub, tb) {
!{nm} zd.S,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x64a04000|((i>>1)<<19)|(zy<<16)|(!{sub}<<13)|((i&1)<<11)|(!{tb}<<10)|(zn<<5)|zd)
}
!sv2fmlal("FMLALB", 0, 0)
!sv2fmlal("FMLALT", 0, 1)
!sv2fmlal("FMLSLB", 1, 0)
!sv2fmlal("FMLSLT", 1, 1)

/* Histogram, match and table lookup */
HISTCNT zd.S,pg/Z,zn.S,zm.S :: .call w4(0x45a0c000|(zm<<16)|(pg<<10)|(zn<<5)|zd)
HISTCNT zd.D,pg/Z,zn.D,zm.D :: .call w4(0x45e0c000|(zm<<16)|(pg<<10)|(zn<<5)|zd)
HISTSEG zd.B,zn.B,zm.B :: .call w4(0x4520a000|(zm<<16)|(zn<<5)|zd)
MATCH pd.B,pg/Z,zn.B,zm.B :: .call w4(0x45208000|(zm<<16)|(pg<<10)|(zn<<5)|pd)
MATCH pd.H,pg/Z,zn.H,zm.H :: .call w4(0x45608000|(zm<<16)|(pg<<10)|(zn<<5)|pd)
NMATCH pd.B,pg/Z,zn.B,zm.B :: .call w4(0x45208010|(zm<<16)|(pg<<10)|(zn<<5)|pd)
NMATCH pd.H,pg/Z,zn.H,zm.H :: .call w4(0x45608010|(zm<<16)|(pg<<10)|(zn<<5)|pd)
!def sv2tbl(el, sz) {
TBL zd.!{el},{zn.!{el},za.!{el}},zm.!{el} :: .call w4(0x05202800|(!{sz}<<22)|(zm<<16)|(zn<<5)|zd)
TBX zd.!{el},zn.!{el},zm.!{el} :: .call w4(0x05202c00|(!{sz}<<22)|(zm<<16)|(zn<<5)|zd)
SPLICE zd.!{el},pg,{zn.!{el},za.!{el}} :: .call w4(0x052d8000|(!{sz}<<22)|(pg<<10)|(zn<<5)|zd)
}
!sv2tbl("B", 0)
!sv2tbl("H", 1)
!sv2tbl("S", 2)
!sv2tbl("D", 3)

/* Read-after-write and write-after-read predicates */
!def sv2while(nm, rw, el, sz) {
!{nm} pd.!{el},xn,xm :: .call w4(0x25203000|(!{sz}<<22)|(xm<<16)|(!{rw}<<4)|(xn<<5)|pd)
}
!def sv2whilea(nm, rw) {
!sv2while(nm, rw, "B", 0)
!sv2while(nm, rw, "H", 1)
!sv2while(nm, rw, "S", 2)
!sv2while(nm, rw, "D", 3)
}
!sv2whilea("WHILERW", 1)
!sv2whilea("WHILEWR", 0)

/* Bitwise ternary, on doublewords only */
BSL zd.D,zd.D,zm.D,zk.D :: .call w4(0x04203c00|(zm<<16)|(zk<<5)|zd)
BSL1N zd.D,zd.D,zm.D,zk.D :: .call w4(0x04603c00|(zm<<16)|(zk<<5)|zd)
BSL2N zd.D,zd.D,zm.D,zk.D :: .call w4(0x04a03c00|(zm<<16)|(zk<<5)|zd)
NBSL zd.D,zd.D,zm.D,zk.D :: .call w4(0x04e03c00|(zm<<16)|(zk<<5)|zd)
EOR3 zd.D,zd.D,zm.D,zk.D :: .call w4(0x04203800|(zm<<16)|(zk<<5)|zd)
BCAX zd.D,zd.D,zm.D,zk.D :: .call w4(0x04603800|(zm<<16)|(zk<<5)|zd)
!def sv2xar(el, es) {
XAR zd.!{el},zd.!{el},zm.!{el},#!s ::s<1;3,s>!{es};3 :: .call w4(0x04203400|((((!{es}*2-s)>>5)&3)<<22)|(((!{es}*2-s)&0x1f)<<16)|(zm<<5)|zd)
}
!sv2xar("B", 8)
!sv2xar("H", 16)
!sv2xar("S", 32)
!sv2xar("D", 64)

/* Cryptography */
AESE zd.B,zd.B,zm.B :: .call w4(0x4522e000|(zm<<5)|zd)
AESD zd.B,zd.B,zm.B :: .call w4(0x4522e400|(zm<<5)|zd)
AESMC zd.B,zd.B :: .call w4(0x4520e000|zd)
AESIMC zd.B,zd.B :: .call w4(0x4520e400|zd)
RAX1 zd.D,zn.D,zm.D :: .call w4(0x4520f400|(zm<<16)|(zn<<5)|zd)
SM4E zd.S,zd.S,zm.S :: .call w4(0x4523e000|(zm<<5)|zd)
SM4EKEY zd.S,zn.S,zm.S :: .call w4(0x4520f000|(zm<<16)|(zn<<5)|zd)

/* -------------------------------------------------------------------
/* SME: streaming mode, the ZA array and outer products.
/*
/* A ZA tile slice is written za<t><h|v>.<el>[<Ws>, <index>].  The tile
/* number and the index share one field, the tile in the high bits and
/* the index in the low ones, so a byte slice is all index and a
/* quadword slice all tile.
/* ------------------------------------------------------------------- */
.check::ws::W12,W13,W14,W15
.check::pf::PLO

/* Entering and leaving streaming mode */
SMSTART :: 0x7f,0x47,0x03,0xd5
SMSTOP :: 0x7f,0x46,0x03,0xd5
SMSTART SM :: 0x7f,0x43,0x03,0xd5
SMSTART ZA :: 0x7f,0x45,0x03,0xd5
SMSTOP SM :: 0x7f,0x42,0x03,0xd5
SMSTOP ZA :: 0x7f,0x44,0x03,0xd5

/* Streaming vector length arithmetic */
RDSVL xd,#!v ::v<-32;3,v>31;3 :: .call w4(0x04bf5800|((v&0x3f)<<5)|xd)
ADDSVL xs,xe,#!v ::v<-32;3,v>31;3 :: .call w4(0x04205800|(xe<<16)|((v&0x3f)<<5)|xs)
ADDSPL xs,xe,#!v ::v<-32;3,v>31;3 :: .call w4(0x04605800|(xe<<16)|((v&0x3f)<<5)|xs)

/* Zero tiles.  One row per list length covers every combination. */
ZERO {} :: .call w4(0xc0080000)
ZERO {ZA} :: .call w4(0xc00800ff)
ZERO {ZA0.B} :: .call w4(0xc00800ff)
ZERO {ZA!!a.H} ::a>1;3 :: .call w4(0xc0080000|((0x55<<a)&0xff))
ZERO {ZA!!a.H,ZA!!b.H} ::a>1;3,b>1;3 :: .call w4(0xc0080000|(((0x55<<a)|(0x55<<b))&0xff))
ZERO {ZA!!a.S} ::a>3;3 :: .call w4(0xc0080000|((0x11<<a)&0xff))
ZERO {ZA!!a.S,ZA!!b.S} ::a>3;3,b>3;3 :: .call w4(0xc0080000|(((0x11<<a)|(0x11<<b))&0xff))
ZERO {ZA!!a.S,ZA!!b.S,ZA!!c.S} ::a>3;3,b>3;3,c>3;3 :: .call w4(0xc0080000|(((0x11<<a)|(0x11<<b)|(0x11<<c))&0xff))
ZERO {ZA!!a.S,ZA!!b.S,ZA!!c.S,ZA!!d.S} ::a>3;3,b>3;3,c>3;3,d>3;3 :: .call w4(0xc0080000|(((0x11<<a)|(0x11<<b)|(0x11<<c)|(0x11<<d))&0xff))
ZERO {ZA!!a.D} ::a>7;3 :: .call w4(0xc0080000|(1<<a))
ZERO {ZA!!a.D,ZA!!b.D} ::a>7;3,b>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b))
ZERO {ZA!!a.D,ZA!!b.D,ZA!!c.D} ::a>7;3,b>7;3,c>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b)|(1<<c))
ZERO {ZA!!a.D,ZA!!b.D,ZA!!c.D,ZA!!d.D} ::a>7;3,b>7;3,c>7;3,d>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b)|(1<<c)|(1<<d))
ZERO {ZA!!a.D,ZA!!b.D,ZA!!c.D,ZA!!d.D,ZA!!e.D} ::a>7;3,b>7;3,c>7;3,d>7;3,e>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b)|(1<<c)|(1<<d)|(1<<e))
ZERO {ZA!!a.D,ZA!!b.D,ZA!!c.D,ZA!!d.D,ZA!!e.D,ZA!!f.D} ::a>7;3,b>7;3,c>7;3,d>7;3,e>7;3,f>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b)|(1<<c)|(1<<d)|(1<<e)|(1<<f))
ZERO {ZA!!a.D,ZA!!b.D,ZA!!c.D,ZA!!d.D,ZA!!e.D,ZA!!f.D,ZA!!g.D} ::a>7;3,b>7;3,c>7;3,d>7;3,e>7;3,f>7;3,g>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b)|(1<<c)|(1<<d)|(1<<e)|(1<<f)|(1<<g))
ZERO {ZA!!a.D,ZA!!b.D,ZA!!c.D,ZA!!d.D,ZA!!e.D,ZA!!f.D,ZA!!g.D,ZA!!h.D} ::a>7;3,b>7;3,c>7;3,d>7;3,e>7;3,f>7;3,g>7;3,h>7;3 :: .call w4(0xc0080000|(1<<a)|(1<<b)|(1<<c)|(1<<d)|(1<<e)|(1<<f)|(1<<g)|(1<<h))

/* Move between a vector and a tile slice */
!def smmova(nm, el, szc, q, nb, maxt, maxi, hv, vb) {
!{nm} zd.!{el},pg/M,ZA!!t!{hv}.!{el}[ws,!!i] ::t>!{maxt};3,i>!{maxi};3 :: .call w4(0xc0020000|(!{szc}<<22)|(!{q}<<16)|(!{vb}<<15)|((ws-12)<<13)|(pg<<10)|((((t<<!{nb})|i)&0x1f)<<5)|zd)
!{nm} ZA!!t!{hv}.!{el}[ws,!!i],pg/M,zn.!{el} ::t>!{maxt};3,i>!{maxi};3 :: .call w4(0xc0000000|(!{szc}<<22)|(!{q}<<16)|(!{vb}<<15)|((ws-12)<<13)|(pg<<10)|(zn<<5)|(((t<<!{nb})|i)&0x1f))
}
!def smmovaa(nm, el, szc, q, nb, maxt, maxi) {
!smmova(nm, el, szc, q, nb, maxt, maxi, "H", 0)
!smmova(nm, el, szc, q, nb, maxt, maxi, "V", 1)
}
!def smmovall(nm) {
!smmovaa(nm, "B", 0, 0, 4, 0, 15)
!smmovaa(nm, "H", 1, 0, 3, 1, 7)
!smmovaa(nm, "S", 2, 0, 2, 3, 3)
!smmovaa(nm, "D", 3, 0, 1, 7, 1)
!smmovaa(nm, "Q", 3, 1, 0, 15, 0)
}
!smmovall("MOVA")
!smmovall("MOV")

/* Load and store a tile slice */
!def smls(sfx, el, msz, nb, maxt, maxi, hv, vb, ix) {
LD1!{sfx} {ZA!!t!{hv}.!{el}[ws,!!i]},pg/Z,[xb] ::t>!{maxt};3,i>!{maxi};3 :: .call w4(0xe0000000|(!{msz}<<22)|(31<<16)|(!{vb}<<15)|((ws-12)<<13)|(pg<<10)|(xb<<5)|(((t<<!{nb})|i)&0xf))
LD1!{sfx} {ZA!!t!{hv}.!{el}[ws,!!i]},pg/Z,[xb,!{ix}] ::t>!{maxt};3,i>!{maxi};3 :: .call w4(0xe0000000|(!{msz}<<22)|(xm<<16)|(!{vb}<<15)|((ws-12)<<13)|(pg<<10)|(xb<<5)|(((t<<!{nb})|i)&0xf))
ST1!{sfx} {ZA!!t!{hv}.!{el}[ws,!!i]},pg,[xb] ::t>!{maxt};3,i>!{maxi};3 :: .call w4(0xe0200000|(!{msz}<<22)|(31<<16)|(!{vb}<<15)|((ws-12)<<13)|(pg<<10)|(xb<<5)|(((t<<!{nb})|i)&0xf))
ST1!{sfx} {ZA!!t!{hv}.!{el}[ws,!!i]},pg,[xb,!{ix}] ::t>!{maxt};3,i>!{maxi};3 :: .call w4(0xe0200000|(!{msz}<<22)|(xm<<16)|(!{vb}<<15)|((ws-12)<<13)|(pg<<10)|(xb<<5)|(((t<<!{nb})|i)&0xf))
}
!def smlsa(sfx, el, msz, nb, maxt, maxi, ix) {
!smls(sfx, el, msz, nb, maxt, maxi, "H", 0, ix)
!smls(sfx, el, msz, nb, maxt, maxi, "V", 1, ix)
}
!smlsa("B", "B", 0, 4, 0, 15, "xm")
!smlsa("H", "H", 1, 3, 1, 7, "xm,LSL #1")
!smlsa("W", "S", 2, 2, 3, 3, "xm,LSL #2")
!smlsa("D", "D", 3, 1, 7, 1, "xm,LSL #3")
!smlsa("Q", "Q", 7, 0, 15, 0, "xm,LSL #4")

/* Load and store the whole array, one vector at a time */
LDR ZA[ws,!!i],[xb] ::i!=0;8 :: .call w4(0xe1000000|((ws-12)<<13)|(xb<<5)|i)
LDR ZA[ws,!!i],[xb,#!v,MUL VL] ::i>15;3,v!=i;8 :: .call w4(0xe1000000|((ws-12)<<13)|(xb<<5)|i)
STR ZA[ws,!!i],[xb] ::i!=0;8 :: .call w4(0xe1200000|((ws-12)<<13)|(xb<<5)|i)
STR ZA[ws,!!i],[xb,#!v,MUL VL] ::i>15;3,v!=i;8 :: .call w4(0xe1200000|((ws-12)<<13)|(xb<<5)|i)

/* Add a vector to every row or column of a tile */
!def smadda(nm, op, el, b22, maxt) {
!{nm} ZA!!t.!{el},pg/M,pf/M,zn.!{el} ::t>!{maxt};3 :: .call w4(0xc0900000|(!{b22}<<22)|(!{op}<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)
}
!def smaddaa(nm, op) {
!smadda(nm, op, "S", 0, 3)
!smadda(nm, op, "D", 1, 7)
}
!smaddaa("ADDHA", 0)
!smaddaa("ADDVA", 1)

/* Outer products */
!def smmopa(nm, base, sub, el, sel, maxt) {
!{nm} ZA!!t.!{el},pg/M,pf/M,zn.!{sel},zm.!{sel} ::t>!{maxt};3 :: .call w4(!{base}|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|(!{sub}<<4)|t)
}
!def smmopi(nm, base, sub) {
!smmopa(nm, base, sub, "S", "B", 3)
!smmopa(nm, base + 0x00400000, sub, "D", "H", 7)
}
!smmopi("SMOPA", 0xa0800000, 0)
!smmopi("SMOPS", 0xa0800000, 1)
!smmopi("SUMOPA", 0xa0a00000, 0)
!smmopi("SUMOPS", 0xa0a00000, 1)
!smmopi("USMOPA", 0xa1800000, 0)
!smmopi("USMOPS", 0xa1800000, 1)
!smmopi("UMOPA", 0xa1a00000, 0)
!smmopi("UMOPS", 0xa1a00000, 1)
!smmopa("FMOPA", 0x80800000, 0, "S", "S", 3)
!smmopa("FMOPS", 0x80800000, 1, "S", "S", 3)
!smmopa("FMOPA", 0x80c00000, 0, "D", "D", 7)
!smmopa("FMOPS", 0x80c00000, 1, "D", "D", 7)
!smmopa("FMOPA", 0x81a00000, 0, "S", "H", 3)
!smmopa("FMOPS", 0x81a00000, 1, "S", "H", 3)
!smmopa("BFMOPA", 0x81800000, 0, "S", "H", 3)
!smmopa("BFMOPS", 0x81800000, 1, "S", "H", 3)

/* Predicate select, and the vector instructions SME adds */
!def smpsel(el, es, mx) {
PSEL pd,pn,pm.!{el}[ws,!!i] ::i>!{mx};3 :: .call w4(0x25204000|(((((i*!{es*2})|!{es})>>3)&3)<<22)|((((i*!{es*2})|!{es})&7)<<18)|((ws-12)<<16)|(pn<<10)|(pm<<5)|pd)
}
!smpsel("B", 1, 15)
!smpsel("H", 2, 7)
!smpsel("S", 4, 3)
!smpsel("D", 8, 1)
REVD zd.Q,pg/M,zn.Q :: .call w4(0x052e8000|(pg<<10)|(zn<<5)|zd)
!def smclamp(nm, base, el, sz) {
!{nm} zd.!{el},zn.!{el},zm.!{el} :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(zn<<5)|zd)
}
!def smclampa(nm, base) {
!smclamp(nm, base, "B", 0)
!smclamp(nm, base, "H", 1)
!smclamp(nm, base, "S", 2)
!smclamp(nm, base, "D", 3)
}
!smclampa("SCLAMP", 0x4400c000)
!smclampa("UCLAMP", 0x4400c400)
!smclamp("FCLAMP", 0x64202400, "H", 1)
!smclamp("FCLAMP", 0x64202400, "S", 2)
!smclamp("FCLAMP", 0x64202400, "D", 3)

/* Loop termination test */
CTERMEQ wn,wm :: .call w4(0x25a02000|(wm<<16)|(wn<<5))
CTERMNE wn,wm :: .call w4(0x25a02010|(wm<<16)|(wn<<5))
CTERMEQ xn,xm :: .call w4(0x25e02000|(xm<<16)|(xn<<5))
CTERMNE xn,xm :: .call w4(0x25e02010|(xm<<16)|(xn<<5))

/* A merging move of floating-point zero is the integer copy of zero */
FMOV zd.H,pv/M,#0.0 :: .call w4(0x05504000|(pv<<16)|zd)
FMOV zd.S,pv/M,#0.0 :: .call w4(0x05904000|(pv<<16)|zd)
FMOV zd.D,pv/M,#0.0 :: .call w4(0x05d04000|(pv<<16)|zd)

/* -------------------------------------------------------------------
/* SME2.
/*
/* Two new operand shapes appear here.  A predicate-as-counter is
/* written pn8-pn15 and holds a count rather than a bit per element;
/* its field is the register number less eight.  A multi-vector list
/* is written {z0.s, z1.s} for a pair and {z0.s - z3.s} for a quad,
/* and only the first register is encoded, so the list has to start on
/* an even or a multiple-of-four boundary.
/* ------------------------------------------------------------------- */
.setsym::PN8::8
.setsym::PN9::9
.setsym::PN10::10
.setsym::PN11::11
.setsym::PN12::12
.setsym::PN13::13
.setsym::PN14::14
.setsym::PN15::15
.setsym::PNS::PN8,PN9,PN10,PN11,PN12,PN13,PN14,PN15
.check::pnn::PNS
.check::pnm::PNS
.check::pe::PR
.check::pk::PR

/* Predicate-as-counter generation and use */
!def s2pn(el, sz) {
PTRUE pnn.!{el} :: .call w4(0x25207810|(!{sz}<<22)|(pnn-8))
PEXT pd.!{el},pnn[!!i] ::i>1;3 :: .call w4(0x25207010|(!{sz}<<22)|(i<<8)|((pnn-8)<<5)|pd)
PEXT {pd.!{el},pe.!{el}},pnn[!!i] ::i>1;3,(pd&1)!=0;5,pe!=pd+1;5 :: .call w4(0x25207410|(!{sz}<<22)|(i<<8)|((pnn-8)<<5)|pd)
CNTP xd,pnn.!{el},VLX2 :: .call w4(0x25208300|(!{sz}<<22)|((pnn-8)<<5)|xd)
CNTP xd,pnn.!{el},VLX4 :: .call w4(0x25208700|(!{sz}<<22)|((pnn-8)<<5)|xd)
}
!s2pn("B", 0)
!s2pn("H", 1)
!s2pn("S", 2)
!s2pn("D", 3)

/* WHILE with a counter or a predicate pair as the destination */
!def s2while1(nm, lt, u, eq, el, sz) {
!{nm} pnn.!{el},xn,xm,VLX2 :: .call w4(0x25204010|(!{sz}<<22)|(xm<<16)|(!{u}<<11)|(!{lt}<<10)|(1<<14)|(!{eq}<<3)|(xn<<5)|(pnn-8))
!{nm} pnn.!{el},xn,xm,VLX4 :: .call w4(0x25206010|(!{sz}<<22)|(xm<<16)|(!{u}<<11)|(!{lt}<<10)|(1<<14)|(!{eq}<<3)|(xn<<5)|(pnn-8))
!{nm} {pd.!{el},pe.!{el}},xn,xm ::(pd&1)!=0;5,pe!=pd+1;5 :: .call w4(0x25205010|(!{sz}<<22)|(xm<<16)|(!{u}<<11)|(!{lt}<<10)|(xn<<5)|!{eq}|pd)
}
!def s2while(nm, lt, u, eq) {
!s2while1(nm, lt, u, eq, "B", 0)
!s2while1(nm, lt, u, eq, "H", 1)
!s2while1(nm, lt, u, eq, "S", 2)
!s2while1(nm, lt, u, eq, "D", 3)
}
!s2while("WHILEGE", 0, 0, 0)
!s2while("WHILEGT", 0, 0, 1)
!s2while("WHILELT", 1, 0, 0)
!s2while("WHILELE", 1, 0, 1)
!s2while("WHILEHS", 0, 1, 0)
!s2while("WHILEHI", 0, 1, 1)
!s2while("WHILELO", 1, 1, 0)
!s2while("WHILELS", 1, 1, 1)

/* The lookup table register */
LDR ZT0,[xb] :: .call w4(0xe11f8000|(xb<<5))
STR ZT0,[xb] :: .call w4(0xe13f8000|(xb<<5))
ZERO {ZT0} :: .call w4(0xc0480001)

/* Table lookup through ZT0.  The index splits across bits 16 and up
/* and the bits just below the element-size field. */
!def s2luti1(nm, base, el, sz, shl, mx) {
!{nm} zd.!{el},ZT0,zn[!!i] ::i>!{mx};3 :: .call w4(!{base}|(!{sz}<<12)|((i&!{(1<<(16-shl))-1})<<!{shl})|((i>>!{16-shl})<<16)|(zn<<5)|zd)
}
!s2luti1("LUTI2", 0xc0cc0000, "B", 0, 14, 7)
!s2luti1("LUTI2", 0xc0cc0000, "H", 1, 14, 7)
!s2luti1("LUTI2", 0xc0cc0000, "S", 2, 14, 7)
!s2luti1("LUTI4", 0xc0ca0000, "B", 0, 14, 7)
!s2luti1("LUTI4", 0xc0ca0000, "H", 1, 14, 7)
!s2luti1("LUTI4", 0xc0ca0000, "S", 2, 14, 7)
/* Pair and quad destinations */
.func::lutil::base2,base4,sz,i,zn,a,b,mx2,mx4,sh2
n = b - a
.if n == 1 .then
.if (a & 1) != 0 .then
.raise 5
.endif
.if i > mx2 .then
.raise 3
.endif
.return .call w4(base2 | (sz << 12) | ((i & ((1 << (16 - sh2)) - 1)) << sh2) | ((i >> (16 - sh2)) << 16) | (zn << 5) | a)
.endif
.if n == 3 .then
.if (a & 3) != 0 .then
.raise 5
.endif
.if i > mx4 .then
.raise 3
.endif
.return .call w4(base4 | (sz << 12) | (i << 16) | (zn << 5) | a)
.endif
.raise 5
.return 0
.endfunc
!def s2luti2(nm, base2, base4, el, sz, mx2, mx4, sh2) {
!{nm} {zd.!{el},za.!{el}},ZT0,zn[!!i] :: .call lutil(!{base2},!{base4},!{sz},i,zn,zd,za,!{mx2},!{mx4},!{sh2})
!{nm} {zd.!{el}-za.!{el}},ZT0,zn[!!i] :: .call lutil(!{base2},!{base4},!{sz},i,zn,zd,za,!{mx2},!{mx4},!{sh2})
}
!s2luti2("LUTI2", 0xc08c4000, 0xc08c8000, "B", 0, 7, 3, 15)
!s2luti2("LUTI2", 0xc08c4000, 0xc08c8000, "H", 1, 7, 3, 15)
!s2luti2("LUTI2", 0xc08c4000, 0xc08c8000, "S", 2, 7, 3, 15)
!s2luti2("LUTI4", 0xc08a4000, 0xc08a8000, "B", 0, 7, -1, 15)
!s2luti2("LUTI4", 0xc08a4000, 0xc08a8000, "H", 1, 7, 3, 15)
!s2luti2("LUTI4", 0xc08a4000, 0xc08a8000, "S", 2, 7, 3, 15)

/* -------------------------------------------------------------------
/* SME2: multi-vector operations on Z registers.
/*
/* A list is a pair or a quad, and only its first register is encoded.
/* n2q reads the two written register numbers, checks the alignment,
/* and answers 0 for a pair and 1 for a quad; every row below goes
/* through it so one pattern covers both widths.
/* ------------------------------------------------------------------- */
.check::zp::ZR
.check::zq::ZR
.check::zr::ZR
.check::zs::ZR

/* like n2q, but for the fields that hold the whole register number
/* and so put no alignment on the list */
.func::n2qf::a,b
n = (b - a) & 31
.if n == 1 .then
.return 0
.endif
.if n == 3 .then
.return 1
.endif
.raise 5
.return 0
.endfunc
.func::n2q::a,b
n = b - a
.if n == 1 .then
.if (a & 1) != 0 .then
.raise 5
.endif
.return 0
.endif
.if n == 3 .then
.if (a & 3) != 0 .then
.raise 5
.endif
.return 1
.endif
.raise 5
.return 0
.endfunc

/* Binary, destructive, against one vector or against a list */
.func::s2a1::sz,opc,u,zm,a,b
g = .call n2q(a, b)
.return .call w4(0xc120a000 | (sz << 22) | (zm << 16) | (g << 11) | (opc << 5) | u | a)
.endfunc
.func::s2a2::sz,opc,u,m,n,a,b
g = .call n2q(a, b)
h = .call n2q(m, n)
.if g != h .then
.raise 5
.endif
.return .call w4(0xc120b000 | (sz << 22) | (m << 16) | (g << 11) | (opc << 5) | u | a)
.endfunc
!def s2mv1(nm, opc, u, el, sz) {
!{nm} {zd.!{el},za.!{el}},{zd.!{el},za.!{el}},zx.!{el} :: .call s2a1(!{sz},!{opc},!{u},zx,zd,za)
!{nm} {zd.!{el}-za.!{el}},{zd.!{el}-za.!{el}},zx.!{el} :: .call s2a1(!{sz},!{opc},!{u},zx,zd,za)
!{nm} {zd.!{el},za.!{el}},{zd.!{el},za.!{el}},{zm.!{el},zk.!{el}} :: .call s2a2(!{sz},!{opc},!{u},zm,zk,zd,za)
!{nm} {zd.!{el}-za.!{el}},{zd.!{el}-za.!{el}},{zm.!{el}-zk.!{el}} :: .call s2a2(!{sz},!{opc},!{u},zm,zk,zd,za)
}
!def s2mvi(nm, opc, u) {
!s2mv1(nm, opc, u, "B", 0)
!s2mv1(nm, opc, u, "H", 1)
!s2mv1(nm, opc, u, "S", 2)
!s2mv1(nm, opc, u, "D", 3)
}
!def s2mvf(nm, opc, u) {
!s2mv1(nm, opc, u, "H", 1)
!s2mv1(nm, opc, u, "S", 2)
!s2mv1(nm, opc, u, "D", 3)
}
!s2mvi("SMAX", 0x00, 0)
!s2mvi("UMAX", 0x00, 1)
!s2mvi("SMIN", 0x01, 0)
!s2mvi("UMIN", 0x01, 1)
!s2mvf("FMAX", 0x08, 0)
!s2mvf("FMIN", 0x08, 1)
!s2mvf("FMAXNM", 0x09, 0)
!s2mvf("FMINNM", 0x09, 1)
!s2mvi("SRSHL", 0x11, 0)
!s2mvi("URSHL", 0x11, 1)
/* ADD has only the single-vector second operand */
!def s2mvs(nm, opc, u, el, sz) {
!{nm} {zd.!{el},za.!{el}},{zd.!{el},za.!{el}},zx.!{el} :: .call s2a1(!{sz},!{opc},!{u},zx,zd,za)
!{nm} {zd.!{el}-za.!{el}},{zd.!{el}-za.!{el}},zx.!{el} :: .call s2a1(!{sz},!{opc},!{u},zx,zd,za)
}
!s2mvs("ADD", 0x18, 0, "B", 0)
!s2mvs("ADD", 0x18, 0, "H", 1)
!s2mvs("ADD", 0x18, 0, "S", 2)
!s2mvs("ADD", 0x18, 0, "D", 3)
!s2mvi("SQDMULH", 0x20, 0)

/* Clamp to a range */
.func::s2cl::base,sz,zn,zm,u,a,b
g = .call n2q(a, b)
.return .call w4(base | (sz << 22) | (zm << 16) | (g << 11) | (zn << 5) | u | a)
.endfunc
!def s2clamp(nm, base, u, el, sz) {
!{nm} {zd.!{el},za.!{el}},zn.!{el},zm.!{el} :: .call s2cl(!{base},!{sz},zn,zm,!{u},zd,za)
!{nm} {zd.!{el}-za.!{el}},zn.!{el},zm.!{el} :: .call s2cl(!{base},!{sz},zn,zm,!{u},zd,za)
}
!def s2clampi(nm, base, u) {
!s2clamp(nm, base, u, "B", 0)
!s2clamp(nm, base, u, "H", 1)
!s2clamp(nm, base, u, "S", 2)
!s2clamp(nm, base, u, "D", 3)
}
!s2clampi("SCLAMP", 0xc120c400, 0)
!s2clampi("UCLAMP", 0xc120c400, 1)
!s2clamp("FCLAMP", 0xc120c000, 0, "H", 1)
!s2clamp("FCLAMP", 0xc120c000, 0, "S", 2)
!s2clamp("FCLAMP", 0xc120c000, 0, "D", 3)

/* Select between two lists under a counter */
.func::s2sel::sz,pn,m,n,x,y,a,b
g = .call n2q(a, b)
.if g != .call n2q(m, n) .then
.raise 5
.endif
.if g != .call n2q(x, y) .then
.raise 5
.endif
.return .call w4(0xc1208000 | (sz << 22) | (x << 16) | (g << 16) | ((pn - 8) << 10) | (m << 5) | a)
.endfunc
!def s2selr(el, sz) {
SEL {zd.!{el},za.!{el}},pnn,{zn.!{el},zb.!{el}},{zm.!{el},zk.!{el}} :: .call s2sel(!{sz},pnn,zn,zb,zm,zk,zd,za)
SEL {zd.!{el}-za.!{el}},pnn,{zn.!{el}-zb.!{el}},{zm.!{el}-zk.!{el}} :: .call s2sel(!{sz},pnn,zn,zb,zm,zk,zd,za)
}
!s2selr("B", 0)
!s2selr("H", 1)
!s2selr("S", 2)
!s2selr("D", 3)

/* Interleave and deinterleave */
!def s2zip(nm, base, u, el, sz) {
!{nm} {zd.!{el},za.!{el}},zn.!{el},zm.!{el} ::(zd&1)!=0;5,za!=zd+1;5 :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(zn<<5)|!{u}|zd)
!{nm} {zd.!{el}-za.!{el}},zn.!{el},zm.!{el} ::(zd&1)!=0;5,za!=zd+1;5 :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(zn<<5)|!{u}|zd)
}
!def s2zipq(nm, base, u, el, sz) {
!{nm} {zd.!{el}-za.!{el}},{zn.!{el}-zb.!{el}} ::(zd&3)!=0;5,za!=zd+3;5,(zn&3)!=0;5,zb!=zn+3;5 :: .call w4(!{base}|(!{sz}<<22)|(zn<<5)|!{u}|zd)
}
!def s2zipa(nm, u) {
!s2zip(nm, 0xc120d000, u, "B", 0)
!s2zip(nm, 0xc120d000, u, "H", 1)
!s2zip(nm, 0xc120d000, u, "S", 2)
!s2zip(nm, 0xc120d000, u, "D", 3)
!s2zip(nm, 0xc120d400, u, "Q", 0)
!s2zipq(nm, 0xc136e000, 2*u, "B", 0)
!s2zipq(nm, 0xc136e000, 2*u, "H", 1)
!s2zipq(nm, 0xc136e000, 2*u, "S", 2)
!s2zipq(nm, 0xc136e000, 2*u, "D", 3)
!s2zipq(nm, 0xc137e000, 2*u, "Q", 0)
}
!s2zipa("ZIP", 0)
!s2zipa("UZP", 1)

/* Conversions between lists of the same width */
!def s2cvt2(nm, base, del, sel) {
!{nm} {zd.!{del},za.!{del}},{zn.!{sel},zb.!{sel}} ::(zd&1)!=0;5,za!=zd+1;5,(zn&1)!=0;5,zb!=zn+1;5 :: .call w4(!{base}|(zn<<5)|zd)
}
!def s2cvt4(nm, base, del, sel) {
!{nm} {zd.!{del}-za.!{del}},{zn.!{sel}-zb.!{sel}} ::(zd&3)!=0;5,za!=zd+3;5,(zn&3)!=0;5,zb!=zn+3;5 :: .call w4(!{base}|(zn<<5)|zd)
}
!s2cvt2("FCVTZS", 0xc121e000, "S", "S")
!s2cvt2("FCVTZU", 0xc121e020, "S", "S")
!s2cvt2("SCVTF", 0xc122e000, "S", "S")
!s2cvt2("UCVTF", 0xc122e020, "S", "S")
!s2cvt2("FRINTN", 0xc1a8e000, "S", "S")
!s2cvt2("FRINTP", 0xc1a9e000, "S", "S")
!s2cvt2("FRINTM", 0xc1aae000, "S", "S")
!s2cvt2("FRINTA", 0xc1ace000, "S", "S")
!s2cvt4("FCVTZS", 0xc131e000, "S", "S")
!s2cvt4("FCVTZU", 0xc131e020, "S", "S")
!s2cvt4("SCVTF", 0xc132e000, "S", "S")
!s2cvt4("UCVTF", 0xc132e020, "S", "S")
!s2cvt4("FRINTN", 0xc1b8e000, "S", "S")
!s2cvt4("FRINTP", 0xc1b9e000, "S", "S")
!s2cvt4("FRINTM", 0xc1bae000, "S", "S")
!s2cvt4("FRINTA", 0xc1bce000, "S", "S")

/* Narrowing conversions into one vector */
!def s2nar2(nm, base, del, sel) {
!{nm} zd.!{del},{zn.!{sel},zb.!{sel}} ::(zn&1)!=0;5,zb!=zn+1;5 :: .call w4(!{base}|(zn<<5)|zd)
}
