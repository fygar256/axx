}
!sv2u("SQABS", 0x08)
!sv2u("SQNEG", 0x09)
URECPE zd.S,pg/M,zn.S :: .call w4(0x4480a000|(pg<<10)|(zn<<5)|zd)
URSQRTE zd.S,pg/M,zn.S :: .call w4(0x4481a000|(pg<<10)|(zn<<5)|zd)
/* Accumulate pairs into the next size up */
!def sv2dalp(nm, opc, el, sel, sz) {
!{nm} zd.!{el},pg/M,zn.!{sel} :: .call w4(0x4400a000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|zd)
}
