!dp3z("UMULL", 5, 0, "xd", "wn", "wm", 1)
!dp3z("UMNEGL", 5, 1, "xd", "wn", "wm", 1)
!dp3z("SMULH", 2, 0, "xd", "xn", "xm", 1)
!dp3z("UMULH", 6, 0, "xd", "xn", "xm", 1)

/* Data processing (2 source) */
!def dp2(nm, opc, rd, rn, rm, sf) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((!{sf}<<31)|(0xd6<<21)|(!{rm}<<16)|(!{opc}<<10)|(!{rn}<<5)|!{rd})
}
!dp2("UDIV", 2, "xd", "xn", "xm", 1)
!dp2("UDIV", 2, "wd", "wn", "wm", 0)
!dp2("SDIV", 3, "xd", "xn", "xm", 1)
!dp2("SDIV", 3, "wd", "wn", "wm", 0)
!dp2("LSLV", 8, "xd", "xn", "xm", 1)
