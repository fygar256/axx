/* Single structure. Q, S and size together hold the lane index, so
/* each row computes them from the index rather than fixing them. */
!def lss1(nm, l, r, opc, el, mx, nb, qe, se, ze) {
!{nm} {vn.!{el}}[!!i],[xb] ::i<0;3,i>!{mx};3 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(!{l}<<22)|(!{r}<<21)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el}}[!!i],[xb],#!o ::i<0;3,i>!{mx};3,o!=!{nb};3 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el}}[!!i],[xb],xm ::i<0;3,i>!{mx};3 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
}
!def lss2(nm, l, r, opc, el, mx, nb, qe, se, ze) {
!{nm} {vn.!{el},va.!{el}}[!!i],[xb] ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(!{l}<<22)|(!{r}<<21)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el},va.!{el}}[!!i],[xb],#!o ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,o!=!{nb};3 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el},va.!{el}}[!!i],[xb],xm ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
}
!def lss3(nm, l, r, opc, el, mx, nb, qe, se, ze) {
!{nm} {vn.!{el},va.!{el},vb.!{el}}[!!i],[xb] ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(!{l}<<22)|(!{r}<<21)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el},va.!{el},vb.!{el}}[!!i],[xb],#!o ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,vb!=((vn+2)&31);5,o!=!{nb};3 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el},va.!{el},vb.!{el}}[!!i],[xb],xm ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,vb!=((vn+2)&31);5 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
}
!def lss4(nm, l, r, opc, el, mx, nb, qe, se, ze) {
!{nm} {vn.!{el},va.!{el},vb.!{el},vc.!{el}}[!!i],[xb] ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(!{l}<<22)|(!{r}<<21)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el},va.!{el},vb.!{el},vc.!{el}}[!!i],[xb],#!o ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5,o!=!{nb};3 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(31<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
!{nm} {vn.!{el},va.!{el},vb.!{el},vc.!{el}}[!!i],[xb],xm ::i<0;3,i>!{mx};3,va!=((vn+1)&31);5,vb!=((vn+2)&31);5,vc!=((vn+3)&31);5 :: .call w4(((!{qe})<<30)|(0x0d<<24)|(1<<23)|(!{l}<<22)|(!{r}<<21)|(xm<<16)|(!{opc}<<13)|((!{se})<<12)|((!{ze})<<10)|(xb<<5)|vn)
}
