!sv2bp1(nm, opc, "B", 0)
!sv2bp1(nm, opc, "H", 1)
!sv2bp1(nm, opc, "S", 2)
!sv2bp1(nm, opc, "D", 3)
}
!sv2bp("SRSHL", 0x02)
!sv2bp("URSHL", 0x03)
