/* ===================================================================
/* AArch64 (A64) instruction set -- pattern file for axx
/*
/* Grown from aarch64_logical_mini.axx, which covered the logical
/* (immediate) group alone. The bitmask-immediate encoder from that
/* file is kept here unchanged in spirit (highbit / find_e / pack_rs),
/* with an added validity test so that an immediate which is not a
/* legal repeating run is rejected instead of silently encoded.
/*
/* Coverage -- the A64 *scalar* instruction set:
/*   - Data processing (immediate): PC-rel, add/sub, logical, move
/*     wide, bitfield, extract, and their aliases
/*   - Data processing (register): logical/arith shifted and extended
/*     register, add/sub with carry, conditional compare, conditional
/*     select, 1/2/3-source, CRC32, and their aliases
/*   - Branches, exception generation, hints, barriers, system
/*     registers, SYS/SYSL/IC/DC/AT/TLBI
/*   - Loads and stores: literal, register (scaled / unscaled / pre /
/*     post / register offset), pair, exclusive, acquire-release,
/*     LSE atomics, PRFM
/*   - Scalar floating point: H/S/D data processing, compare,
/*     conditional select/compare, conversions, FMOV immediate, and
/*     FP loads and stores
/*
/* Not covered, and said so rather than half-done:
/*   Advanced SIMD (the vector forms of V registers), SVE and SVE2,
/*   SME, the memory-tagging instructions (ADDG/SUBG/STG/...), the
/*   pointer-authentication instructions outside the hint space
/*   (PACIA Xd,Xn, BRAA, RETAA, LDRAA, XPACI and the rest), and the
/*   named system registers beyond the common set below -- though
/*   those last are all still reachable through the generic
/*   S<op0>_<op1>_C<Cn>_C<Cm>_<op2> spelling, which is complete.
/*
/* The macro layer (Technical_Manual.md section 7) generates the rows
/* that differ only in an opcode constant, and the mini language
/* (section 3.15) computes the four encodings that no fixed
/* expression can express: the logical bitmask immediate, the MOV
/* immediate alias choice, the scaled/unscaled load-store offset
/* choice, and the 8-bit floating-point immediate.
/*
/* A note on names: every register, condition code, shift kind, extend
/* kind, barrier option, prefetch operation, system register and
/* cache/TLB operation below is a pattern-file symbol, and axx does not
/* let an assembly-source label share a name with one. So a label
/* called "pl", "sy" or "x0" is rejected; give labels names that no
/* operand spelling uses.
/*
/* Verified byte-for-byte against llvm-mc -triple=aarch64 over ~11,700
/* encodings -- among them every valid 32- and 64-bit logical bitmask
/* immediate, every MOV-immediate form, all 256 encodable
/* floating-point immediates, every condition code on every
/* conditional instruction, every addressing mode of every access
/* size, and the load/store offsets either side of the scaled /
/* unscaled boundary. Paxx and Caxx agree byte for byte on all of it.
/* ===================================================================

/* ===================================================================
/* Registers
/* =================================================================== */
!def gpr(p, n) {
!local i = 0
!while i <= n {
.setsym::!{p}!{i}::!{i}
!set i = i + 1
}
}
!def rset(nm, p, n) {
!local s = p + "0"
!local i = 1
!while i <= n {
!set s = s + "," + p + str(i)
!set i = i + 1
}
.setsym::!{nm}::!{s}
}

!gpr("X", 30)
!gpr("W", 30)
.setsym::XZR::31
.setsym::WZR::31
.setsym::SP::31
.setsym::WSP::31

!gpr("B", 31)
!gpr("H", 31)
!gpr("S", 31)
!gpr("D", 31)
!gpr("Q", 31)

!rset("XR", "X", 30)
!rset("WR", "W", 30)
!rset("BR", "B", 31)
!rset("HR", "H", 31)
!rset("SR", "S", 31)
!rset("DR", "D", 31)
!rset("QR", "Q", 31)

/* Variable roles. Every one is positional (.check, section 3.7) and
/* is set once here, so a nonsensical operand is rejected instead of
/* assembling into wrong bytes.
/*   x* / w*  general registers reading 31 as the zero register
/*   xs / ws  general registers reading 31 as SP / WSP
/*   xb       memory base register, reads 31 as SP
/*   f*       scalar floating-point registers */
.check::xd::XR,XZR
.check::xn::XR,XZR
.check::xm::XR,XZR
.check::xa::XR,XZR
.check::xt::XR,XZR
.check::xu::XR,XZR
.check::xs::XR,SP
.check::xe::XR,SP
.check::xb::XR,SP
.check::wd::WR,WZR
.check::wn::WR,WZR
.check::wm::WR,WZR
.check::wa::WR,WZR
.check::wt::WR,WZR
.check::wu::WR,WZR
.check::ws::WR,WSP
.check::we::WR,WSP
.check::fb::BR
.check::fh::HR
.check::fs::SR
.check::ff::DR
.check::fq::QR
.check::fbd::BR
.check::fbn::BR
.check::fhd::HR
.check::fhn::HR
.check::fhm::HR
.check::fha::HR
.check::fsd::SR
.check::fsn::SR
.check::fsm::SR
.check::fsa::SR
.check::fdd::DR
.check::fdn::DR
.check::fdm::DR
.check::fda::DR
.check::fqd::QR
.check::fqn::QR

