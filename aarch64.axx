/* Narrowing arithmetic.  sz is the wider, source element. */
!def sv2n1(nm, opc, el, sel, sz) {
!{nm} zd.!{el},zn.!{sel},zm.!{sel} :: .call w4(0x45200000|(!{sz}<<22)|(zm<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
