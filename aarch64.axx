!s2i("SQNEG", 1, 0x07, 1)
!s2i("ABS", 0, 0x0b, 0)
!s2i("NEG", 1, 0x0b, 0)
!def s2z(nm, u, opc) {
!s2zone(nm, u, 3, 0x10, opc, "fdd", "fdn")
}
