!svclast("CLASTB", 1, "H", 1, "wd", "fhd")
!svclast("CLASTB", 1, "S", 2, "wd", "fsd")
!svclast("CLASTB", 1, "D", 3, "xd", "fdd")

/* Interleave and deinterleave, for vectors and for predicates */
!def svperm(nm, off, el, sz) {
!{nm} zd.!{el},zn.!{el},zm.!{el} :: .call w4(0x05206000|(!{off}<<10)|(!{sz}<<22)|(zm<<16)|(zn<<5)|zd)
!{nm} pd.!{el},pn.!{el},pm.!{el} :: .call w4(0x05204000|(!{off}<<10)|(!{sz}<<22)|(pm<<16)|(pn<<5)|pd)
}
!def svpermall(nm, off) {
!svperm(nm, off, "B", 0)
!svperm(nm, off, "H", 1)
!svperm(nm, off, "S", 2)
!svperm(nm, off, "D", 3)
}
!svpermall("ZIP1", 0)
!svpermall("ZIP2", 1)
!svpermall("UZP1", 2)
!svpermall("UZP2", 3)
!svpermall("TRN1", 4)
!svpermall("TRN2", 5)

/* Unpack the low or high half into wider elements */
!def svunpk(nm, opc, el, sel, sz) {
!{nm} zd.!{el},zn.!{sel} :: .call w4(0x05303800|(!{sz}<<22)|(!{opc}<<16)|(zn<<5)|zd)
}
!def svunpkall(nm, opc) {
!svunpk(nm, opc, "H", "B", 1)
!svunpk(nm, opc, "S", "H", 2)
!svunpk(nm, opc, "D", "S", 3)
}
!svunpkall("SUNPKLO", 0)
!svunpkall("SUNPKHI", 1)
!svunpkall("UUNPKLO", 2)
!svunpkall("UUNPKHI", 3)
PUNPKLO pd.H,pn.B :: .call w4(0x05304000|(pn<<5)|pd)
PUNPKHI pd.H,pn.B :: .call w4(0x05314000|(pn<<5)|pd)

/* Select, copy and move-prefix */
!def svsel(el, sz) {
SEL zd.!{el},pv,zn.!{el},zm.!{el} :: .call w4(0x0520c000|(!{sz}<<22)|(zm<<16)|(pv<<10)|(zn<<5)|zd)
MOV zd.!{el},pv/M,zn.!{el} :: .call w4(0x0520c000|(!{sz}<<22)|(zd<<16)|(pv<<10)|(zn<<5)|zd)
}
!svsel("B", 0)
!svsel("H", 1)
!svsel("S", 2)
!svsel("D", 3)
!def svcpy(el, sz, rn, vn, sh8) {
CPY zd.!{el},pg/M,!{rn} :: .call w4(0x0528a000|(!{sz}<<22)|(pg<<10)|(!{rn}<<5)|zd)
MOV zd.!{el},pg/M,!{rn} :: .call w4(0x0528a000|(!{sz}<<22)|(pg<<10)|(!{rn}<<5)|zd)
CPY zd.!{el},pg/M,!{vn} :: .call w4(0x05208000|(!{sz}<<22)|(pg<<10)|(!{vn}<<5)|zd)
MOV zd.!{el},pg/M,!{vn} :: .call w4(0x05208000|(!{sz}<<22)|(pg<<10)|(!{vn}<<5)|zd)
CPY zd.!{el},pv/Z,#!v :: .call svai(0x05100000|(!{sz}<<22)|(pv<<16),v,-128,127,!{sh8},zd)
CPY zd.!{el},pv/M,#!v :: .call svai(0x05104000|(!{sz}<<22)|(pv<<16),v,-128,127,!{sh8},zd)
MOV zd.!{el},pv/Z,#!v :: .call svai(0x05100000|(!{sz}<<22)|(pv<<16),v,-128,127,!{sh8},zd)
MOV zd.!{el},pv/M,#!v :: .call svai(0x05104000|(!{sz}<<22)|(pv<<16),v,-128,127,!{sh8},zd)
}
!svcpy("B", 0, "wn", "fbn", 0)
!svcpy("H", 1, "wn", "fhn", 1)
!svcpy("S", 2, "wn", "fsn", 1)
!svcpy("D", 3, "xn", "fdn", 1)
!def svcpysh(el, sz) {
CPY zd.!{el},pv/Z,#!v,LSL #!h ::v<-128;3,v>127;3,h!=8;10 :: .call w4(0x05102000|(!{sz}<<22)|(pv<<16)|((v&0xff)<<5)|zd)
CPY zd.!{el},pv/M,#!v,LSL #!h ::v<-128;3,v>127;3,h!=8;10 :: .call w4(0x05106000|(!{sz}<<22)|(pv<<16)|((v&0xff)<<5)|zd)
MOV zd.!{el},pv/Z,#!v,LSL #!h ::v<-128;3,v>127;3,h!=8;10 :: .call w4(0x05102000|(!{sz}<<22)|(pv<<16)|((v&0xff)<<5)|zd)
MOV zd.!{el},pv/M,#!v,LSL #!h ::v<-128;3,v>127;3,h!=8;10 :: .call w4(0x05106000|(!{sz}<<22)|(pv<<16)|((v&0xff)<<5)|zd)
}
!svcpysh("H", 1)
!svcpysh("S", 2)
!svcpysh("D", 3)
MOVPRFX zd,zn :: .call w4(0x0420bc00|(zn<<5)|zd)
!def svmovprfx(el, sz) {
MOVPRFX zd.!{el},pg/M,zn.!{el} :: .call w4(0x04112000|(!{sz}<<22)|(pg<<10)|(zn<<5)|zd)
MOVPRFX zd.!{el},pg/Z,zn.!{el} :: .call w4(0x04102000|(!{sz}<<22)|(pg<<10)|(zn<<5)|zd)
}
!svmovprfx("B", 0)
!svmovprfx("H", 1)
!svmovprfx("S", 2)
!svmovprfx("D", 3)

/* DUPM broadcasts a bitmask immediate, using the same encoder the
/* base ISA's logical immediates use. */
.func::bitmask13::v,maxw
m = (1 << maxw) - 1
v = v & m
e = .call find_e(v, maxw)
.if .call isrun(v, e) == 0 .then
.raise 7
.return 0
.endif
rs = .call pack_rs(v, e)
r = rs[0]
s = rs[1]
nbit = ((s >> 6) & 1) ^ 1
.return (nbit << 12) | (r << 6) | (s & 0x3f)
.endfunc
.func::svdupm::v,maxw,rd
i13 = .call bitmask13(v, maxw)
.return .call w4(0x05c00000 | (i13 << 5) | rd)
.endfunc
DUPM zd.B,#!v :: .call svdupm(v,8,zd)
DUPM zd.H,#!v :: .call svdupm(v,16,zd)
DUPM zd.S,#!v :: .call svdupm(v,32,zd)
DUPM zd.D,#!v :: .call svdupm(v,64,zd)

/* Reductions to a scalar */
!def svred(nm, opc, el, sz, vd) {
!{nm} !{vd},pv,zn.!{el} :: .call w4(0x04002000|(!{sz}<<22)|(!{opc}<<16)|(pv<<10)|(zn<<5)|!{vd})
}
!def svredv(nm, opc) {
!svred(nm, opc, "B", 0, "fbd")
!svred(nm, opc, "H", 1, "fhd")
!svred(nm, opc, "S", 2, "fsd")
!svred(nm, opc, "D", 3, "fdd")
}
!svredv("SMAXV", 0x08)
!svredv("UMAXV", 0x09)
!svredv("SMINV", 0x0a)
!svredv("UMINV", 0x0b)
!svredv("ORV", 0x18)
!svredv("EORV", 0x19)
!svredv("ANDV", 0x1a)
/* The widening sum always lands in a D register */
!def svaddv(nm, opc, el, sz) {
!{nm} fdd,pv,zn.!{el} :: .call w4(0x04002000|(!{sz}<<22)|(!{opc}<<16)|(pv<<10)|(zn<<5)|fdd)
}
!def svaddvall(nm, opc) {
!svaddv(nm, opc, "B", 0)
!svaddv(nm, opc, "H", 1)
!svaddv(nm, opc, "S", 2)
}
!svaddvall("SADDV", 0x00)
!svaddvall("UADDV", 0x01)

/* -------------------------------------------------------------------
/* SVE floating point.
/*
/* Floating-point element sizes are H=1, S=2, D=3; the byte size has no
/* floating-point meaning, so these families start at H.
/* ------------------------------------------------------------------- */
!rset("ZLO8", "Z", 7)
!rset("ZLO16", "Z", 15)
.check::zy::ZLO8
.check::zx::ZLO16

/* Binary, predicated and destructive.
/*   01100101 size 00 opc Pg Zm Zd */
!def svf3p1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.!{el} :: .call w4(0x65008000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
}
!def svf3p(nm, opc) {
!svf3p1(nm, opc, "H", 1)
!svf3p1(nm, opc, "S", 2)
!svf3p1(nm, opc, "D", 3)
}
!svf3p("FADD", 0x00)
!svf3p("FSUB", 0x01)
!svf3p("FMUL", 0x02)
!svf3p("FSUBR", 0x03)
!svf3p("FMAXNM", 0x04)
!svf3p("FMINNM", 0x05)
!svf3p("FMAX", 0x06)
!svf3p("FMIN", 0x07)
!svf3p("FABD", 0x08)
!svf3p("FSCALE", 0x09)
!svf3p("FMULX", 0x0a)
!svf3p("FDIVR", 0x0c)
!svf3p("FDIV", 0x0d)

/* Binary with one of two fixed immediates; bit 5 picks the second. */
!def svf3i1(nm, opc, lo, hi, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},#!{lo} :: .call w4(0x65008000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|zd)
!{nm} zd.!{el},pg/M,zd.!{el},#!{hi} :: .call w4(0x65008020|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|zd)
}
!def svf3i(nm, opc, lo, hi) {
!svf3i1(nm, opc, lo, hi, "H", 1)
!svf3i1(nm, opc, lo, hi, "S", 2)
!svf3i1(nm, opc, lo, hi, "D", 3)
}
!svf3i("FADD", 0x18, "0.5", "1.0")
!svf3i("FSUB", 0x19, "0.5", "1.0")
!svf3i("FMUL", 0x1a, "0.5", "2.0")
!svf3i("FSUBR", 0x1b, "0.5", "1.0")
!svf3i("FMAXNM", 0x1c, "0.0", "1.0")
!svf3i("FMINNM", 0x1d, "0.0", "1.0")
!svf3i("FMAX", 0x1e, "0.0", "1.0")
!svf3i("FMIN", 0x1f, "0.0", "1.0")

/* Binary, unpredicated.
/*   01100101 size 0 Zm 000 opc Zn Zd */
!def svf3u1(nm, opc, el, sz) {
!{nm} zd.!{el},zn.!{el},zm.!{el} :: .call w4(0x65000000|(!{sz}<<22)|(zm<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!def svf3u(nm, opc) {
!svf3u1(nm, opc, "H", 1)
!svf3u1(nm, opc, "S", 2)
!svf3u1(nm, opc, "D", 3)
}
!svf3u("FADD", 0)
!svf3u("FSUB", 1)
!svf3u("FMUL", 2)
!svf3u("FTSMUL", 3)
!svf3u("FRECPS", 6)
!svf3u("FRSQRTS", 7)

/* Trigonometric helpers */
!def svftrig(el, sz) {
FEXPA zd.!{el},zn.!{el} :: .call w4(0x0420b800|(!{sz}<<22)|(zn<<5)|zd)
FTSSEL zd.!{el},zn.!{el},zm.!{el} :: .call w4(0x0420b000|(!{sz}<<22)|(zm<<16)|(zn<<5)|zd)
FTMAD zd.!{el},zd.!{el},zm.!{el},#!i ::i<0;3,i>7;3 :: .call w4(0x65108000|(!{sz}<<22)|(i<<16)|(zm<<5)|zd)
FRECPE zd.!{el},zn.!{el} :: .call w4(0x650e3000|(!{sz}<<22)|(zn<<5)|zd)
FRSQRTE zd.!{el},zn.!{el} :: .call w4(0x650f3000|(!{sz}<<22)|(zn<<5)|zd)
}
!svftrig("H", 1)
!svftrig("S", 2)
!svftrig("D", 3)

/* Unary, predicated.
/*   01100101 size 0 opc Pg Zn Zd */
!def svf2p1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el} :: .call w4(0x6500a000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|zd)
}
!def svf2p(nm, opc) {
!svf2p1(nm, opc, "H", 1)
!svf2p1(nm, opc, "S", 2)
!svf2p1(nm, opc, "D", 3)
}
!svf2p("FRINTN", 0x00)
!svf2p("FRINTP", 0x01)
!svf2p("FRINTM", 0x02)
!svf2p("FRINTZ", 0x03)
!svf2p("FRINTA", 0x04)
!svf2p("FRINTX", 0x06)
!svf2p("FRINTI", 0x07)
!svf2p("FRECPX", 0x0c)
!svf2p("FSQRT", 0x0d)
/* FABS and FNEG sit in the integer unary group instead */
!def svf2pi1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el} :: .call w4(0x0400a000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|zd)
}
!def svf2pi(nm, opc) {
!svf2pi1(nm, opc, "H", 1)
!svf2pi1(nm, opc, "S", 2)
!svf2pi1(nm, opc, "D", 3)
}
!svf2pi("FABS", 0x1c)
!svf2pi("FNEG", 0x1d)
/* FLOGB gives the unbiased exponent */
FLOGB zd.H,pg/M,zn.H :: .call w4(0x651aa000|(pg<<10)|(zn<<5)|zd)
FLOGB zd.S,pg/M,zn.S :: .call w4(0x651ca000|(pg<<10)|(zn<<5)|zd)
FLOGB zd.D,pg/M,zn.D :: .call w4(0x651ea000|(pg<<10)|(zn<<5)|zd)

/* Conversions.  The size pair does not decompose into a single field,
/* so each one names its own base word. */
!def svcvt(nm, base, dl, sl) {
!{nm} zd.!{dl},pg/M,zn.!{sl} :: .call w4(!{base}|(pg<<10)|(zn<<5)|zd)
}
!svcvt("FCVT", 0x6588a000, "H", "S")
!svcvt("FCVT", 0x6589a000, "S", "H")
!svcvt("FCVT", 0x65c8a000, "H", "D")
!svcvt("FCVT", 0x65c9a000, "D", "H")
!svcvt("FCVT", 0x65caa000, "S", "D")
!svcvt("FCVT", 0x65cba000, "D", "S")
!svcvt("FCVTZS", 0x655aa000, "H", "H")
!svcvt("FCVTZS", 0x655ca000, "S", "H")
!svcvt("FCVTZS", 0x655ea000, "D", "H")
!svcvt("FCVTZS", 0x659ca000, "S", "S")
!svcvt("FCVTZS", 0x65dca000, "D", "S")
!svcvt("FCVTZS", 0x65d8a000, "S", "D")
!svcvt("FCVTZS", 0x65dea000, "D", "D")
!svcvt("FCVTZU", 0x655ba000, "H", "H")
!svcvt("FCVTZU", 0x655da000, "S", "H")
!svcvt("FCVTZU", 0x655fa000, "D", "H")
!svcvt("FCVTZU", 0x659da000, "S", "S")
!svcvt("FCVTZU", 0x65dda000, "D", "S")
!svcvt("FCVTZU", 0x65d9a000, "S", "D")
!svcvt("FCVTZU", 0x65dfa000, "D", "D")
!svcvt("SCVTF", 0x6552a000, "H", "H")
!svcvt("SCVTF", 0x6554a000, "H", "S")
!svcvt("SCVTF", 0x6556a000, "H", "D")
!svcvt("SCVTF", 0x6594a000, "S", "S")
!svcvt("SCVTF", 0x65d4a000, "S", "D")
!svcvt("SCVTF", 0x65d0a000, "D", "S")
!svcvt("SCVTF", 0x65d6a000, "D", "D")
!svcvt("UCVTF", 0x6553a000, "H", "H")
!svcvt("UCVTF", 0x6555a000, "H", "S")
!svcvt("UCVTF", 0x6557a000, "H", "D")
!svcvt("UCVTF", 0x6595a000, "S", "S")
!svcvt("UCVTF", 0x65d5a000, "S", "D")
!svcvt("UCVTF", 0x65d1a000, "D", "S")
!svcvt("UCVTF", 0x65d7a000, "D", "D")
/* The top-and-bottom conversions are SVE2 */
!svcvt("FCVTX", 0x650aa000, "S", "D")
!svcvt("FCVTXNT", 0x640aa000, "S", "D")
!svcvt("FCVTNT", 0x6488a000, "H", "S")
!svcvt("FCVTLT", 0x6489a000, "S", "H")
!svcvt("FCVTNT", 0x64caa000, "S", "D")
!svcvt("FCVTLT", 0x64cba000, "D", "S")
!svcvt("BFCVT", 0x658aa000, "H", "S")
!svcvt("BFCVTNT", 0x648aa000, "H", "S")

/* Multiply-accumulate, predicated.
/*   01100101 size 1 Zm opc Pg Zn Zda */
!def svfma1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el},zm.!{el} :: .call w4(0x65200000|(!{sz}<<22)|(zm<<16)|(!{opc}<<13)|(pg<<10)|(zn<<5)|zd)
}
!def svfma(nm, opc) {
!svfma1(nm, opc, "H", 1)
!svfma1(nm, opc, "S", 2)
!svfma1(nm, opc, "D", 3)
}
!svfma("FMLA", 0)
!svfma("FMLS", 1)
!svfma("FNMLA", 2)
!svfma("FNMLS", 3)
!svfma("FMAD", 4)
!svfma("FMSB", 5)
!svfma("FNMAD", 6)
!svfma("FNMSB", 7)

/* Multiply by an indexed element.  The half-precision index is three
/* bits wide and splits across bit 22 and bits 20-19. */
!def svfmul_h(nm, add) {
!{nm} zd.H,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x64200000|!{add}|((i>>2)<<22)|((i&3)<<19)|(zy<<16)|(zn<<5)|zd)
}
!def svfmul_s(nm, add) {
!{nm} zd.S,zn.S,zy.S[!!i] ::i<0;3,i>3;3 :: .call w4(0x64a00000|!{add}|(i<<19)|(zy<<16)|(zn<<5)|zd)
}
!def svfmul_d(nm, add) {
!{nm} zd.D,zn.D,zx.D[!!i] ::i<0;3,i>1;3 :: .call w4(0x64e00000|!{add}|(i<<20)|(zx<<16)|(zn<<5)|zd)
}
!def svfmulx(nm, add) {
!svfmul_h(nm, add)
!svfmul_s(nm, add)
!svfmul_d(nm, add)
}
!svfmulx("FMLA", 0x0000)
!svfmulx("FMLS", 0x0400)
!svfmulx("FMUL", 0x2000)

/* Complex arithmetic */
!def svfcadd(el, sz) {
FCADD zd.!{el},pg/M,zd.!{el},zm.!{el},#90 :: .call w4(0x64008000|(!{sz}<<22)|(pg<<10)|(zm<<5)|zd)
FCADD zd.!{el},pg/M,zd.!{el},zm.!{el},#270 :: .call w4(0x64018000|(!{sz}<<22)|(pg<<10)|(zm<<5)|zd)
}
!svfcadd("H", 1)
!svfcadd("S", 2)
!svfcadd("D", 3)
!def svfcmla(el, sz, r, rv) {
FCMLA zd.!{el},pg/M,zn.!{el},zm.!{el},#!{r} :: .call w4(0x64000000|(!{sz}<<22)|(zm<<16)|(!{rv}<<13)|(pg<<10)|(zn<<5)|zd)
}
!def svfcmlaall(el, sz) {
!svfcmla(el, sz, 0, 0)
!svfcmla(el, sz, 90, 1)
!svfcmla(el, sz, 180, 2)
!svfcmla(el, sz, 270, 3)
}
!svfcmlaall("H", 1)
!svfcmlaall("S", 2)
!svfcmlaall("D", 3)
!def svfcmlai(r, rv) {
FCMLA zd.H,zn.H,zy.H[!!i],#!{r} ::i<0;3,i>3;3 :: .call w4(0x64a01000|(i<<19)|(zy<<16)|(!{rv}<<10)|(zn<<5)|zd)
FCMLA zd.S,zn.S,zx.S[!!i],#!{r} ::i<0;3,i>1;3 :: .call w4(0x64e01000|(i<<20)|(zx<<16)|(!{rv}<<10)|(zn<<5)|zd)
}
!svfcmlai(0, 0)
!svfcmlai(90, 1)
!svfcmlai(180, 2)
!svfcmlai(270, 3)

/* Compares.  ne is bit 4. */
!def svfcmp1(nm, base, ne, el, sz) {
!{nm} pd.!{el},pg/Z,zn.!{el},zm.!{el} :: .call w4(!{base}|(!{sz}<<22)|(zm<<16)|(pg<<10)|(zn<<5)|(!{ne}<<4)|pd)
}
!def svfcmp(nm, base, ne) {
!svfcmp1(nm, base, ne, "H", 1)
!svfcmp1(nm, base, ne, "S", 2)
!svfcmp1(nm, base, ne, "D", 3)
}
!svfcmp("FCMGE", 0x65004000, 0)
!svfcmp("FCMGT", 0x65004000, 1)
!svfcmp("FCMEQ", 0x65006000, 0)
!svfcmp("FCMNE", 0x65006000, 1)
!svfcmp("FCMUO", 0x6500c000, 0)
!svfcmp("FACGE", 0x6500c000, 1)
!svfcmp("FACGT", 0x6500e000, 1)
/* The reversed mnemonics are aliases that swap the source operands */
!def svfcmpr1(nm, base, ne, el, sz) {
!{nm} pd.!{el},pg/Z,zn.!{el},zm.!{el} :: .call w4(!{base}|(!{sz}<<22)|(zn<<16)|(pg<<10)|(zm<<5)|(!{ne}<<4)|pd)
}
!def svfcmpr(nm, base, ne) {
!svfcmpr1(nm, base, ne, "H", 1)
!svfcmpr1(nm, base, ne, "S", 2)
!svfcmpr1(nm, base, ne, "D", 3)
}
!svfcmpr("FCMLE", 0x65004000, 0)
!svfcmpr("FCMLT", 0x65004000, 1)
!svfcmpr("FACLE", 0x6500c000, 1)
!svfcmpr("FACLT", 0x6500e000, 1)
/* Compare against zero */
!def svfcmpz1(nm, opc, ne, el, sz) {
!{nm} pd.!{el},pg/Z,zn.!{el},#0.0 :: .call w4(0x65002000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|(!{ne}<<4)|pd)
}
!def svfcmpz(nm, opc, ne) {
!svfcmpz1(nm, opc, ne, "H", 1)
!svfcmpz1(nm, opc, ne, "S", 2)
!svfcmpz1(nm, opc, ne, "D", 3)
}
!svfcmpz("FCMGE", 0x10, 0)
!svfcmpz("FCMGT", 0x10, 1)
!svfcmpz("FCMLT", 0x11, 0)
!svfcmpz("FCMLE", 0x11, 1)
!svfcmpz("FCMEQ", 0x12, 0)
!svfcmpz("FCMNE", 0x13, 0)

/* Reductions.  FADDA is ordered and reads its accumulator back. */
!def svfredv(nm, opc, el, sz, vd) {
!{nm} !{vd},pg,zn.!{el} :: .call w4(0x65002000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|!{vd})
}
!def svfred(nm, opc) {
!svfredv(nm, opc, "H", 1, "fhd")
!svfredv(nm, opc, "S", 2, "fsd")
!svfredv(nm, opc, "D", 3, "fdd")
}
!svfred("FADDV", 0x00)
!svfred("FMAXNMV", 0x04)
!svfred("FMINNMV", 0x05)
!svfred("FMAXV", 0x06)
!svfred("FMINV", 0x07)
!def svfadda(el, sz, vd) {
FADDA !{vd},pg,!{vd},zm.!{el} :: .call w4(0x65182000|(!{sz}<<22)|(pg<<10)|(zm<<5)|!{vd})
}
!svfadda("H", 1, "fhd")
!svfadda("S", 2, "fsd")
!svfadda("D", 3, "fdd")

/* Broadcast a floating-point immediate */
.func::svfdup::v,sz,rd
i8 = .call fpimm8(v)
.if i8 < 0 .then
.raise 9
.return 0
.endif
.return .call w4(0x2539c000 | (sz << 22) | (i8 << 5) | rd)
.endfunc
.func::svfcpy::v,sz,pg,rd
i8 = .call fpimm8(v)
.if i8 < 0 .then
.raise 9
.return 0
.endif
.return .call w4(0x0510c000 | (sz << 22) | (pg << 16) | (i8 << 5) | rd)
.endfunc
!def svfimm(nm, el, sz) {
!{nm} zd.!{el},#!Dv :: .call svfdup(v,!{sz},zd)
}
!svfimm("FDUP", "H", 1)
!svfimm("FDUP", "S", 2)
!svfimm("FDUP", "D", 3)
!svfimm("FMOV", "H", 1)
!svfimm("FMOV", "S", 2)
!svfimm("FMOV", "D", 3)
!def svfimmp(nm, el, sz) {
!{nm} zd.!{el},pv/M,#!Dv :: .call svfcpy(v,!{sz},pv,zd)
}
!svfimmp("FCPY", "H", 1)
!svfimmp("FCPY", "S", 2)
!svfimmp("FCPY", "D", 3)
!svfimmp("FMOV", "H", 1)
!svfimmp("FMOV", "S", 2)
!svfimmp("FMOV", "D", 3)
/* Zero is not representable as an 8-bit floating-point immediate, so
/* FMOV #0.0 becomes the integer broadcast of zero. */
FMOV zd.H,#0.0 :: .call w4(0x2578c000|zd)
FMOV zd.S,#0.0 :: .call w4(0x25b8c000|zd)
FMOV zd.D,#0.0 :: .call w4(0x25f8c000|zd)

/* Dot product and matrix multiply */
SDOT zd.S,zn.B,zm.B :: .call w4(0x44800000|(zm<<16)|(zn<<5)|zd)
UDOT zd.S,zn.B,zm.B :: .call w4(0x44800400|(zm<<16)|(zn<<5)|zd)
SDOT zd.D,zn.H,zm.H :: .call w4(0x44c00000|(zm<<16)|(zn<<5)|zd)
UDOT zd.D,zn.H,zm.H :: .call w4(0x44c00400|(zm<<16)|(zn<<5)|zd)
SDOT zd.S,zn.B,zy.B[!!i] ::i<0;3,i>3;3 :: .call w4(0x44a00000|(i<<19)|(zy<<16)|(zn<<5)|zd)
UDOT zd.S,zn.B,zy.B[!!i] ::i<0;3,i>3;3 :: .call w4(0x44a00400|(i<<19)|(zy<<16)|(zn<<5)|zd)
SDOT zd.D,zn.H,zx.H[!!i] ::i<0;3,i>1;3 :: .call w4(0x44e00000|(i<<20)|(zx<<16)|(zn<<5)|zd)
UDOT zd.D,zn.H,zx.H[!!i] ::i<0;3,i>1;3 :: .call w4(0x44e00400|(i<<20)|(zx<<16)|(zn<<5)|zd)
USDOT zd.S,zn.B,zm.B :: .call w4(0x44807800|(zm<<16)|(zn<<5)|zd)
USDOT zd.S,zn.B,zy.B[!!i] ::i<0;3,i>3;3 :: .call w4(0x44a01800|(i<<19)|(zy<<16)|(zn<<5)|zd)
SUDOT zd.S,zn.B,zy.B[!!i] ::i<0;3,i>3;3 :: .call w4(0x44a01c00|(i<<19)|(zy<<16)|(zn<<5)|zd)
SMMLA zd.S,zn.B,zm.B :: .call w4(0x45009800|(zm<<16)|(zn<<5)|zd)
USMMLA zd.S,zn.B,zm.B :: .call w4(0x45809800|(zm<<16)|(zn<<5)|zd)
UMMLA zd.S,zn.B,zm.B :: .call w4(0x45c09800|(zm<<16)|(zn<<5)|zd)
FMMLA zd.S,zn.S,zm.S :: .call w4(0x64a0e400|(zm<<16)|(zn<<5)|zd)
FMMLA zd.D,zn.D,zm.D :: .call w4(0x64e0e400|(zm<<16)|(zn<<5)|zd)

/* BFloat16 */
BFDOT zd.S,zn.H,zm.H :: .call w4(0x64608000|(zm<<16)|(zn<<5)|zd)
BFDOT zd.S,zn.H,zy.H[!!i] ::i<0;3,i>3;3 :: .call w4(0x64604000|(i<<19)|(zy<<16)|(zn<<5)|zd)
BFMMLA zd.S,zn.H,zm.H :: .call w4(0x6460e400|(zm<<16)|(zn<<5)|zd)
BFMLALB zd.S,zn.H,zm.H :: .call w4(0x64e08000|(zm<<16)|(zn<<5)|zd)
BFMLALT zd.S,zn.H,zm.H :: .call w4(0x64e08400|(zm<<16)|(zn<<5)|zd)
BFMLALB zd.S,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x64e04000|((i&1)<<11)|((i>>1)<<19)|(zy<<16)|(zn<<5)|zd)
BFMLALT zd.S,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x64e04400|((i&1)<<11)|((i>>1)<<19)|(zy<<16)|(zn<<5)|zd)

/* -------------------------------------------------------------------
/* SVE loads and stores.
/*
/* Vector-length-relative offsets are written "#n, MUL VL"; the field
/* holds n directly for the single-register forms and n divided by the
/* number of registers for the two-, three- and four-register ones.
/* ------------------------------------------------------------------- */
.check::zt::ZR
.check::za::ZR
.check::zb::ZR
.check::zc::ZR
.check::pt::PR

.func::divn::v,n
q = v / n
.if q * n != v .then
.raise 8
.endif
.return q
.endfunc
/* signed four-bit field, in units of n */
.func::divs4::v,n
q = .call divn(v, n)
.if q < -8 .then
.raise 3
.endif
.if q > 7 .then
.raise 3
.endif
.return q & 0xf
.endfunc
/* unsigned six-bit field, in units of n */
.func::divu6::v,n
q = .call divn(v, n)
.if q < 0 .then
.raise 3
.endif
.if q > 63 .then
.raise 3
.endif
.return q
.endfunc
/* the two wrappers that emit an offset form */
.func::svmem4::base,v,n,pg,rn,zt
q = .call divs4(v, n)
.return .call w4(base | (q << 16) | (pg << 10) | (rn << 5) | zt)
.endfunc
.func::svmem6::base,v,n,pg,rn,zt
q = .call divu6(v, n)
.return .call w4(base | (q << 16) | (pg << 10) | (rn << 5) | zt)
.endfunc
/* unsigned five-bit field, in units of n */
.func::divu5::v,n
q = .call divn(v, n)
.if q < 0 .then
.raise 3
.endif
.if q > 31 .then
.raise 3
.endif
.return q
.endfunc

/* Whole-register load and store.  The nine-bit offset splits into six
/* bits at 16 and three bits at 10. */
!def svldrstr(nm, base, rt) {
!{nm} !{rt},[xb] :: .call w4(!{base}|(xb<<5)|!{rt})
!{nm} !{rt},[xb,#!v,MUL VL] ::v<-256;3,v>255;3 :: .call w4(!{base}|(((v>>3)&0x3f)<<16)|((v&7)<<10)|(xb<<5)|!{rt})
}
!svldrstr("LDR", 0x85804000, "zt")
!svldrstr("STR", 0xe5804000, "zt")
!svldrstr("LDR", 0x85800000, "pt")
!svldrstr("STR", 0xe5800000, "pt")

/* Contiguous single-register loads.  base is the top sixteen bits; ix
/* is the scalar index operand with its shift already spelled out. */
!def svld1(sfx, el, base, ix) {
LD1!{sfx} {zt.!{el}},pg/Z,[xb] :: .call w4((!{base}<<16)|0xa000|(pg<<10)|(xb<<5)|zt)
LD1!{sfx} {zt.!{el}},pg/Z,[xb,#!v,MUL VL] ::v<-8;3,v>7;3 :: .call w4((!{base}<<16)|0xa000|((v&0xf)<<16)|(pg<<10)|(xb<<5)|zt)
LD1!{sfx} {zt.!{el}},pg/Z,[xb,!{ix}] :: .call w4((!{base}<<16)|0x4000|(xm<<16)|(pg<<10)|(xb<<5)|zt)
LDNF1!{sfx} {zt.!{el}},pg/Z,[xb] :: .call w4((!{base}<<16)|0x10a000|(pg<<10)|(xb<<5)|zt)
LDNF1!{sfx} {zt.!{el}},pg/Z,[xb,#!v,MUL VL] ::v<-8;3,v>7;3 :: .call w4((!{base}<<16)|0x10a000|((v&0xf)<<16)|(pg<<10)|(xb<<5)|zt)
LDFF1!{sfx} {zt.!{el}},pg/Z,[xb,!{ix}] :: .call w4((!{base}<<16)|0x6000|(xm<<16)|(pg<<10)|(xb<<5)|zt)
LDFF1!{sfx} {zt.!{el}},pg/Z,[xb] :: .call w4((!{base}<<16)|0x6000|(31<<16)|(pg<<10)|(xb<<5)|zt)
}
!svld1("B", "B", 0xa400, "xm")
!svld1("B", "H", 0xa420, "xm")
!svld1("B", "S", 0xa440, "xm")
!svld1("B", "D", 0xa460, "xm")
!svld1("H", "H", 0xa4a0, "xm,LSL #1")
!svld1("H", "S", 0xa4c0, "xm,LSL #1")
!svld1("H", "D", 0xa4e0, "xm,LSL #1")
!svld1("W", "S", 0xa540, "xm,LSL #2")
!svld1("W", "D", 0xa560, "xm,LSL #2")
!svld1("D", "D", 0xa5e0, "xm,LSL #3")
!svld1("SB", "H", 0xa5c0, "xm")
!svld1("SB", "S", 0xa5a0, "xm")
!svld1("SB", "D", 0xa580, "xm")
!svld1("SH", "S", 0xa520, "xm,LSL #1")
!svld1("SH", "D", 0xa500, "xm,LSL #1")
!svld1("SW", "D", 0xa480, "xm,LSL #2")

/* Contiguous single-register stores */
!def svst1(sfx, el, base, ix) {
ST1!{sfx} {zt.!{el}},pg,[xb] :: .call w4((!{base}<<16)|0xe000|(pg<<10)|(xb<<5)|zt)
ST1!{sfx} {zt.!{el}},pg,[xb,#!v,MUL VL] ::v<-8;3,v>7;3 :: .call w4((!{base}<<16)|0xe000|((v&0xf)<<16)|(pg<<10)|(xb<<5)|zt)
ST1!{sfx} {zt.!{el}},pg,[xb,!{ix}] :: .call w4((!{base}<<16)|0x4000|(xm<<16)|(pg<<10)|(xb<<5)|zt)
}
!svst1("B", "B", 0xe400, "xm")
!svst1("B", "H", 0xe420, "xm")
!svst1("B", "S", 0xe440, "xm")
!svst1("B", "D", 0xe460, "xm")
!svst1("H", "H", 0xe4a0, "xm,LSL #1")
!svst1("H", "S", 0xe4c0, "xm,LSL #1")
!svst1("H", "D", 0xe4e0, "xm,LSL #1")
!svst1("W", "S", 0xe540, "xm,LSL #2")
!svst1("W", "D", 0xe560, "xm,LSL #2")
!svst1("D", "D", 0xe5e0, "xm,LSL #3")

/* Non-temporal and multi-register contiguous accesses.  The register
/* count sits at bits 22-21; the store offset form also sets bit 20. */
!def svldn1(nm, regs, n, msz, ix) {
!{nm} {!{regs}},pg/Z,[xb] :: .call w4(0xa400e000|(!{msz}<<23)|(!{n-1}<<21)|(pg<<10)|(xb<<5)|zt)
!{nm} {!{regs}},pg/Z,[xb,#!v,MUL VL] :: .call svmem4(0xa400e000|(!{msz}<<23)|(!{n-1}<<21),v,!{n},pg,xb,zt)
!{nm} {!{regs}},pg/Z,[xb,!{ix}] :: .call w4(0xa400c000|(!{msz}<<23)|(!{n-1}<<21)|(xm<<16)|(pg<<10)|(xb<<5)|zt)
}
!def svstn1(nm, regs, n, msz, ix) {
!{nm} {!{regs}},pg,[xb] :: .call w4(0xe410e000|(!{msz}<<23)|(!{n-1}<<21)|(pg<<10)|(xb<<5)|zt)
!{nm} {!{regs}},pg,[xb,#!v,MUL VL] :: .call svmem4(0xe410e000|(!{msz}<<23)|(!{n-1}<<21),v,!{n},pg,xb,zt)
!{nm} {!{regs}},pg,[xb,!{ix}] :: .call w4(0xe4006000|(!{msz}<<23)|(!{n-1}<<21)|(xm<<16)|(pg<<10)|(xb<<5)|zt)
}
!def svmulti(sfx, el, msz, ix) {
!svldn1("LDNT1" + sfx, "zt." + el, 1, msz, ix)
!svstn1("STNT1" + sfx, "zt." + el, 1, msz, ix)
!svldn1("LD2" + sfx, "zt." + el + ",za." + el, 2, msz, ix)
!svstn1("ST2" + sfx, "zt." + el + ",za." + el, 2, msz, ix)
!svldn1("LD3" + sfx, "zt." + el + ",za." + el + ",zb." + el, 3, msz, ix)
!svstn1("ST3" + sfx, "zt." + el + ",za." + el + ",zb." + el, 3, msz, ix)
!svldn1("LD4" + sfx, "zt." + el + ",za." + el + ",zb." + el + ",zc." + el, 4, msz, ix)
!svstn1("ST4" + sfx, "zt." + el + ",za." + el + ",zb." + el + ",zc." + el, 4, msz, ix)
/* the same lists written with a dash */
!svldn1("LD2" + sfx, "zt." + el + "-za." + el, 2, msz, ix)
!svstn1("ST2" + sfx, "zt." + el + "-za." + el, 2, msz, ix)
!svldn1("LD3" + sfx, "zt." + el + "-zb." + el, 3, msz, ix)
!svstn1("ST3" + sfx, "zt." + el + "-zb." + el, 3, msz, ix)
!svldn1("LD4" + sfx, "zt." + el + "-zc." + el, 4, msz, ix)
!svstn1("ST4" + sfx, "zt." + el + "-zc." + el, 4, msz, ix)
}
!svmulti("B", "B", 0, "xm")
!svmulti("H", "H", 1, "xm,LSL #1")
!svmulti("W", "S", 2, "xm,LSL #2")
!svmulti("D", "D", 3, "xm,LSL #3")

/* Broadcast one element to every lane.  The six-bit offset counts
/* elements, so it is the byte offset divided by the access size. */
!def svld1rp(sfx, el, base, sz) {
LD1R!{sfx} {zt.!{el}},pg/Z,[xb] :: .call w4(!{base}|(pg<<10)|(xb<<5)|zt)
LD1R!{sfx} {zt.!{el}},pg/Z,[xb,#!v] :: .call svmem6(!{base},v,!{sz},pg,xb,zt)
}
!svld1rp("B", "B", 0x84408000, 1)
!svld1rp("B", "H", 0x8440a000, 1)
!svld1rp("B", "S", 0x8440c000, 1)
!svld1rp("B", "D", 0x8440e000, 1)
!svld1rp("H", "H", 0x84c0a000, 2)
!svld1rp("H", "S", 0x84c0c000, 2)
!svld1rp("H", "D", 0x84c0e000, 2)
!svld1rp("W", "S", 0x8540c000, 4)
!svld1rp("W", "D", 0x8540e000, 4)
!svld1rp("D", "D", 0x85c0e000, 8)
!svld1rp("SB", "H", 0x85c0c000, 1)
!svld1rp("SB", "S", 0x85c0a000, 1)
!svld1rp("SB", "D", 0x85c08000, 1)
!svld1rp("SH", "S", 0x8540a000, 2)
!svld1rp("SH", "D", 0x85408000, 2)
!svld1rp("SW", "D", 0x84c08000, 4)

/* Broadcast a whole quadword or octaword */
!def svld1rq(sfx, el, msz, ix, sz, nm, bit21) {
!{nm}!{sfx} {zt.!{el}},pg/Z,[xb] :: .call w4(0xa4002000|(!{msz}<<23)|(!{bit21}<<21)|(pg<<10)|(xb<<5)|zt)
!{nm}!{sfx} {zt.!{el}},pg/Z,[xb,#!v] :: .call svmem4(0xa4002000|(!{msz}<<23)|(!{bit21}<<21),v,!{sz},pg,xb,zt)
!{nm}!{sfx} {zt.!{el}},pg/Z,[xb,!{ix}] :: .call w4(0xa4000000|(!{msz}<<23)|(!{bit21}<<21)|(xm<<16)|(pg<<10)|(xb<<5)|zt)
}
!def svld1rqo(sfx, el, msz, ix) {
!svld1rq(sfx, el, msz, ix, 16, "LD1RQ", 0)
!svld1rq(sfx, el, msz, ix, 32, "LD1RO", 1)
}
!svld1rqo("B", "B", 0, "xm")
!svld1rqo("H", "H", 1, "xm,LSL #1")
!svld1rqo("W", "S", 2, "xm,LSL #2")
!svld1rqo("D", "D", 3, "xm,LSL #3")

/* -------------------------------------------------------------------
/* SVE gather loads, scatter stores and prefetches.
/* ------------------------------------------------------------------- */
.func::svmem5::base,v,n,pg,rn,zt
q = .call divu5(v, n)
.return .call w4(base | (q << 16) | (pg << 10) | (rn << 5) | zt)
.endfunc

/* Gather with 32-bit offsets.  u is the zero-extend bit at 14 and ff
/* the first-fault bit at 13. */
!def svgat32(nm, msz, u, ff, sz) {
!{nm} {zt.S},pg/Z,[xb,zm.S,UXTW] :: .call w4(0x84000000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.S},pg/Z,[xb,zm.S,SXTW] :: .call w4(0x84400000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.S},pg/Z,[zn.S] :: .call w4(0x84208000|(!{msz}<<23)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.S},pg/Z,[zn.S,#!v] :: .call svmem5(0x84208000|(!{msz}<<23)|(!{u}<<14)|(!{ff}<<13),v,!{sz},pg,zn,zt)
}
!def svgat32s(nm, msz, u, ff) {
!{nm} {zt.S},pg/Z,[xb,zm.S,UXTW #!{msz}] :: .call w4(0x84200000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.S},pg/Z,[xb,zm.S,SXTW #!{msz}] :: .call w4(0x84600000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
}
!svgat32("LD1B", 0, 1, 0, 1)
!svgat32("LD1SB", 0, 0, 0, 1)
!svgat32("LDFF1B", 0, 1, 1, 1)
!svgat32("LDFF1SB", 0, 0, 1, 1)
!svgat32("LD1H", 1, 1, 0, 2)
!svgat32("LD1SH", 1, 0, 0, 2)
!svgat32("LDFF1H", 1, 1, 1, 2)
!svgat32("LDFF1SH", 1, 0, 1, 2)
!svgat32("LD1W", 2, 1, 0, 4)
!svgat32("LDFF1W", 2, 1, 1, 4)
!svgat32s("LD1H", 1, 1, 0)
!svgat32s("LD1SH", 1, 0, 0)
!svgat32s("LDFF1H", 1, 1, 1)
!svgat32s("LDFF1SH", 1, 0, 1)
!svgat32s("LD1W", 2, 1, 0)
!svgat32s("LDFF1W", 2, 1, 1)

/* Gather with 64-bit offsets */
!def svgat64(nm, msz, u, ff, sz) {
!{nm} {zt.D},pg/Z,[xb,zm.D,UXTW] :: .call w4(0xc4000000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg/Z,[xb,zm.D,SXTW] :: .call w4(0xc4400000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg/Z,[xb,zm.D] :: .call w4(0xc4408000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg/Z,[zn.D] :: .call w4(0xc4208000|(!{msz}<<23)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.D},pg/Z,[zn.D,#!v] :: .call svmem5(0xc4208000|(!{msz}<<23)|(!{u}<<14)|(!{ff}<<13),v,!{sz},pg,zn,zt)
}
!def svgat64s(nm, msz, u, ff) {
!{nm} {zt.D},pg/Z,[xb,zm.D,UXTW #!{msz}] :: .call w4(0xc4200000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg/Z,[xb,zm.D,SXTW #!{msz}] :: .call w4(0xc4600000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg/Z,[xb,zm.D,LSL #!{msz}] :: .call w4(0xc4608000|(!{msz}<<23)|(zm<<16)|(!{u}<<14)|(!{ff}<<13)|(pg<<10)|(xb<<5)|zt)
}
!svgat64("LD1B", 0, 1, 0, 1)
!svgat64("LD1SB", 0, 0, 0, 1)
!svgat64("LDFF1B", 0, 1, 1, 1)
!svgat64("LDFF1SB", 0, 0, 1, 1)
!svgat64("LD1H", 1, 1, 0, 2)
!svgat64("LD1SH", 1, 0, 0, 2)
!svgat64("LDFF1H", 1, 1, 1, 2)
!svgat64("LDFF1SH", 1, 0, 1, 2)
!svgat64("LD1W", 2, 1, 0, 4)
!svgat64("LD1SW", 2, 0, 0, 4)
!svgat64("LDFF1W", 2, 1, 1, 4)
!svgat64("LDFF1SW", 2, 0, 1, 4)
!svgat64("LD1D", 3, 1, 0, 8)
!svgat64("LDFF1D", 3, 1, 1, 8)
!svgat64s("LD1H", 1, 1, 0)
!svgat64s("LD1SH", 1, 0, 0)
!svgat64s("LDFF1H", 1, 1, 1)
!svgat64s("LDFF1SH", 1, 0, 1)
!svgat64s("LD1W", 2, 1, 0)
!svgat64s("LD1SW", 2, 0, 0)
!svgat64s("LDFF1W", 2, 1, 1)
!svgat64s("LDFF1SW", 2, 0, 1)
!svgat64s("LD1D", 3, 1, 0)
!svgat64s("LDFF1D", 3, 1, 1)

/* Scatter with 32-bit offsets */
!def svsca32(nm, msz, sz) {
!{nm} {zt.S},pg,[xb,zm.S,UXTW] :: .call w4(0xe4408000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.S},pg,[xb,zm.S,SXTW] :: .call w4(0xe440c000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.S},pg,[zn.S] :: .call w4(0xe460a000|(!{msz}<<23)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.S},pg,[zn.S,#!v] :: .call svmem5(0xe460a000|(!{msz}<<23),v,!{sz},pg,zn,zt)
}
!def svsca32s(nm, msz) {
!{nm} {zt.S},pg,[xb,zm.S,UXTW #!{msz}] :: .call w4(0xe4608000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.S},pg,[xb,zm.S,SXTW #!{msz}] :: .call w4(0xe460c000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
}
!svsca32("ST1B", 0, 1)
!svsca32("ST1H", 1, 2)
!svsca32("ST1W", 2, 4)
!svsca32s("ST1H", 1)
!svsca32s("ST1W", 2)

/* Scatter with 64-bit offsets */
!def svsca64(nm, msz, sz) {
!{nm} {zt.D},pg,[xb,zm.D,UXTW] :: .call w4(0xe4008000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg,[xb,zm.D,SXTW] :: .call w4(0xe400c000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg,[xb,zm.D] :: .call w4(0xe400a000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg,[zn.D] :: .call w4(0xe440a000|(!{msz}<<23)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.D},pg,[zn.D,#!v] :: .call svmem5(0xe440a000|(!{msz}<<23),v,!{sz},pg,zn,zt)
}
!def svsca64s(nm, msz) {
!{nm} {zt.D},pg,[xb,zm.D,UXTW #!{msz}] :: .call w4(0xe4208000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg,[xb,zm.D,SXTW #!{msz}] :: .call w4(0xe420c000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
!{nm} {zt.D},pg,[xb,zm.D,LSL #!{msz}] :: .call w4(0xe420a000|(!{msz}<<23)|(zm<<16)|(pg<<10)|(xb<<5)|zt)
}
!svsca64("ST1B", 0, 1)
!svsca64("ST1H", 1, 2)
!svsca64("ST1W", 2, 4)
!svsca64("ST1D", 3, 8)
!svsca64s("ST1H", 1)
!svsca64s("ST1W", 2)
!svsca64s("ST1D", 3)

/* Non-temporal gather and scatter */
!def svntg(nm, msz, lo32, lo64) {
!{nm} {zt.S},pg/Z,[zn.S] :: .call w4(0x84000000|(!{msz}<<23)|(31<<16)|!{lo32}|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.S},pg/Z,[zn.S,xm] :: .call w4(0x84000000|(!{msz}<<23)|(xm<<16)|!{lo32}|(pg<<10)|(zn<<5)|zt)
