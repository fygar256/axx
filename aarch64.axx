!sv2bp("URSHLR", 0x07)
!sv2bp("SQSHL", 0x08)
!sv2bp("UQSHL", 0x09)
!sv2bp("SQRSHL", 0x0a)
!sv2bp("UQRSHL", 0x0b)
!sv2bp("SQSHLR", 0x0c)
!sv2bp("UQSHLR", 0x0d)
!sv2bp("SQRSHLR", 0x0e)
!sv2bp("UQRSHLR", 0x0f)
!sv2bp("SHADD", 0x10)
!sv2bp("UHADD", 0x11)
!sv2bp("SHSUB", 0x12)
!sv2bp("UHSUB", 0x13)
!sv2bp("SRHADD", 0x14)
!sv2bp("URHADD", 0x15)
!sv2bp("SHSUBR", 0x16)
!sv2bp("UHSUBR", 0x17)
!sv2bp("SQADD", 0x18)
!sv2bp("UQADD", 0x19)
