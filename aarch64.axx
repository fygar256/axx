/* -------------------------------------------------------------------
/* SME2: moving between the ZA array and a list, and the multi-vector
/* loads and stores.
/*
/* A list written with commas may be consecutive or strided -- {z0.b,
/* z8.b} is a strided pair and {z0.b, z4.b, z8.b, z12.b} a strided
/* quad -- so the emitters read the register numbers and pick the
/* form.  A list written with a dash is always consecutive.
/* ------------------------------------------------------------------- */

/* MOVA between a tile slice range and a list.  The tile number and
/* the first slice share one field, and the slice index is divided by
/* the list length. */
.func::movam::base,t,i,wv,zn,a,b,nb
g = .call n2q(a, b)
k = 1
.if g == 1 .then
k = 2
.endif
.if (i & (k + k - 1)) != 0 .then
.raise 3
.endif
sh = nb - k
.if sh < 0 .then
sh = 0
.endif
f = (t << sh) | (i >> k)
.return .call w4(base | (g << 10) | ((wv - 12) << 13) | (f << 5) | zn)
.endfunc
.func::movamt::base,t,i,wv,zn,a,b,nb
g = .call n2q(a, b)
k = 1
.if g == 1 .then
k = 2
.endif
.if (i & (k + k - 1)) != 0 .then
.raise 3
.endif
sh = nb - k
.if sh < 0 .then
sh = 0
.endif
f = (t << sh) | (i >> k)
.return .call w4(base | (g << 10) | ((wv - 12) << 13) | (zn << 5) | f)
.endfunc

