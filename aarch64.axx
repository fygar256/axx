/* Long carry propagation, on words and doublewords only */
ADCLB zd.S,zn.S,zm.S :: .call w4(0x4500d000|(zm<<16)|(zn<<5)|zd)
ADCLT zd.S,zn.S,zm.S :: .call w4(0x4500d400|(zm<<16)|(zn<<5)|zd)
