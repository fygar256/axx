LDNT1D {zt.D},pg/Z,[zn.D] :: .call w4(0xc59fc000|(pg<<10)|(zn<<5)|zt)
LDNT1D {zt.D},pg/Z,[zn.D,xm] :: .call w4(0xc580c000|(xm<<16)|(pg<<10)|(zn<<5)|zt)
LDNT1SW {zt.D},pg/Z,[zn.D] :: .call w4(0xc51f8000|(pg<<10)|(zn<<5)|zt)
LDNT1SW {zt.D},pg/Z,[zn.D,xm] :: .call w4(0xc5008000|(xm<<16)|(pg<<10)|(zn<<5)|zt)
