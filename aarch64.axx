!lsm3("ST1", 0, 0x6, "2S", 0, 2, 24)
!lsm3("ST1", 0, 0x6, "4S", 1, 2, 48)
!lsm3("ST1", 0, 0x6, "1D", 0, 3, 24)
!lsm3("ST1", 0, 0x6, "2D", 1, 3, 48)
/* ST1: 4 registers per group */
!lsm4("ST1", 0, 0x2, "8B", 0, 0, 32)
!lsm4("ST1", 0, 0x2, "16B", 1, 0, 64)
