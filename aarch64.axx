!sr("TPIDR_EL0", 3, 3, 13, 0, 2, 2)
!sr("TPIDRRO_EL0", 3, 3, 13, 0, 3, 2)
!sr("CNTFRQ_EL0", 3, 3, 14, 0, 0, 2)
