/* Shift and accumulate, unpredicated */
!def sv2sar(nm, opc, el, es) {
!{nm} zd.!{el},zn.!{el},#!s ::s<1;3,s>!{es};3 :: .call w4(0x45000000|((((!{es}*2-s)>>5)&3)<<22)|(((!{es}*2-s)&0x1f)<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
