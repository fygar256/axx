!sv2pp("UMAXP", 0x15)
!sv2pp("SMINP", 0x16)
!sv2pp("UMINP", 0x17)
!def svfpp1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.!{el} :: .call w4(0x64008000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
}
