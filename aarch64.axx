/* LD2: 2 registers per group */
!lsm2("LD2", 1, 0x8, "8B", 0, 0, 16)
!lsm2("LD2", 1, 0x8, "16B", 1, 0, 32)
!lsm2("LD2", 1, 0x8, "4H", 0, 1, 16)
