!lsm4("ST1", 0, 0x2, "2S", 0, 2, 32)
!lsm4("ST1", 0, 0x2, "4S", 1, 2, 64)
!lsm4("ST1", 0, 0x2, "1D", 0, 3, 32)
!lsm4("ST1", 0, 0x2, "2D", 1, 3, 64)
/* ST2: 2 registers per group */
!lsm2("ST2", 0, 0x8, "8B", 0, 0, 16)
!lsm2("ST2", 0, 0x8, "16B", 1, 0, 32)
!lsm2("ST2", 0, 0x8, "4H", 0, 1, 16)
!lsm2("ST2", 0, 0x8, "8H", 1, 1, 32)
!lsm2("ST2", 0, 0x8, "2S", 0, 2, 16)
!lsm2("ST2", 0, 0x8, "4S", 1, 2, 32)
!lsm2("ST2", 0, 0x8, "2D", 1, 3, 32)
/* ST3: 3 registers per group */
!lsm3("ST3", 0, 0x4, "8B", 0, 0, 24)
!lsm3("ST3", 0, 0x4, "16B", 1, 0, 48)
!lsm3("ST3", 0, 0x4, "4H", 0, 1, 24)
!lsm3("ST3", 0, 0x4, "8H", 1, 1, 48)
!lsm3("ST3", 0, 0x4, "2S", 0, 2, 24)
!lsm3("ST3", 0, 0x4, "4S", 1, 2, 48)
!lsm3("ST3", 0, 0x4, "2D", 1, 3, 48)
/* ST4: 4 registers per group */
!lsm4("ST4", 0, 0x0, "8B", 0, 0, 32)
!lsm4("ST4", 0, 0x0, "16B", 1, 0, 64)
!lsm4("ST4", 0, 0x0, "4H", 0, 1, 32)
