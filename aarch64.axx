!f2iall("FCVTMU", 2, 1)
!f2iall("FCVTZS", 3, 0)
!f2iall("FCVTZU", 3, 1)

/* Integer to floating point */
!def i2f(nm, opc, sf, pt, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{opc}<<16)|(!{rn}<<5)|!{rd})
}
!def i2fall(nm, opc) {
!i2f(nm, opc, 0, 0, "fsd", "wn")
!i2f(nm, opc, 1, 0, "fsd", "xn")
!i2f(nm, opc, 0, 1, "fdd", "wn")
!i2f(nm, opc, 1, 1, "fdd", "xn")
!i2f(nm, opc, 0, 3, "fhd", "wn")
!i2f(nm, opc, 1, 3, "fhd", "xn")
}
!i2fall("SCVTF", 2)
!i2fall("UCVTF", 3)

/* FMOV between a general register and a floating-point register */
!f2i("FMOV", 0, 6, 0, 0, "wd", "fsn")
!i2f("FMOV", 7, 0, 0, "fsd", "wn")
!f2i("FMOV", 0, 6, 1, 1, "xd", "fdn")
!i2f("FMOV", 7, 1, 1, "fdd", "xn")
!f2i("FMOV", 0, 6, 0, 3, "wd", "fhn")
!i2f("FMOV", 7, 0, 3, "fhd", "wn")
!f2i("FMOV", 0, 6, 1, 3, "xd", "fhn")
!i2f("FMOV", 7, 1, 3, "fhd", "xn")

/* FMOV (immediate). The operand is captured as a binary64 bit
/* pattern and fmovi reduces it to the 8-bit field, reporting an
/* error for any value A64 cannot spell. */
FMOV fsd,#!Dv :: .call fmovi(v,0,fsd)
FMOV fdd,#!Dv :: .call fmovi(v,1,fdd)
FMOV fhd,#!Dv :: .call fmovi(v,3,fhd)

/* Fixed-point conversions. The same encoding as the integer ones with
/* bit 21 clear, and the scale field holding 64 minus the fraction
/* width. */
!def f2ifx(nm, rmode, opc, sf, pt, rd, rn, mx) {
!{nm} !{rd},!{rn},#!c ::c<1;3,c>!{mx};3 :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(!{rmode}<<19)|(!{opc}<<16)|((64-c)<<10)|(!{rn}<<5)|!{rd})
}
!def i2ffx(nm, opc, sf, pt, rd, rn, mx) {
!{nm} !{rd},!{rn},#!c ::c<1;3,c>!{mx};3 :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(!{opc}<<16)|((64-c)<<10)|(!{rn}<<5)|!{rd})
}
!def fxall(nm, rmode, opc, dir) {
!if dir == 0 !then {
!f2ifx(nm, rmode, opc, 0, 0, "wd", "fsn", 32)
!f2ifx(nm, rmode, opc, 1, 0, "xd", "fsn", 64)
!f2ifx(nm, rmode, opc, 0, 1, "wd", "fdn", 32)
!f2ifx(nm, rmode, opc, 1, 1, "xd", "fdn", 64)
!f2ifx(nm, rmode, opc, 0, 3, "wd", "fhn", 32)
!f2ifx(nm, rmode, opc, 1, 3, "xd", "fhn", 64)
} !else {
!i2ffx(nm, opc, 0, 0, "fsd", "wn", 32)
!i2ffx(nm, opc, 1, 0, "fsd", "xn", 64)
!i2ffx(nm, opc, 0, 1, "fdd", "wn", 32)
!i2ffx(nm, opc, 1, 1, "fdd", "xn", 64)
!i2ffx(nm, opc, 0, 3, "fhd", "wn", 32)
!i2ffx(nm, opc, 1, 3, "fhd", "xn", 64)
}
}
!fxall("FCVTZS", 3, 0, 0)
!fxall("FCVTZU", 3, 1, 0)
!fxall("SCVTF", 0, 2, 1)
!fxall("UCVTF", 0, 3, 1)

/* Load-acquire RCpc register (FEAT_LRCPC) */
!def ldapr(mn, size, rt) {
!{mn} !{rt},[xb] :: .call w4((!{size}<<30)|(7<<27)|(1<<23)|(1<<21)|(31<<16)|(1<<15)|(4<<12)|(xb<<5)|!{rt})
}
!ldapr("LDAPRB", 0, "wt")
!ldapr("LDAPRH", 1, "wt")
!ldapr("LDAPR", 2, "wt")
!ldapr("LDAPR", 3, "xt")

/* Compare and swap pair (FEAT_LSE). Rs and Rt each name the first of
/* an even-numbered pair. */
!def caspgrp(sz, rt, ru, rr, rv) {
!local ai = 0
!local nm = ""
!local l = 0
!local o0 = 0
!while ai <= 3 {
!set nm = ai == 0 ? "CASP" : (ai == 1 ? "CASPA" : (ai == 2 ? "CASPL" : "CASPAL"))
!set l = (ai == 1 || ai == 3) ? 1 : 0
!set o0 = (ai >= 2) ? 1 : 0
!{nm} !{rr},!{rv},!{rt},!{ru},[xb] ::(!{rr}&1)!=0;5,(!{rt}&1)!=0;5 :: .call w4((!{sz}<<30)|(8<<24)|(!{l}<<22)|(1<<21)|(!{rr}<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
!set ai = ai + 1
}
}
!caspgrp(0, "wt", "wu", "wm", "wn")
!caspgrp(1, "xt", "xu", "xm", "xn")
