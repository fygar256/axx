!{nm} {zt.S},pg,[zn.S] :: .call w4(0xe4402000|(!{msz}<<23)|(31<<16)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.S},pg,[zn.S,xm] :: .call w4(0xe4402000|(!{msz}<<23)|(xm<<16)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.D},pg,[zn.D] :: .call w4(0xe4002000|(!{msz}<<23)|(31<<16)|(pg<<10)|(zn<<5)|zt)
!{nm} {zt.D},pg,[zn.D,xm] :: .call w4(0xe4002000|(!{msz}<<23)|(xm<<16)|(pg<<10)|(zn<<5)|zt)
}
