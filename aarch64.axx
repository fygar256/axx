/* SQRDMLAH and SQRDMLSH sit in the "three same extra" block, which
/* is the same encoding with bit 21 clear. */
!def s3xone(nm, u, opc, rd, rn, rm, sz) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((1<<30)|(!{u}<<29)|(0x1e<<24)|(!{sz}<<22)|(!{rm}<<16)|(!{opc}<<11)|(1<<10)|(!{rn}<<5)|!{rd})
}
!def s3x(nm, u, opc) {
!s3xone(nm, u, opc, "fhd", "fhn", "fhm", 1)
!s3xone(nm, u, opc, "fsd", "fsn", "fsm", 2)
}
!s3x("SQRDMLAH", 1, 0x10)
!s3x("SQRDMLSH", 1, 0x11)

/* Scalar floating-point three same */
!def s3h(nm, u, op, k) {
!{nm} fhd,fhn,fhm :: .call w4((1<<30)|(!{u}<<29)|(0x1e<<24)|(!{op}<<23)|(1<<22)|(fhm<<16)|(!{k}<<11)|(1<<10)|(fhn<<5)|fhd)
}
!def s3f(nm, u, op, k) {
!s3h(nm, u, op, k)
!s3one(nm, u, 0x18 + k, "fsd", "fsn", "fsm", op * 2)
!s3one(nm, u, 0x18 + k, "fdd", "fdn", "fdm", (op * 2) + 1)
}
!s3f("FMULX", 0, 0, 3)
!s3f("FCMEQ", 0, 0, 4)
!s3f("FRECPS", 0, 0, 7)
!s3f("FRSQRTS", 0, 1, 7)
!s3f("FCMGE", 1, 0, 4)
!s3f("FACGE", 1, 0, 5)
!s3f("FABD", 1, 1, 2)
!s3f("FCMGT", 1, 1, 4)
!s3f("FACGT", 1, 1, 5)

/* Scalar two-register miscellaneous */
!def s2one(nm, u, sz, hi, opc, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((1<<30)|(!{u}<<29)|(0x1e<<24)|(!{sz}<<22)|(!{hi}<<17)|(!{opc}<<12)|(2<<10)|(!{rn}<<5)|!{rd})
}
!def s2zone(nm, u, sz, hi, opc, rd, rn) {
!{nm} !{rd},!{rn},#0 :: .call w4((1<<30)|(!{u}<<29)|(0x1e<<24)|(!{sz}<<22)|(!{hi}<<17)|(!{opc}<<12)|(2<<10)|(!{rn}<<5)|!{rd})
}
!def s2i(nm, u, opc, set) {
!if set == 0 !then {
!s2one(nm, u, 3, 0x10, opc, "fdd", "fdn")
} !else {
!s2one(nm, u, 0, 0x10, opc, "fbd", "fbn")
!s2one(nm, u, 1, 0x10, opc, "fhd", "fhn")
!s2one(nm, u, 2, 0x10, opc, "fsd", "fsn")
!s2one(nm, u, 3, 0x10, opc, "fdd", "fdn")
}
}
