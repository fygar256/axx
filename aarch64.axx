/* LD3: 3 registers per group */
!lsm3("LD3", 1, 0x4, "8B", 0, 0, 24)
!lsm3("LD3", 1, 0x4, "16B", 1, 0, 48)
!lsm3("LD3", 1, 0x4, "4H", 0, 1, 24)
