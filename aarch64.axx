!svfpp("FMINP", 0x17)

/* Saturating unary, predicated */
!def sv2u1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zn.!{el} :: .call w4(0x4400a000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zn<<5)|zd)
}
