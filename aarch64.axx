!sv2w1("PMULLT", 0x1b, "H", "B", 1)
!sv2w1("PMULLB", 0x1a, "D", "S", 3)
!sv2w1("PMULLT", 0x1b, "D", "S", 3)
!sv2w("SMULLB", 0x1c)
!sv2w("SMULLT", 0x1d)
!sv2w("UMULLB", 0x1e)
!sv2w("UMULLT", 0x1f)
