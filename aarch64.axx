LDNT1W {zd.S,za.S,zb.S,zc.S},pnn/Z,[xb,xm,LSL #2] :: .call ls4(0xa0000000,xm,xb,pnn,2,1,zd,za,zb,zc)
LDNT1W {zd.S-za.S},pnn/Z,[xb,xm,LSL #2] :: .call lsd(0xa0000000,xm,xb,pnn,2,1,zd,za)
LDNT1D {zd.D,za.D},pnn/Z,[xb] :: .call ls2(0xa0400000,0,xb,pnn,3,1,zd,za)
LDNT1D {zd.D,za.D,zb.D,zc.D},pnn/Z,[xb] :: .call ls4(0xa0400000,0,xb,pnn,3,1,zd,za,zb,zc)
LDNT1D {zd.D-za.D},pnn/Z,[xb] :: .call lsd(0xa0400000,0,xb,pnn,3,1,zd,za)
LDNT1D {zd.D,za.D},pnn/Z,[xb,#!v,MUL VL] :: .call ls2i(0xa0400000,v,xb,pnn,3,1,zd,za)
LDNT1D {zd.D,za.D,zb.D,zc.D},pnn/Z,[xb,#!v,MUL VL] :: .call ls4i(0xa0400000,v,xb,pnn,3,1,zd,za,zb,zc)
LDNT1D {zd.D-za.D},pnn/Z,[xb,#!v,MUL VL] :: .call lsdi(0xa0400000,v,xb,pnn,3,1,zd,za)
LDNT1D {zd.D,za.D},pnn/Z,[xb,xm,LSL #3] :: .call ls2(0xa0000000,xm,xb,pnn,3,1,zd,za)
LDNT1D {zd.D,za.D,zb.D,zc.D},pnn/Z,[xb,xm,LSL #3] :: .call ls4(0xa0000000,xm,xb,pnn,3,1,zd,za,zb,zc)
LDNT1D {zd.D-za.D},pnn/Z,[xb,xm,LSL #3] :: .call lsd(0xa0000000,xm,xb,pnn,3,1,zd,za)
STNT1B {zd.B,za.B},pnn,[xb] :: .call ls2(0xa0600000,0,xb,pnn,0,1,zd,za)
STNT1B {zd.B,za.B,zb.B,zc.B},pnn,[xb] :: .call ls4(0xa0600000,0,xb,pnn,0,1,zd,za,zb,zc)
STNT1B {zd.B-za.B},pnn,[xb] :: .call lsd(0xa0600000,0,xb,pnn,0,1,zd,za)
STNT1B {zd.B,za.B},pnn,[xb,#!v,MUL VL] :: .call ls2i(0xa0600000,v,xb,pnn,0,1,zd,za)
STNT1B {zd.B,za.B,zb.B,zc.B},pnn,[xb,#!v,MUL VL] :: .call ls4i(0xa0600000,v,xb,pnn,0,1,zd,za,zb,zc)
STNT1B {zd.B-za.B},pnn,[xb,#!v,MUL VL] :: .call lsdi(0xa0600000,v,xb,pnn,0,1,zd,za)
STNT1B {zd.B,za.B},pnn,[xb,xm] :: .call ls2(0xa0200000,xm,xb,pnn,0,1,zd,za)
STNT1B {zd.B,za.B,zb.B,zc.B},pnn,[xb,xm] :: .call ls4(0xa0200000,xm,xb,pnn,0,1,zd,za,zb,zc)
STNT1B {zd.B-za.B},pnn,[xb,xm] :: .call lsd(0xa0200000,xm,xb,pnn,0,1,zd,za)
STNT1H {zd.H,za.H},pnn,[xb] :: .call ls2(0xa0600000,0,xb,pnn,1,1,zd,za)
STNT1H {zd.H,za.H,zb.H,zc.H},pnn,[xb] :: .call ls4(0xa0600000,0,xb,pnn,1,1,zd,za,zb,zc)
STNT1H {zd.H-za.H},pnn,[xb] :: .call lsd(0xa0600000,0,xb,pnn,1,1,zd,za)
STNT1H {zd.H,za.H},pnn,[xb,#!v,MUL VL] :: .call ls2i(0xa0600000,v,xb,pnn,1,1,zd,za)
STNT1H {zd.H,za.H,zb.H,zc.H},pnn,[xb,#!v,MUL VL] :: .call ls4i(0xa0600000,v,xb,pnn,1,1,zd,za,zb,zc)
STNT1H {zd.H-za.H},pnn,[xb,#!v,MUL VL] :: .call lsdi(0xa0600000,v,xb,pnn,1,1,zd,za)
STNT1H {zd.H,za.H},pnn,[xb,xm,LSL #1] :: .call ls2(0xa0200000,xm,xb,pnn,1,1,zd,za)
STNT1H {zd.H,za.H,zb.H,zc.H},pnn,[xb,xm,LSL #1] :: .call ls4(0xa0200000,xm,xb,pnn,1,1,zd,za,zb,zc)
STNT1H {zd.H-za.H},pnn,[xb,xm,LSL #1] :: .call lsd(0xa0200000,xm,xb,pnn,1,1,zd,za)
STNT1W {zd.S,za.S},pnn,[xb] :: .call ls2(0xa0600000,0,xb,pnn,2,1,zd,za)
STNT1W {zd.S,za.S,zb.S,zc.S},pnn,[xb] :: .call ls4(0xa0600000,0,xb,pnn,2,1,zd,za,zb,zc)
STNT1W {zd.S-za.S},pnn,[xb] :: .call lsd(0xa0600000,0,xb,pnn,2,1,zd,za)
STNT1W {zd.S,za.S},pnn,[xb,#!v,MUL VL] :: .call ls2i(0xa0600000,v,xb,pnn,2,1,zd,za)
STNT1W {zd.S,za.S,zb.S,zc.S},pnn,[xb,#!v,MUL VL] :: .call ls4i(0xa0600000,v,xb,pnn,2,1,zd,za,zb,zc)
STNT1W {zd.S-za.S},pnn,[xb,#!v,MUL VL] :: .call lsdi(0xa0600000,v,xb,pnn,2,1,zd,za)
STNT1W {zd.S,za.S},pnn,[xb,xm,LSL #2] :: .call ls2(0xa0200000,xm,xb,pnn,2,1,zd,za)
STNT1W {zd.S,za.S,zb.S,zc.S},pnn,[xb,xm,LSL #2] :: .call ls4(0xa0200000,xm,xb,pnn,2,1,zd,za,zb,zc)
STNT1W {zd.S-za.S},pnn,[xb,xm,LSL #2] :: .call lsd(0xa0200000,xm,xb,pnn,2,1,zd,za)
STNT1D {zd.D,za.D},pnn,[xb] :: .call ls2(0xa0600000,0,xb,pnn,3,1,zd,za)
STNT1D {zd.D,za.D,zb.D,zc.D},pnn,[xb] :: .call ls4(0xa0600000,0,xb,pnn,3,1,zd,za,zb,zc)
STNT1D {zd.D-za.D},pnn,[xb] :: .call lsd(0xa0600000,0,xb,pnn,3,1,zd,za)
STNT1D {zd.D,za.D},pnn,[xb,#!v,MUL VL] :: .call ls2i(0xa0600000,v,xb,pnn,3,1,zd,za)
STNT1D {zd.D,za.D,zb.D,zc.D},pnn,[xb,#!v,MUL VL] :: .call ls4i(0xa0600000,v,xb,pnn,3,1,zd,za,zb,zc)
STNT1D {zd.D-za.D},pnn,[xb,#!v,MUL VL] :: .call lsdi(0xa0600000,v,xb,pnn,3,1,zd,za)
STNT1D {zd.D,za.D},pnn,[xb,xm,LSL #3] :: .call ls2(0xa0200000,xm,xb,pnn,3,1,zd,za)
STNT1D {zd.D,za.D,zb.D,zc.D},pnn,[xb,xm,LSL #3] :: .call ls4(0xa0200000,xm,xb,pnn,3,1,zd,za,zb,zc)
STNT1D {zd.D-za.D},pnn,[xb,xm,LSL #3] :: .call lsd(0xa0200000,xm,xb,pnn,3,1,zd,za)

/* The SME2 outer products */
SMOPA ZA!!t.S,pg/M,pf/M,zn.H,zm.H ::t>3;3 :: .call w4(0xa0800008|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)
SMOPS ZA!!t.S,pg/M,pf/M,zn.H,zm.H ::t>3;3 :: .call w4(0xa0800018|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)
UMOPA ZA!!t.S,pg/M,pf/M,zn.H,zm.H ::t>3;3 :: .call w4(0xa1800008|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)
UMOPS ZA!!t.S,pg/M,pf/M,zn.H,zm.H ::t>3;3 :: .call w4(0xa1800018|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)
BMOPA ZA!!t.S,pg/M,pf/M,zn.S,zm.S ::t>3;3 :: .call w4(0x80800008|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)
BMOPS ZA!!t.S,pg/M,pf/M,zn.S,zm.S ::t>3;3 :: .call w4(0x80800018|(zm<<16)|(pf<<13)|(pg<<10)|(zn<<5)|t)

/* -------------------------------------------------------------------
/* The last few forms: SVE2 shapes that the groups above did not
/* reach, and the SME2 unpack.
/* ------------------------------------------------------------------- */

/* The predicate NOT is an EOR against the governing predicate */
NOT pd.B,pv/Z,pn.B :: .call w4(0x25004200|(pv<<16)|(pv<<10)|(pn<<5)|pd)
NOTS pd.B,pv/Z,pn.B :: .call w4(0x25404200|(pv<<16)|(pv<<10)|(pn<<5)|pd)

/* Widening absolute difference */
!sv2w("SABDLB", 0x0c)
!sv2w("SABDLT", 0x0d)
!sv2w("UABDLB", 0x0e)
!sv2w("UABDLT", 0x0f)

/* Widening shift left.  The field holds the source element size plus
/* the shift amount. */
!def sv2shll(nm, opc, el, sel, es) {
!{nm} zd.!{el},zn.!{sel},#!s ::s<0;3,s>!{es-1};3 :: .call w4(0x4500a000|((((!{es}+s)>>5)&3)<<22)|(((!{es}+s)&0x1f)<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
!def sv2shlla(nm, opc) {
!sv2shll(nm, opc, "H", "B", 8)
!sv2shll(nm, opc, "S", "H", 16)
!sv2shll(nm, opc, "D", "S", 32)
}
!sv2shlla("SSHLLB", 0x28)
!sv2shlla("SSHLLT", 0x29)
!sv2shlla("USHLLB", 0x2a)
!sv2shlla("USHLLT", 0x2b)

/* BFloat16 multiply-subtract long */
BFMLSLB zd.S,zn.H,zm.H :: .call w4(0x64e0a000|(zm<<16)|(zn<<5)|zd)
BFMLSLT zd.S,zn.H,zm.H :: .call w4(0x64e0a400|(zm<<16)|(zn<<5)|zd)
BFMLSLB zd.S,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x64e06000|((i&1)<<11)|((i>>1)<<19)|(zy<<16)|(zn<<5)|zd)
BFMLSLT zd.S,zn.H,zy.H[!!i] ::i<0;3,i>7;3 :: .call w4(0x64e06400|((i&1)<<11)|((i>>1)<<19)|(zy<<16)|(zn<<5)|zd)

/* The two-way dot product from halfwords into words */
SDOT zd.S,zn.H,zm.H :: .call w4(0x4400c800|(zm<<16)|(zn<<5)|zd)
UDOT zd.S,zn.H,zm.H :: .call w4(0x4400cc00|(zm<<16)|(zn<<5)|zd)
SDOT zd.S,zn.H,zy.H[!!i] ::i<0;3,i>3;3 :: .call w4(0x4480c800|(i<<19)|(zy<<16)|(zn<<5)|zd)
UDOT zd.S,zn.H,zy.H[!!i] ::i<0;3,i>3;3 :: .call w4(0x4480cc00|(i<<19)|(zy<<16)|(zn<<5)|zd)

/* SME2 unpack: one vector into a pair, or a pair into a quad */
.func::s2unpk::sz,u,zn,a,b
g = .call n2q(a, b)
.return .call w4(0xc125e000 | (sz << 22) | (g << 20) | (zn << 5) | a | u)
.endfunc
!def s2unp(nm, u, el, sel, sz) {
!{nm} {zd.!{el},za.!{el}},zn.!{sel} :: .call s2unpk(!{sz},!{u},zn,zd,za)
!{nm} {zd.!{el}-za.!{el}},zn.!{sel} :: .call s2unpk(!{sz},!{u},zn,zd,za)
!{nm} {zd.!{el}-za.!{el}},{zn.!{sel},zb.!{sel}} ::(zn&1)!=0;5,zb!=zn+1;5 :: .call s2unpk(!{sz},!{u},zn,zd,za)
!{nm} {zd.!{el},za.!{el}},{zn.!{sel},zb.!{sel}} ::(zn&1)!=0;5,zb!=zn+1;5 :: .call s2unpk(!{sz},!{u},zn,zd,za)
}
!def s2unpa(nm, u) {
!s2unp(nm, u, "H", "B", 1)
!s2unp(nm, u, "S", "H", 2)
!s2unp(nm, u, "D", "S", 3)
}
!s2unpa("SUNPK", 0)
!s2unpa("UUNPK", 1)

/* -------------------------------------------------------------------
/* Forms the encoding-space sweep turned up: the SVE bitwise
/* immediates, the constructive EXT, the quadword permutes, the
/* half-precision dot product, and the SME2 widening
/* multiply-accumulates that take a single source vector.
/* ------------------------------------------------------------------- */

/* Bitwise immediate.  BIC is AND against the complement. */
.func::svlogi::base,v,maxw,rd
i13 = .call bitmask13(v, maxw)
.return .call w4(base | (i13 << 5) | rd)
.endfunc
.func::svlogni::base,v,maxw,rd
i13 = .call bitmask13(0 - v - 1, maxw)
.return .call w4(base | (i13 << 5) | rd)
.endfunc
!def svli(nm, base, el, maxw) {
!{nm} zd.!{el},zd.!{el},#!v :: .call svlogi(!{base},v,!{maxw},zd)
}
!def svlia(nm, base) {
!svli(nm, base, "B", 8)
!svli(nm, base, "H", 16)
!svli(nm, base, "S", 32)
!svli(nm, base, "D", 64)
}
!svlia("ORR", 0x05000000)
!svlia("EOR", 0x05400000)
!svlia("AND", 0x05800000)
!def svlin(el, maxw) {
BIC zd.!{el},zd.!{el},#!v :: .call svlogni(0x05800000,v,!{maxw},zd)
}
!svlin("B", 8)
!svlin("H", 16)
!svlin("S", 32)
!svlin("D", 64)

/* Broadcast the low element of a scalar register */
MOV zd.B,fbn :: .call w4(0x05202000|(1<<16)|(fbn<<5)|zd)
MOV zd.H,fhn :: .call w4(0x05202000|(2<<16)|(fhn<<5)|zd)
MOV zd.S,fsn :: .call w4(0x05202000|(4<<16)|(fsn<<5)|zd)
MOV zd.D,fdn :: .call w4(0x05202000|(8<<16)|(fdn<<5)|zd)
MOV zd.Q,fqn :: .call w4(0x05202000|(16<<16)|(fqn<<5)|zd)

/* EXT with a separate destination */
EXT zd.B,{zn.B,za.B},#!i ::i<0;3,i>255;3,za!=((zn+1)&31);5 :: .call w4(0x05600000|((i>>3)<<16)|((i&7)<<10)|(zn<<5)|zd)
EXT zd.B,{zn.B-za.B},#!i ::i<0;3,i>255;3,za!=((zn+1)&31);5 :: .call w4(0x05600000|((i>>3)<<16)|((i&7)<<10)|(zn<<5)|zd)

/* Quadword-element permutes */
!def svqperm(nm, opc) {
!{nm} zd.Q,zn.Q,zm.Q :: .call w4(0x05a00000|(!{opc}<<10)|(zm<<16)|(zn<<5)|zd)
}
!svqperm("ZIP1", 0)
!svqperm("ZIP2", 1)
!svqperm("UZP1", 2)
!svqperm("UZP2", 3)
!svqperm("TRN1", 6)
!svqperm("TRN2", 7)

/* Half-precision dot product into single precision */
FDOT zd.S,zn.H,zm.H :: .call w4(0x64208000|(zm<<16)|(zn<<5)|zd)
FDOT zd.S,zn.H,zy.H[!!i] ::i<0;3,i>3;3 :: .call w4(0x64204000|(i<<19)|(zy<<16)|(zn<<5)|zd)

/* SME2 widening multiply-accumulate from a single vector, indexed */
.func::zasi::base,ib,zm,wv,o,p,zn,w,mx
q = .call slq(o, p, w, mx)
.return .call w4(base | ib | (zm << 16) | ((wv - 8) << 13) | (zn << 5) | q)
.endfunc
!def zasi2(nm, base) {
!{nm} ZA.S[wv,!!o:!!p],zn.H,zx.H[!!i] ::i<0;3,i>7;3 :: .call zasi(!{base},((i&3)<<10)|((i>>2)<<15),zx,wv,o,p,zn,2,7)
}
!zasi2("FMLAL", 0xc1801000)
!zasi2("FMLSL", 0xc1801008)
!zasi2("BFMLAL", 0xc1801010)
!zasi2("BFMLSL", 0xc1801018)
!zasi2("SMLAL", 0xc1c01000)
!zasi2("SMLSL", 0xc1c01008)
!zasi2("UMLAL", 0xc1c01010)
!zasi2("UMLSL", 0xc1c01018)
!def zasi4(nm, base) {
!{nm} ZA.S[wv,!!o:!!p],zn.B,zx.B[!!i] ::i<0;3,i>15;3 :: .call zasi(!{base},((i&3)<<10)|(((i>>2)&1)<<12)|(((i>>3)&1)<<15),zx,wv,o,p,zn,4,3)
}
!zasi4("SMLALL", 0xc1000000)
!zasi4("SMLSLL", 0xc1000008)
!zasi4("UMLALL", 0xc1000010)
!zasi4("UMLSLL", 0xc1000018)
!zasi4("USMLALL", 0xc1000004)
!zasi4("SUMLALL", 0xc1000014)
!def zasi4d(nm, base) {
!{nm} ZA.D[wv,!!o:!!p],zn.H,zx.H[!!i] ::i<0;3,i>7;3 :: .call zasi(!{base},((i&3)<<10)|((i>>2)<<15),zx,wv,o,p,zn,4,3)
}
!zasi4d("SMLALL", 0xc1800000)
!zasi4d("SMLSLL", 0xc1800008)
!zasi4d("UMLALL", 0xc1800010)
!zasi4d("UMLSLL", 0xc1800018)
