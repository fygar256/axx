/* Data processing (3 source) */
!def dp3(nm, o31, o0, rd, rn, rm, ra, sf) {
!{nm} !{rd},!{rn},!{rm},!{ra} :: .call w4((!{sf}<<31)|(0x1b<<24)|(!{o31}<<21)|(!{rm}<<16)|(!{o0}<<15)|(!{ra}<<10)|(!{rn}<<5)|!{rd})
}
!dp3("MADD", 0, 0, "xd", "xn", "xm", "xa", 1)
!dp3("MADD", 0, 0, "wd", "wn", "wm", "wa", 0)
!dp3("MSUB", 0, 1, "xd", "xn", "xm", "xa", 1)
!dp3("MSUB", 0, 1, "wd", "wn", "wm", "wa", 0)
!dp3("SMADDL", 1, 0, "xd", "wn", "wm", "xa", 1)
!dp3("SMSUBL", 1, 1, "xd", "wn", "wm", "xa", 1)
!dp3("UMADDL", 5, 0, "xd", "wn", "wm", "xa", 1)
!dp3("UMSUBL", 5, 1, "xd", "wn", "wm", "xa", 1)

!def dp3z(nm, o31, o0, rd, rn, rm, sf) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((!{sf}<<31)|(0x1b<<24)|(!{o31}<<21)|(!{rm}<<16)|(!{o0}<<15)|(31<<10)|(!{rn}<<5)|!{rd})
}
