/* Scalar pairwise: the source is a two-element vector */
ADDP fdd,vn.2D :: .call w4((1<<30)|(0x1e<<24)|(3<<22)|(0x18<<17)|(0x1b<<12)|(2<<10)|(vn<<5)|fdd)
!def spwf(nm, opc, sz) {
!{nm} fhd,vn.2H :: .call w4((1<<30)|(0x1e<<24)|(!{sz}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|fhd)
!{nm} fsd,vn.2S :: .call w4((1<<30)|(1<<29)|(0x1e<<24)|(!{sz}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|fsd)
!{nm} fdd,vn.2D :: .call w4((1<<30)|(1<<29)|(0x1e<<24)|(!{sz+1}<<22)|(0x18<<17)|(!{opc}<<12)|(2<<10)|(vn<<5)|fdd)
}
