!sv2bp("UQSUB", 0x1b)
!sv2bp("SUQADD", 0x1c)
!sv2bp("USQADD", 0x1d)
!sv2bp("SQSUBR", 0x1e)
!sv2bp("UQSUBR", 0x1f)

/* Pairwise, predicated and destructive */
!def sv2pp1(nm, opc, el, sz) {
!{nm} zd.!{el},pg/M,zd.!{el},zm.!{el} :: .call w4(0x4400a000|(!{sz}<<22)|(!{opc}<<16)|(pg<<10)|(zm<<5)|zd)
}
