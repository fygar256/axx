}
!sv2dalpa("SADALP", 4)
!sv2dalpa("UADALP", 5)

/* Widening and narrowing arithmetic.  sz is the wider element. */
!def sv2w1(nm, opc, el, sel, sz) {
!{nm} zd.!{el},zn.!{sel},zm.!{sel} :: .call w4(0x45000000|(!{sz}<<22)|(zm<<16)|(!{opc}<<10)|(zn<<5)|zd)
}
