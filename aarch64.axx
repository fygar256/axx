!{nm} {zt.D},pg/Z,[zn.D,xm] :: .call w4(0xc4000000|(!{msz}<<23)|(xm<<16)|!{lo64}|(pg<<10)|(zn<<5)|zt)
}
!svntg("LDNT1B", 0, 0xa000, 0xc000)
!svntg("LDNT1H", 1, 0xa000, 0xc000)
