.check::tlbiop0::VMALLE1IS,VMALLE1,ALLE1IS,ALLE2IS,ALLE3IS,ALLE1,ALLE2,ALLE3,VMALLS12E1IS,VMALLS12E1
.check::tlbiop1::VAE1IS,ASIDE1IS,VAAE1IS,VALE1IS,VAALE1IS,VAE1,ASIDE1,VAAE1,VALE1,VAALE1
!sysins0("TLBI", "tlbiop0")
!sysins1("TLBI", "tlbiop1")

/* ===================================================================
/* Loads and stores
/* =================================================================== */
.check::rs::WR,WZR

/* Load/store register. Eleven rows per access size cover the whole
/* addressing repertoire: base with an optional offset (the mini
/* language picks the scaled or the unscaled encoding), pre- and
/* post-index, and the four register-offset extends. The "\!" in the
/* pre-index row escapes axx's own capture sigil so that it matches a
/* literal "!". */
!def lsreg(mn, rt, size, v, opc, scale) {
!{mn} !{rt},[xb[[,#!o]]] :: .call lsoff(!{size},!{v},!{opc},o,xb,!{rt},!{scale})
!{mn} !{rt},[xb,#!o]\! ::o<-256;8,o>255;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|((o&0x1ff)<<12)|(3<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb],#!o ::o<-256;8,o>255;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|((o&0x1ff)<<12)|(1<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(3<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm,LSL #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(3<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm,SXTX] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(7<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,xm,SXTX #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(xm<<16)|(7<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,UXTW] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(2<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,UXTW #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(2<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,SXTW] :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(6<<13)|(2<<10)|(xb<<5)|!{rt})
!{mn} !{rt},[xb,wm,SXTW #!a] ::(a!=0)&&(a!=!{scale});10 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|(1<<21)|(wm<<16)|(6<<13)|((a==!{scale}?1:0)<<12)|(2<<10)|(xb<<5)|!{rt})
}
!lsreg("STRB", "wt", 0, 0, 0, 0)
!lsreg("LDRB", "wt", 0, 0, 1, 0)
!lsreg("LDRSB", "xt", 0, 0, 2, 0)
!lsreg("LDRSB", "wt", 0, 0, 3, 0)
!lsreg("STRH", "wt", 1, 0, 0, 1)
!lsreg("LDRH", "wt", 1, 0, 1, 1)
!lsreg("LDRSH", "xt", 1, 0, 2, 1)
!lsreg("LDRSH", "wt", 1, 0, 3, 1)
!lsreg("STR", "wt", 2, 0, 0, 2)
!lsreg("LDR", "wt", 2, 0, 1, 2)
!lsreg("LDRSW", "xt", 2, 0, 2, 2)
!lsreg("STR", "xt", 3, 0, 0, 3)
!lsreg("LDR", "xt", 3, 0, 1, 3)
!lsreg("PRFM", "prf", 3, 0, 2, 3)
!lsreg("STR", "fb", 0, 1, 0, 0)
!lsreg("LDR", "fb", 0, 1, 1, 0)
!lsreg("STR", "fq", 0, 1, 2, 4)
!lsreg("LDR", "fq", 0, 1, 3, 4)
!lsreg("STR", "fh", 1, 1, 0, 1)
!lsreg("LDR", "fh", 1, 1, 1, 1)
!lsreg("STR", "fs", 2, 1, 0, 2)
!lsreg("LDR", "fs", 2, 1, 1, 2)
!lsreg("STR", "ff", 3, 1, 0, 3)
!lsreg("LDR", "ff", 3, 1, 1, 3)

/* Unscaled offset: the same encoding lsoff falls back to, reached by
/* its own mnemonic so that it can be asked for explicitly. */
!def lsur(mn, rt, size, v, opc) {
!{mn} !{rt},[xb[[,#!o]]] ::o<-256;8,o>255;8 :: .call w4((!{size}<<30)|(7<<27)|(!{v}<<26)|(!{opc}<<22)|((o&0x1ff)<<12)|(xb<<5)|!{rt})
}
!lsur("STURB", "wt", 0, 0, 0)
!lsur("LDURB", "wt", 0, 0, 1)
!lsur("LDURSB", "xt", 0, 0, 2)
!lsur("LDURSB", "wt", 0, 0, 3)
!lsur("STURH", "wt", 1, 0, 0)
!lsur("LDURH", "wt", 1, 0, 1)
!lsur("LDURSH", "xt", 1, 0, 2)
!lsur("LDURSH", "wt", 1, 0, 3)
!lsur("STUR", "wt", 2, 0, 0)
!lsur("LDUR", "wt", 2, 0, 1)
!lsur("LDURSW", "xt", 2, 0, 2)
!lsur("STUR", "xt", 3, 0, 0)
!lsur("LDUR", "xt", 3, 0, 1)
!lsur("PRFUM", "prf", 3, 0, 2)
!lsur("STUR", "fb", 0, 1, 0)
!lsur("LDUR", "fb", 0, 1, 1)
!lsur("STUR", "fq", 0, 1, 2)
!lsur("LDUR", "fq", 0, 1, 3)
!lsur("STUR", "fh", 1, 1, 0)
!lsur("LDUR", "fh", 1, 1, 1)
!lsur("STUR", "fs", 2, 1, 0)
!lsur("LDUR", "fs", 2, 1, 1)
!lsur("STUR", "ff", 3, 1, 0)
!lsur("LDUR", "ff", 3, 1, 1)

/* Load register (literal) */
!def lslit(mn, rt, opc, v) {
!{mn} !{rt},!t ::((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4((!{opc}<<30)|(3<<27)|(!{v}<<26)|((((t-$$)>>2)&0x7ffff)<<5)|!{rt})
}
!lslit("LDR", "wt", 0, 0)
!lslit("LDR", "xt", 1, 0)
!lslit("LDRSW", "xt", 2, 0)
!lslit("PRFM", "prf", 3, 0)
!lslit("LDR", "fs", 0, 1)
!lslit("LDR", "ff", 1, 1)
!lslit("LDR", "fq", 2, 1)

/* PRFM also accepts the raw 5-bit prefetch operand in place of a name */
PRFM #!p,[xb[[,#!o]]] ::p<0;3,p>31;3 :: .call lsoff(3,0,2,o,xb,p,3)
PRFM #!p,[xb,xm[[,LSL #!a]]] ::p<0;3,p>31;3,(a!=0)&&(a!=3);10 :: .call w4((3<<30)|(7<<27)|(2<<22)|(1<<21)|(xm<<16)|(3<<13)|((a==3?1:0)<<12)|(2<<10)|(xb<<5)|p)
PRFM #!p,!t ::p<0;3,p>31;3,((t-$$)<-1048576)||((t-$$)>1048572);2 :: .call w4((3<<30)|(3<<27)|((((t-$$)>>2)&0x7ffff)<<5)|p)
PRFUM #!p,[xb[[,#!o]]] ::p<0;3,p>31;3,o<-256;8,o>255;8 :: .call w4((3<<30)|(7<<27)|(2<<22)|((o&0x1ff)<<12)|(xb<<5)|p)

/* Load/store pair. sh is the log2 of the access size, so the scaled
/* offset is a shift rather than a division. */
!def lspair(mn, l, rt, ru, opc, v, sh) {
!{mn} !{rt},!{ru},[xb[[,#!o]]] ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(2<<23)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
!{mn} !{rt},!{ru},[xb,#!o]\! ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(3<<23)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
!{mn} !{rt},!{ru},[xb],#!o ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(1<<23)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
}
!lspair("STP", 0, "wt", "wu", 0, 0, 2)
!lspair("LDP", 1, "wt", "wu", 0, 0, 2)
!lspair("LDPSW", 1, "xt", "xu", 1, 0, 2)
!lspair("STP", 0, "xt", "xu", 2, 0, 3)
!lspair("LDP", 1, "xt", "xu", 2, 0, 3)
!lspair("STP", 0, "fs", "fsn", 0, 1, 2)
!lspair("LDP", 1, "fs", "fsn", 0, 1, 2)
!lspair("STP", 0, "ff", "fdn", 1, 1, 3)
!lspair("LDP", 1, "ff", "fdn", 1, 1, 3)
!lspair("STP", 0, "fq", "fqn", 2, 1, 4)
!lspair("LDP", 1, "fq", "fqn", 2, 1, 4)

/* Load/store no-allocate pair (offset form only) */
!def lsnp(mn, l, rt, ru, opc, v, sh) {
!{mn} !{rt},!{ru},[xb[[,#!o]]] ::(o&!{(1<<sh)-1})!=0;8,(o>>!{sh})<-64;8,(o>>!{sh})>63;8 :: .call w4((!{opc}<<30)|(5<<27)|(!{v}<<26)|(!{l}<<22)|(((o>>!{sh})&0x7f)<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
}
!lsnp("STNP", 0, "wt", "wu", 0, 0, 2)
!lsnp("LDNP", 1, "wt", "wu", 0, 0, 2)
!lsnp("STNP", 0, "xt", "xu", 2, 0, 3)
!lsnp("LDNP", 1, "xt", "xu", 2, 0, 3)
!lsnp("STNP", 0, "fs", "fsn", 0, 1, 2)
!lsnp("LDNP", 1, "fs", "fsn", 0, 1, 2)
!lsnp("STNP", 0, "ff", "fdn", 1, 1, 3)
!lsnp("LDNP", 1, "ff", "fdn", 1, 1, 3)
!lsnp("STNP", 0, "fq", "fqn", 2, 1, 4)
!lsnp("LDNP", 1, "fq", "fqn", 2, 1, 4)

/* Load/store exclusive and the acquire-release pairs */
!def stex(mn, size, o2, o0, rt) {
!{mn} rs,!{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(!{o2}<<23)|(!{o0}<<15)|(rs<<16)|(31<<10)|(xb<<5)|!{rt})
}
!def ldex(mn, size, o2, o0, rt) {
!{mn} !{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(!{o2}<<23)|(1<<22)|(31<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
}
!def strl(mn, size, o0, rt) {
!{mn} !{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<23)|(31<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
}
!def exgrp(sfx, size, rt) {
!stex("STXR" + sfx, size, 0, 0, rt)
!stex("STLXR" + sfx, size, 0, 1, rt)
!ldex("LDXR" + sfx, size, 0, 0, rt)
!ldex("LDAXR" + sfx, size, 0, 1, rt)
!strl("STLLR" + sfx, size, 0, rt)
!strl("STLR" + sfx, size, 1, rt)
!ldex("LDLAR" + sfx, size, 1, 0, rt)
!ldex("LDAR" + sfx, size, 1, 1, rt)
}
!exgrp("B", 0, "wt")
!exgrp("H", 1, "wt")
!exgrp("", 2, "wt")
!exgrp("", 3, "xt")

/* Load/store exclusive pair */
!def expair(sfx, size, rt, ru) {
STXP!{sfx} rs,!{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<21)|(rs<<16)|(!{ru}<<10)|(xb<<5)|!{rt})
STLXP!{sfx} rs,!{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<21)|(rs<<16)|(1<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
LDXP!{sfx} !{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<22)|(1<<21)|(31<<16)|(!{ru}<<10)|(xb<<5)|!{rt})
LDAXP!{sfx} !{rt},!{ru},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<22)|(1<<21)|(31<<16)|(1<<15)|(!{ru}<<10)|(xb<<5)|!{rt})
}
!expair("", 2, "wt", "wu")
!expair("", 3, "xt", "xu")

/* Compare and swap (FEAT_LSE) */
!def casgrp(sfx, size, rt, rr) {
!local ai = 0
!local nm = ""
!local l = 0
!local o0 = 0
!while ai <= 3 {
!set nm = ai == 0 ? "CAS" : (ai == 1 ? "CASA" : (ai == 2 ? "CASL" : "CASAL"))
!set l = (ai == 1 || ai == 3) ? 1 : 0
!set o0 = (ai >= 2) ? 1 : 0
!{nm}!{sfx} !{rr},!{rt},[xb] :: .call w4((!{size}<<30)|(8<<24)|(1<<23)|(!{l}<<22)|(1<<21)|(!{rr}<<16)|(!{o0}<<15)|(31<<10)|(xb<<5)|!{rt})
!set ai = ai + 1
}
}
!casgrp("B", 0, "wt", "wm")
!casgrp("H", 1, "wt", "wm")
!casgrp("", 2, "wt", "wm")
!casgrp("", 3, "xt", "xm")

/* Atomic memory operations (FEAT_LSE). Four acquire/release variants
/* times four access sizes for each operation, generated rather than
/* written out. */
!def atomop(base, opc, o3) {
!local si = 0
!local sfx = ""
!local rt = ""
!local rr = ""
!local ai = 0
!local ar = ""
!local a = 0
!local r = 0
!while si <= 3 {
!set sfx = si == 0 ? "B" : (si == 1 ? "H" : "")
!set rt = si == 3 ? "xt" : "wt"
!set rr = si == 3 ? "xm" : "wm"
!set ai = 0
!while ai <= 3 {
!set ar = ai == 0 ? "" : (ai == 1 ? "A" : (ai == 2 ? "L" : "AL"))
!set a = (ai == 1 || ai == 3) ? 1 : 0
!set r = ai >= 2 ? 1 : 0
!{base}!{ar}!{sfx} !{rr},!{rt},[xb] :: .call w4((!{si}<<30)|(7<<27)|(!{a}<<23)|(!{r}<<22)|(1<<21)|(!{rr}<<16)|(!{o3}<<15)|(!{opc}<<12)|(xb<<5)|!{rt})
!set ai = ai + 1
}
!set si = si + 1
}
}
!atomop("LDADD", 0, 0)
!atomop("LDCLR", 1, 0)
!atomop("LDEOR", 2, 0)
!atomop("LDSET", 3, 0)
!atomop("LDSMAX", 4, 0)
!atomop("LDSMIN", 5, 0)
!atomop("LDUMAX", 6, 0)
!atomop("LDUMIN", 7, 0)
!atomop("SWP", 0, 1)

/* The ST<op> aliases discard the loaded value, so Rt is the zero
/* register and only the release variant exists. */
!def statomop(base, opc) {
!local si = 0
!local sfx = ""
!local rr = ""
!local ai = 0
!local ar = ""
!local r = 0
!while si <= 3 {
!set sfx = si == 0 ? "B" : (si == 1 ? "H" : "")
!set rr = si == 3 ? "xm" : "wm"
!set ai = 0
!while ai <= 1 {
!set ar = ai == 0 ? "" : "L"
!set r = ai
!{base}!{ar}!{sfx} !{rr},[xb] :: .call w4((!{si}<<30)|(7<<27)|(!{r}<<22)|(1<<21)|(!{rr}<<16)|(!{opc}<<12)|(xb<<5)|31)
!set ai = ai + 1
}
!set si = si + 1
}
}
!statomop("STADD", 0)
!statomop("STCLR", 1)
!statomop("STEOR", 2)
!statomop("STSET", 3)
!statomop("STSMAX", 4)
!statomop("STSMIN", 5)
!statomop("STUMAX", 6)
!statomop("STUMIN", 7)

/* ===================================================================
/* Scalar floating point
/*
/* ptype is 00 for single, 01 for double and 11 for half precision;
/* each group below is written once and instantiated for all three.
/* =================================================================== */

/* Data processing (1 source) */
!def fpdp1(nm, opc, pt, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{opc}<<15)|(0x10<<10)|(!{rn}<<5)|!{rd})
}
!def fp1all(nm, opc) {
!fpdp1(nm, opc, 0, "fsd", "fsn")
!fpdp1(nm, opc, 1, "fdd", "fdn")
!fpdp1(nm, opc, 3, "fhd", "fhn")
}
!fp1all("FMOV", 0)
!fp1all("FABS", 1)
!fp1all("FNEG", 2)
!fp1all("FSQRT", 3)
!fp1all("FRINTN", 8)
!fp1all("FRINTP", 9)
!fp1all("FRINTM", 10)
!fp1all("FRINTZ", 11)
!fp1all("FRINTA", 12)
!fp1all("FRINTX", 14)
!fp1all("FRINTI", 15)

/* FCVT: ptype is the source type, the opcode carries the destination */
!fpdp1("FCVT", 4, 1, "fsd", "fdn")
!fpdp1("FCVT", 4, 3, "fsd", "fhn")
!fpdp1("FCVT", 5, 0, "fdd", "fsn")
!fpdp1("FCVT", 5, 3, "fdd", "fhn")
!fpdp1("FCVT", 7, 0, "fhd", "fsn")
!fpdp1("FCVT", 7, 1, "fhd", "fdn")

/* Data processing (2 source) */
!def fpdp2(nm, opc, pt, rd, rn, rm) {
!{nm} !{rd},!{rn},!{rm} :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(!{opc}<<12)|(2<<10)|(!{rn}<<5)|!{rd})
}
!def fp2all(nm, opc) {
!fpdp2(nm, opc, 0, "fsd", "fsn", "fsm")
!fpdp2(nm, opc, 1, "fdd", "fdn", "fdm")
!fpdp2(nm, opc, 3, "fhd", "fhn", "fhm")
}
!fp2all("FMUL", 0)
!fp2all("FDIV", 1)
!fp2all("FADD", 2)
!fp2all("FSUB", 3)
!fp2all("FMAX", 4)
!fp2all("FMIN", 5)
!fp2all("FMAXNM", 6)
!fp2all("FMINNM", 7)
!fp2all("FNMUL", 8)

/* Data processing (3 source) */
!def fpdp3(nm, o1, o0, pt, rd, rn, rm, ra) {
!{nm} !{rd},!{rn},!{rm},!{ra} :: .call w4((0x1f<<24)|(!{pt}<<22)|(!{o1}<<21)|(!{rm}<<16)|(!{o0}<<15)|(!{ra}<<10)|(!{rn}<<5)|!{rd})
}
!def fp3all(nm, o1, o0) {
!fpdp3(nm, o1, o0, 0, "fsd", "fsn", "fsm", "fsa")
!fpdp3(nm, o1, o0, 1, "fdd", "fdn", "fdm", "fda")
!fpdp3(nm, o1, o0, 3, "fhd", "fhn", "fhm", "fha")
}
!fp3all("FMADD", 0, 0)
!fp3all("FMSUB", 0, 1)
!fp3all("FNMADD", 1, 0)
!fp3all("FNMSUB", 1, 1)

/* Compare */
!def fpcmp(nm, o2, pt, rn, rm) {
!{nm} !{rn},!{rm} :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(8<<10)|(!{rn}<<5)|!{o2})
!{nm} !{rn},#0.0 :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(8<<10)|(!{rn}<<5)|!{o2+8})
!{nm} !{rn},#0 :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(8<<10)|(!{rn}<<5)|!{o2+8})
}
!fpcmp("FCMP", 0, 0, "fsn", "fsm")
!fpcmp("FCMP", 0, 1, "fdn", "fdm")
!fpcmp("FCMP", 0, 3, "fhn", "fhm")
!fpcmp("FCMPE", 16, 0, "fsn", "fsm")
!fpcmp("FCMPE", 16, 1, "fdn", "fdm")
!fpcmp("FCMPE", 16, 3, "fhn", "fhm")

/* Conditional compare and conditional select */
!def fpccmp(nm, op, pt, rn, rm) {
!{nm} !{rn},!{rm},#!f,cnd ::f<0;3,f>15;3 :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(cnd<<12)|(1<<10)|(!{rn}<<5)|(!{op}<<4)|f)
}
!fpccmp("FCCMP", 0, 0, "fsn", "fsm")
!fpccmp("FCCMP", 0, 1, "fdn", "fdm")
!fpccmp("FCCMP", 0, 3, "fhn", "fhm")
!fpccmp("FCCMPE", 1, 0, "fsn", "fsm")
!fpccmp("FCCMPE", 1, 1, "fdn", "fdm")
!fpccmp("FCCMPE", 1, 3, "fhn", "fhm")

!def fpcsel(pt, rd, rn, rm) {
FCSEL !{rd},!{rn},!{rm},cnd :: .call w4((0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rm}<<16)|(cnd<<12)|(3<<10)|(!{rn}<<5)|!{rd})
}
!fpcsel(0, "fsd", "fsn", "fsm")
!fpcsel(1, "fdd", "fdn", "fdm")
!fpcsel(3, "fhd", "fhn", "fhm")

/* Floating point to integer */
!def f2i(nm, rmode, opc, sf, pt, rd, rn) {
!{nm} !{rd},!{rn} :: .call w4((!{sf}<<31)|(0x1e<<24)|(!{pt}<<22)|(1<<21)|(!{rmode}<<19)|(!{opc}<<16)|(!{rn}<<5)|!{rd})
}
!def f2iall(nm, rmode, opc) {
!f2i(nm, rmode, opc, 0, 0, "wd", "fsn")
!f2i(nm, rmode, opc, 1, 0, "xd", "fsn")
!f2i(nm, rmode, opc, 0, 1, "wd", "fdn")
!f2i(nm, rmode, opc, 1, 1, "xd", "fdn")
!f2i(nm, rmode, opc, 0, 3, "wd", "fhn")
!f2i(nm, rmode, opc, 1, 3, "xd", "fhn")
}
!f2iall("FCVTNS", 0, 0)
!f2iall("FCVTNU", 0, 1)
!f2iall("FCVTAS", 0, 4)
!f2iall("FCVTAU", 0, 5)
