/* LD1: 4 registers per group */
!lsm4("LD1", 1, 0x2, "8B", 0, 0, 32)
!lsm4("LD1", 1, 0x2, "16B", 1, 0, 64)
!lsm4("LD1", 1, 0x2, "4H", 0, 1, 32)
