/* Narrowing shifts.  The field holds the destination width less the
/* shift amount. */
!def s2nsh2(nm, base, del, sel, es) {
!{nm} zd.!{del},{zn.!{sel},zb.!{sel}},#!s ::s<1;3,s>!{es};3,(zn&1)!=0;5,zb!=zn+1;5 :: .call w4(!{base}|(((!{es}-s)&0x1f)<<16)|((((!{es}-s)>>5)&1)<<22)|(zn<<5)|zd)
}
!def s2nsh4(nm, base, del, sel, es) {
!{nm} zd.!{del},{zn.!{sel}-zb.!{sel}},#!s ::s<1;3,s>!{es};3,(zn&3)!=0;5,zb!=zn+3;5 :: .call w4(!{base}|(((!{es}-s)&0x1f)<<16)|((((!{es}-s)>>5)&1)<<22)|(zn<<5)|zd)
}
!s2nsh2("SQRSHR", 0xc1e0d400, "H", "S", 16)
!s2nsh2("UQRSHR", 0xc1e0d420, "H", "S", 16)
!s2nsh2("SQRSHRU", 0xc1f0d400, "H", "S", 16)
!s2nsh4("SQRSHR", 0xc160d800, "B", "S", 32)
!s2nsh4("UQRSHR", 0xc160d820, "B", "S", 32)
!s2nsh4("SQRSHRU", 0xc160d840, "B", "S", 32)
!s2nsh4("SQRSHRN", 0xc160dc00, "B", "S", 32)
!s2nsh4("UQRSHRN", 0xc160dc20, "B", "S", 32)
!s2nsh4("SQRSHRUN", 0xc160dc40, "B", "S", 32)
!s2nsh4("SQRSHR", 0xc1a0d800, "H", "D", 64)
!s2nsh4("UQRSHR", 0xc1a0d820, "H", "D", 64)
!s2nsh4("SQRSHRU", 0xc1a0d840, "H", "D", 64)
!s2nsh4("SQRSHRN", 0xc1a0dc00, "H", "D", 64)
!s2nsh4("UQRSHRN", 0xc1a0dc20, "H", "D", 64)
!s2nsh4("SQRSHRUN", 0xc1a0dc40, "H", "D", 64)
!s2nsh2("SQRSHRN", 0x45b02800, "H", "S", 16)
!s2nsh2("UQRSHRN", 0x45b03800, "H", "S", 16)
!s2nsh2("SQRSHRUN", 0x45b00800, "H", "S", 16)

/* -------------------------------------------------------------------
/* SME2: accumulating into the ZA array.
/*
/* The array operand is za.<T>[<Wv>, <off>], optionally followed by
/* vgx2 or vgx4, which only restates what the register list already
/* says.  Widening instructions write a range of slices and write it
/* as <off>:<off+1> or <off>:<off+3>; the field holds the range's
/* first slice divided by its length.
/* ------------------------------------------------------------------- */
.check::wv::W8,W9,W10,W11

.func::slq::o,p,w,mx
.if p != o + w - 1 .then
.raise 3
.endif
q = o / w
.if q * w != o .then
.raise 3
.endif
.if q > mx .then
.raise 3
.endif
.return q
.endfunc
/* vgx2 and vgx4 only restate the list width, so check they agree */
.func::gchk::g,vg
.if vg >= 0 .then
.if g != vg .then
.raise 5
.endif
.endif
.return g
.endfunc
/* a list accumulated into the array, with no second operand */
.func::za0::base,wv,off,a,b,vg
g = .call n2q(a, b)
g = .call gchk(g, vg)
.return .call w4(base | (g << 16) | ((wv - 8) << 13) | (a << 5) | off)
.endfunc
/* a list against one vector */
.func::za1::base,zm,wv,off,zn,a,b,vg
g = .call n2qf(a, b)
g = .call gchk(g, vg)
.return .call w4(base | (g << 20) | (zm << 16) | ((wv - 8) << 13) | (zn << 5) | off)
.endfunc
/* a list against a list */
.func::za2::base,wv,off,zn,a,b,m,n,vg
g = .call n2q(a, b)
g = .call gchk(g, vg)
h = .call n2q(m, n)
.if g != h .then
.raise 5
.endif
.return .call w4(base | (g << 16) | (m << 16) | ((wv - 8) << 13) | (zn << 5) | off)
.endfunc
/* the same three, writing a range of slices */
.func::za1s::base,zm,wv,o,p,zn,a,b,w,mx,vg
q = .call slq(o, p, w, mx)
g = .call n2qf(a, b)
g = .call gchk(g, vg)
.return .call w4(base | (g << 20) | (zm << 16) | ((wv - 8) << 13) | (zn << 5) | q)
.endfunc
.func::za2s::base,wv,o,p,zn,a,b,m,n,w,mx,vg
q = .call slq(o, p, w, mx)
g = .call n2q(a, b)
g = .call gchk(g, vg)
h = .call n2q(m, n)
.if g != h .then
.raise 5
.endif
.return .call w4(base | (g << 16) | (m << 16) | ((wv - 8) << 13) | (zn << 5) | q)
.endfunc
.func::zass::base,zm,wv,o,p,zn,w,mx
q = .call slq(o, p, w, mx)
.return .call w4(base | (zm << 16) | ((wv - 8) << 13) | (zn << 5) | q)
.endfunc
/* indexed by an element of one vector */
.func::zaix::base,ib,zm,wv,off,zn,a,b,vg
g = .call n2qf(a, b)
g = .call gchk(g, vg)
.return .call w4(base | ib | (g << 15) | (zm << 16) | ((wv - 8) << 13) | (zn << 5) | off)
.endfunc
.func::zaixs::base,ib,zm,wv,o,p,zn,a,b,w,mx,vg
q = .call slq(o, p, w, mx)
g = .call n2qf(a, b)
g = .call gchk(g, vg)
.return .call w4(base | ib | (g << 15) | (zm << 16) | ((wv - 8) << 13) | (zn << 5) | q)
.endfunc

