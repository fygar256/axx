/* Scalar narrowing */
!def s2n(nm, u, opc) {
!s2one(nm, u, 0, 0x10, opc, "fbd", "fhn")
!s2one(nm, u, 1, 0x10, opc, "fhd", "fsn")
!s2one(nm, u, 2, 0x10, opc, "fsd", "fdn")
}
