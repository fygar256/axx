/* ===================================================================
/* elfsec.axx -- pattern file for `.elfsection` (manual 3.7.7)
/*
/*   .elfsection::<name>::<sh_flags>[::<sh_type>[::<align>]]
/*
/* A section axx knows by name gets its attributes from that name:
/* `.text` is SHF_ALLOC|SHF_EXECINSTR, `.data` and `.bss` are
/* SHF_ALLOC|SHF_WRITE, `.rodata` and everything else are SHF_ALLOC,
/* and only `.bss` is SHT_NOBITS. This declaration is how a section
/* the name rule does not know -- a machine's own vector table, an
/* uninitialised region that is not called `.bss`, a note section --
/* gets the attributes it needs.
/*
/* The fourth field is sh_addralign. It must be 0 or a power of two.
/* Left out, a section gets 16, except SHT_NOTE, which gets 4 so that
/* binutils can read the note (16 makes it report the note corrupt).
/* A note that needs 8, such as .note.gnu.property, says so in this
/* field.
/*
/* Assemble with:
/*   axx elfsec.axx elfsec.s -o out.o
/* ===================================================================

.bits::8

/*             name        sh_flags  sh_type  align                   */
.elfsection::.vectors::0x6           /* ALLOC|EXECINSTR, PROGBITS, 16 */
.elfsection::.noinit::0x3::8         /* ALLOC|WRITE, NOBITS, 16       */
.elfsection::.note.axx::0::7         /* no flags, NOTE, 4             */
.elfsection::.vectors2::0x6::1::2    /* align written out: 2          */

DB !t :: t
NOP :: 0x90
