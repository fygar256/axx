/*  ==================================================================
/*  symcap.axx -- `!Y<集合>[<変数>]` シンボル捕捉子
/*
/*  Technical_Manual 3.6.3 のテスト。集合の項目名を1つ読んでその番号を
/*  変数に束縛する捕捉子が、paxx と caxx で一致することを確かめる。
/*  ==================================================================

.bits::8

.setsym::y::R0,R1,R2
.setsym::x::AX,BX,CX
.setsym::lo::AL,BL,CL
.setsym::both::x|lo
.setsym::over::A,AX,AL
.setsym::DX::7

/*  基本。ax,bx,cx の番号で別の集合 y を引く。 */
MOV !Yx[z],!e::"mov {{y[z]}},0x{{.hex(e)}}\n"

/*  集合にない綴りはこのパターンに落ちる。 */
MOV r,!e::"mov #{{.hex(r)}},0x{{.hex(e)}}\n"

/*  番号はただの変数なので、式にもテンプレートにも書ける。 */
ADD !Yboth[u],!Yboth[v]::"add {{u}}+{{v}}={{.hex(u+v)}}\n"

/*  重なる名前は最長一致。`al` は A ではなく AL に当たる。 */
LEN !Yover[w]::"len {{w}} {{over[w]}}\n"

/*  番号は binary_list の式としても使える。 */
ENC !Yx[z]::0x40|z
