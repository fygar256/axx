/*  ==================================================================
/*  datadirbe.axx -- .db / .dw / .dd / .dq / .do / .dy / .dz のテスト（8 ビット、big）
/*
/*  datadir.axx と同じソースを、上位のワードから並べて出すことを確かめる。
/*  ==================================================================

.bits::big::8

NOP :: 0x90
/*  2 つ目以降のセクションで、取り込んだ `$$` がセクション相対で読まれることを
/*  確かめる命令（x86 の短いジャンプ。datadir.s では `jr $$+5` だけに使う）。 */
JR !e :: 0xeb, e-$$-2
