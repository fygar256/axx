!v_vpmulld512("VMINSS_E", 0x01, 0x06, 0x00, 0x5d, 0xc0, 0x41, 0x00, 508, -512, 3, 2, 0x40, 0x01, 0x04, 0x44, 0x84, 0x80)
!v_vpmulld512("VMINSD_E", 0x01, 0x87, 0x00, 0x5d, 0xc0, 0x41, 0x00, 1016, -1024, 7, 3, 0x40, 0x01, 0x04, 0x44, 0x84, 0x80)
