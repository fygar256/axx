RORX d,s,!i  ::  i>255;3,i<-128;3  ::  0xc4,(0x43|((~(d)>>3&1)<<7)|((~(s)>>3&1)<<5))&0xff,0xfb,0xf0,0xc0|((d&7)<<3)|(s&7),(i&0xff)
