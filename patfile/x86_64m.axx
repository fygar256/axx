SHUFPD x,y,!i            :: i>255;3,i<-128;3 ::  0x66,;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xc6,0xc0|((x&7)<<3)|(y&7),(i&0xff)
SHUFPS x,y,!i            :: i>255;3,i<-128;3 ::  ;(((x|y)&8)?(0x40|((x&8)>>1)|((y&8)>>3)):0),0x0f,0xc6,0xc0|((x&7)<<3)|(y&7),(i&0xff)
PINSRW x,d,!i            :: i>255;3,i<-128;3 ::  0x66,;(((x|d)&8)?(0x40|((x&8)>>1)|((d&8)>>3)):0),0x0f,0xc4,0xc0|((x&7)<<3)|(d&7),(i&0xff)
PEXTRW d,x,!i            :: i>255;3,i<-128;3 ::  0x66,;(((d|x)&8)?(0x40|((d&8)>>1)|((x&8)>>3)):0),0x0f,0xc5,0xc0|((d&7)<<3)|(x&7),(i&0xff)
PMOVMSKB d,x             ::  ::  0x66,;(((d|x)&8)?(0x40|((d&8)>>1)|((x&8)>>3)):0),0x0f,0xd7,0xc0|((d&7)<<3)|(x&7)
MOVMSKPD d,x             ::  ::  0x66,;(((d|x)&8)?(0x40|((d&8)>>1)|((x&8)>>3)):0),0x0f,0x50,0xc0|((d&7)<<3)|(x&7)
MOVMSKPS d,x             ::  ::  ;(((d|x)&8)?(0x40|((d&8)>>1)|((x&8)>>3)):0),0x0f,0x50,0xc0|((d&7)<<3)|(x&7)

