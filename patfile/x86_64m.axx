SETNC BYTE [b+r*2+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x40|0x04,(0x40|((r&7)<<3)|(b&7)),(o&0xff)
SETNC BYTE [b+r*4+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x40|0x04,(0x80|((r&7)<<3)|(b&7)),(o&0xff)
SETNC BYTE [b+r*8+!o]B    :: o>127;3,o<-128;3  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x40|0x04,(0xc0|((r&7)<<3)|(b&7)),(o&0xff)
.reloc::o::abs32s
SETNC BYTE [b+r*1+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x80|0x04,(0x00|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
SETNC BYTE [b+r*2+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x80|0x04,(0x40|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
SETNC BYTE [b+r*4+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x80|0x04,(0x80|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
SETNC BYTE [b+r*8+!o]     ::  ::;(((b|r)&8)?(0x40|((r&8)>>2)|((b&8)>>3)):0),0x0f,0x93,0x80|0x04,(0xc0|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
SETNC BYTE [b+!o]     ::  ::  ;((b&8)?0x41:0),0x0f,0x93,0x80|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]
.clrreloc::o
SETNC d               ::  ::  ;((d&8)?0x41:0),0x0f,0x93,0xc0|(d&7)
!x_seto("SETAE", 0x93)
SETNB j               ::  ::  ;((j&8)?0x41:0),0x0f,0x93,0xc0|(j&7)
SETNC j               ::  ::  ;((j&8)?0x41:0),0x0f,0x93,0xc0|(j&7)
SETNB u               ::  ::0x40,0x0f,0x93,0xc0|(u&7)
SETNC u               ::  ::0x40,0x0f,0x93,0xc0|(u&7)

