/* ====================== EVEX 整数シフト (512-bit) ====================== */
/* 3オペランド形式 (NDS): x=dest, y=vvvv, z=src */
VPSLLW512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x05|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xf1,0xc0|((x&7)<<3)|(z&7)
VPSLLD512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x05|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xf2,0xc0|((x&7)<<3)|(z&7)
VPSLLQ512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x85|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xf3,0xc0|((x&7)<<3)|(z&7)
VPSRLW512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x05|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xd1,0xc0|((x&7)<<3)|(z&7)
VPSRLD512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x05|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xd2,0xc0|((x&7)<<3)|(z&7)
VPSRLQ512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x85|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xd3,0xc0|((x&7)<<3)|(z&7)
VPSRAW512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x05|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xe1,0xc0|((x&7)<<3)|(z&7)
VPSRAD512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x05|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xe2,0xc0|((x&7)<<3)|(z&7)
VPSRAQ512 x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x85|((~(y)&0xf)<<3))&0xff,(0x40|((~(y)>>4&1)<<3))&0xff,0xe2,0xc0|((x&7)<<3)|(z&7)

/* イミディエイトシフト (NDD形式): d=dest(vvvv), z=src */
VPSLLWI512 x,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x91|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5))&0xff,(0x05|((~(x)&0xf)<<3))&0xff,(0x40|((~(x)>>4&1)<<3))&0xff,0x71,0xf0|(z&7),(i&0xff)
VPSLLDWI512 x,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x91|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5))&0xff,(0x05|((~(x)&0xf)<<3))&0xff,(0x40|((~(x)>>4&1)<<3))&0xff,0x72,0xf0|(z&7),(i&0xff)
VPSLLQI512 x,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x91|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5))&0xff,(0x85|((~(x)&0xf)<<3))&0xff,(0x40|((~(x)>>4&1)<<3))&0xff,0x73,0xf0|(z&7),(i&0xff)
VPSRLWI512 x,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x91|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5))&0xff,(0x05|((~(x)&0xf)<<3))&0xff,(0x40|((~(x)>>4&1)<<3))&0xff,0x71,0xd0|(z&7),(i&0xff)
VPSRLDI512 x,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x91|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5))&0xff,(0x05|((~(x)&0xf)<<3))&0xff,(0x40|((~(x)>>4&1)<<3))&0xff,0x72,0xd0|(z&7),(i&0xff)
