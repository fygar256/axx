/* ====================== PUSH / POP ====================== */
PUSHFQ                  ::  ::  0x9c
POPFQ                   ::  ::  0x9d
PUSHFW                  ::  ::  0x66,0x9c
PUSHF                   ::  ::  0x9c
POPFW                   ::  ::  0x66,0x9d
POPF                    ::  ::  0x9d
/* PUSH/POP セグメントレジスタ (64ビットモードでは FS/GS のみ有効) */
/* ★ 順序重要: PUSH d より前に配置 ★
   PUSH FS: 0F A0  PUSH GS: 0F A8
   POP  FS: 0F A1  POP  GS: 0F A9
   CS/DS/SS/ES の PUSH/POP は 64ビットモードでは無効 (UD例外)       */
PUSH FS      ::  ::  0x0f,0xa0
PUSH GS      ::  ::  0x0f,0xa8
POP  FS      ::  ::  0x0f,0xa1
POP  GS      ::  ::  0x0f,0xa9

