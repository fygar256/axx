VSQRTSS_E x,y,z  ::    ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x06|((~(y)&0xf)<<3))&0xff,(0x00|((~(y)>>4&1)<<3))&0xff,0x51,0xc0|((x&7)<<3)|(z&7)
