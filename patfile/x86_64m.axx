KMOVQ [b],x  ::    ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,0xf8,0x91,(((b&7)==5)?0x40:0)|0x00|((x&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
KMOVQ [b+!o]B,x  ::  o>127;3,o<-128;3  ::  0xc4,(0x41|((~(x)>>3&1)<<7)|((~(b)>>3&1)<<5))&0xff,0xf8,0x91,0x40|((x&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
