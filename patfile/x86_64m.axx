RORX f,[b+r*2+!o]B,!i  ::  o>127;3,o<-128;3,i>255;3,i<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,0x7b,0xf0,0x44|((f&7)<<3),0x40|((r&7)<<3)|(b&7),(o&0xff),(i&0xff)
.reloc::o::abs32s
RORX f,[b+r*2+!o],!i  ::  i>255;3,i<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,0x7b,0xf0,0x84|((f&7)<<3),0x40|((r&7)<<3)|(b&7),@@[4,*(o,%%)],(i&0xff)
.clrreloc::o
RORX f,[b+r*4+!o]B,!i  ::  o>127;3,o<-128;3,i>255;3,i<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,0x7b,0xf0,0x44|((f&7)<<3),0x80|((r&7)<<3)|(b&7),(o&0xff),(i&0xff)
.reloc::o::abs32s
RORX f,[b+r*4+!o],!i  ::  i>255;3,i<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,0x7b,0xf0,0x84|((f&7)<<3),0x80|((r&7)<<3)|(b&7),@@[4,*(o,%%)],(i&0xff)
.clrreloc::o
RORX f,[b+r*8+!o]B,!i  ::  o>127;3,o<-128;3,i>255;3,i<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,0x7b,0xf0,0x44|((f&7)<<3),0xc0|((r&7)<<3)|(b&7),(o&0xff),(i&0xff)
.reloc::o::abs32s
RORX f,[b+r*8+!o],!i  ::  i>255;3,i<-128;3  ::  0xc4,(0x03|((~(f)>>3&1)<<7)|((~(r)>>3&1)<<6)|((~(b)>>3&1)<<5))&0xff,0x7b,0xf0,0x84|((f&7)<<3),0xc0|((r&7)<<3)|(b&7),@@[4,*(o,%%)],(i&0xff)
