/* ====== マクロ定義ここまで ====== */

/* ========================================
   x86_64 完全パターンファイル for axx  v10.0 (簡約化版) (x87 FPU 完全版 + DWORD/WORD/BYTE セグメントオーバーライド)
   全アドレッシングモード+セグメントオーバーライド対応版

   追加 (v9.0):
     x87 FPU 完全版:
       FLD/FST/FSTP (DWORD/QWORD/TBYTE, register ST0-ST7)
       FADD/FSUB/FMUL/FDIV/FADDP/FSUBP/FMULP/FDIVP (全変形)
       FIADD/FISUB/FIMUL/FIDIV (WORD/DWORD)
       FCOM/FCOMP/FCOMPP/FUCOM/FUCOMPP (比較)
       FCOMI/FUCOMI/FCOMIP/FUCOMIP (EFLAGS設定比較)
       FCMOVxx ST0,STi (条件付き移動、8種)
       FILD/FIST/FISTP/FISTTP (WORD/DWORD/QWORD)
       FICOM/FICOMP/FBLD/FBSTP (整数・BCD)
       FLDCW/FNSTCW/FSTCW/FNSTSW/FSTSW/FNSTSW AX
       FLDENV/FNSTENV/FSTENV/FNSAVE/FSAVE/FRSTOR
       FCHS/FABS/FSQRT/FSIN/FCOS/FSINCOS/FPTAN/FPATAN
       F2XM1/FYL2X/FYL2XP1/FPREM/FPREM1/FRNDINT/FSCALE
       FXTRACT/FLD1/FLDLxxx/FLDZ/FWAIT/FNCLEX/FINIT 等
     セグメントオーバーライド DWORD/WORD/BYTE MOV (ロード+ストア)
     セグメントオーバーライド即値ストア (QWORD/DWORD/WORD/BYTE)
     セグメントオーバーライド文字列命令 (FS/GS × 20命令 + REP/REPE/REPNE)

   追加 (v8.0):
     セグメントアドレッシング完全対応:
     MOV sreg,r / MOV r,sreg  (0x8E/0x8C, ± REX.B)
     MOV sreg,[mem]           (RIP相対・RSP/R12 SIB・RBP/R13 disp8=0 含む)
     PUSH FS / PUSH GS / POP FS / POP GS  (0F A0/A8/A1/A9)
     MOV r64, SEG:[mem]       (6セグメント × 全アドレッシングモード)
     MOV SEG:[mem], r64       (同上 ストア方向)
     LFS / LGS / LSS d,[mem]  (ファーポインタロード 0F B4/B5/B2)


   追加 (v7.0):
     x86_64-v3 対応強化:
     BMI1/BMI2: ANDN, BEXTR, BLSI, BLSMSK, BLSR, BZHI, MULX, PDEP, PEXT, RORX, SARX, SHLX, SHRX
     LZCNT / TZCNT (64/32/16bit)
     AVX/AVX2/FMA3 の全アドレッシングモード完全網羅版

   追加 (v6.0):
     SSE3: ADDSUBPD/PS, HADDPD/PS, HSUBPD/PS, MOVDDUP,
           MOVSLDUP, MOVSHDUP, LDDQU, MONITOR, MWAIT
     SSE4.2: CRC32 (64/32/8bit src)
     RDRAND / RDSEED (64/32/16bit)
     MOVBE (load/store, 64/32bit)
     SIB scale=1: [b+r*1] 全パターン
     ALU store方向: ADD/SUB/AND/OR/XOR [b+r*scale],s

   アドレッシングモード一覧:
     d,s          : レジスタ直接
     d,!i         : 即値 (imm32)
     d8 d,!i      : 即値 (imm8 符号拡張)
     d,[b]        : レジスタ間接
     d,[b+!o]B    : ベース+disp8
     d,[b+!o]     : ベース+disp32
     d,[RIP+!a]   : RIP相対
     [b],s        : メモリ→レジスタ(store)
     [b+!o]B,s    : disp8 store
     [b+!o],s     : disp32 store
     SIZE [b],!i  : メモリに即値

   SIZE修飾子: QWORD/DWORD/WORD/BYTE
   注: RSP(4)/R12(12)ベースはSIB必要(別途)
   ======================================== */

/* ===================================================================
/* ELF 出力 (-o)。組み込みの x86-64 (EM_X86_64, 62) の表をそのまま使う。
/* 既定では 4 バイト幅の参照は pc32（CALL/JMP の変位に合わせたもの）と
/* 推測されるので、行ごとに .reloc で上書きする。DD は abs32、絶対アドレッ
/* シングの MOV ストア（SIZE [!a],!i）は、ModRM+SIB（base=none）がそのまま
/* disp32 を符号拡張して使うアドレッシングなので abs32s（R_X86_64_32S）。
/* 32 ビットの即値は abs32（R_X86_64_32）、64 ビットへ符号拡張されるもの
/* （REX.W 付き、PUSH imm32）は abs32s、メモリの 32 ビット変位（[b+!o] など、
/* VEX / EVEX の形も）は abs32s。どれも行の前後の .reloc / .clrreloc で宣言する。
/* さもないと PC 相対型が付いてしまう。CALL・JMP・Jcc の近い形（32 ビット
/* 変位）は GNU as /
/* llvm-mc が外部・大域シンボルに付ける PLT32 を、短い形（8 ビット変位、
/* Jcc8・JMP8・LOOP 系・JRCXZ）は PC8 を、行ごとに宣言する。
/*
/* 同じセクションの局所ラベル（.global でも .weak でもないもの）を指す
/* PLT32・PC8・PC32（RIP 相対の mov/lea/ALU 命令。既定の推測のまま）は
/* axx がその場で解決し、リロケーションを出さない。GNU as と llvm-mc が
/* セクション内の分岐・RIP 相対参照を自分で解決するのと同じである。
/* セクションをまたぐ・外部・大域の参照は今までどおりリロケーションを
/* 持つ。asmsrc/x86_64_reloc.s で llvm-mc 19 と ld.lld 19 と照合した。
/* =================================================================== */
.elfresolve::plt32
.elfresolve::pc32
.elfresolve::pc8
/* ---------------------------------------------------------------
/* ADD / OR / ADC / SBB / AND / SUB / XOR / CMP の「レジスタ, 即値」の形。
/* 即値が -128..127 の数なら 0x83 /r ib、それ以外の数は 0x81 /r iw / id（AX / EAX /
/* RAX なら短い 0x05 系）を選ぶ。即値がラベル（.islabel）なら値はリンカが埋める
/* ので、大きさで選ばずに 0x81 /r iw / id の形にする（GNU as と同じ）。
/* 3 つの関数に分けるのは、ラベルの参照を即値の欄だけに付けるため。何も出さない
/* .call が読んだラベル参照は捨てられるので、alulab() はラベルのときのオペコードと
/* ModRM を（ラベルを読まずに）、alunum() は数のときの全体を、alub() はラベルの
/* ときの即値の欄を 1 バイトずつ出す（参照が欄のバイトの並びに付き、普通のデータと
/* 同じく欄全体が 0 になる）。base は /digit を 3 ビット左にずらした値（ADD 0x00、
/* OR 0x08 … CMP 0x38）、r はレジスタ番号、w は即値のバイト数（2 か 4）、sym は
/* .islabel の結果。
/* --------------------------------------------------------------- */
.func alulab(base, r, sym)
.if sym .then
.emit(0x81, 0xc0 | base | (r & 7))
.endif
.return
.endfunc
.func alunum(base, r, w, v, sym)
.if sym .then
.return
.endif
.if v >= -128 && v <= 127 .then
.emit(0x83, 0xc0 | base | (r & 7), v & 0xff)
.return
.endif
.if r == 0 .then
.emit(base + 5)
.else
.emit(0x81, 0xc0 | base | (r & 7))
.endif
.emit(v & 0xff, (v >> 8) & 0xff)
.if w == 4 .then
.emit((v >> 16) & 0xff, (v >> 24) & 0xff)
.endif
.return
.endfunc
.func alub(k, v, sym)
.if sym .then
.emit((v >> (8 * k)) & 0xff)
.endif
.return
.endfunc

