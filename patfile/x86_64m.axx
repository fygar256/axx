/* ====================== EVEX スカラー算術 (ZMM16-31 対応, LIG形式) ====================== */
/* 注: スカラー命令はL'L=00(LIG)。ZMM0-15ではVEX版と同じ結果だが、
   ZMM16-31やSAE制御など拡張機能のために使用する */
!v_vpmulld512("VADDSS_E", 0x01, 0x06, 0x00, 0x58, 0xc0, 0x41, 0x00, 508, -512, 3, 2, 0x40, 0x01, 0x04, 0x44, 0x84, 0x80)
