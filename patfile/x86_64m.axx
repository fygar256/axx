/* ====================== EVEX 比較 (512-bit) ====================== */
/* VCMPPS512/VCMPPD512: x=dest, y=vvvv, z=src, !i=述語 */
!v_vcmpps512("VCMPPS512", 0x01, 0x04, 0x40, 0xc2, 0xc0, 0x41, 0x00, 8128, -8192, 63, 6, 0x40, 0x01, 0x04, 0x44, 0x84, 0x80)
!v_vcmpps512("VCMPPD512", 0x01, 0x85, 0x40, 0xc2, 0xc0, 0x41, 0x00, 8128, -8192, 63, 6, 0x40, 0x01, 0x04, 0x44, 0x84, 0x80)
/* VCMPSS/VCMPSD: スカラー比較 (EVEX.LIG, L'L=00) */
VCMPSS512 x,y,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x06|((~(y)&0xf)<<3))&0xff,(0x00|((~(y)>>4&1)<<3))&0xff,0xc2,0xc0|((x&7)<<3)|(z&7),(i&0xff)
VCMPSD512 x,y,z,!i  ::  i>255;3,i<-128;3  ::  0x62,(0x01|((~(x)>>3&1)<<7)|((~(z)>>4&1)<<6)|((~(z)>>3&1)<<5)|((~(x)>>4&1)<<4))&0xff,(0x87|((~(y)&0xf)<<3))&0xff,(0x00|((~(y)>>4&1)<<3))&0xff,0xc2,0xc0|((x&7)<<3)|(z&7),(i&0xff)

