/* ====================== IN / OUT ====================== */
IN AL,DX                ::  ::  0xec
IN AX,DX                ::  ::  0x66,0xed
IN EAX,DX               ::  ::  0xed
IN AL,!i                :: i>255;3,i<-128;3 ::  0xe4,(i&0xff)
IN EAX,!i               :: i>255;3,i<-128;3 ::  0xe5,(i&0xff)
OUT DX,AL               ::  ::  0xee
OUT DX,EAX              ::  ::  0xef
OUT !i,AL               :: i>255;3,i<-128;3 ::  0xe6,(i&0xff)
OUT !i,EAX              :: i>255;3,i<-128;3 ::  0xe7,(i&0xff)

/* ====================== セグメント / CR / DR ====================== */
MOV FS,d                ::  ::  ;((d&8)?0x41:0),0x8e,0xe0|(d&7)
MOV GS,d                ::  ::  ;((d&8)?0x41:0),0x8e,0xe8|(d&7)
MOV d,FS                ::  ::  ;((d&8)?0x41:0),0x8c,0xe0|(d&7)
MOV d,GS                ::  ::  ;((d&8)?0x41:0),0x8c,0xe8|(d&7)
MOV CR0,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x22,0xc0|(d&7)
MOV d,CR0             ::  ::  ;((d&8)?0x41:0),0x0f,0x20,0xc0|(d&7)
MOV CR2,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x22,0xd0|(d&7)
MOV d,CR2             ::  ::  ;((d&8)?0x41:0),0x0f,0x20,0xd0|(d&7)
MOV CR3,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x22,0xd8|(d&7)
MOV d,CR3             ::  ::  ;((d&8)?0x41:0),0x0f,0x20,0xd8|(d&7)
MOV CR4,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x22,0xe0|(d&7)
MOV d,CR4             ::  ::  ;((d&8)?0x41:0),0x0f,0x20,0xe0|(d&7)
MOV DR0,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x23,0xc0|(d&7)
MOV d,DR0             ::  ::  ;((d&8)?0x41:0),0x0f,0x21,0xc0|(d&7)
MOV DR1,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x23,0xc8|(d&7)
MOV d,DR1             ::  ::  ;((d&8)?0x41:0),0x0f,0x21,0xc8|(d&7)
MOV DR2,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x23,0xd0|(d&7)
MOV d,DR2             ::  ::  ;((d&8)?0x41:0),0x0f,0x21,0xd0|(d&7)
MOV DR3,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x23,0xd8|(d&7)
MOV d,DR3             ::  ::  ;((d&8)?0x41:0),0x0f,0x21,0xd8|(d&7)
MOV DR6,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x23,0xf0|(d&7)
MOV d,DR6             ::  ::  ;((d&8)?0x41:0),0x0f,0x21,0xf0|(d&7)
MOV DR7,d             ::  ::  ;((d&8)?0x41:0),0x0f,0x23,0xf8|(d&7)
MOV d,DR7             ::  ::  ;((d&8)?0x41:0),0x0f,0x21,0xf8|(d&7)
!x_cmpxchg8b("INVLPG", 0x01, 0x38)
