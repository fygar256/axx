!x_lzcnt("LZCNT", 0xbd)

!x_lzcnt("TZCNT", 0xbc)

/* BSWAP */
BSWAP f           ::  ::  ;((f&8)?0x41:0),0x0f,0xc8|(f&7)

/* ====================== XCHG / CMPXCHG / XADD (全アドレッシングモード) ====================== */
