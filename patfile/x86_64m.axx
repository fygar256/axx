/* ======================================================== */
/* ADC */
/* ======================================================== */
/* ADD 16-bit */
!x_add8("ADD8", 0x00)
/* ADD 32-bit */
/* ADD 64-bit */
/* ADC 8-bit */
!x_adc("ADC", 0x10)

/* ======================================================== */
/* SUB */
/* ======================================================== */
/* ADC 16-bit */
!x_add8("ADC8", 0x10)
/* ADC 32-bit */
/* ADC 64-bit */
