/* ===================================================================
/* elfpair.axx -- pattern file for relocations that come in pairs or
/*                with a companion, section groups and sh_link
/*                (manual 3.7.10)
/*
/* The machine is RISC-V (EM_RISCV, 243): riscv64.axx gives the
/* instructions, and this file adds what a linker that relaxes code
/* needs from an object:
/*
/*   .elfextra::<type>::<companion>[::<symbol>]
/*        every relocation of <type> gets <companion> at the same
/*        offset with addend 0; <symbol> 0 (default) writes symbol
/*        index 0, 1 the same symbol. A `call` gets R_RISCV_RELAX,
/*        as GNU as and llvm-mc write it.
/*   .elfdiff::<width>::<add type>::<subtract type>
/*        a <width>-byte field holding a sum and difference of labels
/*        (a-b, a-b+c-d+4, -(a-b)) gets the add type against each
/*        added label (the first one carries the constant) and the
/*        subtract type against each subtracted one. Under RELA the
/*        field itself is written as 0, because these types add to
/*        and subtract from what is in it.
/*   .elfdiff::<type>::<add type>::<subtract type>
/*        the same for a field `.reloc` gives <type>: a ULEB128 or the
/*        6-bit field of DW_CFA_advance_loc.
/*   .elfcfi / .elfcfiinit / .elfcfireg
/*        call frame information; the advances of the .eh_frame use
/*        the .elfdiff::4 pair, so they shrink with relaxed code.
/*   .elfgroup::<name>::<signature>::<flags>::<member>[,<member>...]
/*        a section group (SHT_GROUP); flags 1 is GRP_COMDAT.
/*   .elflink::<section>::<sh_link>[::<sh_info>]
/*        the sh_link / sh_info of a section, by section name or
/*        number.
/*
/* The relocations, the group and the section header fields match
/* what llvm-mc writes for the same code (see elfpair.s).
/*
/* Assemble with:
/*   axx elfpair.axx elfpair.s -o out.o
/* =================================================================== */

.include "riscv64.axx"

/* --- types this file adds to riscv64.axx -------------------------- */
.elftype::add32::35            /* R_RISCV_ADD32                     */
.elftype::add64::36            /* R_RISCV_ADD64                     */
.elftype::sub32::39            /* R_RISCV_SUB32                     */
.elftype::sub64::40            /* R_RISCV_SUB64                     */
.elftype::relax::51            /* R_RISCV_RELAX                     */

/* --- a call may be relaxed: R_RISCV_RELAX rides along -------------- */
.elfextra::call::relax

/* --- label differences in data ------------------------------------ */
/* The linker may shrink code here, so even a difference inside one   */
/* section stays an ADD/SUB pair (riscv64.axx says .elfrelax::0).     */
.elfdiff::4::add32::sub32
.elfdiff::8::add64::sub64
.elfrelax::1

/* --- typed differences: a ULEB128 field and a 6-bit field ---------- */
/* A difference in a field `.reloc` types gets the pair declared for  */
/* that type. The ULEB128 keeps its assembled bytes (the linker       */
/* rewrites it in place, keeping its length); the 6-bit field is the  */
/* low bits of a byte, as in DW_CFA_advance_loc.                      */
.elftype::set6::53::1          /* R_RISCV_SET6                      */
.elftype::sub6::52::1          /* R_RISCV_SUB6                      */
.elftype::set_uleb128::60      /* R_RISCV_SET_ULEB128               */
.elftype::sub_uleb128::61      /* R_RISCV_SUB_ULEB128               */
.elffield::set6::0x3f
.elfdiff::set6::set6::sub6
.elfdiff::set_uleb128::set_uleb128::sub_uleb128

.func uleb(v)
a = []
i = 0
.while(1)
b = v & 0x7f
v = (v >> 7) & ((1 << 249) - 1)    /* 論理シフト。負の値でも 0 になって止まる */
.if v == 0 .then
a[i] = b
.return a
.endif
a[i] = b | 0x80
i = i + 1
.endwhile
.endfunc

.reloc::v::set_uleb128
ULEB !v :: .call uleb(v)
.clrreloc::v
.reloc::v::set6
ADV6 !v :: 0x40|(v&0x3f)
.clrreloc::v

/* --- call frame information (manual 3.7.11) ------------------------ */
/* With .elfdiff::4 declared, the function length and every advance  */
/* of the CFI are written as ADD32/SUB32 pairs on local symbols, so   */
/* they stay right when the linker relaxes the code.                  */
.elftype::pcrel32::57::4::1    /* R_RISCV_32_PCREL: the FDE address */
.elfcfi::1::1::-8              /* RA = x1, code 1, data -8          */
.elfcfiinit::def_cfa sp, 0
.elfcfireg::ra::1
.elfcfireg::sp::2

/* --- a COMDAT group and a link-order section ------------------------ */
.elfsection::.text.foo::0x6            /* ALLOC+EXECINSTR             */
.elfgroup::.group::foo::1::.text.foo   /* GRP_COMDAT, signature foo   */
.elfsection::.meta::0x82               /* ALLOC+LINK_ORDER            */
.elflink::.meta::.text                 /* sh_link -> .text            */
