/*  ==================================================================
/*  ministr.axx -- ミニ言語の文字列
/*
/*  MINI.md「文字列」のテスト。
/*    - `.call f(10,"text")` のように binary_list から文字列を渡せること
/*      （文字列の中のカンマや括弧で引数が割れないこと）
/*    - 文字列リテラルを式の中・変数・配列でない値として使えること
/*    - `+` の連結（整数は符号付き 10 進）、`*` の繰り返し、`==` `!=`、
/*      `<` などの辞書式比較
/*    - `.len` `s[i]` `s[lo:hi]` がバイト単位であること（UTF-8 も含む）
/*    - `.str` `.chr` `.int` の変換
/*    - `.emit(文字列)` と文字列の返り値が 1 バイト 1 ワードになること
/*    - `.echo` が文字列をそのまま出し、NUL を `\0` と書くこと
/*    - `.call f(x,.exp(x))` で、パターン変数が捕捉した綴りを文字列として
/*      渡せること
/*    - `.call f(10,msg)` で、文字列シンボル `.setsym::msg::"..."` を
/*      文字列として渡せること（逃げ記号は `"..."` と直接書いたときと同じ）
/*    - 配列の要素に文字列を入れられること（リテラル・代入・切り出し・
/*      `binary_list` からの `["..", .exp(x), 名前]`・返り値・`.echo` の体裁）
/*    - `.for 変数 in 配列` が要素を順に回すこと（`.continue` / `.break`、
/*      本体で配列を書き換えても回る順番が変わらないこと、空の配列）
/*    - `s[i] = 値` で文字列の 1 バイトを書き換えられること（整数か 1 バイトの
/*      文字列、末尾より先は NUL で埋めて伸ばす、写しには影響しない）
/*  を確かめる。paxx と caxx が同じバイト列と同じ標準エラーを出すことも
/*  確かめる。
/*  ==================================================================

.bits::8

/*  binary_list から数と文字列を渡す。返り値の文字列もそのまま出る。 */
GREET !n :: 0xaa,.call greet(n,"Hi"),0xbb
.func greet(n, s)
.emit(.len(s))
.emit(s)
.return s + "!" + n
.endfunc

/*  文字列の中のカンマ・括弧・逃げ記号。 */
QUOTE :: .call show("a,b)", "q\"t\\n\t")
.func show(a, b)
.echo("a=", a, "b=", b)
.emit(.len(a), .len(b))
.return a + b
.endfunc

/*  連結・繰り返し・比較。 */
OPS !n :: .call ops(n)
.func ops(n)
s = "ab" * 3
.emit(.len(s))
t = "-" + n + "-"
.echo(s, t)
.emit(s == "ababab", s != "ababab", "x" == 120, "x" != 120)
.emit("abc" < "abd", "abc" < "ab", "b" > "abc", "ab" <= "ab", "" >= "")
.emit("ab" * 0 == "", 2 * "z" == "zz")
.endfunc

/*  添字・切り出し・長さはバイト単位。UTF-8 の文字は 3 バイト。 */
BYTES :: .call bytes("aあb")
.func bytes(s)
.emit(.len(s), s[0], s[1], s[4], s[99], s[-1])
.return s[1:4] + s[4:] + s[:1]
.endfunc

/*  変換。 */
CONV !n :: .call conv(n)
.func conv(n)
.emit(.int(" -0x1_0 "), .int("+25"), .int("0b101"), .int(n))
.echo(.str(n), .str(-n), .str("keep"), .chr(65) + .chr(0x42))
z = .chr(0) + "x"
.echo(z, .len(z))
.emit(z)
.endfunc

/*  関数のあいだで文字列を受け渡す。配列とは別の値である。 */
PASS :: .call pass()
.func pass()
v = .call twice("ok")
w = 1 + .len(.call twice("abc"))
a = [1, 2]
.echo(v, w, a, .len(v + "!"))
.return v
.endfunc
.func twice(s)
.return s + s
.endfunc

/*  `.exp(変数)` は、その変数が捕捉した綴りの文字列になる。`{{.exp()}}` と同じ。 */
.setsym::RA::1
.setsym::RB::2
.check::r::RA,RB
SPELL !x, r :: .call spell(x, .exp(x), .exp( r ))
.func spell(v, s, t)
.echo(v, s, t, .len(s))
.emit(.len(s))
.return s + "/" + t
.endfunc

/*  文字列シンボルの名前 1 つだけの引数は、その文字列になる。 */
.setsym::msg::"say \"hi\""
NAMED !n :: .call named(n, msg, MSG)
.func named(n, s, t)
.echo(n, s, s == t)
.return s
.endfunc

/*  配列の要素は整数か文字列。返した配列は、文字列の要素を 1 バイト 1 ワードで出す。 */
SARR !n :: .call sarr(n, ["ab", n, .exp(n), msg])
.func sarr(n, a)
a[5] = "z" + n
b = a[1:3]
.echo(a, .len(a), a[0] + a[4], b)
c = ["p", .chr(0) + "q", 3]
c[0] = 7
.echo(c, c[1] == .chr(0) + "q")
.return ["ok", 0, c[1]]
.endfunc

/*  `.for 変数 in 配列` は要素を順に回す。文字列の配列でも整数の配列でもよい。 */
FORIN :: .call forin(["mov", "add", "", "jmp", "sub"])
.func forin(ops)
out = ""
.for op in ops
.if op == "" .then
.continue
.endif
.if op == "jmp" .then
.break
.endif
out = out + op + ","
ops[1] = "changed"
.next
.for x in [1, "two", 3]
.echo(x)
.next
n = 0
.for e in []
n = n + 1
.next
range = ["r"]
.for r in range
.echo(out, n, r, ops)
.next
.return out
.endfunc

/*  `s[i] = 値` は文字列の 1 バイトを書き換える。写しには影響しない。 */
POKE :: .call poke("cat")
.func poke(s)
t = s
s[0] = "b"
s[2] = 0x72
s[5] = "!"
.call poke2(t)
.echo(s, .len(s), t)
.return s
.endfunc
.func poke2(u)
u[0] = "X"
.endfunc
