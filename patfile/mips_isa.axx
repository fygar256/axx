/* ===================================================================
/* MT (multi-threading)
/* =================================================================== */
!def MT0(nm, base) {
!Z(nm, "", "", base, "")
!Z(nm, "t", "", base, "|(t<<16)")
}
!MT0("DMT", 0x41600bc1)
!MT0("EMT", 0x41600be1)
!MT0("DVPE", 0x41600001)
!MT0("EVPE", 0x41600021)
!Z("FORK", "d,s,t", "", 0x7c000008, RF())
!Z("YIELD", "s", "", 0x7c000009, "|(s<<21)")
!Z("YIELD", "d,s", "", 0x7c000009, "|(s<<21)|(d<<11)")
/* mftr rd,rt,u,sel,h reads rt of the target thread into rd; mttr
/* rt,rd,u,sel,h writes rt into rd of the target thread */
!Z("MFTR", "d,t,!u,!q,!h", "u<0||u>1||q<0||q>7||h<0||h>1;10", 0x41000000, "|(t<<16)|(d<<11)|(u<<5)|(h<<4)|q")
!Z("MTTR", "t,d,!u,!q,!h", "u<0||u>1||q<0||q>7||h<0||h>1;10", 0x41800000, "|(t<<16)|(d<<11)|(u<<5)|(h<<4)|q")
/* the named forms: from (mft*) the target register is in rt, to
/* (mtt*) it is in rd */
!Z("MFTGPR", "d,t", "", 0x41000020, "|(t<<16)|(d<<11)")
!Z("MTTGPR", "t,d", "", 0x41800020, "|(t<<16)|(d<<11)")
!Z("MFTC0", "d,n", "", 0x41000000, "|(n<<16)|(d<<11)")
!Z("MFTC0", "d,n,!q", "q<0||q>7;10", 0x41000000, "|(n<<16)|(d<<11)|(q&7)")
!Z("MTTC0", "t,n", "", 0x41800000, "|(t<<16)|(n<<11)")
!Z("MTTC0", "t,n,!q", "q<0||q>7;10", 0x41800000, "|(t<<16)|(n<<11)|(q&7)")
!def MFTX(nm, sel, cls) {
!Z("MFT" + nm, "d," + cls, "", 0x41000020 | sel, "|(" + cls + "<<16)|(d<<11)")
!Z("MTT" + nm, "t," + cls, "", 0x41800020 | sel, "|(t<<16)|(" + cls + "<<11)")
}
!MFTX("C1", 0x02, "fs")
!MFTX("HC1", 0x12, "fs")
!MFTX("C2", 0x04, "n")
!MFTX("HC2", 0x14, "n")
!Z("CFTC1", "d,n", "", 0x41000023, "|(n<<16)|(d<<11)")
!Z("CTTC1", "t,n", "", 0x41800023, "|(t<<16)|(n<<11)")
!Z("CFTC2", "d,n", "", 0x41000025, "|(n<<16)|(d<<11)")
!Z("CTTC2", "t,n", "", 0x41800025, "|(t<<16)|(n<<11)")
/* the DSP accumulators of the target thread: register 0 lo, 1 hi,
/* 2 acx of accumulator ac (bits 3-2), 16 the DSP control register */
!def MFTA(nm, r) {
!Z("MFT" + nm, "d", "", 0x41000021 | (r << 16), "|(d<<11)")
!Z("MFT" + nm, "d,ac", "", 0x41000021 | (r << 16), "|(ac<<18)|(d<<11)")
!Z("MTT" + nm, "t", "", 0x41800021 | (r << 11), "|(t<<16)")
!Z("MTT" + nm, "t,ac", "", 0x41800021 | (r << 11), "|(t<<16)|(ac<<13)")
}
!MFTA("LO", 0)
!MFTA("HI", 1)
!MFTA("ACX", 2)
!Z("MFTDSP", "d", "", 0x41100021, "|(d<<11)")
!Z("MTTDSP", "t", "", 0x41808021, "|(t<<16)")

