/* ===================================================================
/* MCU
/* =================================================================== */
!def ABIT(nm, base) {
!Z(nm, "!b,!v(s)", "b<0||b>7;10,v<-2048||v>2047;8", base, "|(s<<21)|((b&7)<<12)|(v&0xfff)")
!Z(nm, "!b,(s)", "b<0||b>7;10", base, "|(s<<21)|((b&7)<<12)")
}
!ABIT("ACLR", 0x04070000)
!ABIT("ASET", 0x04078000)
!Z("IRET", "", "", 0x42000038, "")
}

/* ===================================================================
/* EVA: user-space loads and stores from kernel mode, 9-bit offset
/* =================================================================== */
!E9G("LBE", 0x2c)
!E9G("LBUE", 0x28)
!E9G("LHE", 0x2d)
!E9G("LHUE", 0x29)
