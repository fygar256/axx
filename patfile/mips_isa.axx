/* ===================================================================
/* MSA (SIMD)
/*
/* $w0-$w31; df is the element format B H W D, written as the
/* suffix. An element index is written as $w1[n]; sld and splat take
/* a general register there, $w1[$t0].
/* =================================================================== */
!def MDF(f) {
!if f == "B" !then {
!return 0
}
!if f == "H" !then {
!return 1
}
!if f == "W" !then {
!return 2
}
!return 3
}
/* 3R: wd,ws,wt; op in bits 25-23, df in 22-21 */
!def M3R(nm, minor, op, dfs) {
!local i = 0
!local f = ""
!while i < len(dfs) {
!set f = substr(dfs, i, 1)
!Z(nm + "." + f, "wd,ws,wt", "", 0x78000000 | (op << 23) | (MDF(f) << 21) | minor, "|(wt<<16)|(ws<<11)|(wd<<6)")
!set i = i + 1
}
}
!M3R("SLL", 0x0d, 0, "BHWD")
!M3R("SRA", 0x0d, 1, "BHWD")
!M3R("SRL", 0x0d, 2, "BHWD")
!M3R("BCLR", 0x0d, 3, "BHWD")
!M3R("BSET", 0x0d, 4, "BHWD")
