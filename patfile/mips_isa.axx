!M3R("SRLR", 0x15, 2, "BHWD")
!M3R("HADD\\_S", 0x15, 4, "HWD")
!M3R("HADD\\_U", 0x15, 5, "HWD")
!M3R("HSUB\\_S", 0x15, 6, "HWD")
!M3R("HSUB\\_U", 0x15, 7, "HWD")
/* sld / splat: wd,ws[rt] */
!def M3G(nm, op) {
!local i = 0
!local f = ""
!while i < 4 {
!set f = substr("BHWD", i, 1)
!Z(nm + "." + f, "wd,ws[t]", "", 0x78000014 | (op << 23) | (i << 21), "|(t<<16)|(ws<<11)|(wd<<6)")
!set i = i + 1
}
}
!M3G("SLD", 0)
!M3G("SPLAT", 1)
/* 3RF: op in bits 25-22, the format in bit 21 (W D, or H W for the
/* fixed point and the narrowing ones) */
!def M3F(nm, minor, op, dfs) {
!local i = 0
!while i < 2 {
!Z(nm + "." + substr(dfs, i, 1), "wd,ws,wt", "", 0x78000000 | (op << 22) | (i << 21) | minor, "|(wt<<16)|(ws<<11)|(wd<<6)")
!set i = i + 1
}
}
!M3F("FCAF", 0x1a, 0, "WD")
!M3F("FCUN", 0x1a, 1, "WD")
!M3F("FCEQ", 0x1a, 2, "WD")
!M3F("FCUEQ", 0x1a, 3, "WD")
!M3F("FCLT", 0x1a, 4, "WD")
!M3F("FCULT", 0x1a, 5, "WD")
!M3F("FCLE", 0x1a, 6, "WD")
!M3F("FCULE", 0x1a, 7, "WD")
!M3F("FSAF", 0x1a, 8, "WD")
!M3F("FSUN", 0x1a, 9, "WD")
!M3F("FSEQ", 0x1a, 10, "WD")
!M3F("FSUEQ", 0x1a, 11, "WD")
!M3F("FSLT", 0x1a, 12, "WD")
!M3F("FSULT", 0x1a, 13, "WD")
!M3F("FSLE", 0x1a, 14, "WD")
!M3F("FSULE", 0x1a, 15, "WD")
!M3F("FADD", 0x1b, 0, "WD")
!M3F("FSUB", 0x1b, 1, "WD")
!M3F("FMUL", 0x1b, 2, "WD")
!M3F("FDIV", 0x1b, 3, "WD")
!M3F("FMADD", 0x1b, 4, "WD")
!M3F("FMSUB", 0x1b, 5, "WD")
!M3F("FEXP2", 0x1b, 7, "WD")
!M3F("FEXDO", 0x1b, 8, "HW")
!M3F("FTQ", 0x1b, 10, "HW")
!M3F("FMIN", 0x1b, 12, "WD")
!M3F("FMIN\\_A", 0x1b, 13, "WD")
!M3F("FMAX", 0x1b, 14, "WD")
!M3F("FMAX\\_A", 0x1b, 15, "WD")
!M3F("FCOR", 0x1c, 1, "WD")
!M3F("FCUNE", 0x1c, 2, "WD")
!M3F("FCNE", 0x1c, 3, "WD")
!M3F("MUL\\_Q", 0x1c, 4, "HW")
!M3F("MADD\\_Q", 0x1c, 5, "HW")
!M3F("MSUB\\_Q", 0x1c, 6, "HW")
!M3F("FSOR", 0x1c, 9, "WD")
!M3F("FSUNE", 0x1c, 10, "WD")
!M3F("FSNE", 0x1c, 11, "WD")
!M3F("MULR\\_Q", 0x1c, 12, "HW")
!M3F("MADDR\\_Q", 0x1c, 13, "HW")
!M3F("MSUBR\\_Q", 0x1c, 14, "HW")
/* 2R: wd,ws (fill: wd,rs) */
!def M2R(nm, op) {
!local i = 0
!while i < 4 {
!Z(nm + "." + substr("BHWD", i, 1), "wd,ws", "", 0x7b00001e | (op << 18) | (i << 16), "|(ws<<11)|(wd<<6)")
!set i = i + 1
}
}
!M2R("PCNT", 1)
!M2R("NLOC", 2)
!M2R("NLZC", 3)
!def MFILL(f, i) {
!Z("FILL." + f, "wd,s", "", 0x7b00001e | (i << 16), "|(s<<11)|(wd<<6)")
}
!MFILL("B", 0)
!MFILL("H", 1)
!MFILL("W", 2)
!MFILL("D", 3)
/* 2RF: wd,ws, W D */
!def M2F(nm, op) {
!Z(nm + ".W", "wd,ws", "", 0x7b20001e | (op << 17), "|(ws<<11)|(wd<<6)")
!Z(nm + ".D", "wd,ws", "", 0x7b21001e | (op << 17), "|(ws<<11)|(wd<<6)")
}
!M2F("FCLASS", 0)
!M2F("FTRUNC\\_S", 1)
!M2F("FTRUNC\\_U", 2)
!M2F("FSQRT", 3)
!M2F("FRSQRT", 4)
!M2F("FRCP", 5)
!M2F("FRINT", 6)
!M2F("FLOG2", 7)
!M2F("FEXUPL", 8)
!M2F("FEXUPR", 9)
!M2F("FFQL", 10)
!M2F("FFQR", 11)
!M2F("FTINT\\_S", 12)
!M2F("FTINT\\_U", 13)
!M2F("FFINT\\_S", 14)
!M2F("FFINT\\_U", 15)
/* I5: wd,ws,imm5, signed (sg = 1) or unsigned */
!def MI5(nm, minor, op, sg) {
!local i = 0
!local er = "v<0||v>31;3"
!if sg !then {
!set er = "v<-16||v>15;3"
}
!while i < 4 {
!Z(nm + "." + substr("BHWD", i, 1), "wd,ws,!v", er, 0x78000000 | (op << 23) | (i << 21) | minor, "|((v&31)<<16)|(ws<<11)|(wd<<6)")
!set i = i + 1
}
}
!MI5("ADDVI", 6, 0, 0)
!MI5("SUBVI", 6, 1, 0)
!MI5("MAXI\\_S", 6, 2, 1)
!MI5("MAXI\\_U", 6, 3, 0)
!MI5("MINI\\_S", 6, 4, 1)
!MI5("MINI\\_U", 6, 5, 0)
!MI5("CEQI", 7, 0, 1)
!MI5("CLTI\\_S", 7, 2, 1)
!MI5("CLTI\\_U", 7, 3, 0)
!MI5("CLEI\\_S", 7, 4, 1)
!MI5("CLEI\\_U", 7, 5, 0)
!def MLDI(f, i) {
!Z("LDI." + f, "wd,!v", "v<-512||v>511;3", 0x7b000007 | (i << 21), "|((v&0x3ff)<<11)|(wd<<6)")
}
!MLDI("B", 0)
!MLDI("H", 1)
!MLDI("W", 2)
!MLDI("D", 3)
/* I8: wd,ws,imm8 */
!def MI8(nm, base) {
!Z(nm, "wd,ws,!v", "v<0||v>255;3", base, "|((v&0xff)<<16)|(ws<<11)|(wd<<6)")
}
!MI8("ANDI.B", 0x78000000)
!MI8("ORI.B", 0x79000000)
!MI8("NORI.B", 0x7a000000)
!MI8("XORI.B", 0x7b000000)
!MI8("BMNZI.B", 0x78000001)
!MI8("BMZI.B", 0x79000001)
!MI8("BSELI.B", 0x7a000001)
!MI8("SHF.B", 0x78000002)
!MI8("SHF.H", 0x79000002)
!MI8("SHF.W", 0x7a000002)
/* BIT: wd,ws,m, the bit number m of the element size; the format and
/* m share bits 22-16 (B 1110mmm, H 110mmmm, W 10mmmmm, D 0mmmmmm) */
!def MBIT(nm, minor, op) {
!Z(nm + ".B", "wd,ws,!v", "v<0||v>7;10", 0x78700000 | (op << 23) | minor, "|((v&7)<<16)|(ws<<11)|(wd<<6)")
!Z(nm + ".H", "wd,ws,!v", "v<0||v>15;10", 0x78600000 | (op << 23) | minor, "|((v&15)<<16)|(ws<<11)|(wd<<6)")
!Z(nm + ".W", "wd,ws,!v", "v<0||v>31;10", 0x78400000 | (op << 23) | minor, "|((v&31)<<16)|(ws<<11)|(wd<<6)")
!Z(nm + ".D", "wd,ws,!v", "v<0||v>63;10", 0x78000000 | (op << 23) | minor, "|((v&63)<<16)|(ws<<11)|(wd<<6)")
}
!MBIT("SLLI", 9, 0)
!MBIT("SRAI", 9, 1)
!MBIT("SRLI", 9, 2)
!MBIT("BCLRI", 9, 3)
!MBIT("BSETI", 9, 4)
!MBIT("BNEGI", 9, 5)
!MBIT("BINSLI", 9, 6)
!MBIT("BINSRI", 9, 7)
!MBIT("SAT\\_S", 10, 0)
!MBIT("SAT\\_U", 10, 1)
!MBIT("SRARI", 10, 2)
!MBIT("SRLRI", 10, 3)
/* ELM: an element index n; the format and n share bits 21-16
/* (B 00nnnn, H 100nnn, W 1100nn, D 11100n) */
!def MDN(i) {
!if i == 0 !then {
!return 0
}
!if i == 1 !then {
!return 0x20
}
!if i == 2 !then {
!return 0x30
}
!return 0x38
}
!def MELM(nm, op, pat, fx, dfs) {
!local i = 0
!local f = ""
!while i < 4 {
!set f = substr("BHWD", i, 1)
!if substr(dfs, i, 1) != "-" !then {
!Z(nm + "." + f, pat, "n<0||n>" + str((16 >> i) - 1) + ";10", 0x78000019 | (op << 22) | (MDN(i) << 16), "|(n<<16)" + fx)
}
!set i = i + 1
}
}
!MELM("SLDI", 0, "wd,ws[!n]", "|(ws<<11)|(wd<<6)", "BHWD")
!MELM("SPLATI", 1, "wd,ws[!n]", "|(ws<<11)|(wd<<6)", "BHWD")
!MELM("COPY\\_S", 2, "d,ws[!n]", "|(ws<<11)|(d<<6)", "BHWD")
!MELM("COPY\\_U", 3, "d,ws[!n]", "|(ws<<11)|(d<<6)", "BHW-")
!MELM("INSERT", 4, "wd[!n],s", "|(s<<11)|(wd<<6)", "BHWD")
!MELM("INSVE", 5, "wd[!n],ws[0]", "|(ws<<11)|(wd<<6)", "BHWD")
!Z("MOVE.V", "wd,ws", "", 0x78be0019, "|(ws<<11)|(wd<<6)")
/* the MSA control registers: $0-$7 or by name */
!Z("CFCMSA", "d,mc", "", 0x787e0019, "|(mc<<11)|(d<<6)")
!Z("CTCMSA", "mc,s", "", 0x783e0019, "|(s<<11)|(mc<<6)")
/* VEC: wd,ws,wt */
!def MVEC(nm, op) {
!Z(nm + ".V", "wd,ws,wt", "", 0x7800001e | (op << 21), "|(wt<<16)|(ws<<11)|(wd<<6)")
}
!MVEC("AND", 0)
!MVEC("OR", 1)
!MVEC("NOR", 2)
!MVEC("XOR", 3)
!MVEC("BMNZ", 4)
!MVEC("BMZ", 5)
!MVEC("BSEL", 6)
/* MI10: wd,offset(rs), the offset a multiple of the element size and
/* stored divided by it */
!def MLS(nm, minor) {
!local i = 0
!local f = ""
!local sz = 1
!while i < 4 {
!set f = substr("BHWD", i, 1)
!set sz = 1 << i
!Z(nm + "." + f, "wd,!v(s)", "v<" + str(-512 * sz) + "||v>" + str(511 * sz) + "||(v&" + str(sz - 1) + ")!=0;8", 0x78000000 | minor | i, "|(((v>>" + str(i) + ")&0x3ff)<<16)|(s<<11)|(wd<<6)")
!Z(nm + "." + f, "wd,(s)", "", 0x78000000 | minor | i, "|(s<<11)|(wd<<6)")
!set i = i + 1
}
}
!MLS("LD", 0x20)
!MLS("ST", 0x24)
/* branches on a vector: wt,target */
!def MBR(nm, base) {
.reloc::v::pc16
!Z(nm, "wt,!v", EBR(), base, "|(wt<<16)" + FBR())
.clrreloc::v
}
!MBR("BZ.V", 0x45600000)
!MBR("BNZ.V", 0x45e00000)
!MBR("BZ.B", 0x47000000)
!MBR("BZ.H", 0x47200000)
!MBR("BZ.W", 0x47400000)
!MBR("BZ.D", 0x47600000)
!MBR("BNZ.B", 0x47800000)
!MBR("BNZ.H", 0x47a00000)
!MBR("BNZ.W", 0x47c00000)
!MBR("BNZ.D", 0x47e00000)
/* lsa / dlsa rd,rs,rt,sa: rd = (rs << sa) + rt, sa 1-4 */
!Z("LSA", "d,s,t,!v", "v<1||v>4;10", 0x00000005, RF() + "|(((v-1)&3)<<6)")
!Z("DLSA", "d,s,t,!v", "v<1||v>4;10", 0x00000015, RF() + "|(((v-1)&3)<<6)")

/* ===================================================================
/* Release 6 (front files with R6() = 1)
/*
/* Release 6 drops what the !if R6() == 0 blocks above hold (branch
/* likely, HI / LO multiply and divide, lwl / lwr ..., movz / movn,
/* the FP condition codes and paired single, COP1X, the trap
/* immediates, jalx, addi / daddi, MIPS-3D, SmartMIPS, MCU), re-encodes
/* clz / clo / dclz / dclo, ll / sc / lld / scd, cache / pref,
/* lwc2 / swc2 / ldc2 / sdc2, jr and sdbbp (above, by R6()), and adds
/* the instructions below.
/* =================================================================== */
!if R6() !then {
/* multiply and divide into a general register: rd,rs,rt or rd,rt
/* (rd,rd,rt) */
!def M6(nm, fn) {
!Z(nm, "d,s,t", "", fn, RF())
!Z(nm, "d,t", "", fn, "|(d<<21)|(t<<16)|(d<<11)")
}
!M6("MUL", 0x98)
!M6("MUH", 0xd8)
!M6("MULU", 0x99)
!M6("MUHU", 0xd9)
!M6("DIV", 0x9a)
!M6("MOD", 0xda)
!M6("DIVU", 0x9b)
!M6("MODU", 0xdb)
!M6("DMUL", 0x9c)
!M6("DMUH", 0xdc)
!M6("DMULU", 0x9d)
!M6("DMUHU", 0xdd)
!M6("DDIV", 0x9e)
!M6("DMOD", 0xde)
!M6("DDIVU", 0x9f)
!M6("DMODU", 0xdf)
!Z("SELEQZ", "d,s,t", "", 0x35, RF())
!Z("SELNEZ", "d,s,t", "", 0x37, RF())
/* align / dalign rd,rs,rt,bp: the byte position bp in bits 8-6 */
!Z("ALIGN", "d,s,t,!v", "v<0||v>3;10", 0x7c000220, RF() + "|((v&3)<<6)")
!Z("DALIGN", "d,s,t,!v", "v<0||v>7;10", 0x7c000224, RF() + "|((v&7)<<6)")
!Z("BITSWAP", "d,t", "", 0x7c000020, "|(t<<16)|(d<<11)")
!Z("DBITSWAP", "d,t", "", 0x7c000024, "|(t<<16)|(d<<11)")
/* add an upper immediate: aui rt,rs,imm (lui is aui with rs = $0),
/* daui (rs not $0), dahi / dati rs,imm (also rs,rs,imm) */
!Z("AUI", "t,s,!v", EU16(), 0x3c000000, "|(s<<21)|(t<<16)|(v&0xffff)")
!MODS("AUI", "t,s,", "", 0x3c000000, IFLD())
!Z("DAUI", "t,s,!v", "s==0;5," + EU16(), 0x74000000, "|(s<<21)|(t<<16)|(v&0xffff)")
!MODS("DAUI", "t,s,", "", 0x74000000, IFLD())
!def DAH(nm, base) {
!Z(nm, "s,!v", EU16(), base, "|(s<<21)|(v&0xffff)")
!Z(nm, "s,t,!v", "s!=t;5," + EU16(), base, "|(s<<21)|(v&0xffff)")
}
!DAH("DAHI", 0x04060000)
!DAH("DATI", 0x041e0000)
/* PC-relative: addiupc / lwpc / lwupc rs,target (19 bits, words),
/* ldpc (18 bits, doublewords from the doubleword of the pc), auipc /
/* aluipc rs,imm and rs,%pcrel_hi(target) */
.reloc::v::pc19_s2
!def PC19(nm, base) {
!Z(nm, "s,!v", "(v-$$)>1048572||(v-$$)<-1048576||((v-$$)&3)!=0;2", base, "|(s<<21)|(((v-$$)>>2)&0x7ffff)")
}
!PC19("ADDIUPC", 0xec000000)
!PC19("LAPC", 0xec000000)
!PC19("LWPC", 0xec080000)
!PC19("LWUPC", 0xec100000)
.reloc::v::pc18_s3
!Z("LDPC", "s,!v", "(v-$$+($$&7))>1048568||(v-$$+($$&7))<-1048576||(v&7)!=0;2", 0xec180000, "|(s<<21)|(((v-$$+($$&7))>>3)&0x3ffff)")
.clrreloc::v
!Z("AUIPC", "s,!v", EU16(), 0xec1e0000, "|(s<<21)|(v&0xffff)")
!Z("ALUIPC", "s,!v", EU16(), 0xec1f0000, "|(s<<21)|(v&0xffff)")
.reloc::v::pchi16
!Z("AUIPC", "s,%PCREL\\_HI(!v)", "", 0xec1e0000, "|(s<<21)|(((v-$$+0x8000)>>16)&0xffff)")
!Z("ALUIPC", "s,%PCREL\\_HI(!v)", "", 0xec1f0000, "|(s<<21)|(((v-$$+0x8000)>>16)&0xffff)")
.clrreloc::v

/* compact branches (no delay slot). The two-register forms take
/* their registers in the order the encoding needs: beqc / bnec put
/* the smaller number in rs, bovc / bnvc the larger. */
!def MINR() {
!return "((s<t)*s+(s>=t)*t)"
}
!def MAXR() {
!return "((s<t)*t+(s>=t)*s)"
}
.reloc::v::pc16
!def BCE(nm, base) {
!Z(nm, "s,t,!v", "s==t||s==0||t==0;5," + EBR(), base, "|(" + MINR() + "<<21)|(" + MAXR() + "<<16)" + FBR())
}
!BCE("BEQC", 0x20000000)
!BCE("BNEC", 0x60000000)
!def BCV(nm, base) {
!Z(nm, "s,t,!v", EBR(), base, "|(" + MAXR() + "<<21)|(" + MINR() + "<<16)" + FBR())
}
!BCV("BOVC", 0x20000000)
!BCV("BNVC", 0x60000000)
/* bgec / bltc / bgeuc / bltuc rs,rt; blec / bgtc / bleuc / bgtuc are
/* the same with the registers exchanged */
!def BCC2(nm, swnm, base) {
!Z(nm, "s,t,!v", "s==t||s==0||t==0;5," + EBR(), base, "|(s<<21)|(t<<16)" + FBR())
!Z(swnm, "t,s,!v", "s==t||s==0||t==0;5," + EBR(), base, "|(s<<21)|(t<<16)" + FBR())
}
!BCC2("BGEC", "BLEC", 0x58000000)
!BCC2("BLTC", "BGTC", 0x5c000000)
!BCC2("BGEUC", "BLEUC", 0x18000000)
!BCC2("BLTUC", "BGTUC", 0x1c000000)
/* against zero: rt alone (rs = 0) or rt twice (rs = rt) */
!def BCZ(nm, base, twice) {
!local f = "|(t<<16)"
!if twice !then {
!set f = "|(t<<21)|(t<<16)"
}
!Z(nm, "t,!v", "t==0;5," + EBR(), base, f + FBR())
}
!BCZ("BLEZC", 0x58000000, 0)
!BCZ("BGEZC", 0x58000000, 1)
!BCZ("BGTZC", 0x5c000000, 0)
!BCZ("BLTZC", 0x5c000000, 1)
!BCZ("BLEZALC", 0x18000000, 0)
!BCZ("BGEZALC", 0x18000000, 1)
!BCZ("BGTZALC", 0x1c000000, 0)
!BCZ("BLTZALC", 0x1c000000, 1)
!BCZ("BEQZALC", 0x20000000, 0)
!BCZ("BNEZALC", 0x60000000, 0)
/* the FP and COP2 branches on a register */
!Z("BC1EQZ", "ft,!v", EBR(), 0x45200000, "|(ft<<16)" + FBR())
!Z("BC1NEZ", "ft,!v", EBR(), 0x45a00000, "|(ft<<16)" + FBR())
!Z("BC2EQZ", "n,!v", EBR(), 0x49200000, "|(n<<16)" + FBR())
!Z("BC2NEZ", "n,!v", EBR(), 0x49a00000, "|(n<<16)" + FBR())
!Z("NAL", "", "", 0x04100000, "")
.clrreloc::v
/* beqzc / bnezc rs,target: 21 bits */
.reloc::v::pc21_s2
!def B21(nm, base) {
!Z(nm, "s,!v", "s==0;5,(v-$$-4)>4194300||(v-$$-4)<-4194304||((v-$$)&3)!=0;2", base, "|(s<<21)|(((v-$$-4)>>2)&0x1fffff)")
}
!B21("BEQZC", 0xd8000000)
!B21("BNEZC", 0xf8000000)
/* bc / balc target: 26 bits */
.reloc::v::pc26_s2
!def B26(nm, base) {
!Z(nm, "!v", "(v-$$-4)>134217724||(v-$$-4)<-134217728||((v-$$)&3)!=0;2", base, "|(((v-$$-4)>>2)&0x3ffffff)")
}
!B26("BC", 0xc8000000)
!B26("BALC", 0xe8000000)
.clrreloc::v
/* jumps through a register plus an offset */
!Z("JIC", "t,!v", ES16(), 0xd8000000, "|(t<<16)|(v&0xffff)")
!Z("JIALC", "t,!v", ES16(), 0xf8000000, "|(t<<16)|(v&0xffff)")
!Z("JRC", "t", "", 0xd8000000, "|(t<<16)")
!Z("JALRC", "t", "", 0xf8000000, "|(t<<16)")
!Z("SIGRIE", "!v", EU16(), 0x04170000, "|(v&0xffff)")
!Z("SIGRIE", "", "", 0x04170000, "")

/* CRC32: rt,rs,rt (the result replaces rt) */
!def CRC(nm, k) {
!Z(nm, "t,s,d", "d!=t;5", 0x7c00000f | (k << 6), "|(s<<21)|(t<<16)")
}
!CRC("CRC32B", 0)
!CRC("CRC32H", 1)
!CRC("CRC32W", 2)
!CRC("CRC32D", 3)
!CRC("CRC32CB", 4)
!CRC("CRC32CH", 5)
!CRC("CRC32CW", 6)
!CRC("CRC32CD", 7)
/* GINV */
!Z("GINVI", "s", "", 0x7c00003d, "|(s<<21)")
!Z("GINVT", "s,!v", "v<0||v>3;10", 0x7c0000bd, "|(s<<21)|((v&3)<<8)")
/* virtual processors */
!MT0("DVP", 0x41600024)
!MT0("EVP", 0x41600004)
/* paired load linked / store conditional: rt,rd,(base) */
!def LLP(nm, base) {
!Z(nm, "t,d,(s)", "", base, RF())
!Z(nm, "t,d,s", "", base, RF())
}
!LLP("LLWP", 0x7c000076)
!LLP("LLDP", 0x7c000077)
!LLP("SCWP", 0x7c000066)
!LLP("SCDP", 0x7c000067)
!LLP("LLWPE", 0x7c00006e)
!LLP("SCWPE", 0x7c00005e)

/* floating point */
!FSD2("CLASS", 0x1b)
!FSD2("RINT", 0x1a)
!FSD3("SEL", 0x10)
!FSD3("SELEQZ", 0x14)
!FSD3("SELNEZ", 0x17)
!FSD3("MADDF", 0x18)
!FSD3("MSUBF", 0x19)
!FSD3("MIN", 0x1c)
!FSD3("MINA", 0x1d)
!FSD3("MAX", 0x1e)
!FSD3("MAXA", 0x1f)
/* cmp.<cond>.<fmt> fd,fs,ft: fmt field W (20) for S and L (21) for D */
!def CMP6(cn, i) {
!Z("CMP." + cn + ".S", "fd,fs,ft", "", 0x46800000 | i, "|(ft<<16)|(fs<<11)|(fd<<6)")
!Z("CMP." + cn + ".D", "fd,fs,ft", "", 0x46a00000 | i, "|(ft<<16)|(fs<<11)|(fd<<6)")
}
!CMP6("AF", 0)
!CMP6("UN", 1)
!CMP6("EQ", 2)
!CMP6("UEQ", 3)
!CMP6("LT", 4)
!CMP6("ULT", 5)
!CMP6("LE", 6)
!CMP6("ULE", 7)
!CMP6("SAF", 8)
!CMP6("SUN", 9)
!CMP6("SEQ", 10)
!CMP6("SUEQ", 11)
!CMP6("SLT", 12)
!CMP6("SULT", 13)
!CMP6("SLE", 14)
!CMP6("SULE", 15)
!CMP6("OR", 17)
!CMP6("UNE", 18)
!CMP6("NE", 19)
!CMP6("SOR", 25)
!CMP6("SUNE", 26)
!CMP6("SNE", 27)
}

/* ===================================================================
/* Data
/* =================================================================== */
DB !v :: v
BYTE !v :: v
!if BE() !then {
HALF !v :: v>>8,v
WORD !v :: v>>24,v>>16,v>>8,v
DWORD !v :: v>>56,v>>48,v>>40,v>>32,v>>24,v>>16,v>>8,v
FLOAT !Fv :: v>>24,v>>16,v>>8,v
DOUBLE !Dv :: v>>56,v>>48,v>>40,v>>32,v>>24,v>>16,v>>8,v
} !else {
HALF !v :: v,v>>8
WORD !v :: v,v>>8,v>>16,v>>24
DWORD !v :: v,v>>8,v>>16,v>>24,v>>32,v>>40,v>>48,v>>56
FLOAT !Fv :: v,v>>8,v>>16,v>>24
DOUBLE !Dv :: v,v>>8,v>>16,v>>24,v>>32,v>>40,v>>48,v>>56
}
