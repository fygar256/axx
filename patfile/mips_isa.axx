!E9G("LWLE", 0x19)
!E9G("LWRE", 0x1a)
!E9G("SWLE", 0x21)
!E9G("SWRE", 0x22)
}
!E9H("CACHEE", 0x1b)
!E9H("PREFE", 0x23)

