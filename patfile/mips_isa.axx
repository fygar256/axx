!MC("MFC2", 0x48000000)
!MC("DMFC2", 0x48200000)
!Z("CFC2", "t,n", "", 0x48400000, "|(t<<16)|(n<<11)")
!MC("MFHC2", 0x48600000)
!MC("MTC2", 0x48800000)
!MC("DMTC2", 0x48a00000)
!Z("CTC2", "t,n", "", 0x48c00000, "|(t<<16)|(n<<11)")
!MC("MTHC2", 0x48e00000)
!Z("C2", "!v", "v<0||v>0x1ffffff;3", 0x4a000000, "|(v&0x1ffffff)")
!Z("COP2", "!v", "v<0||v>0x1ffffff;3", 0x4a000000, "|(v&0x1ffffff)")

/* ===================================================================
/* Registers of the extensions: the DSP accumulators $ac0-$ac3 (ac),
/* the MSA vector registers $w0-$w31 (wd ws wt) and the MSA control
/* registers $0-$7 or $msair $msacsr $msaaccess $msasave $msamodify
/* $msarequest $msamap $msaunmap (mc)
/* =================================================================== */
!regs("$AC", 3)
!regs("$W", 31)
!nm("MSAIR", 0)
!nm("MSACSR", 1)
!nm("MSAACCESS", 2)
!nm("MSASAVE", 3)
!nm("MSAMODIFY", 4)
!nm("MSAREQUEST", 5)
!nm("MSAMAP", 6)
!nm("MSAUNMAP", 7)
!regset("ACR", "$AC", 3)
!regset("WR", "$W", 31)
!regset("MSACN", "$", 7)
.setsym::MSACR::MSACN,$MSAIR,$MSACSR,$MSAACCESS,$MSASAVE,$MSAMODIFY,$MSAREQUEST,$MSAMAP,$MSAUNMAP
.check::ac::ACR
.check::wd::WR
.check::ws::WR
.check::wt::WR
.check::mc::MSACR

!if R6() == 0 !then {
/* ===================================================================
/* MIPS I coprocessor 3 and COP0 forms (dropped in later levels; their
/* opcodes were reused, but the mnemonics are unambiguous)
/* =================================================================== */
!LSC("LWC3", 51)
!LSC("LDC3", 55)
!LSC("SWC3", 59)
!LSC("SDC3", 63)
!Z("RFE", "", "", 0x42000010, "")
!BCC("BC0F", 0x41000000, "e")
!BCC("BC0T", 0x41010000, "e")
!BCC("BC0FL", 0x41020000, "e")
!BCC("BC0TL", 0x41030000, "e")
!BCC("BC3F", 0x4d000000, "e")
!BCC("BC3T", 0x4d010000, "e")
!BCC("BC3FL", 0x4d020000, "e")
!BCC("BC3TL", 0x4d030000, "e")
!Z("C3", "!v", "v<0||v>0x1ffffff;3", 0x4e000000, "|(v&0x1ffffff)")
!Z("COP3", "!v", "v<0||v>0x1ffffff;3", 0x4e000000, "|(v&0x1ffffff)")

/* ===================================================================
/* MIPS-3D
/* =================================================================== */
!F3("ADDR", 0x18, "PS")
!F3("MULR", 0x1a, "PS")
!Z("CVT.PS.PW", "fd,fs", "", FB("W", 0x26), "|(fs<<11)|(fd<<6)")
!Z("CVT.PW.PS", "fd,fs", "", FB("PS", 0x24), "|(fs<<11)|(fd<<6)")
!FALL3("RECIP2", 0x1c)
!FALL2("RECIP1", 0x1d)
!FALL2("RSQRT1", 0x1e)
!FALL3("RSQRT2", 0x1f)
/* the condition code of the "any" branches is a multiple of 2 or 4 */
!def BANY(nm, base, m) {
.reloc::v::pc16
!Z(nm, "c,!v", "(c&" + str(m) + ")!=0;10," + EBR(), base, "|(c<<18)" + FBR())
.clrreloc::v
}
!BANY("BC1ANY2F", 0x45200000, 1)
!BANY("BC1ANY2T", 0x45210000, 1)
!BANY("BC1ANY4F", 0x45400000, 3)
!BANY("BC1ANY4T", 0x45410000, 3)
/* cabs.<cond>.<fmt> [cc,]fs,ft: c.cond with the absolute bit (6) */
!def FCABS(cn, i) {
!local k = 0
!local f = ""
!while k < 3 {
!set f = substr("SDP", k, 1)
!if f == "P" !then {
!set f = "PS"
}
!Z("CABS." + cn + "." + f, "fs,ft", "", FB(f, 112 + i), "|(ft<<16)|(fs<<11)")
!Z("CABS." + cn + "." + f, "c,fs,ft", "", FB(f, 112 + i), "|(ft<<16)|(fs<<11)|(c<<8)")
!set k = k + 1
}
}
!FCABS("F", 0)
!FCABS("UN", 1)
!FCABS("EQ", 2)
!FCABS("UEQ", 3)
!FCABS("OLT", 4)
!FCABS("ULT", 5)
!FCABS("OLE", 6)
!FCABS("ULE", 7)
!FCABS("SF", 8)
!FCABS("NGLE", 9)
!FCABS("SEQ", 10)
!FCABS("NGL", 11)
!FCABS("LT", 12)
!FCABS("NGE", 13)
!FCABS("LE", 14)
!FCABS("NGT", 15)

/* ===================================================================
/* SmartMIPS
/* =================================================================== */
!Z("LWXS", "d,t(s)", "", 0x70000088, RF())
!Z("MADDP", "s,t", "", 0x70000441, "|(s<<21)|(t<<16)")
