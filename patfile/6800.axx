LDAA [[!v]],X :: v>0xff||v<0;2 :: 0xA6,v&0xff
LDAA <!v :: v>0xff||v<0;2 :: 0x96,v&0xff
LDAA >!v :: v>0xffff||v<0;2 :: 0xB6,(v>>8)&0xff,v&0xff
LDAA !v :: :: (v>0xff)?0xB6:0x96,;((v>0xff)?((v>>8)&0xff):0),v&0xff

