/* =====================================================================
/*  6800.axx -- Motorola MC6800 full pattern file for axx
/*
/*  Covers the complete official MC6800 instruction set: all 51
/*  inherent (1-byte) opcodes, the 15 short (8-bit) relative branches
/*  plus BSR, the accumulator-A and accumulator-B groups (immediate /
/*  direct / indexed / extended), the memory read-modify-write group
/*  (NEG/COM/LSR/ROR/ASR/ASL(LSL)/ROL/DEC/INC/TST/CLR/JMP -- indexed
/*  and extended only, the MC6800 has no direct-page form of these),
/*  JSR (indexed/extended only), and the 16-bit CPX/LDS/STS/LDX/STX
/*  group. 197 opcodes in total. Undocumented/illegal opcodes (e.g.
/*  the HCF-behaving 0x9D/0xDD, or the partial-STA 0x87/0x8F/0xC7/0xCF)
/*  are intentionally not included, matching the existing 6502.axx /
/*  6809.axx house convention.
/*
/*  Mnemonics use the widely-used single-token form (LDAA, LDAB, STAA,
/*  STAB, ...) found in most modern MC6800 cross-assemblers, not the
/*  older two-token "LDA A" form used by Motorola's original resident
/*  assembler.
/*
/*  ============================= SYNTAX =============================
/*
/*  Immediate / direct / extended / indexed (accumulator-A shown, B is
/*  identical in form):
/*
/*     LDAA #$41          immediate (8-bit; CPX/LDS/LDX take a 16-bit
/*                        immediate instead, e.g. LDX #$1234)
/*     LDAA $10           direct    (auto: chosen when value <= $FF)
/*     LDAA $1000         extended  (auto: chosen otherwise)
/*     LDAA <$10          force direct    (error if operand > $FF)
/*     LDAA >$10          force extended  (always a 2-byte address)
/*     LDAA 5,X           indexed -- unsigned 8-bit offset from X only;
/*                        the MC6800 has a single index register and no
/*                        indirect/auto-inc/auto-dec indexed forms (all
/*                        of those are 6809 additions)
/*     LDAA ,X            indexed with an offset of 0
/*
/*  axx does not optimise instruction length by itself, so the direct /
/*  extended choice above is made inside the pattern by a ternary on the
/*  operand value. A forward label is unknown on the first relaxation
/*  pass, so its instruction may change length between passes; axx
/*  re-runs pass 1 until the addresses stop moving, and refuses to write
/*  output if they never settle.
/*
/*  Memory read-modify-write groups have NO direct-page form on real
/*  MC6800 hardware -- only indexed and extended exist (plus separate
/*  inherent opcodes for the accumulator forms, e.g. NEGA/NEGB):
/*
/*     NEG 5,X            indexed
/*     NEG $1000          extended (always 3 bytes; there is no
/*                        direct/extended auto-choice to make here)
/*     NEG >$1000         extended, forced explicitly (same encoding;
/*                        accepted for symmetry with the accumulator
/*                        groups below)
/*     NEG <$10           always an error (error code 1) -- there is
/*                        no direct-page form to force here; this is
/*                        defined on purpose so the typo is caught
/*                        instead of silently mis-assembling (axx's
/*                        expression grammar also treats a leading
/*                        unmatched `<`/`>` as the comparison operator,
/*                        so an undefined `<`/`>` prefix elsewhere would
/*                        otherwise silently parse as `0 < value` and
/*                        emit a 0 operand rather than raising an error)
/*     NEGA / NEGB         accumulator forms (inherent, 1 byte)
/*
/*  Relative branches (including BSR) are 2 bytes; the displacement is
/*  measured from the address of the byte after the instruction ($$+2):
/*
/*     BEQ label
/*     BSR sub
/*
/*  Aliases provided for convenience, matching common assembler usage:
/*     LSL / LSLA / LSLB    same opcodes as ASL / ASLA / ASLB
/*     BHS                  same opcode as BCC (branch if C=0)
/*     BLO                  same opcode as BCS (branch if C=1)
/*
/*  Data definition (numbers use axx expression syntax, 0x10 / 16 /
/*  0b10000, not $10):
/*     FCB v[,w[,x[,y[,z[,i[,j[,k]]]]]]]   up to 8 values, 1 byte each
/*     FDB v[,w[,x[,y]]]                   up to 4 values, 2 bytes each
/*                                         (big-endian, Motorola order)
/*     RMB !n                              reserve n bytes, filled with
/*                                         0x00 in the binary output.
/*                                         For a true no-output
/*                                         reservation (e.g. inside a
/*                                         .bss section) use axx's
/*                                         built-in `.resb n` instead.
/*  There is no FCC directive here (axx has no generic delimited-
/*  string operand capture outside its built-in directives); use the
/*  built-in `.ascii "text"` / `.asciz "text"` directives for strings.
/*
/*  Error codes raised by this file
/*     1  Invalid syntax        (only from NEG/COM/.../JMP/JSR `<value`,
/*        which has no addressing mode to mean -- see above)
/*     2  Address out of range  (indexed offset > 8 bits, forced direct
/*        operand > $FF, or forced/computed extended address > $FFFF)
/*     3  Value out of range    (immediate operand too big)
/* ===================================================================== */

/* ---------- inherent (no operand) ---------- */
NOP :: 0x01
TAP :: 0x06
TPA :: 0x07
INX :: 0x08
DEX :: 0x09
CLV :: 0x0A
SEV :: 0x0B
CLC :: 0x0C
SEC :: 0x0D
CLI :: 0x0E
SEI :: 0x0F
SBA :: 0x10
CBA :: 0x11
TAB :: 0x16
TBA :: 0x17
DAA :: 0x19
ABA :: 0x1B
TSX :: 0x30
INS :: 0x31
PULA :: 0x32
PULB :: 0x33
DES :: 0x34
TXS :: 0x35
PSHA :: 0x36
PSHB :: 0x37
RTS :: 0x39
RTI :: 0x3B
WAI :: 0x3E
SWI :: 0x3F

/* ---------- inherent accumulator shift/rotate/test group ---------- */
NEGA :: 0x40
COMA :: 0x43
LSRA :: 0x44
RORA :: 0x46
ASRA :: 0x47
ASLA :: 0x48
LSLA :: 0x48
ROLA :: 0x49
DECA :: 0x4A
INCA :: 0x4C
TSTA :: 0x4D
CLRA :: 0x4F
NEGB :: 0x50
COMB :: 0x53
LSRB :: 0x54
RORB :: 0x56
ASRB :: 0x57
ASLB :: 0x58
LSLB :: 0x58
ROLB :: 0x59
DECB :: 0x5A
INCB :: 0x5C
TSTB :: 0x5D
CLRB :: 0x5F

/* ---------- short (8-bit) relative branches, including BSR ---------- */
/* $$ is the location counter at the start of this instruction; the
/* displacement is measured from the byte after the operand ($$+2). */
BRA !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x20,(e-$$-2)&0xff
BHI !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x22,(e-$$-2)&0xff
BLS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x23,(e-$$-2)&0xff
BCC !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x24,(e-$$-2)&0xff
BHS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x24,(e-$$-2)&0xff
BCS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x25,(e-$$-2)&0xff
BLO !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x25,(e-$$-2)&0xff
BNE !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x26,(e-$$-2)&0xff
BEQ !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x27,(e-$$-2)&0xff
BVC !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x28,(e-$$-2)&0xff
BVS !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x29,(e-$$-2)&0xff
BPL !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2A,(e-$$-2)&0xff
BMI !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2B,(e-$$-2)&0xff
BGE !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2C,(e-$$-2)&0xff
BLT !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2D,(e-$$-2)&0xff
BGT !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2E,(e-$$-2)&0xff
BLE !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x2F,(e-$$-2)&0xff
BSR !e :: (e-$$-2)>127||(e-$$-2)<-128;2 :: 0x8D,(e-$$-2)&0xff

/* ---------- memory read-modify-write group: indexed / extended only ---------- */
/* No direct-page form exists for this group on real MC6800 hardware. */
NEG [[!v]],X :: v>0xff||v<0;2 :: 0x60,v&0xff
NEG <!v :: 1;1 :: 0x60,v&0xff
NEG >!v :: v>0xffff||v<0;2 :: 0x70,(v>>8)&0xff,v&0xff
NEG !v :: v>0xffff||v<0;2 :: 0x70,(v>>8)&0xff,v&0xff
COM [[!v]],X :: v>0xff||v<0;2 :: 0x63,v&0xff
COM <!v :: 1;1 :: 0x63,v&0xff
COM >!v :: v>0xffff||v<0;2 :: 0x73,(v>>8)&0xff,v&0xff
COM !v :: v>0xffff||v<0;2 :: 0x73,(v>>8)&0xff,v&0xff
LSR [[!v]],X :: v>0xff||v<0;2 :: 0x64,v&0xff
LSR <!v :: 1;1 :: 0x64,v&0xff
LSR >!v :: v>0xffff||v<0;2 :: 0x74,(v>>8)&0xff,v&0xff
LSR !v :: v>0xffff||v<0;2 :: 0x74,(v>>8)&0xff,v&0xff
ROR [[!v]],X :: v>0xff||v<0;2 :: 0x66,v&0xff
ROR <!v :: 1;1 :: 0x66,v&0xff
ROR >!v :: v>0xffff||v<0;2 :: 0x76,(v>>8)&0xff,v&0xff
ROR !v :: v>0xffff||v<0;2 :: 0x76,(v>>8)&0xff,v&0xff
ASR [[!v]],X :: v>0xff||v<0;2 :: 0x67,v&0xff
ASR <!v :: 1;1 :: 0x67,v&0xff
ASR >!v :: v>0xffff||v<0;2 :: 0x77,(v>>8)&0xff,v&0xff
ASR !v :: v>0xffff||v<0;2 :: 0x77,(v>>8)&0xff,v&0xff
ASL [[!v]],X :: v>0xff||v<0;2 :: 0x68,v&0xff
ASL <!v :: 1;1 :: 0x68,v&0xff
ASL >!v :: v>0xffff||v<0;2 :: 0x78,(v>>8)&0xff,v&0xff
ASL !v :: v>0xffff||v<0;2 :: 0x78,(v>>8)&0xff,v&0xff
LSL [[!v]],X :: v>0xff||v<0;2 :: 0x68,v&0xff
LSL <!v :: 1;1 :: 0x68,v&0xff
LSL >!v :: v>0xffff||v<0;2 :: 0x78,(v>>8)&0xff,v&0xff
LSL !v :: v>0xffff||v<0;2 :: 0x78,(v>>8)&0xff,v&0xff
ROL [[!v]],X :: v>0xff||v<0;2 :: 0x69,v&0xff
ROL <!v :: 1;1 :: 0x69,v&0xff
ROL >!v :: v>0xffff||v<0;2 :: 0x79,(v>>8)&0xff,v&0xff
ROL !v :: v>0xffff||v<0;2 :: 0x79,(v>>8)&0xff,v&0xff
DEC [[!v]],X :: v>0xff||v<0;2 :: 0x6A,v&0xff
DEC <!v :: 1;1 :: 0x6A,v&0xff
DEC >!v :: v>0xffff||v<0;2 :: 0x7A,(v>>8)&0xff,v&0xff
DEC !v :: v>0xffff||v<0;2 :: 0x7A,(v>>8)&0xff,v&0xff
INC [[!v]],X :: v>0xff||v<0;2 :: 0x6C,v&0xff
INC <!v :: 1;1 :: 0x6C,v&0xff
INC >!v :: v>0xffff||v<0;2 :: 0x7C,(v>>8)&0xff,v&0xff
INC !v :: v>0xffff||v<0;2 :: 0x7C,(v>>8)&0xff,v&0xff
TST [[!v]],X :: v>0xff||v<0;2 :: 0x6D,v&0xff
TST <!v :: 1;1 :: 0x6D,v&0xff
TST >!v :: v>0xffff||v<0;2 :: 0x7D,(v>>8)&0xff,v&0xff
TST !v :: v>0xffff||v<0;2 :: 0x7D,(v>>8)&0xff,v&0xff
CLR [[!v]],X :: v>0xff||v<0;2 :: 0x6F,v&0xff
CLR <!v :: 1;1 :: 0x6F,v&0xff
CLR >!v :: v>0xffff||v<0;2 :: 0x7F,(v>>8)&0xff,v&0xff
CLR !v :: v>0xffff||v<0;2 :: 0x7F,(v>>8)&0xff,v&0xff
JMP [[!v]],X :: v>0xff||v<0;2 :: 0x6E,v&0xff
JMP <!v :: 1;1 :: 0x6E,v&0xff
JMP >!v :: v>0xffff||v<0;2 :: 0x7E,(v>>8)&0xff,v&0xff
JMP !v :: v>0xffff||v<0;2 :: 0x7E,(v>>8)&0xff,v&0xff

/* ---------- JSR: indexed / extended only ---------- */
JSR [[!v]],X :: v>0xff||v<0;2 :: 0xAD,v&0xff
JSR <!v :: 1;1 :: 0xAD,v&0xff
JSR >!v :: v>0xffff||v<0;2 :: 0xBD,(v>>8)&0xff,v&0xff
JSR !v :: v>0xffff||v<0;2 :: 0xBD,(v>>8)&0xff,v&0xff

/* ---------- accumulator A group: immediate / direct / indexed / extended ---------- */
SUBA #!v :: v>0xff||v<0;3 :: 0x80,v&0xff
SUBA [[!v]],X :: v>0xff||v<0;2 :: 0xA0,v&0xff
SUBA <!v :: v>0xff||v<0;2 :: 0x90,v&0xff
SUBA >!v :: v>0xffff||v<0;2 :: 0xB0,(v>>8)&0xff,v&0xff
SUBA !v :: :: (v>0xff)?0xB0:0x90,;((v>0xff)?((v>>8)&0xff):0),v&0xff

CMPA #!v :: v>0xff||v<0;3 :: 0x81,v&0xff
CMPA [[!v]],X :: v>0xff||v<0;2 :: 0xA1,v&0xff
CMPA <!v :: v>0xff||v<0;2 :: 0x91,v&0xff
CMPA >!v :: v>0xffff||v<0;2 :: 0xB1,(v>>8)&0xff,v&0xff
CMPA !v :: :: (v>0xff)?0xB1:0x91,;((v>0xff)?((v>>8)&0xff):0),v&0xff

SBCA #!v :: v>0xff||v<0;3 :: 0x82,v&0xff
SBCA [[!v]],X :: v>0xff||v<0;2 :: 0xA2,v&0xff
SBCA <!v :: v>0xff||v<0;2 :: 0x92,v&0xff
SBCA >!v :: v>0xffff||v<0;2 :: 0xB2,(v>>8)&0xff,v&0xff
SBCA !v :: :: (v>0xff)?0xB2:0x92,;((v>0xff)?((v>>8)&0xff):0),v&0xff

ANDA #!v :: v>0xff||v<0;3 :: 0x84,v&0xff
ANDA [[!v]],X :: v>0xff||v<0;2 :: 0xA4,v&0xff
ANDA <!v :: v>0xff||v<0;2 :: 0x94,v&0xff
ANDA >!v :: v>0xffff||v<0;2 :: 0xB4,(v>>8)&0xff,v&0xff
ANDA !v :: :: (v>0xff)?0xB4:0x94,;((v>0xff)?((v>>8)&0xff):0),v&0xff

BITA #!v :: v>0xff||v<0;3 :: 0x85,v&0xff
BITA [[!v]],X :: v>0xff||v<0;2 :: 0xA5,v&0xff
BITA <!v :: v>0xff||v<0;2 :: 0x95,v&0xff
BITA >!v :: v>0xffff||v<0;2 :: 0xB5,(v>>8)&0xff,v&0xff
BITA !v :: :: (v>0xff)?0xB5:0x95,;((v>0xff)?((v>>8)&0xff):0),v&0xff

