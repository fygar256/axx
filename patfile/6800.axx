EORA [[!v]],X :: v>0xff||v<0;2 :: 0xA8,v&0xff
EORA <!v :: v>0xff||v<0;2 :: 0x98,v&0xff
EORA >!v :: v>0xffff||v<0;2 :: 0xB8,(v>>8)&0xff,v&0xff
EORA !v :: :: (v>0xff)?0xB8:0x98,;((v>0xff)?((v>>8)&0xff):0),v&0xff

ADCA #!v :: v>0xff||v<0;3 :: 0x89,v&0xff
ADCA [[!v]],X :: v>0xff||v<0;2 :: 0xA9,v&0xff
ADCA <!v :: v>0xff||v<0;2 :: 0x99,v&0xff
ADCA >!v :: v>0xffff||v<0;2 :: 0xB9,(v>>8)&0xff,v&0xff
ADCA !v :: :: (v>0xff)?0xB9:0x99,;((v>0xff)?((v>>8)&0xff):0),v&0xff

ORAA #!v :: v>0xff||v<0;3 :: 0x8A,v&0xff
ORAA [[!v]],X :: v>0xff||v<0;2 :: 0xAA,v&0xff
ORAA <!v :: v>0xff||v<0;2 :: 0x9A,v&0xff
ORAA >!v :: v>0xffff||v<0;2 :: 0xBA,(v>>8)&0xff,v&0xff
ORAA !v :: :: (v>0xff)?0xBA:0x9A,;((v>0xff)?((v>>8)&0xff):0),v&0xff

ADDA #!v :: v>0xff||v<0;3 :: 0x8B,v&0xff
ADDA [[!v]],X :: v>0xff||v<0;2 :: 0xAB,v&0xff
ADDA <!v :: v>0xff||v<0;2 :: 0x9B,v&0xff
ADDA >!v :: v>0xffff||v<0;2 :: 0xBB,(v>>8)&0xff,v&0xff
ADDA !v :: :: (v>0xff)?0xBB:0x9B,;((v>0xff)?((v>>8)&0xff):0),v&0xff

