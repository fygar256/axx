/* ---------- 16-bit group: CPX / LDS / STS / LDX / STX ---------- */
CPX #!v :: v>0xffff||v<0;3 :: 0x8C,(v>>8)&0xff,v&0xff
CPX [[!v]],X :: v>0xff||v<0;2 :: 0xAC,v&0xff
CPX <!v :: v>0xff||v<0;2 :: 0x9C,v&0xff
CPX >!v :: v>0xffff||v<0;2 :: 0xBC,(v>>8)&0xff,v&0xff
CPX !v :: :: (v>0xff)?0xBC:0x9C,;((v>0xff)?((v>>8)&0xff):0),v&0xff

LDS #!v :: v>0xffff||v<0;3 :: 0x8E,(v>>8)&0xff,v&0xff
LDS [[!v]],X :: v>0xff||v<0;2 :: 0xAE,v&0xff
LDS <!v :: v>0xff||v<0;2 :: 0x9E,v&0xff
LDS >!v :: v>0xffff||v<0;2 :: 0xBE,(v>>8)&0xff,v&0xff
LDS !v :: :: (v>0xff)?0xBE:0x9E,;((v>0xff)?((v>>8)&0xff):0),v&0xff

STS [[!v]],X :: v>0xff||v<0;2 :: 0xAF,v&0xff
STS <!v :: v>0xff||v<0;2 :: 0x9F,v&0xff
STS >!v :: v>0xffff||v<0;2 :: 0xBF,(v>>8)&0xff,v&0xff
STS !v :: :: (v>0xff)?0xBF:0x9F,;((v>0xff)?((v>>8)&0xff):0),v&0xff

LDX #!v :: v>0xffff||v<0;3 :: 0xCE,(v>>8)&0xff,v&0xff
LDX [[!v]],X :: v>0xff||v<0;2 :: 0xEE,v&0xff
LDX <!v :: v>0xff||v<0;2 :: 0xDE,v&0xff
LDX >!v :: v>0xffff||v<0;2 :: 0xFE,(v>>8)&0xff,v&0xff
LDX !v :: :: (v>0xff)?0xFE:0xDE,;((v>0xff)?((v>>8)&0xff):0),v&0xff

STX [[!v]],X :: v>0xff||v<0;2 :: 0xEF,v&0xff
STX <!v :: v>0xff||v<0;2 :: 0xDF,v&0xff
STX >!v :: v>0xffff||v<0;2 :: 0xFF,(v>>8)&0xff,v&0xff
STX !v :: :: (v>0xff)?0xFF:0xDF,;((v>0xff)?((v>>8)&0xff):0),v&0xff

/* ---------- assembler pseudo-ops for data definition ---------- */
/* One pattern per element count, deliberately NOT using the
   comma-optional-group trick used elsewhere, because a real data
   byte/word of value 0 must never be suppressed, and the suppression
   idiom cannot distinguish "slot absent" from "slot present with
   value 0" for an arbitrary data list. The 0x100| flag on every
   element after the first forces emission even when the value is 0. */
FCB !v :: :: v&0xff
FCB !v,!w :: :: v&0xff,0x100|(w&0xff)
FCB !v,!w,!x :: :: v&0xff,0x100|(w&0xff),0x100|(x&0xff)
FCB !v,!w,!x,!y :: :: v&0xff,0x100|(w&0xff),0x100|(x&0xff),0x100|(y&0xff)
FCB !v,!w,!x,!y,!z :: :: v&0xff,0x100|(w&0xff),0x100|(x&0xff),0x100|(y&0xff),0x100|(z&0xff)
FCB !v,!w,!x,!y,!z,!i :: :: v&0xff,0x100|(w&0xff),0x100|(x&0xff),0x100|(y&0xff),0x100|(z&0xff),0x100|(i&0xff)
FCB !v,!w,!x,!y,!z,!i,!j :: :: v&0xff,0x100|(w&0xff),0x100|(x&0xff),0x100|(y&0xff),0x100|(z&0xff),0x100|(i&0xff),0x100|(j&0xff)
FCB !v,!w,!x,!y,!z,!i,!j,!k :: :: v&0xff,0x100|(w&0xff),0x100|(x&0xff),0x100|(y&0xff),0x100|(z&0xff),0x100|(i&0xff),0x100|(j&0xff),0x100|(k&0xff)
FDB !v :: :: (v>>8)&0xff,v&0xff
FDB !v,!w :: :: (v>>8)&0xff,0x100|(v&0xff),0x100|((w>>8)&0xff),0x100|(w&0xff)
FDB !v,!w,!x :: :: (v>>8)&0xff,0x100|(v&0xff),0x100|((w>>8)&0xff),0x100|(w&0xff),0x100|((x>>8)&0xff),0x100|(x&0xff)
FDB !v,!w,!x,!y :: :: (v>>8)&0xff,0x100|(v&0xff),0x100|((w>>8)&0xff),0x100|(w&0xff),0x100|((x>>8)&0xff),0x100|(x&0xff),0x100|((y>>8)&0xff),0x100|(y&0xff)
RMB !n :: n<0;2 :: @@[n,0x00]
