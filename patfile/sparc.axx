.elftype::tls_le_lox10::73::4
.elftype::gotdata_hix22::80::4
.elftype::gotdata_lox10::81::4

/* The fields, in the big-endian instruction word. The branch fields
/* count words (shift 2), which RELA itself does not use but the
/* resolution below does. */
.elffield::wdisp30::0x3fffffff::0::2
.elffield::wdisp22::0x3fffff::0::2
.elffield::wdisp19::0x7ffff::0::2
.elffield::wdisp16::0x303fff::0::2
/* A call or branch to a local label of the same section is resolved
/* here, with no relocation, as GNU as and llvm-mc do (manual 3.7.7):
/* the object then links with ld.lld, which cannot apply WDISP22 /
/* WDISP19 / WDISP16. A global or weak target keeps its relocation. */
.elfresolve::wdisp30
.elfresolve::wdisp22
.elfresolve::wdisp19
.elfresolve::wdisp16
.elffield::r13::0x1fff
.elffield::got13::0x1fff
.elffield::l44::0xfff
!def F22(ty) {
.elffield::!{ty}::0x3fffff
}
!def F10(ty) {
.elffield::!{ty}::0x3ff
}
!F22("hi22")
!F22("r22")
!F22("got22")
!F22("pc22")
