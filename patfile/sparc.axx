/* compares: nm [%fccN,] rs1, rs2 (%fcc0 when no cc is written) */
!def FCMP(nm, opf, t) {
!P2(nm, opf, t, t, "c")
!P2(nm, opf, t, t, "")
}
!FCMP("FCMPS", 0x051, "s")
