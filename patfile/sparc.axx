/* movr and fmovr: rcond on the value of rs1 */
!def MR(nm, c) {
!local b = 0x81780000 | (c << 10)
!Z("MOVR" + nm, "ra,rb,rd", "", b, "|(rd<<25)|(ra<<14)|rb")
!Z("MOVR" + nm, "ra,!v,rd", "v<-512||v>511;3", b, "|(rd<<25)|(ra<<14)|0x2000|(v&0x3ff)")
!local f = 0x81a80000 | (c << 10)
!Z("FMOVRS" + nm, "ra,sb,sd", "", f | (5 << 5), "|(sd<<25)|(ra<<14)|sb")
!Z("FMOVRD" + nm, "ra,db,dd", "", f | (6 << 5), "|(dd<<25)|(ra<<14)|db")
!Z("FMOVRQ" + nm, "ra,qb,qd", "", f | (7 << 5), "|(qd<<25)|(ra<<14)|qb")
}
!MR("Z", 1)
!MR("E", 1)
!MR("LEZ", 2)
!MR("LZ", 3)
!MR("NZ", 5)
!MR("NE", 5)
!MR("GZ", 6)
!MR("GEZ", 7)

/* ===================================================================
/* Loads and stores
/* =================================================================== */
/* integer: nm [address],rd (loads) and nm rd,[address] (stores); ev
/* asks for an even register (ldd / std); a = 1 is the alternate
/* space form */
!def LG(nm, op3, ev) {
!local x = ""
!if ev !then {
!set x = "rd&1;5"
}
!MA(nm, "", ",rd", 0xc0000000 | (op3 << 19), "|(rd<<25)", x)
}
!def SG(nm, op3, ev) {
!local x = ""
!if ev !then {
!set x = "rd&1;5"
}
!MA(nm, "rd,", "", 0xc0000000 | (op3 << 19), "|(rd<<25)", x)
}
!def LGA(nm, op3, ev) {
!local x = ""
!if ev !then {
!set x = "rd&1;5"
}
!MAA(nm, "", ",rd", 0xc0000000 | (op3 << 19), "|(rd<<25)", x)
}
!def SGA(nm, op3, ev) {
!local x = ""
!if ev !then {
!set x = "rd&1;5"
}
!MAA(nm, "rd,", "", 0xc0000000 | (op3 << 19), "|(rd<<25)", x)
}
!LG("LD", 0x00, 0)
!LG("LDUW", 0x00, 0)
!LG("LDUB", 0x01, 0)
