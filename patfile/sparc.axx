.elfwidth::8::r64
.elfwidth::4::r32
.elfwidth::2::r16
.elfwidth::1::r8
.elfextern::r64
.elfdwarf::r64
/* Data written as label-$$, or as a label minus a label of the section
/* being assembled (word ext-$$, xword ext-dat), is PC-relative:
/* R_SPARC_DISP8 / DISP16 / DISP32 / DISP64 (manual 3.7.9). */
.elfpcguess::1

/* ===================================================================
/* Registers and names
/* =================================================================== */
!def setr(p, n, b) {
!local i = 0
!while i < n {
.setsym::!{p}!{i}::!{b + i}
!set i = i + 1
}
}
!setr("%G", 8, 0)
!setr("%O", 8, 8)
!setr("%L", 8, 16)
!setr("%I", 8, 24)
!setr("%R", 32, 0)
.setsym::%SP::14
.setsym::%FP::30

/* %f0-%f31 hold their number; the even %f32-%f62 fold bit 5 into
/* bit 0 (the V9 encoding of a double / quad register) */
!def fregs() {
!local i = 0
!while i < 64 {
!if i < 32 !then {
.setsym::%F!{i}::!{i}
} !elif (i & 1) == 0 !then {
.setsym::%F!{i}::!{(i & 30) | 1}
}
!set i = i + 1
}
}
!fregs()
!setr("%C", 32, 0)

/* lst(p, a, n, s): the list "p<a>,p<a+s>,..." of n names */
!def lst(p, a, n, s) {
!local r = ""
!local i = 0
!while i < n {
!if i > 0 !then {
!set r = r + ","
}
!set r = r + p + str(a + i * s)
!set i = i + 1
}
!return r
}
.setsym::R_GPR::!{lst("%G", 0, 8, 1)},!{lst("%O", 0, 8, 1)},!{lst("%L", 0, 8, 1)},!{lst("%I", 0, 8, 1)},!{lst("%R", 0, 32, 1)},%SP,%FP
.setsym::R_FPS::!{lst("%F", 0, 32, 1)}
.setsym::R_FPD::!{lst("%F", 0, 32, 2)}
.setsym::R_FPQ::!{lst("%F", 0, 16, 4)}
.setsym::R_CPR::!{lst("%C", 0, 32, 1)}

/* condition codes: the value is the cc2:cc1:cc0 of movcc and the
/* opf_cc of fmovcc; the low two bits are the cc1:cc0 of BPcc, FBPfcc,
/* Tcc and fcmp */
.setsym::%ICC::4
.setsym::%XCC::6
!setr("%FCC", 4, 0)
.setsym::R_ICC::%ICC,%XCC
.setsym::R_FCC::!{lst("%FCC", 0, 4, 1)}
.setsym::R_ANYCC::R_ICC,R_FCC

/* ancillary state registers (rd / wr) */
!setr("%ASR", 32, 0)
.setsym::%Y::0
.setsym::%CCR::2
.setsym::%ASI::3
.setsym::%TICK::4
.setsym::%PC::5
.setsym::%FPRS::6
.setsym::%PCR::16
.setsym::%PIC::17
.setsym::%DCR::18
.setsym::%GSR::19
.setsym::%SET_SOFTINT::20
.setsym::%SOFTINT_SET::20
.setsym::%CLEAR_SOFTINT::21
.setsym::%SOFTINT_CLR::21
.setsym::%SOFTINT::22
.setsym::%TICK_CMPR::23
.setsym::%STICK::24
.setsym::%SYS_TICK::24
.setsym::%STICK_CMPR::25
.setsym::%SYS_TICK_CMPR::25
.setsym::R_ASR::!{lst("%ASR", 0, 32, 1)},%Y,%CCR,%ASI,%TICK,%PC,%FPRS,%PCR,%PIC,%DCR,%GSR,%SET_SOFTINT,%SOFTINT_SET,%CLEAR_SOFTINT,%SOFTINT_CLR,%SOFTINT,%TICK_CMPR,%STICK,%SYS_TICK,%STICK_CMPR,%SYS_TICK_CMPR

/* privileged registers (rdpr / wrpr) */
.setsym::%TPC::0
.setsym::%TNPC::1
.setsym::%TSTATE::2
.setsym::%TT::3
.setsym::%TBA::5
.setsym::%PSTATE::6
.setsym::%TL::7
.setsym::%PIL::8
.setsym::%CWP::9
.setsym::%CANSAVE::10
.setsym::%CANRESTORE::11
.setsym::%CLEANWIN::12
.setsym::%OTHERWIN::13
.setsym::%WSTATE::14
.setsym::%FQ::15
.setsym::%GL::16
.setsym::%VER::31
.setsym::R_PR::%TPC,%TNPC,%TSTATE,%TT,%TICK,%TBA,%PSTATE,%TL,%PIL,%CWP,%CANSAVE,%CANRESTORE,%CLEANWIN,%OTHERWIN,%WSTATE,%FQ,%GL,%VER

/* hyperprivileged registers (rdhpr / wrhpr) */
.setsym::%HPSTATE::0
.setsym::%HTSTATE::1
.setsym::%HINTP::3
.setsym::%HTBA::5
.setsym::%HVER::6
.setsym::%HSTICK_CMPR::31
.setsym::%HSYS_TICK_CMPR::31
.setsym::R_HPR::%HPSTATE,%HTSTATE,%HINTP,%HTBA,%HVER,%HSTICK_CMPR,%HSYS_TICK_CMPR

/* the variables of the register classes
/*   ra rb rd rt   integer rs1 rs2 rd, and the setx temporary
/*   sa sb sc sd   single precision rs1 rs2 rs3 rd
/*   da db dc dd   double precision
/*   qa qb qd      quad precision
/*   ic            %icc / %xcc        fc  %fcc0-%fcc3
/*   mc            any of them (movcc, fmovcc)
/*   ar pr hr      ASR, privileged and hyperprivileged registers
/*   cd            coprocessor register */
.check::ra::R_GPR
.check::rb::R_GPR
.check::rd::R_GPR
.check::rt::R_GPR
.check::sa::R_FPS
.check::sb::R_FPS
.check::sc::R_FPS
.check::sd::R_FPS
.check::da::R_FPD
.check::db::R_FPD
.check::dc::R_FPD
.check::dd::R_FPD
.check::qa::R_FPQ
.check::qb::R_FPQ
.check::qd::R_FPQ
.check::ic::R_ICC
.check::fc::R_FCC
.check::mc::R_ANYCC
.check::ar::R_ASR
.check::pr::R_PR
.check::hr::R_HPR
.check::cd::R_CPR

/* membar masks, prefetch functions and ASI names (read with #) */
.setsym::LOADLOAD::0x01
.setsym::STORELOAD::0x02
.setsym::LOADSTORE::0x04
.setsym::STORESTORE::0x08
.setsym::LOOKASIDE::0x10
.setsym::MEMISSUE::0x20
.setsym::SYNC::0x40
.setsym::N_READS::0
.setsym::ONE_READ::1
.setsym::N_WRITES::2
.setsym::ONE_WRITE::3
.setsym::PAGE::4
.setsym::UNIFIED::17
.setsym::N_READS_STRONG::20
.setsym::ONE_READ_STRONG::21
.setsym::N_WRITES_STRONG::22
.setsym::ONE_WRITE_STRONG::23
!def asi(n, v) {
.setsym::ASI_!{n}::!{v}
}
