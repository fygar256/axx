/* prefetch [address], fcn and prefetcha [address] asi, fcn */
!MA("PREFETCH", "", ",!fn", 0xc1680000, "|((fn&31)<<25)", "fn<0||fn>31;3")
!MAA("PREFETCHA", "", ",!fn", 0xc1e80000, "|((fn&31)<<25)", "fn<0||fn>31;3")

/* compare and swap: casa [rs1] asi, rs2, rd and casxa, with the ASI
/* in the instruction or (i = 1) from %asi; cas / casl / casx / casxl
/* use ASI_P / ASI_PL */
!def CAS(nm, op3) {
!local b = 0xc0000000 | (op3 << 19)
!Z(nm, "[ra]!w,rb,rd", EASI(), b, "|(rd<<25)|(ra<<14)|((w&0xff)<<5)|rb")
!Z(nm, "[ra]%ASI,rb,rd", "", b, "|(rd<<25)|(ra<<14)|0x2000|rb")
}
!CAS("CASA", 0x3c)
!CAS("CASXA", 0x3e)
!Z("CAS", "[ra],rb,rd", "", 0xc1e01000, "|(rd<<25)|(ra<<14)|rb")
!Z("CASL", "[ra],rb,rd", "", 0xc1e01100, "|(rd<<25)|(ra<<14)|rb")
!Z("CASX", "[ra],rb,rd", "", 0xc1f01000, "|(rd<<25)|(ra<<14)|rb")
!Z("CASXL", "[ra],rb,rd", "", 0xc1f01100, "|(rd<<25)|(ra<<14)|rb")

/* ===================================================================
/* Floating point operate (FPop1, FPop2)
/* =================================================================== */
/* OPF(nm, base, opf, a, b, d): the operand classes of rs1, rs2 and rd:
/*   "s" "d" "q"  single / double / quad register
/*   "r"          integer register
/*   "c"          %fcc0-%fcc3 in rd (written first, as fcmp does)
/*   ""           the field is 0 and there is no operand */
!def OPF(nm, base, opf, a, b, d) {
!local ops = ""
!local fx = ""
!if d == "c" !then {
!set ops = "fc"
!set fx = "|((fc&3)<<25)"
}
!if a != "" !then {
!if ops != "" !then {
!set ops = ops + ","
}
!set ops = ops + a + "a"
!set fx = fx + "|(" + a + "a<<14)"
}
!if b != "" !then {
!if ops != "" !then {
!set ops = ops + ","
}
!set ops = ops + b + "b"
!set fx = fx + "|" + b + "b"
}
!if d != "" && d != "c" !then {
!if ops != "" !then {
!set ops = ops + ","
}
!set ops = ops + d + "d"
!set fx = fx + "|(" + d + "d<<25)"
}
!Z(nm, ops, "", base | (opf << 5), fx)
}
!def P1(nm, opf, a, b, d) {
!OPF(nm, 0x81a00000, opf, a, b, d)
}
!def P2(nm, opf, a, b, d) {
!OPF(nm, 0x81a80000, opf, a, b, d)
}
!P1("FMOVS", 0x001, "", "s", "s")
!P1("FMOVD", 0x002, "", "d", "d")
!P1("FMOVQ", 0x003, "", "q", "q")
