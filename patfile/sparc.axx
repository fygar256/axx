!V("FANDNOT2S", 0x065, "s", "s", "s")
!V("FNOT2", 0x066, "", "d", "d")
!V("FNOT2S", 0x067, "", "s", "s")
!V("FANDNOT1", 0x068, "d", "d", "d")
!V("FANDNOT1S", 0x069, "s", "s", "s")
!V("FNOT1", 0x06a, "d", "", "d")
!V("FNOT1S", 0x06b, "s", "", "s")
!V("FXOR", 0x06c, "d", "d", "d")
!V("FXORS", 0x06d, "s", "s", "s")
!V("FNAND", 0x06e, "d", "d", "d")
!V("FNANDS", 0x06f, "s", "s", "s")
!V("FAND", 0x070, "d", "d", "d")
!V("FANDS", 0x071, "s", "s", "s")
!V("FXNOR", 0x072, "d", "d", "d")
!V("FXNORS", 0x073, "s", "s", "s")
!V("FSRC1", 0x074, "d", "", "d")
!V("FSRC1S", 0x075, "s", "", "s")
!V("FORNOT2", 0x076, "d", "d", "d")
!V("FORNOT2S", 0x077, "s", "s", "s")
!V("FSRC2", 0x078, "", "d", "d")
!V("FSRC2S", 0x079, "", "s", "s")
!V("FORNOT1", 0x07a, "d", "d", "d")
!V("FORNOT1S", 0x07b, "s", "s", "s")
!V("FOR", 0x07c, "d", "d", "d")
!V("FORS", 0x07d, "s", "s", "s")
!V("FONE", 0x07e, "", "", "d")
!V("FONES", 0x07f, "", "", "s")
!V("SHUTDOWN", 0x080, "", "", "")
!Z("SIAM", "!v", "v<0||v>7;3", 0x81b01020, "|(v&7)")
!V("MOVDTOX", 0x110, "", "d", "r")
!V("MOVSTOUW", 0x111, "", "s", "r")
!V("MOVSTOSW", 0x113, "", "s", "r")
!V("XMULX", 0x115, "r", "r", "r")
!V("XMULXHI", 0x116, "r", "r", "r")
!V("MOVXTOD", 0x118, "", "r", "d")
!V("MOVWTOS", 0x119, "", "r", "s")
!V("FUCMPLE8", 0x120, "d", "d", "r")
!V("FUCMPNE8", 0x122, "d", "d", "r")
!V("FUCMPGT8", 0x128, "d", "d", "r")
!V("FUCMPEQ8", 0x12a, "d", "d", "r")
!V("FLCMPS", 0x151, "s", "s", "c")
!V("FLCMPD", 0x152, "d", "d", "c")

/* V8 coprocessor operate: cpop1 / cpop2 opc, %c rs1, %c rs2, %c rd */
!def CPOP(nm, op3) {
!Z(nm, "!v,ca,cb,cd", "v<0||v>511;3", 0x80000000 | (op3 << 19), "|(cd<<25)|(ca<<14)|((v&0x1ff)<<5)|cb")
}
.check::ca::R_CPR
.check::cb::R_CPR
!CPOP("CPOP1", 0x36)
!CPOP("CPOP2", 0x37)

/* ===================================================================
/* State registers and control
/* =================================================================== */
/* rd %asr, rd and wr rs1, reg_or_imm, %asr (also wr rs2, %asr) */
!Z("RD", "ar,rd", "", 0x81400000, "|(rd<<25)|(ar<<14)")
!RI("WR", "ra,", ",ar", 0x81800000, "|(ar<<25)|(ra<<14)")
!Z("WR", "rb,ar", "", 0x81800000, "|(ar<<25)|rb")
/* V8: %psr %wim %tbr */
!Z("RD", "%PSR,rd", "", 0x81480000, "|(rd<<25)")
!Z("RD", "%WIM,rd", "", 0x81500000, "|(rd<<25)")
!Z("RD", "%TBR,rd", "", 0x81580000, "|(rd<<25)")
!RI("WR", "ra,", ",%PSR", 0x81880000, "|(ra<<14)")
!RI("WR", "ra,", ",%WIM", 0x81900000, "|(ra<<14)")
!RI("WR", "ra,", ",%TBR", 0x81980000, "|(ra<<14)")
!Z("WR", "rb,%PSR", "", 0x81880000, "|rb")
!Z("WR", "rb,%WIM", "", 0x81900000, "|rb")
!Z("WR", "rb,%TBR", "", 0x81980000, "|rb")
/* LEON: pwr rs1, reg_or_imm, %psr (wr %psr with the power-down bit) */
!RI("PWR", "ra,", ",%PSR", 0x83880000, "|(ra<<14)")
/* V9: rdpr / wrpr */
!Z("RDPR", "pr,rd", "", 0x81500000, "|(rd<<25)|(pr<<14)")
!RI("WRPR", "ra,", ",pr", 0x81900000, "|(pr<<25)|(ra<<14)")
!Z("WRPR", "ra,pr", "", 0x81900000, "|(pr<<25)|(ra<<14)")
/* UltraSPARC Architecture 2005: rdhpr / wrhpr */
!Z("RDHPR", "hr,rd", "", 0x81480000, "|(rd<<25)|(hr<<14)")
!RI("WRHPR", "ra,", ",hr", 0x81980000, "|(hr<<25)|(ra<<14)")
!Z("WRHPR", "ra,hr", "", 0x81980000, "|(hr<<25)|(ra<<14)")

/* membar mask (7 bits), stbar, sir */
!Z("MEMBAR", "!v", "v<0||v>127;3", 0x8143e000, "|(v&0x7f)")
STBAR :: .call w4(0x8143c000)
!Z("SIR", "!v", ES13(), 0x9f802000, "|(v&0x1fff)")

/* flush address (also iflush), flush alone, flushw */
!AD("FLUSH", "", "", 0x81d80000, "", "", 1)
!AD("IFLUSH", "", "", 0x81d80000, "", "", 1)
FLUSH :: .call w4(0x81d80000)
FLUSHW :: .call w4(0x81580000)

/* register windows and traps */
SAVED :: .call w4(0x81880000)
RESTORED :: .call w4(0x83880000)
ALLCLEAN :: .call w4(0x85880000)
OTHERW :: .call w4(0x87880000)
NORMALW :: .call w4(0x89880000)
INVALW :: .call w4(0x8b880000)
DONE :: .call w4(0x81f00000)
RETRY :: .call w4(0x83f00000)
ILLTRAP !v :: v<0||v>0x3fffff;3 :: .call w4(v&0x3fffff)
UNIMP !v :: v<0||v>0x3fffff;3 :: .call w4(v&0x3fffff)

/* ===================================================================
/* Synthetic instructions (SPARC V9 manual appendix G, GNU as, llvm-mc)
/* =================================================================== */
/* cmp rs1, reg_or_imm = subcc rs1, x, %g0; tst rs1 = orcc rs1, %g0, %g0
/* (the form of GNU as and llvm-mc) */
!RI("CMP", "ra,", "", 0x80a00000, "|(ra<<14)")
!Z("TST", "ra", "", 0x80900000, "|(ra<<14)")
/* mov reg_or_imm, rd = or %g0, x, rd; mov %asr, rd; mov rs2, %asr */
!RI("MOV", "", ",rd", 0x80100000, "|(rd<<25)")
!Z("MOV", "ar,rd", "", 0x81400000, "|(rd<<25)|(ar<<14)")
!Z("MOV", "rb,ar", "", 0x81800000, "|(ar<<25)|rb")
/* clr rd, not, neg, signx, clruw */
!Z("CLR", "rd", "", 0x80100000, "|(rd<<25)")
!Z("NOT", "ra,rd", "", 0x80380000, "|(rd<<25)|(ra<<14)")
!Z("NOT", "rd", "", 0x80380000, "|(rd<<25)|(rd<<14)")
!Z("NEG", "rb,rd", "", 0x80200000, "|(rd<<25)|rb")
!Z("NEG", "rd", "", 0x80200000, "|(rd<<25)|rd")
!Z("SIGNX", "ra,rd", "", 0x81380000, "|(rd<<25)|(ra<<14)")
!Z("SIGNX", "rd", "", 0x81380000, "|(rd<<25)|(rd<<14)")
!Z("CLRUW", "ra,rd", "", 0x81300000, "|(rd<<25)|(ra<<14)")
!Z("CLRUW", "rd", "", 0x81300000, "|(rd<<25)|(rd<<14)")
/* inc / inccc / dec / deccc [const13,] rd */
!def INC(nm, op3) {
!local b = 0x80002000 | (op3 << 19)
!Z(nm, "rd", "", b, "|(rd<<25)|(rd<<14)|1")
!I13(nm, "", ",rd", b & 0xffffdfff, "|(rd<<25)|(rd<<14)", ES13(), "")
}
!INC("INC", 0x00)
!INC("INCCC", 0x10)
!INC("DEC", 0x04)
!INC("DECCC", 0x14)
/* btst reg_or_imm, rs1 = andcc rs1, x, %g0; bset / bclr / btog
/* reg_or_imm, rd = or / andn / xor rd, x, rd */
!RI("BTST", "", ",ra", 0x80880000, "|(ra<<14)")
!RI("BSET", "", ",rd", 0x80100000, "|(rd<<25)|(rd<<14)")
!RI("BCLR", "", ",rd", 0x80280000, "|(rd<<25)|(rd<<14)")
!RI("BTOG", "", ",rd", 0x80180000, "|(rd<<25)|(rd<<14)")
/* set / setuw / setsw / setx. With a label the words are the fixed
/* form, and under -o they carry R_SPARC_HI22 + LO10 (set, setuw, setsw)
/* or HI22 + LO10 + HH22 + HM10 (setx) against the symbol with its
/* addend (the extra relocations of .reloc), as GNU as and llvm-mc do */
.reloc::v::hi22::::lo10@4
SET !v,rd :: .call setuw(rd,v,.islabel(v))
SETUW !v,rd :: .call setuw(rd,v,.islabel(v))
SETSW !v,rd :: .call setsw(rd,v,.islabel(v))
.reloc::v::hi22::::lo10@4,hh22@8,hm10@12
SETX !v,rt,rd :: .call setx(rd,rt,v,.islabel(v))
.clrreloc::v

/* ===================================================================
/* Data (big-endian)
/* =================================================================== */
BYTE !v :: v
HALF !v :: v>>8,v
WORD !v :: v>>24,v>>16,v>>8,v
XWORD !v :: v>>56,v>>48,v>>40,v>>32,v>>24,v>>16,v>>8,v
NWORD !v :: v>>56,v>>48,v>>40,v>>32,v>>24,v>>16,v>>8,v
SINGLE !Fv :: v>>24,v>>16,v>>8,v
FLOAT !Fv :: v>>24,v>>16,v>>8,v
DOUBLE !Dv :: v>>56,v>>48,v>>40,v>>32,v>>24,v>>16,v>>8,v
