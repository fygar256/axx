/* fmovcc: opf_cc = the cc value (fcc0-3, icc 4, xcc 6), opf_low
/* 1 / 2 / 3 for s / d / q */
!def FMV(nm, c, cv) {
!local b = 0x81a80000 | (c << 14)
!local f = "|((" + cv + "&7)<<11)"
!Z("FMOVS" + nm, cv + ",sb,sd", "", b | (1 << 5), f + "|(sd<<25)|sb")
!Z("FMOVD" + nm, cv + ",db,dd", "", b | (2 << 5), f + "|(dd<<25)|db")
!Z("FMOVQ" + nm, cv + ",qb,qd", "", b | (3 << 5), f + "|(qd<<25)|qb")
}
!def FMVI(nm, c) {
!FMV(nm, c, "ic")
}
!def FMVF(nm, c) {
!FMV(nm, c, "fc")
}
