/* fused multiply-add (IMPDEP2, SPARC64 VI / OSA 2011):
/* nm rs1, rs2, rs3, rd -- rd = rs1 * rs2 +- rs3 */
!def FMA(nm, op5, t) {
!Z(nm, t + "a," + t + "b," + t + "c," + t + "d", "", 0x81b80000 | (op5 << 5), "|(" + t + "d<<25)|(" + t + "a<<14)|(" + t + "c<<9)|" + t + "b")
}
