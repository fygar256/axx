/* ===================================================================
/* sparc.axx -- SPARC (V7 / V8 / V9, VIS 1-3) pattern file for axx
/*
/* Assemble with:
/*   axx sparc.axx prog.s -b out.bin       (a flat binary)
/*   axx sparc.axx prog.s -o out.o         (an ELF64 SPARCV9 object)
/*
/* The syntax is that of GNU as and llvm-mc (the Sun / SPARC
/* International assembly language): registers with a %, the
/* destination last, addresses in brackets ([%o0+8], [%o0+%o1],
/* [%o0-8], [%o0], [100]), annulled and predicted branches written
/* with suffixes (bne,a,pn %xcc, label). Nothing is put into a delay
/* slot on its own: write the delay slot yourself. A comment starts
/* with ';' (as in every axx source), not with '!'.
/*
/* Coverage
/*   Integer      add sub and andn or orn xor xnor and their cc forms,
/*                addx / addc / subx / subc and the cc forms (addxcc
/*                addccc subxcc subccc), tagged add / sub (taddcc
/*                tsubcc taddcctv tsubcctv), mulscc, umul smul umulcc
/*                smulcc, udiv sdiv udivcc sdivcc, mulx sdivx udivx,
/*                popc, the 32-bit and 64-bit shifts (sll srl sra
/*                sllx srlx srax), sethi, save / restore (also with no
/*                operands), the LEON umac / smac
/*   Every 13-bit immediate and every displacement from a base
/*   register ([%o0+%lo(sym)], jmpl %g1+%lo(sym)) takes the operand
/*   modifiers %lo %hm %ulo %m44 %l44 %lox %pc10 %got10 %got13
/*   %tgd_lo10 %tldm_lo10 %tldo_lox10 %tie_lo10 %tle_lox10
/*   %gdop_lox10, and sethi takes %hi %hh %uhi %lm %h44 %hix %pc22
/*   %got22 %tgd_hi22 %tldm_hi22 %tldo_hix22 %tie_hi22 %tle_hix22
/*   %gdop_hix22. An address with no base register ([100]) and the
/*   alternate space forms ([%o0+8] %asi) take a plain immediate.
/*   Branches     Bicc (ba bn bne bnz be bz bg ble bge bl bgu bleu bcc
/*                bgeu bcs blu bpos bneg bvc bvs, and b), the V9 BPcc
/*                with %icc / %xcc, FBfcc and the V9 FBPfcc with
/*                %fcc0-%fcc3, BPr (brz brlez brlz brnz brgz brgez and
/*                bre brne), the V8 coprocessor branches (cba ... cb012),
/*                all of them with ",a" and the V9 ones with ",pt" /
/*                ",pn" (",pt" when neither is written); call, jmpl,
/*                return, rett, the trap Tcc (ta ... tvs, with %icc /
/*                %xcc), iprefetch
/*   Conditional  movcc on %icc / %xcc / %fcc0-%fcc3 (mova ... movo,
/*   moves        with the integer and the floating point condition
/*                names), movr (movrz ... movrgez, movre, movrne),
/*                fmovs / fmovd / fmovq cc and fmovr{s,d,q}
/*   Load / store every integer load and store (ld lduw ldub lduh ldsb
/*                ldsh ldsw ldx ldd ldtw st stw stuw stsw stb stub stsb
/*                sth stuh stsh stx std sttw), ldstub, swap, the
/*                alternate space forms with an ASI number or name
/*                ([%o0+%o1] #ASI_P) or %asi ([%o0+8] %asi), casa /
/*                casxa and cas casl casx casxl, prefetch / prefetcha
/*                with the function names (#n_reads ... #one_write_strong)
/*   FPU          the floating point loads and stores (ld ldd ldq st std
/*                stq, the alternate forms lda ldda ldqa sta stda stqa),
/*                ld / ldx / st / stx of %fsr, every FPop1 and FPop2:
/*                fmov fneg fabs fsqrt fadd fsub fmul fdiv in s d q,
/*                fsmuld fdmulq, every conversion (fitos ... fqtox),
/*                fcmp / fcmpe in s d q with an optional %fcc, the
/*                UltraSPARC Architecture 2007 fnadd fnmul fhadd fhsub
/*                fnhadd fnsmuld, and the fused multiply-add of
/*                SPARC64 VI / Oracle SPARC Architecture 2011 (fmadd
/*                fmsub fnmsub fnmadd in s d)
/*   Registers    rd / wr of %y %ccr %asi %tick %pc %fprs %asr0-%asr31
/*   and control  and their names (%pcr %pic %dcr %gsr %set_softint
/*                %clear_softint %softint %tick_cmpr %stick %stick_cmpr
/*                ...), rdpr / wrpr of every privileged register, the
/*                V8 rd / wr of %psr %wim %tbr, the UltraSPARC
/*                Architecture 2005 rdhpr / wrhpr, membar (with the
/*                #LoadLoad ... #Sync names), stbar, flush / iflush,
/*                flushw, saved / restored / allclean / otherw /
/*                normalw / invalw, done / retry, sir, illtrap / unimp,
/*                the LEON pwr
/*   VIS          VIS 1, 2 and 3: edge*, array*, alignaddr(l),
/*                faligndata, the partitioned arithmetic, compares,
/*                multiplies, pack / expand / merge, pdist(n), the 64
/*                logical operations, fsrc / fnot / fzero / fone,
/*                bmask / bshuffle, siam, shutdown, cmask*, fmean16,
/*                fchksm16, fpadd64 / fpsub64, the saturating fpadds /
/*                fpsubs, the partitioned shifts, fucmp*8, flcmps /
/*                flcmpd, lzcnt, addxc / addxccc, umulxhi, xmulx /
/*                xmulxhi, movdtox movstouw movstosw movxtod movwtos
/*   V8           the coprocessor: ld / ldd / st / std of %c0-%c31, ld
/*                / st of %csr, std of %cq, cpop1 / cpop2; std of %fq
/*   Synthetic    nop, cmp, tst, mov (also from and to %y and the ASRs),
/*                clr (register and memory: clr clrb clrh clrx), not,
/*                neg, inc / inccc / dec / deccc, btst / bset / bclr /
/*                btog, signx, clruw, jmp, call through a register,
/*                ret, retl, set / setuw / setsw / setx (set, setuw
/*                and setx take the sequences of llvm-mc, setsw that
/*                of the SPARC V9 manual)
/*
/* Registers. %g0-%g7 %o0-%o7 %l0-%l7 %i0-%i7, %r0-%r31, %sp (= %o6)
/* and %fp (= %i6). Floating point: %f0-%f31 for single precision,
/* the even %f0-%f62 for double and %f0, %f4, ... %f60 for quad (V9
/* folds the upper bit of a double / quad register number into bit
/* 0 of the field, as the architecture defines). %fcc0-%fcc3, %icc,
/* %xcc. The coprocessor registers are %c0-%c31.
/*
/* Names. The membar masks (#LoadLoad #StoreLoad #LoadStore
/* #StoreStore #Lookaside #MemIssue #Sync), the prefetch functions
/* (#n_reads #one_read #n_writes #one_write #page #unified
/* #n_reads_strong #one_read_strong #n_writes_strong
/* #one_write_strong) and the ASI names (#ASI_P #ASI_PRIMARY ...)
/* are pattern-file symbols that an expression reads with '#', so they
/* combine like numbers: membar #StoreLoad | #StoreStore. axx does not
/* let an assembly-source label share a name with a symbol, so give
/* labels names that none of these use (such as PAGE or SYNC).
/*
/* Data. BYTE (1 byte), HALF (2), WORD (4), XWORD and NWORD (8),
/* SINGLE / FLOAT and DOUBLE, big-endian.
/*
/* ELF output (-o). An ELF64 object for SPARC V9 (EM_SPARCV9, RELA).
/* Every operand that can hold a symbol carries its relocation type:
/* R_SPARC_WDISP30 (call), WDISP22 (Bicc FBfcc CBccc), WDISP19 (BPcc
/* FBPfcc), WDISP16 (BPr), 13 (a plain 13-bit immediate), 22 (a
/* plain sethi operand), and for the modifiers LO10 HI22 HH22 HM10
/* LM22 H44 M44 L44 HIX22 LOX10 PC10 PC22 GOT10 GOT13 GOT22, the TLS
/* types and GOTDATA_HIX22 / LOX10. BYTE HALF WORD XWORD take 8 16 32
/* and 64. The field is written as 0 and the addend goes in the RELA
/* entry, as GNU as and llvm-mc do. A 32-bit object for the same
/* relocations comes from -f 32 -m 18 (EM_SPARC32PLUS) or -m 2
/* (EM_SPARC).
/*
/* set / setuw / setsw / setx of a label take the fixed form GNU as and
/* llvm-mc write for a symbol (sethi %hi + or %lo, setsw adding sra, and
/* the six words of setx), with R_SPARC_HI22 + LO10 (and HH22 + HM10 for
/* setx) against the symbol and its addend; a number still takes the
/* shortest form. Data written as label-$$ or as a label minus a label
/* of this section takes R_SPARC_DISP8 / 16 / 32 / 64.
/*
/* Differences from llvm-mc, by design
/*   - a plain sethi operand takes R_SPARC_22 (llvm-mc writes
/*     R_SPARC_13, GNU as R_SPARC_22);
/*   - %hix leaves the field 0 where llvm-mc fills it with ones; the
/*     linker writes the whole field either way;
/*   - the VIS operations whose operands are single precision
/*     registers by the architecture (fexpand fpack16 fpackfix fpmerge
/*     fmul8x16 fmul8x16au fmul8x16al fmuld8sux16 fmuld8ulx16 movstouw
/*     movstosw flcmps fnadds fhadds ...) take single precision
/*     register names, where llvm-mc 19 asks for double ones;
/*   - xmulxhi is opf 0x116 and bshuffle 0x04c, as in the architecture
/*     manuals and the GNU opcode table (llvm-mc 19 writes 0x117 and
/*     0x01c);
/*   - a local label is named by its own symbol in a relocation, where
/*     llvm-mc uses the section symbol plus an offset; both link the
/*     same. (A call or branch to a local label of the same section is
/*     resolved, as by llvm-mc; see .elfresolve below.)
/*
/* Not covered: the TLS call / add annotations (add ...,
/* %tgd_add(sym) and the like), the SPARC T4 / M7 crypto and VIS 4
/* instructions, and the impdep1 / impdep2 raw forms.
/*
/* Verification. caxx and axx.py give identical output.
/*   asmsrc/sparc_test.s   every row, about 2400 lines. The rows llvm-mc
/*                         19 has are byte-for-byte identical to
/*                         llvm-mc -triple=sparcv9 -mattr=+vis,+vis2,
/*                         +vis3,+hard-quad-float,+hasumacsmac (the V8
/*                         rows to -triple=sparc), apart from the two
/*                         opf values above; the others (about 110 rows:
/*                         %r names, fpadds / fpsubs, fucmp*8, movxtod /
/*                         movwtos, the 2007 FPop1, fmadd ..., rdhpr /
/*                         wrhpr, allclean ..., cpop1 / cpop2, ldtw /
/*                         sttw, setuw / setsw, clrx / clruw, iprefetch,
/*                         the data rows) were checked against encodings
/*                         written out from the manuals
/*   asmsrc/sparc_reloc.s  every relocating operand against an external
/*                         symbol: the relocation entries (offset, type,
/*                         symbol, addend) and the bytes are those of
/*                         llvm-mc 19
/*   asmsrc/sparc_reloc2.s set / setx of a label, PC-relative data and
/*                         branches to local labels: the bytes and the
/*                         relocation entries are those of llvm-mc 19
/*                         (a local label named by its own symbol), and
/*                         the object links with ld.lld 19
/*   asmsrc/bf_sparc.s     the Brainfuck interpreter, linked with ld.lld
/*                         and run under qemu-sparc64 (bsd-user) with
/*                         mandelbrot.bf: the output is that of bfi.s
/*                         on x86_64
/* The out-of-range errors (immediates, displacements, shift counts,
/* ASIs, trap numbers, branch distances, odd registers for ldd / std)
/* were checked in both implementations.
/* =================================================================== */
.bits::big::8

.error::2::"branch target out of range or not a multiple of 4"
.error::3::"immediate value out of range"
.error::5::"register not allowed here (an even register is required)"
.error::8::"displacement out of range"
.error::10::"shift count out of range"
.error::11::"ASI out of range (0-255)"

/* ===================================================================
/* ELF description
/* =================================================================== */
.elfbuiltin::0
.elfmachine::43::SPARCV9
.elfclass::64
.elfrela::1

/*     name             number  width  pc-relative */
