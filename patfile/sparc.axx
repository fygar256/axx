!MA("STX", "%FSR,", "", 0xc3280000, "", "")

/* V8: the floating point queue and the coprocessor */
!MA("STD", "%FQ,", "", 0xc1300000, "", "")
!MA("LD", "", ",cd", 0xc1800000, "|(cd<<25)", "")
!MA("LDD", "", ",cd", 0xc1980000, "|(cd<<25)", "cd&1;5")
