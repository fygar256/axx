/* clear memory: clr / clrb / clrh / clrx [address] stores %g0 */
!MA("CLR", "", "", 0xc0200000, "", "")
!MA("CLRB", "", "", 0xc0280000, "", "")
!MA("CLRH", "", "", 0xc0300000, "", "")
!MA("CLRX", "", "", 0xc0700000, "", "")

/* floating point: the register class gives the instruction */
!MA("LD", "", ",sd", 0xc1000000, "|(sd<<25)", "")
!MA("LDD", "", ",dd", 0xc1180000, "|(dd<<25)", "")
!MA("LDQ", "", ",qd", 0xc1100000, "|(qd<<25)", "")
!MA("ST", "sd,", "", 0xc1200000, "|(sd<<25)", "")
!MA("STD", "dd,", "", 0xc1380000, "|(dd<<25)", "")
!MA("STQ", "qd,", "", 0xc1300000, "|(qd<<25)", "")
!MAA("LDA", "", ",sd", 0xc1800000, "|(sd<<25)", "")
!MAA("LDDA", "", ",dd", 0xc1980000, "|(dd<<25)", "")
!MAA("LDQA", "", ",qd", 0xc1900000, "|(qd<<25)", "")
