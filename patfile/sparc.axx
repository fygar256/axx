/* ===================================================================
/* Word emitters (mini language, section 3.15)
/* =================================================================== */
.func w4(z)
.return [(z >> 24) & 0xff, (z >> 16) & 0xff, (z >> 8) & 0xff, z & 0xff]
.endfunc
.func ew(z)
.emit((z >> 24) & 0xff, (z >> 16) & 0xff, (z >> 8) & 0xff, z & 0xff)
.return
.endfunc

/* sethi / or words */
.func sethi(rd, v)
.return 0x01000000 | (rd << 25) | ((v >> 10) & 0x3fffff)
.endfunc
.func orlo(rd, rs, v)
.return 0x80102000 | (rd << 25) | (rs << 14) | (v & 0x3ff)
.endfunc
.func ori(rd, rs, v)
.return 0x80102000 | (rd << 25) | (rs << 14) | (v & 0x1fff)
.endfunc

/* set / setuw: the 32-bit value zero extended (SPARC V9 manual G.3,
/* and llvm-mc) -- or alone when it fits 0..4095, sethi alone when the
/* low 10 bits are zero, sethi + or otherwise. sym = 1 (the operand
/* names a label, .islabel) always gives sethi %hi + or %lo, the two
/* words GNU as and llvm-mc write for a symbol, whatever its value. */
.func setuw(rd, v, sym)
.if v < -2147483648 || v > 4294967295 .then
.raise 3
.return
.endif
v = v & 0xffffffff
.if sym .then
w = .call sethi(rd, v)
.call ew(w)
w = .call orlo(rd, rd, v)
.call ew(w)
.return
.endif
.if v < 4096 .then
w = .call ori(rd, 0, v)
.call ew(w)
.return
.endif
w = .call sethi(rd, v)
.call ew(w)
.if (v & 0x3ff) != 0 .then
w = .call orlo(rd, rd, v)
.call ew(w)
.endif
.return
.endfunc

/* setsw: the 32-bit value sign extended (SPARC V9 manual G.3). For a
/* label (sym = 1): sethi %hi + or %lo + sra rd,%g0,rd, as its sign is
/* not known until the link */
.func setsw(rd, v, sym)
.if v < -2147483648 || v > 4294967295 .then
.raise 3
.return
.endif
.if sym .then
w = .call sethi(rd, v)
.call ew(w)
w = .call orlo(rd, rd, v)
.call ew(w)
.call ew(0x81380000 | (rd << 25) | (rd << 14))
.return
.endif
v = ((v & 0xffffffff) ^ 0x80000000) - 0x80000000
.if v >= -4096 && v < 4096 .then
w = .call ori(rd, 0, v)
.call ew(w)
.return
.endif
w = .call sethi(rd, v)
.call ew(w)
.if (v & 0x3ff) != 0 .then
w = .call orlo(rd, rd, v)
.call ew(w)
.endif
.if v < 0 .then
.call ew(0x81380000 | (rd << 25) | (rd << 14))
.endif
.return
.endfunc

/* setx value, rtmp, rd: the expansion of llvm-mc -- or alone for a
/* 13-bit signed value, sethi + or for a 32-bit unsigned one, and
/* otherwise sethi %hi / or %lo into rd, sethi %hh / or %hm into rtmp,
/* sllx rtmp,32 and or rtmp,rd,rd. For a label (sym = 1) always the
/* last, six-word form, as llvm-mc writes it for a symbol */
.func setx(rd, rt, v, sym)
.if v < -9223372036854775808 || v > 18446744073709551615 .then
.raise 3
.return
.endif
v = ((v & 0xffffffffffffffff) ^ 0x8000000000000000) - 0x8000000000000000
.if sym .then
w = .call sethi(rd, v)
.call ew(w)
w = .call orlo(rd, rd, v)
.call ew(w)
.call ew(0x01000000 | (rt << 25) | ((v >> 42) & 0x3fffff))
w = .call orlo(rt, rt, v >> 32)
.call ew(w)
.call ew(0x81283020 | (rt << 25) | (rt << 14))
.call ew(0x80100000 | (rd << 25) | (rt << 14) | rd)
.return
.endif
.if v >= -4096 && v < 4096 .then
w = .call ori(rd, 0, v)
.call ew(w)
.return
.endif
w = .call sethi(rd, v)
.call ew(w)
w = .call orlo(rd, rd, v)
.call ew(w)
.if v >= 0 && v <= 4294967295 .then
.return
.endif
.call ew(0x01000000 | (rt << 25) | ((v >> 42) & 0x3fffff))
w = .call orlo(rt, rt, v >> 32)
.call ew(w)
.call ew(0x81283020 | (rt << 25) | (rt << 14))
.call ew(0x80100000 | (rd << 25) | (rt << 14) | rd)
.return
.endfunc

/* ===================================================================
/* Row generators (macro layer, section 7)
/*
/* Z emits one row: the mnemonic, the operand text, the error list,
/* the constant part of the word and the operand fields or'ed into it.
/* =================================================================== */
!def Z(nm, ops, er, base, fx) {
!local head = nm
!if ops != "" !then {
!set head = nm + " " + ops
}
!if er == "" !then {
!{head} :: .call w4(0x!{base:08x}!{fx})
} !else {
!{head} :: !{er} :: .call w4(0x!{base:08x}!{fx})
}
}

/* the range tests */
!def ES13() {
!return "v<-4096||v>4095;3"
}
!def ED13() {
!return "v<-4096||v>4095;8"
}
!def EASI() {
!return "w<0||w>255;11"
}
/* J(a, b): two error lists joined */
!def J(a, b) {
!if a == "" !then {
!return b
}
!if b == "" !then {
!return a
}
!return a + "," + b
}

/* the operand modifiers of a 13-bit field. M13 emits one row with
/* the operand text pre + %md(!v) + post; val is the value the field
/* takes in a flat binary (the GOT and TLS ones are known only to the
/* linker and give 0 there). xer is an error list for the other
/* operands. */
!def M13(nm, pre, post, base, fx, xer, md, ty, val) {
.reloc::v::!{ty}
!Z(nm, pre + "%" + md + "(!v)" + post, xer, base, fx + "|0x2000|((" + val + ")&0x1fff)")
.clrreloc::v
}
/* I13: every form of a 13-bit signed immediate at one place: !v
/* (R_SPARC_13 against a symbol, range error er) and the modifiers;
/* I13N: !v alone */
!def I13N(nm, pre, post, base, fx, er, xer) {
.reloc::v::r13
!Z(nm, pre + "!v" + post, J(xer, er), base, fx + "|0x2000|(v&0x1fff)")
.clrreloc::v
}
!def I13(nm, pre, post, base, fx, er, xer) {
!I13N(nm, pre, post, base, fx, er, xer)
!M13(nm, pre, post, base, fx, xer, "LO", "lo10", "v&0x3ff")
!M13(nm, pre, post, base, fx, xer, "HM", "hm10", "(v>>32)&0x3ff")
!M13(nm, pre, post, base, fx, xer, "ULO", "hm10", "(v>>32)&0x3ff")
!M13(nm, pre, post, base, fx, xer, "M44", "m44", "(v>>12)&0x3ff")
!M13(nm, pre, post, base, fx, xer, "L44", "l44", "v&0xfff")
!M13(nm, pre, post, base, fx, xer, "LOX", "lox10", "(v&0x3ff)|0x1c00")
!M13(nm, pre, post, base, fx, xer, "PC10", "pc10", "(v-$$)&0x3ff")
!M13(nm, pre, post, base, fx, xer, "GOT10", "got10", "v&0")
!M13(nm, pre, post, base, fx, xer, "GOT13", "got13", "v&0")
!M13(nm, pre, post, base, fx, xer, "TGD\\_LO10", "tls_gd_lo10", "v&0")
!M13(nm, pre, post, base, fx, xer, "TLDM\\_LO10", "tls_ldm_lo10", "v&0")
!M13(nm, pre, post, base, fx, xer, "TLDO\\_LOX10", "tls_ldo_lox10", "v&0")
!M13(nm, pre, post, base, fx, xer, "TIE\\_LO10", "tls_ie_lo10", "v&0")
!M13(nm, pre, post, base, fx, xer, "TLE\\_LOX10", "tls_le_lox10", "v&0")
!M13(nm, pre, post, base, fx, xer, "GDOP\\_LOX10", "gotdata_lox10", "v&0")
}

/* reg_or_imm at one place: a register rb, or a 13-bit immediate */
!def RI(nm, pre, post, base, fx) {
!Z(nm, pre + "rb" + post, "", base, fx + "|rb")
!I13(nm, pre, post, base, fx, ES13(), "")
}

/* an address without brackets (jmpl, return, rett, flush): ra+rb,
/* ra, ra+imm (and so ra-imm) and, when im is 1, a bare imm (the
/* modifiers go with a base register: [%o0+%lo(sym)]) */
!def AD(nm, pre, post, base, fx, xer, im) {
!Z(nm, pre + "ra+rb" + post, xer, base, fx + "|(ra<<14)|rb")
!Z(nm, pre + "ra" + post, xer, base, fx + "|(ra<<14)")
!I13(nm, pre + "ra+", post, base, fx + "|(ra<<14)", ED13(), xer)
!if im !then {
!I13N(nm, pre, post, base, fx, ED13(), xer)
}
}

/* a memory address [ ... ] of a load or store */
!def MA(nm, pre, post, base, fx, xer) {
!AD(nm, pre + "[", "]" + post, base, fx, xer, 1)
}

/* the alternate space address: [ra+rb] asi and [ra] asi with an ASI
/* number or name in the instruction, and [ra+imm] %asi, [ra] %asi and
/* [imm] %asi with the ASI from the %asi register (a plain immediate:
/* the operand modifiers are not taken here) */
!def MAA(nm, pre, post, base, fx, xer) {
!Z(nm, pre + "[ra+rb]!w" + post, J(xer, EASI()), base, fx + "|(ra<<14)|((w&0xff)<<5)|rb")
!Z(nm, pre + "[ra]!w" + post, J(xer, EASI()), base, fx + "|(ra<<14)|((w&0xff)<<5)")
!Z(nm, pre + "[ra]%ASI" + post, xer, base, fx + "|(ra<<14)|0x2000")
!I13N(nm, pre + "[ra+", "]%ASI" + post, base, fx + "|(ra<<14)", ED13(), xer)
!I13N(nm, pre + "[", "]%ASI" + post, base, fx, ED13(), xer)
}

/* ===================================================================
/* Integer arithmetic and logic: nm rs1, reg_or_imm, rd
/* =================================================================== */
!def ALU(nm, op3) {
!RI(nm, "ra,", ",rd", 0x80000000 | (op3 << 19), "|(rd<<25)|(ra<<14)")
}
!ALU("ADD", 0x00)
!ALU("AND", 0x01)
!ALU("OR", 0x02)
!ALU("XOR", 0x03)
!ALU("SUB", 0x04)
!ALU("ANDN", 0x05)
!ALU("ORN", 0x06)
!ALU("XNOR", 0x07)
!ALU("ADDX", 0x08)
!ALU("ADDC", 0x08)
!ALU("MULX", 0x09)
!ALU("UMUL", 0x0a)
!ALU("SMUL", 0x0b)
!ALU("SUBX", 0x0c)
!ALU("SUBC", 0x0c)
!ALU("UDIVX", 0x0d)
!ALU("UDIV", 0x0e)
!ALU("SDIV", 0x0f)
!ALU("ADDCC", 0x10)
!ALU("ANDCC", 0x11)
!ALU("ORCC", 0x12)
!ALU("XORCC", 0x13)
!ALU("SUBCC", 0x14)
!ALU("ANDNCC", 0x15)
!ALU("ORNCC", 0x16)
!ALU("XNORCC", 0x17)
!ALU("ADDXCC", 0x18)
!ALU("ADDCCC", 0x18)
!ALU("UMULCC", 0x1a)
!ALU("SMULCC", 0x1b)
!ALU("SUBXCC", 0x1c)
!ALU("SUBCCC", 0x1c)
!ALU("UDIVCC", 0x1e)
!ALU("SDIVCC", 0x1f)
!ALU("TADDCC", 0x20)
!ALU("TSUBCC", 0x21)
!ALU("TADDCCTV", 0x22)
!ALU("TSUBCCTV", 0x23)
!ALU("MULSCC", 0x24)
!ALU("SDIVX", 0x2d)
!ALU("SAVE", 0x3c)
!ALU("RESTORE", 0x3d)
/* LEON: multiply-accumulate */
!ALU("UMAC", 0x3e)
!ALU("SMAC", 0x3f)
SAVE :: .call w4(0x81e00000)
RESTORE :: .call w4(0x81e80000)

/* population count: popc reg_or_imm, rd (rs1 = 0) */
!RI("POPC", "", ",rd", 0x81700000, "|(rd<<25)")

/* shifts: the count is 5 bits (sll srl sra) or 6 bits (x = 1) */
!def SH(nm, op3, x) {
!local b = 0x80000000 | (op3 << 19) | (x << 12)
!Z(nm, "ra,rb,rd", "", b, "|(rd<<25)|(ra<<14)|rb")
!if x !then {
!Z(nm, "ra,!v,rd", "v<0||v>63;10", b, "|(rd<<25)|(ra<<14)|0x2000|(v&63)")
} !else {
!Z(nm, "ra,!v,rd", "v<0||v>31;10", b, "|(rd<<25)|(ra<<14)|0x2000|(v&31)")
}
}
!SH("SLL", 0x25, 0)
!SH("SRL", 0x26, 0)
!SH("SRA", 0x27, 0)
!SH("SLLX", 0x25, 1)
!SH("SRLX", 0x26, 1)
!SH("SRAX", 0x27, 1)

/* sethi: a plain 22-bit value (R_SPARC_22 against a symbol) and the
/* modifiers of a 22-bit field */
.reloc::v::r22
SETHI !v,rd :: v<0||v>0x3fffff;3 :: .call w4(0x01000000|(rd<<25)|(v&0x3fffff))
.clrreloc::v
!def M22(md, ty, val) {
.reloc::v::!{ty}
SETHI %!{md}(!v),rd :: .call w4(0x01000000|(rd<<25)|((!{val})&0x3fffff))
.clrreloc::v
}
!M22("HI", "hi22", "v>>10")
!M22("HH", "hh22", "v>>42")
!M22("UHI", "hh22", "v>>42")
!M22("LM", "lm22", "v>>10")
!M22("H44", "h44", "v>>22")
!M22("HIX", "hix22", "(~v)>>10")
!M22("PC22", "pc22", "(v-$$)>>10")
!M22("GOT22", "got22", "v&0")
!M22("TGD\\_HI22", "tls_gd_hi22", "v&0")
!M22("TLDM\\_HI22", "tls_ldm_hi22", "v&0")
!M22("TLDO\\_HIX22", "tls_ldo_hix22", "v&0")
!M22("TIE\\_HI22", "tls_ie_hi22", "v&0")
!M22("TLE\\_HIX22", "tls_le_hix22", "v&0")
!M22("GDOP\\_HIX22", "gotdata_hix22", "v&0")
NOP :: .call w4(0x01000000)

/* ===================================================================
/* Branches
/* =================================================================== */
!def EB(bits) {
!local m = 1 << (bits + 1)
!return "(v-$$)>" + str(m - 4) + "||(v-$$)<-" + str(m) + "||((v-$$)&3)!=0;2"
}
!def D(bits) {
!return "|(((v-$$)>>2)&0x" + hex((1 << bits) - 1) + ")"
}

/* Bicc (op2 2, disp22) and BPcc (op2 1, %icc / %xcc, disp19) */
!def BI(nm, c) {
!local b = (c << 25) | (2 << 22)
.reloc::v::wdisp22
!Z(nm, "!v", EB(22), b, D(22))
!Z(nm + ",A", "!v", EB(22), b | 0x20000000, D(22))
.clrreloc::v
!local p = (c << 25) | (1 << 22)
!local f = "|((ic&3)<<20)" + D(19)
.reloc::v::wdisp19
!Z(nm, "ic,!v", EB(19), p | 0x80000, f)
!Z(nm + ",PT", "ic,!v", EB(19), p | 0x80000, f)
!Z(nm + ",PN", "ic,!v", EB(19), p, f)
!Z(nm + ",A", "ic,!v", EB(19), p | 0x20080000, f)
!Z(nm + ",A,PT", "ic,!v", EB(19), p | 0x20080000, f)
!Z(nm + ",A,PN", "ic,!v", EB(19), p | 0x20000000, f)
.clrreloc::v
}
!BI("BA", 8)
!BI("B", 8)
!BI("BN", 0)
!BI("BNE", 9)
!BI("BNZ", 9)
!BI("BE", 1)
!BI("BZ", 1)
!BI("BG", 10)
!BI("BLE", 2)
!BI("BGE", 11)
!BI("BL", 3)
!BI("BGU", 12)
!BI("BLEU", 4)
!BI("BCC", 13)
!BI("BGEU", 13)
!BI("BCS", 5)
!BI("BLU", 5)
!BI("BPOS", 14)
!BI("BNEG", 6)
!BI("BVC", 15)
!BI("BVS", 7)

/* FBfcc (op2 6, disp22) and FBPfcc (op2 5, %fcc0-%fcc3, disp19) */
!def FB(nm, c) {
!local b = (c << 25) | (6 << 22)
.reloc::v::wdisp22
!Z(nm, "!v", EB(22), b, D(22))
!Z(nm + ",A", "!v", EB(22), b | 0x20000000, D(22))
.clrreloc::v
!local p = (c << 25) | (5 << 22)
!local f = "|((fc&3)<<20)" + D(19)
.reloc::v::wdisp19
!Z(nm, "fc,!v", EB(19), p | 0x80000, f)
!Z(nm + ",PT", "fc,!v", EB(19), p | 0x80000, f)
!Z(nm + ",PN", "fc,!v", EB(19), p, f)
!Z(nm + ",A", "fc,!v", EB(19), p | 0x20080000, f)
!Z(nm + ",A,PT", "fc,!v", EB(19), p | 0x20080000, f)
!Z(nm + ",A,PN", "fc,!v", EB(19), p | 0x20000000, f)
.clrreloc::v
}
!FB("FBA", 8)
!FB("FBN", 0)
!FB("FBU", 7)
!FB("FBG", 6)
!FB("FBUG", 5)
!FB("FBL", 4)
!FB("FBUL", 3)
!FB("FBLG", 2)
!FB("FBNE", 1)
!FB("FBNZ", 1)
!FB("FBE", 9)
!FB("FBZ", 9)
!FB("FBUE", 10)
!FB("FBGE", 11)
!FB("FBUGE", 12)
!FB("FBLE", 13)
!FB("FBULE", 14)
!FB("FBO", 15)

/* BPr (op2 3): rs1 and a 16-bit displacement split d16hi:d16lo */
!def BR(nm, c) {
!local p = (c << 25) | (3 << 22)
!local f = "|(ra<<14)|(((((v-$$)>>2)>>14)&3)<<20)|(((v-$$)>>2)&0x3fff)"
.reloc::v::wdisp16
!Z(nm, "ra,!v", EB(16), p | 0x80000, f)
!Z(nm + ",PT", "ra,!v", EB(16), p | 0x80000, f)
!Z(nm + ",PN", "ra,!v", EB(16), p, f)
!Z(nm + ",A", "ra,!v", EB(16), p | 0x20080000, f)
!Z(nm + ",A,PT", "ra,!v", EB(16), p | 0x20080000, f)
!Z(nm + ",A,PN", "ra,!v", EB(16), p | 0x20000000, f)
.clrreloc::v
}
!BR("BRZ", 1)
!BR("BRE", 1)
!BR("BRLEZ", 2)
!BR("BRLZ", 3)
!BR("BRNZ", 5)
!BR("BRNE", 5)
!BR("BRGZ", 6)
!BR("BRGEZ", 7)

/* the V8 coprocessor branches CBccc (op2 7, disp22) */
!def CB(nm, c) {
!local b = (c << 25) | (7 << 22)
.reloc::v::wdisp22
!Z(nm, "!v", EB(22), b, D(22))
!Z(nm + ",A", "!v", EB(22), b | 0x20000000, D(22))
.clrreloc::v
}
!CB("CBA", 8)
!CB("CBN", 0)
!CB("CB3", 7)
!CB("CB2", 6)
!CB("CB23", 5)
!CB("CB1", 4)
!CB("CB13", 3)
!CB("CB12", 2)
!CB("CB123", 1)
!CB("CB0", 9)
!CB("CB03", 10)
!CB("CB02", 11)
!CB("CB023", 12)
!CB("CB01", 13)
!CB("CB013", 14)
!CB("CB012", 15)

/* iprefetch label: bn,a,pt %xcc,label (SPARC V9 manual G.3) */
.reloc::v::wdisp19
!Z("IPREFETCH", "!v", EB(19), 0x20680000, D(19))
.clrreloc::v

/* call: disp30 (R_SPARC_WDISP30), or through a register (jmpl ...,%o7) */
.reloc::v::wdisp30
!Z("CALL", "!v", EB(30), 0x40000000, D(30))
.clrreloc::v
!AD("CALL", "", "", 0x9fc00000, "", "", 0)

/* jmpl address, rd; jmp address; return; rett */
!AD("JMPL", "", ",rd", 0x81c00000, "|(rd<<25)", "", 1)
!AD("JMP", "", "", 0x81c00000, "", "", 1)
!AD("RETURN", "", "", 0x81c80000, "", "", 1)
!AD("RETT", "", "", 0x81c80000, "", "", 1)
RET :: .call w4(0x81c7e008)
RETL :: .call w4(0x81c3e008)

/* Tcc: t<cond> [%icc|%xcc,] trap number, with the number given as
/* imm, rs2, rs1+rs2 or rs1+imm (0-255, the UltraSPARC Architecture
/* range; V8 and V9 use 0-127) */
!def TC(nm, c) {
!local b = 0x81d00000 | (c << 25)
!Z(nm, "!v", "v<0||v>255;3", b, "|0x2000|(v&0xff)")
!Z(nm, "rb", "", b, "|rb")
!Z(nm, "ra+rb", "", b, "|(ra<<14)|rb")
!Z(nm, "ra+!v", "v<0||v>255;3", b, "|(ra<<14)|0x2000|(v&0xff)")
!Z(nm, "ic,!v", "v<0||v>255;3", b, "|((ic&3)<<11)|0x2000|(v&0xff)")
!Z(nm, "ic,rb", "", b, "|((ic&3)<<11)|rb")
!Z(nm, "ic,ra+rb", "", b, "|((ic&3)<<11)|(ra<<14)|rb")
!Z(nm, "ic,ra+!v", "v<0||v>255;3", b, "|((ic&3)<<11)|(ra<<14)|0x2000|(v&0xff)")
}
!TC("TA", 8)
!TC("TN", 0)
!TC("TNE", 9)
!TC("TNZ", 9)
!TC("TE", 1)
!TC("TZ", 1)
!TC("TG", 10)
!TC("TLE", 2)
!TC("TGE", 11)
!TC("TL", 3)
!TC("TGU", 12)
!TC("TLEU", 4)
!TC("TCC", 13)
!TC("TGEU", 13)
!TC("TCS", 5)
!TC("TLU", 5)
!TC("TPOS", 14)
!TC("TNEG", 6)
!TC("TVC", 15)
!TC("TVS", 7)

/* ===================================================================
/* Conditional moves
/* =================================================================== */
/* movcc: the cc variable (ic or fc) gives cc2 (bit 18) and cc1:cc0 */
!def MV(nm, c, cv) {
!local b = 0x81600000 | (c << 14)
!local f = "|(rd<<25)|((" + cv + "&4)<<16)|((" + cv + "&3)<<11)"
!Z(nm, cv + ",rb,rd", "", b, f + "|rb")
!Z(nm, cv + ",!v,rd", "v<-1024||v>1023;3", b, f + "|0x2000|(v&0x7ff)")
}
!def MVI(nm, c) {
!MV(nm, c, "ic")
}
!def MVF(nm, c) {
!MV(nm, c, "fc")
}
