/*  ==================================================================
/*  exprmiss.axx -- 式・因子のあるべきところに式・因子が無い行のテスト
/*
/*  Technical_Manual 3.3 のテスト。式の捕捉（`!x`・`!L`・`!F`・`!D`・`!Q`）と
/*  因子の捕捉（`!!x`）で、そこに式・因子が無ければパターンが当たらない
/*  ことを確かめる。空のとき（`ld a,`）だけでなく、式の中で因子が欠けて
/*  いるとき（`1+`・`-`・`~`・`()`）も当たらない。当たらない行は .passthru
/*  でそのまま出るので、書き換わった行と素通しの行を見比べられる。
/*  paxx と caxx が同じバイト列を出すことも確かめる。
/*  ==================================================================

.bits::8
.passthru
.eol

LD A,!n     :: "LD A,0x{{.hex(n)}}"
LD (!a),A   :: "LD (0x{{.hex(a)}}),A"
ADD A,!!f   :: "ADD A,0x{{.hex(f)}}"
JP !La      :: "JP {{.exp(a)}}"
DF !Fx      :: "DF 0x{{.hex(x)}}"
DD !Dx      :: "DD 0x{{.hex(x)}}"
DQ !Qx      :: "DQ 0x{{.hex(x)}}"
