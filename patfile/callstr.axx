/*  ==================================================================
/*  callstr.axx -- .textmode と .call の文字列の戻り値のテスト
/*
/*  Technical_Manual 3.18 のテスト。テキスト置換モードで `.call` の
/*  戻り値が文字列のとき
/*    - その文字列が -b のバイト列にも -V のテキストにも出ること
/*    - 行頭の `label:`・`;` コメント・字下げが前後に付くこと
/*    - `"..."` のテンプレートと並べるとテキストがつながること
/*    - `;.call` で空文字列なら何も出さず、`;;.call` は捨てること
/*    - 空文字列（`;` 無し）でもテキストとして扱われ、ラベルとコメントが出ること
/*    - NUL を含む文字列は -b には全部、-V には NUL の手前まで出ること
/*    - `.emit` の語は -b だけに出て、テキストは戻り値の文字列だけであること
/*    - 数の戻り値は今までどおり -b だけに出ること
/*  を確かめる。paxx と caxx が同じバイト列・同じテキストを出すことも確かめる。
/*  ==================================================================

.bits::8
.textmode

.map::r::B,C,D,E,H,L,A

.func ld(d,s)
.return "LD " + d + "," + s
.endfunc

.func jp(t)
.return "JP " + t
.endfunc

.func id(x)
.return x
.endfunc

.func nul()
.return "AB" + .chr(0) + "CD"
.endfunc

.func emitret()
.emit(0x41,0x42)
.return "cd"
.endfunc

.func num()
.return 5
.endfunc

/*  レジスタ名と拾った綴りを関数に渡し、組み立てた文字列を返す。 */
MOV r,r2    :: .call ld(.exp(r),.exp(r2))
JMP !La     :: .call jp(.exp(a))
/*  テンプレートと並べる。 */
MVI r,!La   :: "LD ",.call id(.exp(r)),",",.call id(.exp(a))
/*  ; と ;; と空文字列。 */
SEMI !La    :: ;.call id(.exp(a))
SEMI0       :: ;.call id("")
DROP        :: ;;.call id("dropped")
EMPTY       :: .call id("")
/*  NUL・.emit・数の戻り値。 */
NUL         :: .call nul()
EMITRET     :: .call emitret()
NUM         :: .call num()
