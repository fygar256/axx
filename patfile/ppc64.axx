/* ===================================================================
/* Prefixed instructions (Power ISA v3.1), 8 bytes: prefix, suffix
/*
/* d is a 34-bit signed displacement split 18:16 over the two words.
/* R = 1 makes it PC relative (relative to the prefix word); RA must
/* then be 0. The @pcrel spelling (pld 3,sym@pcrel) computes
/* sym - $$ and sets R = 1. A prefixed instruction may not cross a
/* 64-byte boundary.
/* =================================================================== */
/* A prefixed instruction may not cross a 64-byte boundary. When it
/* would (the location counter is 60 mod 64), a nop is emitted first,
/* as GNU as does; PAD is that optional nop, and PQ the address of the
/* prefixed instruction itself, which PC-relative operands count from. */
!set PAD = "@@[(($$&63)==60),0x60*(1-#PPCLE),0,0,0x60*#PPCLE],"
!set PQ = "($$+((($$&63)==60)*4))"

/* Prefixed masked forms (MMIRR): pmxv<name> AT,XA,XB,XMSK,YMSK[,PMSK].
/* The prefix holds the masks: XMSK 4 bits, YMSK 4 bits (2 for the
/* f64 forms), PMSK 8 / 4 / 2 bits for the 4-, 8- and 16-bit element
/* forms (none for f32 / f64). The suffix is the unprefixed xv*ger*. */
!def pger(nm, xo, pb) {
!local sw = (59 << 26) | (xo << 3)
!local f = "((acc&7)<<23)|((xa&31)<<16)|((xa>>5)<<2)|((xb&31)<<11)|((xb>>5)<<1)"
!local ce = "acc<0;3,acc>7;3,xm<0;3,xm>15;3"
!if pb > 0 !then {
!local pm = (1 << pb) - 1
!local ps = 16 - pb
PM!{nm} !acc,xa,xb,!xm,!ym,!pm ::!{ce},ym<0;3,ym>15;3,pm<0;3,pm>!{pm};3 :: !{PAD}.call w8(0x07900000|((pm&!{pm})<<!{ps})|((xm&15)<<4)|(ym&15),0x!{sw:08x}|!{f})
}
!if pb == 0 !then {
PM!{nm} !acc,xa,xb,!xm,!ym ::!{ce},ym<0;3,ym>15;3 :: !{PAD}.call w8(0x07900000|((xm&15)<<4)|(ym&15),0x!{sw:08x}|!{f})
}
!if pb < 0 !then {
PM!{nm} !acc,xa,xb,!xm,!ym ::!{ce},ym<0;3,ym>3;3,(xa&1)!=0;5 :: !{PAD}.call w8(0x07900000|((xm&15)<<4)|((ym&3)<<2),0x!{sw:08x}|!{f})
}
}
!pger("XVI4GER8", 35, 8)
!pger("XVI4GER8PP", 34, 8)
!pger("XVI8GER4", 3, 4)
!pger("XVI8GER4PP", 2, 4)
!pger("XVI8GER4SPP", 99, 4)
!pger("XVI16GER2", 75, 2)
!pger("XVI16GER2PP", 107, 2)
!pger("XVI16GER2S", 43, 2)
!pger("XVI16GER2SPP", 42, 2)
!pger("XVF16GER2", 19, 2)
!pger("XVF16GER2PP", 18, 2)
!pger("XVF16GER2PN", 146, 2)
!pger("XVF16GER2NP", 82, 2)
!pger("XVF16GER2NN", 210, 2)
!pger("XVBF16GER2", 51, 2)
!pger("XVBF16GER2PP", 50, 2)
!pger("XVBF16GER2PN", 178, 2)
!pger("XVBF16GER2NP", 114, 2)
!pger("XVBF16GER2NN", 242, 2)
