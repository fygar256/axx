/* ROP protection: hashst / hashchk RB,D(RA), D = -512..-8, step 8 */
!def hashx(nm, xo) {
!{nm} rb,!d(ra) ::d<-512;8,d>-8;8,(d&7)!=0;8 :: .call w4(0x!{(31 << 26) | (xo << 1):08x}|(((d>>3)&31)<<21)|(ra<<16)|(rb<<11)|((d>>8)&1))
}
