!x31("MFCR", 19, "rt@21")
!xg("MFOCRF", (31 << 26) | (1 << 20) | (19 << 1), "rt@21,!u:fxm@12/8")
/* mtcrf with a single-bit mask is emitted as mtocrf (bit 11 set),
/* as GNU as does for POWER4 and later. */
MTCRF !fxm,rs ::fxm<0;3,fxm>255;3 :: .call w4(0x7c000120|(rs<<21)|((fxm&255)<<12)|((((fxm!=0)&&((fxm&(fxm-1))==0))&1)<<20))
!xg("MTOCRF", (31 << 26) | (1 << 20) | (144 << 1), "!u:fxm@12/8,rs@21")
MTCR rs :: .call w4(0x7c0ff120|(rs<<21))
