.reloc::v::addr16
TW!{cn}I ra,!v ::v<-32768;3,v>32767;3 :: .call w4(0x!{(3 << 26) | (to << 21):08x}|(ra<<16)|(v&0xffff))
.clrreloc::v
.reloc::v::addr16
TD!{cn}I ra,!v ::v<-32768;3,v>32767;3 :: .call w4(0x!{(2 << 26) | (to << 21):08x}|(ra<<16)|(v&0xffff))
.clrreloc::v
}
