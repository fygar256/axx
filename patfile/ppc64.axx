CMPLI bf,!l,ra,!v ::l<0;3,l>1;3,v<0;3,v>65535;3 :: .call w4(0x28000000|(bf<<23)|(l<<21)|(ra<<16)|(v&0xffff))
.clrreloc::v
!def cmpx(nm, base) {
!{nm} ra,rb :: .call w4(0x!{base:08x}|(ra<<16)|(rb<<11))
!{nm} bf,ra,rb :: .call w4(0x!{base:08x}|(bf<<23)|(ra<<16)|(rb<<11))
}
!def cmpxi(nm, base, lo, hi) {
.reloc::v::addr16
!{nm} ra,!v ::v<!{lo};3,v>!{hi};3 :: .call w4(0x!{base:08x}|(ra<<16)|(v&0xffff))
.clrreloc::v
.reloc::v::addr16
!{nm} bf,ra,!v ::v<!{lo};3,v>!{hi};3 :: .call w4(0x!{base:08x}|(bf<<23)|(ra<<16)|(v&0xffff))
.clrreloc::v
!hsfx(nm, "ra,", base, "|(ra<<16)")
!hsfx(nm, "bf,ra,", base, "|(bf<<23)|(ra<<16)")
}
