TDI !to,ra,!v ::to<0;3,to>31;3,v<-32768;3,v>32767;3 :: .call w4(0x08000000|(to<<21)|(ra<<16)|(v&0xffff))
.clrreloc::v
TRAP :: .call w4(0x7fe00008)
!def trp(cn, to) {
TW!{cn} ra,rb :: .call w4(0x!{(31 << 26) | (to << 21) | (4 << 1):08x}|(ra<<16)|(rb<<11))
