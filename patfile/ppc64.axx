!crl("CRORC", 417)
CRSET !bx ::bx<0;3,bx>31;3 :: .call w4(0x4c000242|(bx<<21)|(bx<<16)|(bx<<11))
CRCLR !bx ::bx<0;3,bx>31;3 :: .call w4(0x4c000182|(bx<<21)|(bx<<16)|(bx<<11))
CRMOVE !bx,!by ::bx<0;3,bx>31;3,by<0;3,by>31;3 :: .call w4(0x4c000382|(bx<<21)|(by<<16)|(by<<11))
CRNOT !bx,!by ::bx<0;3,bx>31;3,by<0;3,by>31;3 :: .call w4(0x4c000042|(bx<<21)|(by<<16)|(by<<11))
!x19("MCRF", 0, "bf@23,bfa@18")

SC :: .call w4(0x44000002)
SC !lev ::lev<0;3,lev>127;3 :: .call w4(0x44000002|(lev<<5))
SCV !lev ::lev<0;3,lev>127;3 :: .call w4(0x44000001|(lev<<5))
