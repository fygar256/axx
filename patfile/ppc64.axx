XXSPLTIB xt,!v ::v<-128;3,v>255;3 :: .call w4(0xf00002d0|((xt&31)<<21)|((xt>>5)&1)|((v&0xff)<<11))
LXVKQ xt,!v ::v<0;3,v>31;3 :: .call w4(0xf01f02d0|((xt&31)<<21)|((xt>>5)&1)|(v<<11))
/* test data class, vector: DCMX split dc:dm:dx */
!def xvtst(nm, base) {
!{nm} xt,xb,!d ::d<0;3,d>127;3 :: .call w4(0x!{base:08x}|((xt&31)<<21)|((xt>>5)&1)|((xb&31)<<11)|(((xb>>5)&1)<<1)|((d&31)<<16)|(((d>>5)&1)<<2)|(((d>>6)&1)<<6))
}
!xvtst("XVTSTDCSP", 0xf00006a8)
!xvtst("XVTSTDCDP", 0xf00007a8)
/* selector forms (XX2 with bits 16-20 as part of the opcode) */
!def xsel(nm, xo, s, spec) {
!xg(nm, (60 << 26) | (s << 16) | xo, spec)
}
