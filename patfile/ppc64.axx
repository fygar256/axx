/* PowerPC64, big-endian (ELFv1 / ppc64). See ppc64_isa.axx. */
.setsym::PPCLE::0
.bits::big::8
.elfmachine::21::PowerPC64
.elfclass::64

/* ELF relocations (-o). Relocation types of the 64-bit PowerPC ELF ABI,
/* and, for the instruction-field ones, where the field sits (.elffield:
/* the bits within the field, then its byte offset in the instruction).
/* A 16-bit field is the low halfword of the word: bytes 2-3 big-endian,
/* bytes 0-1 little-endian. A 34-bit prefixed field is 18 bits of the
/* prefix word and 16 bits of the suffix word. */
.elftype::addr32::1::4
.elftype::addr24::2::4
.elftype::addr16::3::2
.elftype::addr16_lo::4::2
.elftype::addr16_hi::5::2
.elftype::addr16_ha::6::2
.elftype::addr14::7::4
.elftype::rel24::10::4::1
.elftype::rel14::11::4::1
.elftype::addr64::38::8
.elftype::addr16_higher::39::2
.elftype::addr16_highera::40::2
.elftype::addr16_highest::41::2
.elftype::addr16_highesta::42::2
.elftype::addr16_ds::56::2
.elftype::addr16_lo_ds::57::2
.elftype::addr16_high::110::2
.elftype::addr16_higha::111::2
.elftype::d34::128::8
.elftype::pcrel34::132::8::1
.elffield::rel24::0x03fffffc
.elffield::addr24::0x03fffffc
.elffield::rel14::0xfffc
.elffield::addr14::0xfffc
.elffield::addr16::0xffff::2
.elffield::addr16_lo::0xffff::2
.elffield::addr16_hi::0xffff::2
.elffield::addr16_ha::0xffff::2
.elffield::addr16_high::0xffff::2
.elffield::addr16_higha::0xffff::2
.elffield::addr16_higher::0xffff::2
.elffield::addr16_highera::0xffff::2
.elffield::addr16_highest::0xffff::2
.elffield::addr16_highesta::0xffff::2
/* DS / DQ forms: the low bits of the field hold opcode bits (and TX
/* for lxv / stxv), which the linker keeps, so they are not cleared. */
.elffield::addr16_ds::0xfff0::2
.elffield::addr16_lo_ds::0xfff0::2
.elffield::d34::0x0003ffff0000ffff
.elffield::pcrel34::0x0003ffff0000ffff
/* data: .long / .short / .quad of a symbol, and .extern with no type */
.elfwidth::8::addr64
.elfwidth::4::addr32
.elfwidth::2::addr16
.elfextern::addr64
.elfdwarf::addr64
/* A prefixed instruction must not cross a 64-byte boundary, so .text
/* keeps that alignment through the link, as GNU as does. */
.elfsection::.text::6::1::64


/* ===================================================================
/* PowerPC64 (Power ISA v3.1) instruction set -- pattern file for axx
/*
/* This file holds the instruction set only. Do not pass it to axx
/* directly; use one of the two wrappers, which fix the byte order
/* first and then include this file:
/*
/*   ppc64.axx     big-endian    (ELF64 MSB, e_machine 21)
/*   ppc64le.axx   little-endian (ELF64 LSB, e_machine 21, ELFv2)
/*
/* Coverage -- Power ISA v3.1 (POWER10) in the GNU assembler syntax:
/*   - Branch: I/B/XL forms, BO/BI/BH operands, absolute and link
/*     variants, and the extended mnemonics (blr, bctr, beq, bnelr+,
/*     bdnz, bdnzt, bt, bf, ...) with an optional CR field and the
/*     "+" / "-" prediction hints (the Power ISA "at" bit encoding)
/*   - CR logical, mcrf, system call (sc, scv), rfid/hrfid/urfid/rfscv
/*   - Fixed-point: every D/DS/DQ/X load and store incl. update,
/*     indexed, byte-reversed, multiple/string (big-endian only, as
/*     the ISA requires; ppc64le.axx reports error 15), load-and-reserve /
/*     store-conditional, caching-inhibited and atomic memory ops;
/*     arithmetic (XO forms with o/./o.), multiply-add, modulo,
/*     compare (incl. cmprb, cmpeqb, setb, setbc...), trap, logical,
/*     count/popcount/parity, rotate and shift (M/MD/MDS/XS forms),
/*     isel, the v3.1 bit-manipulation ops (cfuged, pdepd, pextd,
/*     cntlzdm, brh/brw/brd), and the move to/from SPR/CR/MSR group
/*   - Extended mnemonics: li, lis, la, subi, subis, subic, sub, subc,
/*     mr, not, nop, xnop, cmpw/cmpd/cmplw/cmpld(+i), tw<cond>(i),
/*     td<cond>(i), rotlwi, slwi, srwi, clrlwi, extlwi, inslwi,
/*     rotldi, sldi, srdi, clrldi, extrdi, insrdi, clrlsldi, ...,
/*     mflr/mtlr/mfctr/mtctr and many more SPR aliases, crset/crclr/
/*     crmove/crnot, lwsync/hwsync/ptesync, isellt/iselgt/iseleq
/*   - The @l, @h, @ha, @high, @higha, @higher, @highera, @highest and
/*     @highesta operand modifiers on every 16-bit immediate and every
/*     D-form displacement
/*   - Storage control: cache ops, sync/eieio/isync, wait, copy/paste,
/*     msgsnd family, SLB and TLB management, hash{st,chk}[p]
/*   - Floating point: loads/stores, A/X-form arithmetic, conversions,
/*     rounding, compares, FPSCR ops (mffs family, mtfsf, mtfsfi, ...)
/*   - Decimal floating point: arithmetic, quantize, round, compare,
/*     test, conversion, BCD, insert/extract exponent, shifts (and the
/*     quad "q" forms)
/*   - Vector (VMX / AltiVec): VX, VA and VC forms incl. the v2.07,
/*     v3.0 and v3.1 additions (divide, modulo, mask ops, string ops,
/*     insert/extract, quad-word ops, BCD, crypto, ...)
/*   - VSX: loads/stores, scalar and vector DP/SP arithmetic, FMA,
/*     compare, convert, round, test, logical, permute, splat,
/*     insert/extract, the quad-precision (xs*qp) group, and moves
/*     between GPRs and VSRs
/*   - MMA: xxmfacc/xxmtacc/xxsetaccz, the xv*ger* outer products and
/*     their prefixed masked forms (pmxv*ger*: XMSK, YMSK, PMSK)
/*   - Prefixed (8-byte) instructions: paddi/pli/pla, the prefixed
/*     loads and stores (incl. the @pcrel form), pnop, xxsplti32dx,
/*     xxspltiw, xxspltidp, xxblendv*, xxpermx, xxeval, pmxv*. One that
/*     would cross a 64-byte boundary gets a nop in front of it, as GNU
/*     as does (PC-relative operands count from the instruction itself)
/*   - Data: .byte/.short/.long/.quad written in the target byte order
/*
/* Register spelling. Every register may be written the three ways
/* GNU as accepts: a bare number (addi 3,1,8), a name (addi r3,r1,8)
/* or a %-name (addi %r3,%r1,8). The names are r0-r31 (sp = r1,
/* rtoc = r2), f0-f31, v0-v31, vs0-vs63, cr0-cr7. The CR-bit operands
/* of bc, crand, isel, ... are plain numbers or expressions (0-31);
/* the extended branch mnemonics take a CR field instead (beq cr7,x).
/*
/* A note on names: every register name above is a pattern-file
/* symbol, and axx does not let an assembly-source label share a name
/* with one. Give labels names that no register spelling uses.
/*
/* Not covered: the transactional-memory instructions (removed in
/* v3.1), and the embedded (Book E) and SPE instruction sets.
/*
/* ELF output (-o). The wrappers declare the 64-bit PowerPC ELF ABI
/* relocation types with .elftype / .elffield, and every operand that
/* can hold a symbol is typed with .reloc, so an object links like one
/* from GNU as: REL24 / ADDR24 (b, bl, ba), REL14 / ADDR14 (bc and the
/* extended conditional branches), ADDR16 / _LO / _HI / _HA / _HIGH /
/* _HIGHA / _HIGHER(A) / _HIGHEST(A) (the @ modifiers), ADDR16_DS /
/* _LO_DS (DS and DQ forms), D34 / PCREL34 (prefixed), and ADDR16 /
/* ADDR32 / ADDR64 for data. The field is written as 0 and the addend
/* goes in the RELA entry. The .elffield directive needs an axx that
/* has it (added together with this file). Differences from GNU as
/* that the linker makes disappear: references to a local label are
/* relocations against that label (GNU as resolves same-section
/* branches itself and uses the section symbol), and GNU as leaves
/* the addend in the field of hinted bc and of prefixed instructions.
/* .align inside code pads with the .padding byte, not with nops.
/*
/* Extras beyond GNU as: a zero displacement may be omitted
/* (lwz 3,(1)), mfpid/mtpid, cp_abort as another name for cpabort, and
/* the v2.05 lfdp/stfdp(x) pair.
/*
/* Verified against GNU as 2.42 (-mpower10) in both byte orders:
/*   - every pattern row instantiated, byte-for-byte identical;
/*   - every relocatable row against an external symbol: relocation
/*     entries (offset, type, symbol, addend) identical, and the linked
/*     text (GNU ld) identical;
/*   - the C (caxx) and Python (axx.py) implementations give identical
/*     output. See ppc64_test.s.
/* =================================================================== */

/* ===================================================================
/* Error messages (Technical_Manual.md section 3.14)
/* =================================================================== */
.error::2::"branch target out of range or not a multiple of 4"
.error::3::"immediate value out of range"
.error::5::"register out of range (an even register is required here)"
.error::8::"displacement out of range or not suitably aligned"
.error::10::"shift, mask or field value out of range"
.error::15::"load/store multiple and string instructions are big-endian only"

/* ===================================================================
/* Word emitters (mini language, section 3.15)
/*
/* PPCLE is set by the wrapper: 0 = big-endian, 1 = little-endian.
/* A prefixed instruction is two words, prefix first, each word in the
/* target byte order.
/* =================================================================== */
.func w4(z)
.if #PPCLE .then
.return [z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff]
.endif
.return [(z >> 24) & 0xff, (z >> 16) & 0xff, (z >> 8) & 0xff, z & 0xff]
.endfunc

.func w8(p, s)
.if #PPCLE .then
.emit(p & 0xff, (p >> 8) & 0xff, (p >> 16) & 0xff, (p >> 24) & 0xff)
.emit(s & 0xff, (s >> 8) & 0xff, (s >> 16) & 0xff, (s >> 24) & 0xff)
.return
.endif
.emit((p >> 24) & 0xff, (p >> 16) & 0xff, (p >> 8) & 0xff, p & 0xff)
.emit((s >> 24) & 0xff, (s >> 16) & 0xff, (s >> 8) & 0xff, s & 0xff)
.return
.endfunc

/* data items of 2 and 8 bytes */
.func w2(z)
.if #PPCLE .then
.return [z & 0xff, (z >> 8) & 0xff]
.endif
.return [(z >> 8) & 0xff, z & 0xff]
.endfunc

.func d8(z)
.if #PPCLE .then
.emit(z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff)
.emit((z >> 32) & 0xff, (z >> 40) & 0xff, (z >> 48) & 0xff, (z >> 56) & 0xff)
.return
.endif
.emit((z >> 56) & 0xff, (z >> 48) & 0xff, (z >> 40) & 0xff, (z >> 32) & 0xff)
.emit((z >> 24) & 0xff, (z >> 16) & 0xff, (z >> 8) & 0xff, z & 0xff)
.return
.endfunc

/* rlw(op,rs,ra,sh,mb,me,rc): an M-form rotate word (rlwinm / rlwimi) */
.func rlw(op, rs, ra, sh, mb, me, rc)
.return .call w4((op << 26) | (rs << 21) | (ra << 16) | ((sh & 31) << 11) | ((mb & 31) << 6) | ((me & 31) << 1) | rc)
.endfunc

/* md(xo,rs,ra,sh,mb,rc): an MD-form rotate doubleword. The 6-bit sh
/* and mb fields are split in the encoding (sh5 at bit 30, mb5 last). */
.func md(xo, rs, ra, sh, mb, rc)
m = ((mb & 31) << 1) | ((mb >> 5) & 1)
.return .call w4(0x78000000 | (rs << 21) | (ra << 16) | ((sh & 31) << 11) | (m << 5) | (xo << 2) | (((sh >> 5) & 1) << 1) | rc)
.endfunc

/* ===================================================================
/* Macro helpers (section 7)
/* =================================================================== */
!def find(s, c) {
!local i = 0
!while i < len(s) {
!if substr(s, i, 1) == c !then {
!return i
}
!set i = i + 1
}
!return -1
}

/* lst(p, n): the string "p0,p1,...,pn" */
!def lst(p, n) {
!local s = p + "0"
!local i = 1
!while i <= n {
!set s = s + "," + p + str(i)
!set i = i + 1
}
!return s
}

/* xg(nm, base, spec, rc): one instruction row from an operand spec.
/*
/*   nm    mnemonic, upper case (it is a pattern literal)
/*   base  the instruction word with every operand field zero
/*   spec  the operands in source order, comma separated:
/*           rt@21      register variable rt, field at bit shift 21
/*           rt@21e     the same, and the register must be even
/*           xt@21+0    a 6-bit VSX register: low 5 bits at shift 21,
/*                      the high bit at shift 0 (TX/AX/BX/CX)
/*           !u:sh@11/5 an unsigned 5-bit expression at shift 11
/*           !s:si@0/16 a signed 16-bit expression at shift 0
/*   rc    1 also emits the record form "nm." with bit 31 set
/*
/* The register classes come from the .check lists below, so a
/* variable name alone decides which register file an operand takes.
/* The field shifts are LSB-based (shift 21 = the RT/RS/FRT field). */
!def xg(nm, base, spec, rc = 0) {
!local ops = ""
!local fx = ""
!local er = ""
!local s = spec + ","
!local item = ""
!local i = 0
!local c = ""
!local k = ""
!local v = ""
!local at = 0
!local rest = ""
!local p = 0
!local bits = 0
!local mx = 0
!while i < len(s) {
!set c = substr(s, i, 1)
!if c == "," !then {
!if item != "" !then {
!set k = ""
!if substr(item, 0, 1) == "!" !then {
!set k = substr(item, 1, 1)
!set item = substr(item, 3)
}
!set at = find(item, "@")
!set v = substr(item, 0, at)
!set rest = substr(item, at + 1)
!if ops != "" !then {
!set ops = ops + ","
}
!if k == "" !then {
!set ops = ops + v
!if substr(rest, len(rest) - 1, 1) == "e" !then {
!set rest = substr(rest, 0, len(rest) - 1)
!if er != "" !then {
!set er = er + ","
}
!set er = er + "(" + v + "&1)!=0;5"
}
!set p = find(rest, "+")
!if p < 0 !then {
!set fx = fx + "|(" + v + "<<" + rest + ")"
} !else {
!set fx = fx + "|((" + v + "&31)<<" + substr(rest, 0, p) + ")|((" + v + ">>5)<<" + substr(rest, p + 1) + ")"
}
} !else {
!set ops = ops + "!" + v
!set p = find(rest, "/")
!set bits = int(substr(rest, p + 1))
!set mx = (1 << bits) - 1
!set fx = fx + "|((" + v + "&" + str(mx) + ")<<" + substr(rest, 0, p) + ")"
!if er != "" !then {
!set er = er + ","
}
!if k == "u" !then {
!set er = er + v + "<0;3," + v + ">" + str(mx) + ";3"
} !else {
!set er = er + v + "<" + str(-(1 << (bits - 1))) + ";3," + v + ">" + str((1 << (bits - 1)) - 1) + ";3"
}
}
}
!set item = ""
} !else {
!if c != " " !then {
!set item = item + c
}
}
!set i = i + 1
}
!if ops == "" !then {
!{nm} :: .call w4(0x!{base:08x})
!if rc == 1 !then {
!{nm}. :: .call w4(0x!{base | 1:08x})
}
!return
}
!{nm} !{ops} :: !{er} :: .call w4(0x!{base:08x}!{fx})
!if rc == 1 !then {
!{nm}. !{ops} :: !{er} :: .call w4(0x!{base | 1:08x}!{fx})
}
}

/* Shorthands for the common primary opcodes: the extended opcode goes
/* in as the value the survey tables list (xo<<1 is done here). */
!def x31(nm, xo, spec, rc = 0) {
!xg(nm, (31 << 26) | (xo << 1), spec, rc)
}
!def x19(nm, xo, spec, rc = 0) {
!xg(nm, (19 << 26) | (xo << 1), spec, rc)
}
!def x63(nm, xo, spec, rc = 0) {
!xg(nm, (63 << 26) | (xo << 1), spec, rc)
}
!def x59(nm, xo, spec, rc = 0) {
!xg(nm, (59 << 26) | (xo << 1), spec, rc)
}
/* op 4 and op 60 carry the whole low 11 bits as the table value */
!def x4(nm, xo, spec, rc = 0) {
!xg(nm, (4 << 26) | xo, spec, rc)
}
!def x60(nm, xo, spec, rc = 0) {
!xg(nm, (60 << 26) | xo, spec, rc)
}
/* XO form: nm, nm., nmo, nmo. */
!def xoe(nm, xo, spec) {
!x31(nm, xo, spec, 1)
!x31(nm + "O", xo | 512, spec, 1)
}

/* The @-modifier rows for a 16-bit immediate field (the low 16 bits
/* of the word). ops is the operand text before the immediate and f
/* the register-field expression. */
!def hsfx(nm, ops, base, f) {
.reloc::v::addr16_lo
!{nm} !{ops}!v@L :: .call w4(0x!{base:08x}!{f}|(v&0xffff))
.clrreloc::v
.reloc::v::addr16_hi
!{nm} !{ops}!v@H :: .call w4(0x!{base:08x}!{f}|((v>>16)&0xffff))
.clrreloc::v
.reloc::v::addr16_ha
!{nm} !{ops}!v@HA :: .call w4(0x!{base:08x}!{f}|(((v+0x8000)>>16)&0xffff))
.clrreloc::v
.reloc::v::addr16_high
!{nm} !{ops}!v@HIGH :: .call w4(0x!{base:08x}!{f}|((v>>16)&0xffff))
.clrreloc::v
.reloc::v::addr16_higha
!{nm} !{ops}!v@HIGHA :: .call w4(0x!{base:08x}!{f}|(((v+0x8000)>>16)&0xffff))
.clrreloc::v
.reloc::v::addr16_higher
!{nm} !{ops}!v@HIGHER :: .call w4(0x!{base:08x}!{f}|((v>>32)&0xffff))
.clrreloc::v
.reloc::v::addr16_highera
!{nm} !{ops}!v@HIGHERA :: .call w4(0x!{base:08x}!{f}|(((v+0x80008000)>>32)&0xffff))
.clrreloc::v
.reloc::v::addr16_highest
!{nm} !{ops}!v@HIGHEST :: .call w4(0x!{base:08x}!{f}|((v>>48)&0xffff))
.clrreloc::v
.reloc::v::addr16_highesta
!{nm} !{ops}!v@HIGHESTA :: .call w4(0x!{base:08x}!{f}|(((v+0x800080008000)>>48)&0xffff))
.clrreloc::v
}

/* ===================================================================
/* Registers
/* =================================================================== */
!def regs(p, n) {
!local i = 0
!while i <= n {
.setsym::!{p}!{i}::!{i}
.setsym::%!{p}!{i}::!{i}
!set i = i + 1
}
}
!def nums(n) {
!local i = 0
!while i <= n {
.setsym::!{i}::!{i}
!set i = i + 1
}
}
!nums(63)
!regs("R", 31)
!regs("F", 31)
!regs("V", 31)
!regs("VS", 63)
!regs("CR", 7)
.setsym::SP::1
.setsym::RTOC::2

!set N7 = lst("", 7)
!set N31 = lst("", 31)
!set N63 = lst("", 63)
!set GPRS = N31 + "," + lst("R", 31) + "," + lst("%R", 31) + ",SP,RTOC"
!set FPRS = N31 + "," + lst("F", 31) + "," + lst("%F", 31)
!set VRS = N31 + "," + lst("V", 31) + "," + lst("%V", 31)
!set VSRS = N63 + "," + lst("VS", 63) + "," + lst("%VS", 63)
!set CRS = N7 + "," + lst("CR", 7) + "," + lst("%CR", 7)

/* Variable roles. Every one is positional (.check, section 3.7) and
/* is set once here, so an operand of the wrong register file is
/* rejected instead of assembling into wrong bytes.
/*   rt rs ra rb rc      general registers
/*   ft fs fa fb fc      floating-point registers
/*   vt vs va vb vc      vector (VMX) registers
/*   xt xs xa xb xc      VSX registers 0-63
/*   bf bfa              CR fields
/*   acc                 MMA accumulators 0-7 */
.check::rt::!{GPRS}
.check::rs::!{GPRS}
.check::ra::!{GPRS}
.check::rb::!{GPRS}
.check::rc::!{GPRS}
.check::ft::!{FPRS}
.check::fs::!{FPRS}
.check::fa::!{FPRS}
.check::fb::!{FPRS}
.check::fc::!{FPRS}
.check::vt::!{VRS}
.check::vs::!{VRS}
.check::va::!{VRS}
.check::vb::!{VRS}
.check::vc::!{VRS}
.check::xt::!{VSRS}
.check::xs::!{VSRS}
.check::xa::!{VSRS}
.check::xb::!{VSRS}
.check::xc::!{VSRS}
.check::bf::!{CRS}
.check::bfa::!{CRS}
.check::acc::!{N7}

/* ===================================================================
/* Branch
/* =================================================================== */
/* I form. The displacement is relative to the branch itself ($$). */
.reloc::t::rel24
B !t ::((t-$$)<-33554432)||((t-$$)>33554428)||(((t-$$)&3)!=0);2 :: .call w4(0x48000000|((t-$$)&0x3fffffc))
.clrreloc::t
.reloc::t::rel24
BL !t ::((t-$$)<-33554432)||((t-$$)>33554428)||(((t-$$)&3)!=0);2 :: .call w4(0x48000001|((t-$$)&0x3fffffc))
.clrreloc::t
.reloc::t::addr24
BA !t ::(t<-33554432)||(t>33554428)||((t&3)!=0);2 :: .call w4(0x48000002|(t&0x3fffffc))
.clrreloc::t
.reloc::t::addr24
BLA !t ::(t<-33554432)||(t>33554428)||((t&3)!=0);2 :: .call w4(0x48000003|(t&0x3fffffc))
.clrreloc::t

/* B form, raw BO,BI */
.reloc::t::rel14
BC !bo,!bi,!t ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,((t-$$)<-32768)||((t-$$)>32764)||(((t-$$)&3)!=0);2 :: .call w4(0x40000000|(bo<<21)|(bi<<16)|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::rel14
BCL !bo,!bi,!t ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,((t-$$)<-32768)||((t-$$)>32764)||(((t-$$)&3)!=0);2 :: .call w4(0x40000001|(bo<<21)|(bi<<16)|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::addr14
BCA !bo,!bi,!t ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,(t<-32768)||(t>32764)||((t&3)!=0);2 :: .call w4(0x40000002|(bo<<21)|(bi<<16)|(t&0xfffc))
.clrreloc::t
.reloc::t::addr14
BCLA !bo,!bi,!t ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,(t<-32768)||(t>32764)||((t&3)!=0);2 :: .call w4(0x40000003|(bo<<21)|(bi<<16)|(t&0xfffc))
.clrreloc::t

/* XL form, raw BO,BI[,BH] */
BCLR !bo,!bi[[,!bh]] ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,bh<0;3,bh>3;3 :: .call w4(0x4c000020|(bo<<21)|(bi<<16)|(bh<<11))
BCLRL !bo,!bi[[,!bh]] ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,bh<0;3,bh>3;3 :: .call w4(0x4c000021|(bo<<21)|(bi<<16)|(bh<<11))
BCCTR !bo,!bi[[,!bh]] ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,bh<0;3,bh>3;3 :: .call w4(0x4c000420|(bo<<21)|(bi<<16)|(bh<<11))
BCCTRL !bo,!bi[[,!bh]] ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,bh<0;3,bh>3;3 :: .call w4(0x4c000421|(bo<<21)|(bi<<16)|(bh<<11))
BCTAR !bo,!bi[[,!bh]] ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,bh<0;3,bh>3;3 :: .call w4(0x4c000460|(bo<<21)|(bi<<16)|(bh<<11))
BCTARL !bo,!bi[[,!bh]] ::bo<0;3,bo>31;3,bi<0;3,bi>31;3,bh<0;3,bh>3;3 :: .call w4(0x4c000461|(bo<<21)|(bi<<16)|(bh<<11))

/* Unconditional to LR / CTR */
BLR :: .call w4(0x4e800020)
BLRL :: .call w4(0x4e800021)
BCTR :: .call w4(0x4e800420)
BCTRL :: .call w4(0x4e800421)

/* Extended conditional branches.
/*
/* bcr(nm, h, bo, bi, cf): the shapes of one decrement / CR-bit
/* condition -- to a target (l, a, la) and to LR / CTR (lrl, ctrl).
/* h is the "+" / "-" prediction hint, which goes after the whole
/* mnemonic (bdnzl+, btctr-). cf = 2 means BI is written as an
/* expression operand (bt / bdnzt family); cf = 0 means there is no
/* BI at all (bdnz family). */
!def bcr(nm, h, bo, bi, cf, ctr = 1) {
!local b = (16 << 26) | (bo << 21) | (bi << 16)
!local l = (19 << 26) | (bo << 21) | (bi << 16) | (16 << 1)
!local c = (19 << 26) | (bo << 21) | (bi << 16) | (528 << 1)
!local rel = "((t-$$)<-32768)||((t-$$)>32764)||(((t-$$)&3)!=0);2"
!local ab = "(t<-32768)||(t>32764)||((t&3)!=0);2"
!local bie = "bi<0;3,bi>31;3,"
!if cf == 0 !then {
.reloc::t::rel14
!{nm}!{h} !t ::!{rel} :: .call w4(0x!{b:08x}|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::rel14
!{nm}L!{h} !t ::!{rel} :: .call w4(0x!{b | 1:08x}|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}A!{h} !t ::!{ab} :: .call w4(0x!{b | 2:08x}|(t&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}LA!{h} !t ::!{ab} :: .call w4(0x!{b | 3:08x}|(t&0xfffc))
.clrreloc::t
!{nm}LR!{h} :: .call w4(0x!{l:08x})
!{nm}LRL!{h} :: .call w4(0x!{l | 1:08x})
}
!if cf == 2 !then {
.reloc::t::rel14
!{nm}!{h} !bi,!t ::!{bie}!{rel} :: .call w4(0x!{b:08x}|(bi<<16)|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::rel14
!{nm}L!{h} !bi,!t ::!{bie}!{rel} :: .call w4(0x!{b | 1:08x}|(bi<<16)|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}A!{h} !bi,!t ::!{bie}!{ab} :: .call w4(0x!{b | 2:08x}|(bi<<16)|(t&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}LA!{h} !bi,!t ::!{bie}!{ab} :: .call w4(0x!{b | 3:08x}|(bi<<16)|(t&0xfffc))
.clrreloc::t
!{nm}LR!{h} !bi ::!{bie} :: .call w4(0x!{l:08x}|(bi<<16))
!{nm}LRL!{h} !bi ::!{bie} :: .call w4(0x!{l | 1:08x}|(bi<<16))
!if ctr == 1 !then {
!{nm}CTR!{h} !bi ::!{bie} :: .call w4(0x!{c:08x}|(bi<<16))
!{nm}CTRL!{h} !bi ::!{bie} :: .call w4(0x!{c | 1:08x}|(bi<<16))
}
}
}

/* Conditions on a CR field (beq, bnelr+, bgectrl- ...), with an
/* optional CR field operand in front (beq cr7,x adds 4*crf to BI).
/* The hints use the Power ISA "at" bits of BO: "+" = at 11 (likely
/* taken), "-" = at 10 (likely not taken). */
!def bch(cn, bo, bit) {
!local sfx = ""
!local k = 0
!local b = 0
!while k < 3 {
!if k == 0 !then {
!set sfx = "-"
!set b = bo | 2
}
!if k == 1 !then {
!set sfx = "+"
!set b = bo | 3
}
!if k == 2 !then {
!set sfx = ""
!set b = bo
}
!bcx("B" + cn, sfx, b, bit)
!set k = k + 1
}
}
!def bcx(nm, h, bo, bi) {
!local b = (16 << 26) | (bo << 21) | (bi << 16)
!local l = (19 << 26) | (bo << 21) | (bi << 16) | (16 << 1)
!local c = (19 << 26) | (bo << 21) | (bi << 16) | (528 << 1)
!local rel = "((t-$$)<-32768)||((t-$$)>32764)||(((t-$$)&3)!=0);2"
!local ab = "(t<-32768)||(t>32764)||((t&3)!=0);2"
.reloc::t::rel14
!{nm}!{h} !t ::!{rel} :: .call w4(0x!{b:08x}|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::rel14
!{nm}!{h} bf,!t ::!{rel} :: .call w4(0x!{b:08x}|(bf<<18)|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::rel14
!{nm}L!{h} !t ::!{rel} :: .call w4(0x!{b | 1:08x}|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::rel14
!{nm}L!{h} bf,!t ::!{rel} :: .call w4(0x!{b | 1:08x}|(bf<<18)|((t-$$)&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}A!{h} !t ::!{ab} :: .call w4(0x!{b | 2:08x}|(t&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}A!{h} bf,!t ::!{ab} :: .call w4(0x!{b | 2:08x}|(bf<<18)|(t&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}LA!{h} !t ::!{ab} :: .call w4(0x!{b | 3:08x}|(t&0xfffc))
.clrreloc::t
.reloc::t::addr14
!{nm}LA!{h} bf,!t ::!{ab} :: .call w4(0x!{b | 3:08x}|(bf<<18)|(t&0xfffc))
.clrreloc::t
!{nm}LR!{h} :: .call w4(0x!{l:08x})
!{nm}LR!{h} bf :: .call w4(0x!{l:08x}|(bf<<18))
!{nm}LRL!{h} :: .call w4(0x!{l | 1:08x})
!{nm}LRL!{h} bf :: .call w4(0x!{l | 1:08x}|(bf<<18))
!{nm}CTR!{h} :: .call w4(0x!{c:08x})
!{nm}CTR!{h} bf :: .call w4(0x!{c:08x}|(bf<<18))
!{nm}CTRL!{h} :: .call w4(0x!{c | 1:08x})
!{nm}CTRL!{h} bf :: .call w4(0x!{c | 1:08x}|(bf<<18))
}

/* condition   BO (12 = branch if the bit is set, 4 = if clear)  bit */
!bch("LT", 12, 0)
!bch("LE", 4, 1)
!bch("EQ", 12, 2)
!bch("GE", 4, 0)
!bch("GT", 12, 1)
!bch("NL", 4, 0)
!bch("NE", 4, 2)
!bch("NG", 4, 1)
!bch("SO", 12, 3)
!bch("NS", 4, 3)
!bch("UN", 12, 3)
!bch("NU", 4, 3)

/* Decrement CTR: bdnz / bdz, with hints (BO 1a00t: "+" a=1 t=1,
/* "-" a=1 t=0), and the CR-bit conditional forms. */
!bcr("BDNZ", "-", 24, 0, 0)
!bcr("BDNZ", "+", 25, 0, 0)
!bcr("BDNZ", "", 16, 0, 0)
!bcr("BDZ", "-", 26, 0, 0)
!bcr("BDZ", "+", 27, 0, 0)
!bcr("BDZ", "", 18, 0, 0)
!bcr("BDNZT", "", 8, 0, 2, 0)
!bcr("BDNZF", "", 0, 0, 2, 0)
!bcr("BDZT", "", 10, 0, 2, 0)
!bcr("BDZF", "", 2, 0, 2, 0)
/* Branch on a CR bit given as an operand. The hinted rows come
/* first so that "bt- 5,x" is never read as "bt" with BI = -5. */
!bcr("BT", "-", 14, 0, 2)
!bcr("BT", "+", 15, 0, 2)
!bcr("BT", "", 12, 0, 2)
!bcr("BF", "-", 6, 0, 2)
!bcr("BF", "+", 7, 0, 2)
!bcr("BF", "", 4, 0, 2)

/* ===================================================================
/* CR logical, system call and return from interrupt
/* =================================================================== */
!def crl(nm, xo) {
!x19(nm, xo, "!u:bt@21/5,!u:ba@16/5,!u:bb@11/5")
}
!crl("CRAND", 257)
!crl("CRNAND", 225)
!crl("CROR", 449)
!crl("CRXOR", 193)
!crl("CRNOR", 33)
!crl("CREQV", 289)
