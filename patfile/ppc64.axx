/* XS form: 6-bit SH, sh5 at bit 30 */
!def xsf(nm, base) {
!{nm} ra,rs,!sh ::sh<0;10,sh>63;10 :: .call w4(0x!{base:08x}|(rs<<21)|(ra<<16)|((sh&31)<<11)|(((sh>>5)&1)<<1))
!{nm}. ra,rs,!sh ::sh<0;10,sh>63;10 :: .call w4(0x!{base | 1:08x}|(rs<<21)|(ra<<16)|((sh&31)<<11)|(((sh>>5)&1)<<1))
}
!xsf("SRADI", 0x7c000674)
!xsf("EXTSWSLI", 0x7c0006f4)

/* Extended rotate mnemonics, word (rlwinm / rlwnm / rlwimi) */
!def rlwx(sfx, rc) {
ROTLWI!{sfx} ra,rs,!n ::n<0;10,n>31;10 :: .call rlw(21,rs,ra,n,0,31,!{rc})
ROTRWI!{sfx} ra,rs,!n ::n<0;10,n>31;10 :: .call rlw(21,rs,ra,32-n,0,31,!{rc})
SLWI!{sfx} ra,rs,!n ::n<0;10,n>31;10 :: .call rlw(21,rs,ra,n,0,31-n,!{rc})
SRWI!{sfx} ra,rs,!n ::n<0;10,n>31;10 :: .call rlw(21,rs,ra,32-n,n,31,!{rc})
CLRLWI!{sfx} ra,rs,!n ::n<0;10,n>31;10 :: .call rlw(21,rs,ra,0,n,31,!{rc})
CLRRWI!{sfx} ra,rs,!n ::n<0;10,n>31;10 :: .call rlw(21,rs,ra,0,0,31-n,!{rc})
EXTLWI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>32;10 :: .call rlw(21,rs,ra,b,0,n-1,!{rc})
EXTRWI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>32;10 :: .call rlw(21,rs,ra,b+n,32-n,31,!{rc})
INSLWI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>32;10 :: .call rlw(20,rs,ra,32-b,b,b+n-1,!{rc})
INSRWI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>32;10 :: .call rlw(20,rs,ra,32-(b+n),b,b+n-1,!{rc})
CLRLSLWI!{sfx} ra,rs,!b,!n ::n<0;10,b<n;10,b>31;10 :: .call rlw(21,rs,ra,n,b-n,31-n,!{rc})
ROTLW!{sfx} ra,rs,rb :: .call w4(0x!{0x5c00003e | rc:08x}|(rs<<21)|(ra<<16)|(rb<<11))
}
!rlwx("", 0)
!rlwx(".", 1)
/* Extended rotate mnemonics, doubleword (rldicl / rldicr / rldic /
/* rldimi / rldcl) */
!def rldx(sfx, rc) {
ROTLDI!{sfx} ra,rs,!n ::n<0;10,n>63;10 :: .call md(0,rs,ra,n,0,!{rc})
ROTRDI!{sfx} ra,rs,!n ::n<0;10,n>63;10 :: .call md(0,rs,ra,(64-n)&63,0,!{rc})
SLDI!{sfx} ra,rs,!n ::n<0;10,n>63;10 :: .call md(1,rs,ra,n,63-n,!{rc})
SRDI!{sfx} ra,rs,!n ::n<0;10,n>63;10 :: .call md(0,rs,ra,(64-n)&63,n,!{rc})
CLRLDI!{sfx} ra,rs,!n ::n<0;10,n>63;10 :: .call md(0,rs,ra,0,n,!{rc})
CLRRDI!{sfx} ra,rs,!n ::n<0;10,n>63;10 :: .call md(1,rs,ra,0,63-n,!{rc})
EXTLDI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>64;10 :: .call md(1,rs,ra,b,n-1,!{rc})
EXTRDI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>64;10 :: .call md(0,rs,ra,(b+n)&63,64-n,!{rc})
INSRDI!{sfx} ra,rs,!n,!b ::n<1;10,b<0;10,n+b>64;10 :: .call md(3,rs,ra,(64-(b+n))&63,b,!{rc})
CLRLSLDI!{sfx} ra,rs,!b,!n ::n<0;10,b<n;10,b>63;10 :: .call md(2,rs,ra,n,b-n,!{rc})
ROTLD!{sfx} ra,rs,rb :: .call w4(0x!{0x78000010 | rc:08x}|(rs<<21)|(ra<<16)|(rb<<11))
}
!rldx("", 0)
!rldx(".", 1)

/* ===================================================================
/* Move to/from SPR, CR, MSR
/* =================================================================== */
/* The SPR number is written with its two 5-bit halves swapped. */
MFSPR rt,!n ::n<0;3,n>1023;3 :: .call w4(0x7c0002a6|(rt<<21)|((n&31)<<16)|(((n>>5)&31)<<11))
MTSPR !n,rs ::n<0;3,n>1023;3 :: .call w4(0x7c0003a6|(rs<<21)|((n&31)<<16)|(((n>>5)&31)<<11))
!def spr(nm, n, rw = 3) {
!local f = ((n & 31) << 16) | ((n >> 5) << 11)
!if (rw & 1) != 0 !then {
MF!{nm} rt :: .call w4(0x!{0x7c0002a6 | f:08x}|(rt<<21))
}
!if (rw & 2) != 0 !then {
MT!{nm} rs :: .call w4(0x!{0x7c0003a6 | f:08x}|(rs<<21))
}
}
