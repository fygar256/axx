CMP bf,!l,ra,rb ::l<0;3,l>1;3 :: .call w4(0x7c000000|(bf<<23)|(l<<21)|(ra<<16)|(rb<<11))
CMPL bf,!l,ra,rb ::l<0;3,l>1;3 :: .call w4(0x7c000040|(bf<<23)|(l<<21)|(ra<<16)|(rb<<11))
.reloc::v::addr16
CMPI bf,!l,ra,!v ::l<0;3,l>1;3,v<-32768;3,v>32767;3 :: .call w4(0x2c000000|(bf<<23)|(l<<21)|(ra<<16)|(v&0xffff))
.clrreloc::v
