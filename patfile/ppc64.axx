/* ===================================================================
/* Fixed-point arithmetic
/* =================================================================== */
/* D form with a signed 16-bit immediate: rt,ra,SI */
!def dsi(nm, op, lo = -32768, hi = 32767) {
.reloc::v::addr16
!{nm} rt,ra,!v ::v<!{lo};3,v>!{hi};3 :: .call w4(0x!{op << 26:08x}|(rt<<21)|(ra<<16)|(v&0xffff))
.clrreloc::v
!hsfx(nm, "rt,ra,", op << 26, "|(rt<<21)|(ra<<16)")
}
!dsi("ADDI", 14)
!dsi("ADDIS", 15, -32768, 65535)
!dsi("ADDIC", 12)
!dsi("ADDIC.", 13)
!dsi("SUBFIC", 8)
!dsi("MULLI", 7)
/* negated-immediate aliases */
SUBI rt,ra,!v ::v<-32767;3,v>32768;3 :: .call w4(0x38000000|(rt<<21)|(ra<<16)|((-v)&0xffff))
SUBIS rt,ra,!v ::v<-65535;3,v>32768;3 :: .call w4(0x3c000000|(rt<<21)|(ra<<16)|((-v)&0xffff))
SUBIC rt,ra,!v ::v<-32767;3,v>32768;3 :: .call w4(0x30000000|(rt<<21)|(ra<<16)|((-v)&0xffff))
SUBIC. rt,ra,!v ::v<-32767;3,v>32768;3 :: .call w4(0x34000000|(rt<<21)|(ra<<16)|((-v)&0xffff))
/* li / lis / la */
.reloc::v::addr16
LI rt,!v ::v<-32768;3,v>32767;3 :: .call w4(0x38000000|(rt<<21)|(v&0xffff))
.clrreloc::v
!hsfx("LI", "rt,", 14 << 26, "|(rt<<21)")
.reloc::v::addr16
LIS rt,!v ::v<-32768;3,v>65535;3 :: .call w4(0x3c000000|(rt<<21)|(v&0xffff))
.clrreloc::v
!hsfx("LIS", "rt,", 15 << 26, "|(rt<<21)")
.reloc::d::addr16
LA rt,!d(ra) ::d<-32768;3,d>32767;3 :: .call w4(0x38000000|(rt<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
.reloc::d::addr16_lo
LA rt,!d@L(ra) :: .call w4(0x38000000|(rt<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
/* addpcis: DX form, D split d0:d1:d2; lnia and subpcis */
ADDPCIS rt,!d ::d<-32768;3,d>32767;3 :: .call w4(0x4c000004|(rt<<21)|(((d>>1)&31)<<16)|(((d>>6)&0x3ff)<<6)|(d&1))
SUBPCIS rt,!d ::d<-32767;3,d>32768;3 :: .call w4(0x4c000004|(rt<<21)|((((-d)>>1)&31)<<16)|((((-d)>>6)&0x3ff)<<6)|((-d)&1))
LNIA rt :: .call w4(0x4c000004|(rt<<21))

/* XO form: rt,ra,rb with o / . / o. */
!def xo3(nm, xo) {
!xoe(nm, xo, "rt@21,ra@16,rb@11")
}
!def xo2(nm, xo) {
!xoe(nm, xo, "rt@21,ra@16")
}
