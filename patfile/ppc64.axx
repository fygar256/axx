/* ===================================================================
/* Fixed-point rotate and shift
/* =================================================================== */
!def rlwm(nm, op) {
!{nm} ra,rs,!sh,!mb,!me ::sh<0;10,sh>31;10,mb<0;10,mb>31;10,me<0;10,me>31;10 :: .call rlw(!{op},rs,ra,sh,mb,me,0)
!{nm}. ra,rs,!sh,!mb,!me ::sh<0;10,sh>31;10,mb<0;10,mb>31;10,me<0;10,me>31;10 :: .call rlw(!{op},rs,ra,sh,mb,me,1)
}
!rlwm("RLWINM", 21)
!rlwm("RLWIMI", 20)
RLWNM ra,rs,rb,!mb,!me ::mb<0;10,mb>31;10,me<0;10,me>31;10 :: .call w4(0x5c000000|(rs<<21)|(ra<<16)|(rb<<11)|(mb<<6)|(me<<1))
RLWNM. ra,rs,rb,!mb,!me ::mb<0;10,mb>31;10,me<0;10,me>31;10 :: .call w4(0x5c000001|(rs<<21)|(ra<<16)|(rb<<11)|(mb<<6)|(me<<1))
!def mdr(nm, xo) {
!{nm} ra,rs,!sh,!mb ::sh<0;10,sh>63;10,mb<0;10,mb>63;10 :: .call md(!{xo},rs,ra,sh,mb,0)
!{nm}. ra,rs,!sh,!mb ::sh<0;10,sh>63;10,mb<0;10,mb>63;10 :: .call md(!{xo},rs,ra,sh,mb,1)
}
!mdr("RLDICL", 0)
!mdr("RLDICR", 1)
!mdr("RLDIC", 2)
!mdr("RLDIMI", 3)
!def mdsr(nm, xo) {
!{nm} ra,rs,rb,!mb ::mb<0;10,mb>63;10 :: .call w4(0x!{(30 << 26) | (xo << 1):08x}|(rs<<21)|(ra<<16)|(rb<<11)|((((mb&31)<<1)|((mb>>5)&1))<<5))
!{nm}. ra,rs,rb,!mb ::mb<0;10,mb>63;10 :: .call w4(0x!{(30 << 26) | (xo << 1) | 1:08x}|(rs<<21)|(ra<<16)|(rb<<11)|((((mb&31)<<1)|((mb>>5)&1))<<5))
}
!mdsr("RLDCL", 8)
!mdsr("RLDCR", 9)
!xlog("SLW", 24)
!xlog("SRW", 536)
!xlog("SRAW", 792)
!xlog("SLD", 27)
!xlog("SRD", 539)
!xlog("SRAD", 794)
