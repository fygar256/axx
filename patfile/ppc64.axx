/* extended mnemonics */
XXMRGHD xt,xa,xb :: .call w4(0xf0000050|((xt&31)<<21)|((xt>>5)&1)|((xa&31)<<16)|(((xa>>5)&1)<<2)|((xb&31)<<11)|(((xb>>5)&1)<<1))
XXMRGLD xt,xa,xb :: .call w4(0xf0000350|((xt&31)<<21)|((xt>>5)&1)|((xa&31)<<16)|(((xa>>5)&1)<<2)|((xb&31)<<11)|(((xb>>5)&1)<<1))
XXSWAPD xt,xa :: .call w4(0xf0000250|((xt&31)<<21)|((xt>>5)&1)|((xa&31)<<16)|(((xa>>5)&1)<<2)|((xa&31)<<11)|(((xa>>5)&1)<<1))
XXSPLTD xt,xa,!d ::d<0;3,d>1;3 :: .call w4(0xf0000050|((d*3)<<8)|((xt&31)<<21)|((xt>>5)&1)|((xa&31)<<16)|(((xa>>5)&1)<<2)|((xa&31)<<11)|(((xa>>5)&1)<<1))
XXMR xt,xa :: .call w4(0xf0000490|((xt&31)<<21)|((xt>>5)&1)|((xa&31)<<16)|(((xa>>5)&1)<<2)|((xa&31)<<11)|(((xa>>5)&1)<<1))
XXLNOT xt,xa :: .call w4(0xf0000510|((xt&31)<<21)|((xt>>5)&1)|((xa&31)<<16)|(((xa>>5)&1)<<2)|((xa&31)<<11)|(((xa>>5)&1)<<1))

