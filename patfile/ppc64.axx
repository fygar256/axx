MTTBL rs :: .call w4(0x7c1c43a6|(rs<<21))
MTTBU rs :: .call w4(0x7c1d43a6|(rs<<21))
/* mftb / mftbu are written as mfspr 268 / 269, as GNU as does for
/* POWER4 and later (the old XFX opcode 371 is phased out). */
MFTB rt :: .call w4(0x7c0c42a6|(rt<<21))
MFTB rt,!n ::n<0;3,n>1023;3 :: .call w4(0x7c0002a6|(rt<<21)|((n&31)<<16)|(((n>>5)&31)<<11))
MFTBU rt :: .call w4(0x7c0d42a6|(rt<<21))
