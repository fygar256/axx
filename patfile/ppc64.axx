!if pair == 0 !then {
!xg(nm, (59 << 26) | (xo << 3), "!u:acc@23/3,xa@16+2,xb@11+1")
}
!if pair == 1 !then {
!xg(nm, (59 << 26) | (xo << 3), "!u:acc@23/3,xa@16+2e,xb@11+1")
}
}
