!pger("XVF64GERPP", 58, -1)
!pger("XVF64GERPN", 186, -1)
!pger("XVF64GERNP", 122, -1)
!pger("XVF64GERNN", 250, -1)
!set D34 = "d<-8589934592;8,d>8589934591;8"
/* pfx(nm, ptype, sop, reg, sfx): ptype 0x04000000 (8LS) or
/* 0x06000000 (MLS); sop is the suffix word with the operand fields
/* zero; reg is the data operand ("rt", or "xt6" / "xs6" for the VSX
/* forms whose TX bit sits in the suffix opcode, or "xtp" / "xsp" for
/* the paired forms). */
!def pfx(nm, ptype, sop, reg) {
!local rf = "(" + reg + "<<21)"
!local rv = reg
!local er = ""
!if reg == "xt6" !then {
!set rv = "xt"
!set rf = "((xt&31)<<21)|(((xt>>5)&1)<<26)"
}
!if reg == "xs6" !then {
!set rv = "xs"
!set rf = "((xs&31)<<21)|(((xs>>5)&1)<<26)"
}
!if reg == "xtp" !then {
!set rv = "xt"
!set rf = "(((xt>>1)&15)<<22)|(((xt>>5)&1)<<21)"
!set er = "(xt&1)!=0;5,"
}
!if reg == "xsp" !then {
!set rv = "xs"
!set rf = "(((xs>>1)&15)<<22)|(((xs>>5)&1)<<21)"
!set er = "(xs&1)!=0;5,"
}
!if reg == "rte" !then {
!set rv = "rt"
!set rf = "(rt<<21)"
!set er = "(rt&1)!=0;5,"
}
!if reg == "rse" !then {
!set rv = "rs"
!set rf = "(rs<<21)"
!set er = "(rs&1)!=0;5,"
}
.reloc::d::d34
!{nm} !{rv},!d(ra) ::!{er}!{D34} :: !{PAD}.call w8(0x!{ptype:08x}|((d>>16)&0x3ffff),0x!{sop:08x}|!{rf}|(ra<<16)|(d&0xffff))
.clrreloc::d
!{nm} !{rv},!d(ra),!r ::!{er}!{D34},r<0;3,r>1;3,(r==1)&&(ra!=0);5 :: !{PAD}.call w8(0x!{ptype:08x}|(r<<20)|((d>>16)&0x3ffff),0x!{sop:08x}|!{rf}|(ra<<16)|(d&0xffff))
.reloc::t::pcrel34
!{nm} !{rv},!t@PCREL ::!{er}((t-!{PQ})<-8589934592)||((t-!{PQ})>8589934591);8 :: !{PAD}.call w8(0x!{ptype | 0x100000:08x}|(((t-!{PQ})>>16)&0x3ffff),0x!{sop:08x}|!{rf}|((t-!{PQ})&0xffff))
.clrreloc::t
}
/* MLS: the D-form loads and stores and paddi */
!pfx("PLBZ", 0x06000000, 34 << 26, "rt")
!pfx("PLHZ", 0x06000000, 40 << 26, "rt")
!pfx("PLHA", 0x06000000, 42 << 26, "rt")
!pfx("PLWZ", 0x06000000, 32 << 26, "rt")
!pfx("PSTB", 0x06000000, 38 << 26, "rs")
!pfx("PSTH", 0x06000000, 44 << 26, "rs")
!pfx("PSTW", 0x06000000, 36 << 26, "rs")
!pfx("PLFS", 0x06000000, 48 << 26, "ft")
!pfx("PLFD", 0x06000000, 50 << 26, "ft")
!pfx("PSTFS", 0x06000000, 52 << 26, "fs")
!pfx("PSTFD", 0x06000000, 54 << 26, "fs")
!pfx("PLA", 0x06000000, 14 << 26, "rt")
/* 8LS: the DS/DQ-form ones, whose suffix has its own opcode */
!pfx("PLD", 0x04000000, 57 << 26, "rt")
!pfx("PSTD", 0x04000000, 61 << 26, "rs")
!pfx("PLWA", 0x04000000, 41 << 26, "rt")
!pfx("PLQ", 0x04000000, 56 << 26, "rte")
!pfx("PSTQ", 0x04000000, 60 << 26, "rse")
!pfx("PLXSD", 0x04000000, 42 << 26, "vt")
!pfx("PLXSSP", 0x04000000, 43 << 26, "vt")
!pfx("PSTXSD", 0x04000000, 46 << 26, "vs")
!pfx("PSTXSSP", 0x04000000, 47 << 26, "vs")
!pfx("PLXV", 0x04000000, 50 << 26, "xt6")
!pfx("PSTXV", 0x04000000, 54 << 26, "xs6")
!pfx("PLXVP", 0x04000000, 58 << 26, "xtp")
!pfx("PSTXVP", 0x04000000, 62 << 26, "xsp")
/* paddi / pli */
.reloc::d::d34
PADDI rt,ra,!d ::!{D34} :: !{PAD}.call w8(0x06000000|((d>>16)&0x3ffff),0x38000000|(rt<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
PADDI rt,ra,!d,!r ::!{D34},r<0;3,r>1;3,(r==1)&&(ra!=0);5 :: !{PAD}.call w8(0x06000000|(r<<20)|((d>>16)&0x3ffff),0x38000000|(rt<<21)|(ra<<16)|(d&0xffff))
.reloc::d::d34
PLI rt,!d ::!{D34} :: !{PAD}.call w8(0x06000000|((d>>16)&0x3ffff),0x38000000|(rt<<21)|(d&0xffff))
.clrreloc::d
PNOP :: :: !{PAD}.call w8(0x07000000,0x00000000)
/* 8RR / MMIRR VSX: the immediate lives in the prefix */
XXSPLTI32DX xt,!ix,!v ::ix<0;3,ix>1;3,v<-2147483648;3,v>4294967295;3 :: !{PAD}.call w8(0x05000000|((v>>16)&0xffff),0x80000000|((xt&31)<<21)|(ix<<17)|(((xt>>5)&1)<<16)|(v&0xffff))
XXSPLTIW xt,!v ::v<-2147483648;3,v>4294967295;3 :: !{PAD}.call w8(0x05000000|((v>>16)&0xffff),0x80060000|((xt&31)<<21)|(((xt>>5)&1)<<16)|(v&0xffff))
XXSPLTIDP xt,!v ::v<-2147483648;3,v>4294967295;3 :: !{PAD}.call w8(0x05000000|((v>>16)&0xffff),0x80040000|((xt&31)<<21)|(((xt>>5)&1)<<16)|(v&0xffff))
!def xx4p(nm, pw, sw, imm) {
!local f = "((xt&31)<<21)|((xa&31)<<16)|((xb&31)<<11)|((xc&31)<<6)|(((xc>>5)&1)<<3)|(((xa>>5)&1)<<2)|(((xb>>5)&1)<<1)|((xt>>5)&1)"
!if imm == 0 !then {
!{nm} xt,xa,xb,xc :: :: !{PAD}.call w8(0x!{pw:08x},0x!{sw:08x}|!{f})
}
!if imm == 3 !then {
!{nm} xt,xa,xb,xc,!u ::u<0;3,u>7;3 :: !{PAD}.call w8(0x!{pw:08x}|u,0x!{sw:08x}|!{f})
}
!if imm == 8 !then {
!{nm} xt,xa,xb,xc,!u ::u<0;3,u>255;3 :: !{PAD}.call w8(0x!{pw:08x}|u,0x!{sw:08x}|!{f})
}
}
!xx4p("XXBLENDVB", 0x05000000, 0x84000000, 0)
!xx4p("XXBLENDVH", 0x05000000, 0x84000010, 0)
!xx4p("XXBLENDVW", 0x05000000, 0x84000020, 0)
!xx4p("XXBLENDVD", 0x05000000, 0x84000030, 0)
!xx4p("XXPERMX", 0x05000000, 0x88000000, 3)
!xx4p("XXEVAL", 0x05000000, 0x88000010, 8)

/* ===================================================================
/* Data, in the target byte order
/*
/* axx itself provides .ascii / .asciz / .zero / .resb ... ; these add
/* the GNU spellings of the sized integer directives. One value per
/* line. The bytes are written one list element each, so that under -o
/* a symbol in the value is seen across the whole field and gets the
/* data relocation of that width (ADDR16 / ADDR32 / ADDR64).
/* =================================================================== */
.BYTE !v :: v&0xff
.SHORT !v :: @@[2,(v>>(8*(1*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.HWORD !v :: @@[2,(v>>(8*(1*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.2BYTE !v :: @@[2,(v>>(8*(1*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.LONG !v :: @@[4,(v>>(8*(3*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.WORD !v :: @@[4,(v>>(8*(3*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.4BYTE !v :: @@[4,(v>>(8*(3*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.QUAD !v :: @@[8,(v>>(8*(7*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.8BYTE !v :: @@[8,(v>>(8*(7*(1-#PPCLE)+(%%)*(2*(#PPCLE)-1))))&0xff]
.FLOAT !Fv :: .call w4(v)
.DOUBLE !Dv :: .call d8(v)
