/* mtvsrbmi: DX form, b0 at 6 (10 bits), b1 at 16 (5 bits), b2 at 0 */
MTVSRBMI vt,!b ::b<0;3,b>65535;3 :: .call w4(0x10000014|(vt<<21)|(((b>>6)&0x3ff)<<6)|(((b>>1)&31)<<16)|(b&1))
/* vector string/BCD aliases GNU accepts */
VMR vt,va :: .call w4(0x10000484|(vt<<21)|(va<<16)|(va<<11))
VNOT vt,va :: .call w4(0x10000504|(vt<<21)|(va<<16)|(va<<11))

