!def larx(nm, xo, ev = 0) {
!if ev == 0 !then {
!x31(nm, xo, "rt@21,ra@16,rb@11")
!x31(nm, xo, "rt@21,ra@16,rb@11,!u:eh@0/1")
}
!if ev == 1 !then {
!x31(nm, xo, "rt@21e,ra@16,rb@11")
!x31(nm, xo, "rt@21e,ra@16,rb@11,!u:eh@0/1")
}
}
