/* Load / store multiple: big-endian mode only (Power ISA), so the
/* little-endian wrapper reports error 15 for them. */
.reloc::d::addr16
LMW rt,!d(ra) ::#PPCLE!=0;15,d<-32768;8,d>32767;8 :: .call w4(0xb8000000|(rt<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
LMW rt,(ra) ::#PPCLE!=0;15 :: .call w4(0xb8000000|(rt<<21)|(ra<<16))
.reloc::d::addr16_lo
LMW rt,!d@L(ra) ::#PPCLE!=0;15 :: .call w4(0xb8000000|(rt<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
.reloc::d::addr16_hi
LMW rt,!d@H(ra) ::#PPCLE!=0;15 :: .call w4(0xb8000000|(rt<<21)|(ra<<16)|((d>>16)&0xffff))
.clrreloc::d
.reloc::d::addr16_ha
LMW rt,!d@HA(ra) ::#PPCLE!=0;15 :: .call w4(0xb8000000|(rt<<21)|(ra<<16)|(((d+0x8000)>>16)&0xffff))
.clrreloc::d
.reloc::d::addr16
STMW rs,!d(ra) ::#PPCLE!=0;15,d<-32768;8,d>32767;8 :: .call w4(0xbc000000|(rs<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
STMW rs,(ra) ::#PPCLE!=0;15 :: .call w4(0xbc000000|(rs<<21)|(ra<<16))
.reloc::d::addr16_lo
STMW rs,!d@L(ra) ::#PPCLE!=0;15 :: .call w4(0xbc000000|(rs<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
.reloc::d::addr16_hi
STMW rs,!d@H(ra) ::#PPCLE!=0;15 :: .call w4(0xbc000000|(rs<<21)|(ra<<16)|((d>>16)&0xffff))
.clrreloc::d
.reloc::d::addr16_ha
STMW rs,!d@HA(ra) ::#PPCLE!=0;15 :: .call w4(0xbc000000|(rs<<21)|(ra<<16)|(((d+0x8000)>>16)&0xffff))
.clrreloc::d
!dsmem("LD", 58, 0, "rt")
!dsmem("LDU", 58, 1, "rt")
!dsmem("LWA", 58, 2, "rt")
!dsmem("STD", 62, 0, "rs")
!dsmem("STDU", 62, 1, "rs")
/* quadword: RTp / RSp is an even register */
.reloc::d::addr16_ds
LQ rt,!d(ra) ::(rt&1)!=0;5,d<-32768;8,d>32767;8,(d&15)!=0;8 :: .call w4(0xe0000000|(rt<<21)|(ra<<16)|(d&0xfff0))
.clrreloc::d
.reloc::d::addr16_lo_ds
LQ rt,!d@L(ra) ::(rt&1)!=0;5,(d&15)!=0;8 :: .call w4(0xe0000000|(rt<<21)|(ra<<16)|(d&0xfff0))
.clrreloc::d
LQ rt,(ra) ::(rt&1)!=0;5 :: .call w4(0xe0000000|(rt<<21)|(ra<<16))
.reloc::d::addr16_ds
STQ rs,!d(ra) ::(rs&1)!=0;5,d<-32768;8,d>32767;8,(d&3)!=0;8 :: .call w4(0xf8000002|(rs<<21)|(ra<<16)|(d&0xfffc))
.clrreloc::d
.reloc::d::addr16_lo_ds
STQ rs,!d@L(ra) ::(rs&1)!=0;5,(d&3)!=0;8 :: .call w4(0xf8000002|(rs<<21)|(ra<<16)|(d&0xfffc))
.clrreloc::d
STQ rs,(ra) ::(rs&1)!=0;5 :: .call w4(0xf8000002|(rs<<21)|(ra<<16))

/* X form, indexed */
!def xld(nm, xo) {
!x31(nm, xo, "rt@21,ra@16,rb@11")
}
!def xst(nm, xo) {
!x31(nm, xo, "rs@21,ra@16,rb@11")
}
