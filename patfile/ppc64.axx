.reloc::v::addr16
!{nm} ra,rs,!v ::v<0;3,v>65535;3 :: .call w4(0x!{op << 26:08x}|(rs<<21)|(ra<<16)|(v&0xffff))
.clrreloc::v
!hsfx(nm, "ra,rs,", op << 26, "|(rs<<21)|(ra<<16)")
}
