/* A form. fp3: frt,fra,frb ; fpm: frt,fra,frc ; fp4: frt,fra,frc,frb */
!def fp3(nm, op, xo) {
!xg(nm, (op << 26) | (xo << 1), "ft@21,fa@16,fb@11", 1)
}
!def fpm(nm, op, xo) {
!xg(nm, (op << 26) | (xo << 1), "ft@21,fa@16,fc@6", 1)
}
!def fp4(nm, op, xo) {
!xg(nm, (op << 26) | (xo << 1), "ft@21,fa@16,fc@6,fb@11", 1)
}
!def fp1(nm, op, xo) {
!xg(nm, (op << 26) | (xo << 1), "ft@21,fb@11", 1)
}
