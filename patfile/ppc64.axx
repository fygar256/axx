/* ===================================================================
/* Fixed-point loads and stores
/* =================================================================== */
/* D form: nm reg,d(ra) and nm reg,sym@l(ra) (plus the other @-forms,
/* which are rare on a displacement but legal). reg is the register
/* variable of the data operand (rt, rs, ft, fs). */
!def dmem(nm, op, reg) {
!local b = op << 26
.reloc::d::addr16
!{nm} !{reg},!d(ra) ::d<-32768;8,d>32767;8 :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
!{nm} !{reg},(ra) :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16))
.reloc::d::addr16_lo
!{nm} !{reg},!d@L(ra) :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16)|(d&0xffff))
.clrreloc::d
.reloc::d::addr16_hi
!{nm} !{reg},!d@H(ra) :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16)|((d>>16)&0xffff))
.clrreloc::d
.reloc::d::addr16_ha
!{nm} !{reg},!d@HA(ra) :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16)|(((d+0x8000)>>16)&0xffff))
.clrreloc::d
}
/* DS form: the displacement is a multiple of 4; the low 2 bits hold
/* the extended opcode. */
!def dsmem(nm, op, xo, reg, fx = "") {
!local b = (op << 26) | xo
.reloc::d::addr16_ds
!{nm} !{reg},!d(ra) ::d<-32768;8,d>32767;8,(d&3)!=0;8 :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16)|(d&0xfffc))
.clrreloc::d
!{nm} !{reg},(ra) :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16))
.reloc::d::addr16_lo_ds
!{nm} !{reg},!d@L(ra) ::(d&3)!=0;8 :: .call w4(0x!{b:08x}|(!{reg}<<21)|(ra<<16)|(d&0xfffc))
.clrreloc::d
}

!dmem("LBZ", 34, "rt")
!dmem("LBZU", 35, "rt")
