/* the vector crypto instructions (opcode OP-VE), never masked */
!def Vk2(nm, f6, c) {
!Z(nm, "vd,vs", "", (f6 << 26) | (1 << 25) | (2 << 12) | (c << 15) | 0x77, "|(vs<<20)|(vd<<7)")
}
!def Vk3(nm, f6) {
!Z(nm, "vd,vs,vt", "", (f6 << 26) | (1 << 25) | (2 << 12) | 0x77, "|(vs<<20)|(vt<<15)|(vd<<7)")
}
!def Vki(nm, f6) {
!Z(nm, "vd,vs,!v", "v<0||v>31;3", (f6 << 26) | (1 << 25) | (2 << 12) | 0x77, "|(vs<<20)|(v<<15)|(vd<<7)")
}
