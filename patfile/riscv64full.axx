!def csrp(nm, f3) {
!Z(nm, "!S{{csr}}c,s", "c>4095||c<0;3", (f3 << 12) | 0x73, "|(c<<20)|(s<<15)")
!Z(nm, "!S{{csr}}c,!v", "c>4095||c<0||v>31||v<0;3", ((f3 + 4) << 12) | 0x73, "|(c<<20)|(v<<15)")
!Z(nm + "I", "!S{{csr}}c,!v", "c>4095||c<0||v>31||v<0;3", ((f3 + 4) << 12) | 0x73, "|(c<<20)|(v<<15)")
}
!csrp("CSRW", 1)
!csrp("CSRS", 2)
!csrp("CSRC", 3)
/* rdcycle, rdtime, rdinstret (the RV32 high halves do not exist on RV64) */
!def rdc(nm, c) {
!Z(nm, "d", "", (2 << 12) | 0x73, "|(" + str(c) + "<<20)|(d<<7)")
}
!rdc("RDCYCLE", 0xc00)
!rdc("RDTIME", 0xc01)
!rdc("RDINSTRET", 0xc02)
/* the floating point CSR group */
!Z("FRCSR", "d", "", (2 << 12) | 0x73 | (3 << 20), "|(d<<7)")
!Z("FSCSR", "d,s", "", (1 << 12) | 0x73 | (3 << 20), "|(s<<15)|(d<<7)")
!Z("FSCSR", "s", "", (1 << 12) | 0x73 | (3 << 20), "|(s<<15)")
!Z("FRRM", "d", "", (2 << 12) | 0x73 | (2 << 20), "|(d<<7)")
!Z("FSRM", "d,s", "", (1 << 12) | 0x73 | (2 << 20), "|(s<<15)|(d<<7)")
!Z("FSRM", "s", "", (1 << 12) | 0x73 | (2 << 20), "|(s<<15)")
!Z("FSRMI", "d,!v", "v>31||v<0;3", (5 << 12) | 0x73 | (2 << 20), "|(v<<15)|(d<<7)")
!Z("FSRMI", "!v", "v>31||v<0;3", (5 << 12) | 0x73 | (2 << 20), "|(v<<15)")
!Z("FRFLAGS", "d", "", (2 << 12) | 0x73 | (1 << 20), "|(d<<7)")
!Z("FSFLAGS", "d,s", "", (1 << 12) | 0x73 | (1 << 20), "|(s<<15)|(d<<7)")
!Z("FSFLAGS", "s", "", (1 << 12) | 0x73 | (1 << 20), "|(s<<15)")
!Z("FSFLAGSI", "d,!v", "v>31||v<0;3", (5 << 12) | 0x73 | (1 << 20), "|(v<<15)|(d<<7)")
!Z("FSFLAGSI", "!v", "v>31||v<0;3", (5 << 12) | 0x73 | (1 << 20), "|(v<<15)")

/* ===================================================================
/* Data
/* =================================================================== */
DB !v :: v
HALF !v :: v,v>>8
WORD !v :: v,v>>8,v>>16,v>>24
DWORD !v :: v,v>>8,v>>16,v>>24
QUAD !v :: v,v>>8,v>>16,v>>24,v>>32,v>>40,v>>48,v>>56
FLOAT !Fv :: v,v>>8,v>>16,v>>24
DOUBLE !Dv :: v,v>>8,v>>16,v>>24,v>>32,v>>40,v>>48,v>>56

/* ===================================================================
/* F, D, Q, Zfh, Zfa: floating point
/*
/* A row with a rounding mode written out uses the rm table; one without
/* encodes the dynamic mode (7). fmt is 0 for S, 1 for D, 2 for H and
/* 3 for Q.
/* =================================================================== */
.sub::rm
RNE::0
RTZ::1
RDN::2
RUP::3
RMM::4
DYN::7
.endsub

/* Fm: nm ops and nm ops,rm */
!def Fm(nm, ops, base, fx) {
!{nm} !{ops} :: .call w4(0x!{base | (7 << 12):08x}!{fx})
!{nm} !{ops},!S{{rm}}r :: .call w4(0x!{base:08x}!{fx}|(r<<12))
}

/* Fz: the same, but the form without a mode encodes rm = 0 (conversions
/* that are exact: widening, and integer to double / quad) */
!def Fz(nm, ops, base, fx) {
!{nm} !{ops} :: .call w4(0x!{base:08x}!{fx})
!{nm} !{ops},!S{{rm}}r :: .call w4(0x!{base:08x}!{fx}|(r<<12))
}

!def fpf(sfx, fmt) {
!local f = fmt << 25
!local S = "." + sfx
!Fm("FADD" + S, "fd,fs,ft", (0x00 << 27) | f | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FSUB" + S, "fd,fs,ft", (0x01 << 27) | f | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FMUL" + S, "fd,fs,ft", (0x02 << 27) | f | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FDIV" + S, "fd,fs,ft", (0x03 << 27) | f | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FSQRT" + S, "fd,fs", (0x0b << 27) | f | 0x53, "|(fs<<15)|(fd<<7)")
!Z("FSGNJ" + S, "fd,fs,ft", "", (0x04 << 27) | f | (0 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FSGNJN" + S, "fd,fs,ft", "", (0x04 << 27) | f | (1 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FSGNJX" + S, "fd,fs,ft", "", (0x04 << 27) | f | (2 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FMIN" + S, "fd,fs,ft", "", (0x05 << 27) | f | (0 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FMAX" + S, "fd,fs,ft", "", (0x05 << 27) | f | (1 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FEQ" + S, "d,fs,ft", "", (0x14 << 27) | f | (2 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(d<<7)")
!Z("FLT" + S, "d,fs,ft", "", (0x14 << 27) | f | (1 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(d<<7)")
!Z("FLE" + S, "d,fs,ft", "", (0x14 << 27) | f | (0 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(d<<7)")
!Z("FGT" + S, "d,fs,ft", "", (0x14 << 27) | f | (1 << 12) | 0x53, "|(fs<<20)|(ft<<15)|(d<<7)")
!Z("FGE" + S, "d,fs,ft", "", (0x14 << 27) | f | (0 << 12) | 0x53, "|(fs<<20)|(ft<<15)|(d<<7)")
!Z("FCLASS" + S, "d,fs", "", (0x1c << 27) | f | (1 << 12) | 0x53, "|(fs<<15)|(d<<7)")
!Z("FMV" + S, "fd,fs", "", (0x04 << 27) | f | (0 << 12) | 0x53, "|(fs<<20)|(fs<<15)|(fd<<7)")
!Z("FNEG" + S, "fd,fs", "", (0x04 << 27) | f | (1 << 12) | 0x53, "|(fs<<20)|(fs<<15)|(fd<<7)")
!Z("FABS" + S, "fd,fs", "", (0x04 << 27) | f | (2 << 12) | 0x53, "|(fs<<20)|(fs<<15)|(fd<<7)")
!Fm("FMADD" + S, "fd,fs,ft,fu", f | 0x43, "|(fu<<27)|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FMSUB" + S, "fd,fs,ft,fu", f | 0x47, "|(fu<<27)|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FNMSUB" + S, "fd,fs,ft,fu", f | 0x4b, "|(fu<<27)|(ft<<20)|(fs<<15)|(fd<<7)")
!Fm("FNMADD" + S, "fd,fs,ft,fu", f | 0x4f, "|(fu<<27)|(ft<<20)|(fs<<15)|(fd<<7)")
/* conversions to and from the integer registers */
!Fm("FCVT.W" + S, "d,fs", (0x18 << 27) | f | (0 << 20) | 0x53, "|(fs<<15)|(d<<7)")
!Fm("FCVT.WU" + S, "d,fs", (0x18 << 27) | f | (1 << 20) | 0x53, "|(fs<<15)|(d<<7)")
!Fm("FCVT.L" + S, "d,fs", (0x18 << 27) | f | (2 << 20) | 0x53, "|(fs<<15)|(d<<7)")
!Fm("FCVT.LU" + S, "d,fs", (0x18 << 27) | f | (3 << 20) | 0x53, "|(fs<<15)|(d<<7)")
!if fmt == 1 || fmt == 3 !then {
!Fz("FCVT" + S + ".W", "fd,s", (0x1a << 27) | f | (0 << 20) | 0x53, "|(s<<15)|(fd<<7)")
!Fz("FCVT" + S + ".WU", "fd,s", (0x1a << 27) | f | (1 << 20) | 0x53, "|(s<<15)|(fd<<7)")
} !else {
!Fm("FCVT" + S + ".W", "fd,s", (0x1a << 27) | f | (0 << 20) | 0x53, "|(s<<15)|(fd<<7)")
!Fm("FCVT" + S + ".WU", "fd,s", (0x1a << 27) | f | (1 << 20) | 0x53, "|(s<<15)|(fd<<7)")
}
!if fmt == 3 !then {
!Fz("FCVT" + S + ".L", "fd,s", (0x1a << 27) | f | (2 << 20) | 0x53, "|(s<<15)|(fd<<7)")
!Fz("FCVT" + S + ".LU", "fd,s", (0x1a << 27) | f | (3 << 20) | 0x53, "|(s<<15)|(fd<<7)")
} !else {
!Fm("FCVT" + S + ".L", "fd,s", (0x1a << 27) | f | (2 << 20) | 0x53, "|(s<<15)|(fd<<7)")
!Fm("FCVT" + S + ".LU", "fd,s", (0x1a << 27) | f | (3 << 20) | 0x53, "|(s<<15)|(fd<<7)")
}
/* Zfa */
!Z("FMINM" + S, "fd,fs,ft", "", (0x05 << 27) | f | (2 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FMAXM" + S, "fd,fs,ft", "", (0x05 << 27) | f | (3 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(fd<<7)")
!Z("FLEQ" + S, "d,fs,ft", "", (0x14 << 27) | f | (4 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(d<<7)")
!Z("FLTQ" + S, "d,fs,ft", "", (0x14 << 27) | f | (5 << 12) | 0x53, "|(ft<<20)|(fs<<15)|(d<<7)")
!Fm("FROUND" + S, "fd,fs", (0x08 << 27) | f | (4 << 20) | 0x53, "|(fs<<15)|(fd<<7)")
!Fm("FROUNDNX" + S, "fd,fs", (0x08 << 27) | f | (5 << 20) | 0x53, "|(fs<<15)|(fd<<7)")
!{"FLI" + S} fd,!Fv :: .call fli4(0x!{(0x1e << 27) | f | (1 << 20) | 0x53:08x},fd,v)
!Z("FLI" + S, "fd,MIN", "", (0x1e << 27) | f | (1 << 20) | 0x53, "|(1<<15)|(fd<<7)")
!Z("FLI" + S, "fd,INF", "", (0x1e << 27) | f | (1 << 20) | 0x53, "|(30<<15)|(fd<<7)")
!Z("FLI" + S, "fd,NAN", "", (0x1e << 27) | f | (1 << 20) | 0x53, "|(31<<15)|(fd<<7)")
}
!fpf("S", 0)
!fpf("D", 1)
!fpf("H", 2)
!fpf("Q", 3)

/* fli: the 32 constants of Zfa, found from the binary32 pattern of the
/* operand (the same table serves .s .d .h and .q); index 1 is the
/* minimum normal number, reached with the name MIN */
.func fli4(base, rd, v)
t = [0xbf800000, 0x00800000, 0x37800000, 0x38000000, 0x3b800000, 0x3c000000, 0x3d800000, 0x3e000000, 0x3e800000, 0x3ea00000, 0x3ec00000, 0x3ee00000, 0x3f000000, 0x3f200000, 0x3f400000, 0x3f600000, 0x3f800000, 0x3fa00000, 0x3fc00000, 0x3fe00000, 0x40000000, 0x40200000, 0x40400000, 0x40800000, 0x41000000, 0x41800000, 0x43000000, 0x43800000, 0x47000000, 0x47800000, 0x7f800000, 0x7fc00000]
ix = 32
.for i in range(32)
.if i != 1 && t[i] == (v & 0xffffffff) .then
ix = i
.endif
.next
.if ix == 32 .then
.raise 3
.return
.endif
z = base | (ix << 15) | (rd << 7)
.return [z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff]
.endfunc

/* moves between the register files */
!Z("FMV.X.W", "d,fs", "", (0x1c << 27) | (0 << 25) | 0x53, "|(fs<<15)|(d<<7)")
!Z("FMV.W.X", "fd,s", "", (0x1e << 27) | (0 << 25) | 0x53, "|(s<<15)|(fd<<7)")
!Z("FMV.X.D", "d,fs", "", (0x1c << 27) | (1 << 25) | 0x53, "|(fs<<15)|(d<<7)")
!Z("FMV.D.X", "fd,s", "", (0x1e << 27) | (1 << 25) | 0x53, "|(s<<15)|(fd<<7)")
!Z("FMV.X.H", "d,fs", "", (0x1c << 27) | (2 << 25) | 0x53, "|(fs<<15)|(d<<7)")
!Z("FMV.H.X", "fd,s", "", (0x1e << 27) | (2 << 25) | 0x53, "|(s<<15)|(fd<<7)")

/* conversions between the floating point formats: FCVT.dst.src. A
/* widening one is exact, so without a mode it encodes rm = 0. */
!def fcc(dst, df, src, sf, rm) {
!local b = (0x08 << 27) | (df << 25) | (sf << 20) | 0x53
!if rm == 1 !then {
!Fm("FCVT." + dst + "." + src, "fd,fs", b, "|(fs<<15)|(fd<<7)")
} !else {
!Fz("FCVT." + dst + "." + src, "fd,fs", b, "|(fs<<15)|(fd<<7)")
}
}
!fcc("S", 0, "D", 1, 1)
!fcc("D", 1, "S", 0, 0)
!fcc("S", 0, "H", 2, 0)
!fcc("H", 2, "S", 0, 1)
!fcc("D", 1, "H", 2, 0)
!fcc("H", 2, "D", 1, 1)
!fcc("S", 0, "Q", 3, 1)
!fcc("Q", 3, "S", 0, 0)
!fcc("D", 1, "Q", 3, 1)
!fcc("Q", 3, "D", 1, 0)
!fcc("H", 2, "Q", 3, 1)
!fcc("Q", 3, "H", 2, 0)
/* Zfa: fcvtmod.w.d takes only the round-towards-zero mode */
!Z("FCVTMOD.W.D", "d,fs,RTZ", "", (0x18 << 27) | (1 << 25) | (8 << 20) | (1 << 12) | 0x53, "|(fs<<15)|(d<<7)")

/* loads and stores */
!ldm("FLH", 1, 0x07, "fd")
!ldm("FLW", 2, 0x07, "fd")
!ldm("FLD", 3, 0x07, "fd")
!ldm("FLQ", 4, 0x07, "fd")
!stm("FSH", 1, 0x27, "ft")
!stm("FSW", 2, 0x27, "ft")
!stm("FSD", 3, 0x27, "ft")
!stm("FSQ", 4, 0x27, "ft")
/* the global forms: flw ft0,sym,t0 / fsw ft0,sym,t0 */
!def glf(nm, f3, rd) {
!{nm} !{rd},!v,s :: .call pair_i(v-$$,s,0x!{(f3 << 12) | 0x07:x}|(s<<15)|(!{rd}<<7))
}
!def gsf(nm, f3, rt) {
!{nm} !{rt},!v,s :: .call pair_s(v-$$,s,0x!{(f3 << 12) | 0x27:x}|(s<<15)|(!{rt}<<20))
}
!glf("FLH", 1, "fd")
!glf("FLW", 2, "fd")
!glf("FLD", 3, "fd")
!glf("FLQ", 4, "fd")
!gsf("FSH", 1, "ft")
!gsf("FSW", 2, "ft")
!gsf("FSD", 3, "ft")
!gsf("FSQ", 4, "ft")

/* ===================================================================
/* C: the compressed instructions (Zca, Zcf-less RV64, Zcd, Zcb), and
/* Zcmp / Zcmt / Zcmop. Two-byte words; rd' rs1' rs2' are x8-x15 and
/* written cd cs ct (cfd cft for f8-f15).
/* =================================================================== */
!def Cz(nm, ops, er, base, fx) {
!local head = nm
!if ops != "" !then {
!set head = nm + " " + ops
}
!if er == "" !then {
!{head} :: .call w2(0x!{base:04x}!{fx})
} !else {
!{head} :: !{er} :: .call w2(0x!{base:04x}!{fx})
}
}

/* register-based loads and stores of the quadrant 0.
/*   w4: word access (offset multiple of 4, up to 124)
/*   w8: doubleword access (offset multiple of 8, up to 248)
/* rd is cd / cfd for a load, ct / cft for a store */
!def Cw4(nm, f3, rg) {
!Cz(nm, rg + ",!v(cs)", "v<0||v>124||(v&3)!=0;8", (f3 << 13), "|(((v>>3)&7)<<10)|((cs-8)<<7)|(((v>>2)&1)<<6)|(((v>>6)&1)<<5)|((" + rg + "-8)<<2)")
!Cz(nm, rg + ",(cs)", "", (f3 << 13), "|((cs-8)<<7)|((" + rg + "-8)<<2)")
}
!def Cw8(nm, f3, rg) {
!Cz(nm, rg + ",!v(cs)", "v<0||v>248||(v&7)!=0;8", (f3 << 13), "|(((v>>3)&7)<<10)|((cs-8)<<7)|(((v>>6)&3)<<5)|((" + rg + "-8)<<2)")
!Cz(nm, rg + ",(cs)", "", (f3 << 13), "|((cs-8)<<7)|((" + rg + "-8)<<2)")
}
!Cw4("C.LW", 2, "cd")
!Cw8("C.LD", 3, "cd")
!Cw8("C.FLD", 1, "cfd")
!Cw4("C.SW", 6, "ct")
!Cw8("C.SD", 7, "ct")
!Cw8("C.FSD", 5, "cft")

/* stack-pointer relative loads and stores of the quadrant 2 */
!def Cs4(nm, f3, rd, nz) {
!local e = "v<0||v>252||(v&3)!=0;8"
!if nz == 1 !then {
!set e = e + ",d==0;5"
}
!Cz(nm, rd + ",!v(SP)", e, (f3 << 13) | 2, "|(((v>>5)&1)<<12)|(" + rd + "<<7)|(((v>>2)&7)<<4)|(((v>>6)&3)<<2)")
!Cz(nm, rd + ",(SP)", "", (f3 << 13) | 2, "|(" + rd + "<<7)")
}
!def Cs8(nm, f3, rd, nz) {
!local e = "v<0||v>504||(v&7)!=0;8"
!if nz == 1 !then {
!set e = e + ",d==0;5"
}
!Cz(nm, rd + ",!v(SP)", e, (f3 << 13) | 2, "|(((v>>5)&1)<<12)|(" + rd + "<<7)|(((v>>3)&3)<<5)|(((v>>6)&7)<<2)")
!Cz(nm, rd + ",(SP)", "", (f3 << 13) | 2, "|(" + rd + "<<7)")
}
!def Ss4(nm, f3, rs) {
!Cz(nm, rs + ",!v(SP)", "v<0||v>252||(v&3)!=0;8", (f3 << 13) | 2, "|(((v>>2)&15)<<9)|(((v>>6)&3)<<7)|(" + rs + "<<2)")
!Cz(nm, rs + ",(SP)", "", (f3 << 13) | 2, "|(" + rs + "<<2)")
}
!def Ss8(nm, f3, rs) {
!Cz(nm, rs + ",!v(SP)", "v<0||v>504||(v&7)!=0;8", (f3 << 13) | 2, "|(((v>>3)&7)<<10)|(((v>>6)&7)<<7)|(" + rs + "<<2)")
!Cz(nm, rs + ",(SP)", "", (f3 << 13) | 2, "|(" + rs + "<<2)")
}
!Cs4("C.LWSP", 2, "d", 1)
!Cs8("C.LDSP", 3, "d", 1)
!Cs8("C.FLDSP", 1, "fd", 0)
!Ss4("C.SWSP", 6, "t")
!Ss8("C.SDSP", 7, "t")
!Ss8("C.FSDSP", 5, "ft")

/* arithmetic */
!Cz("C.NOP", "", "", 0x0001, "")
!Cz("C.ADDI", "d,!v", "v<-32||v>31||v==0||d==0;3", 0x0001, "|(((v>>5)&1)<<12)|(d<<7)|((v&31)<<2)")
!Cz("C.ADDIW", "d,!v", "v<-32||v>31||d==0;3", 0x2001, "|(((v>>5)&1)<<12)|(d<<7)|((v&31)<<2)")
!Cz("C.LI", "d,!v", "v<-32||v>31||d==0;3", 0x4001, "|(((v>>5)&1)<<12)|(d<<7)|((v&31)<<2)")
!Cz("C.ADDI16SP", "SP,!v", "v<-512||v>496||(v&15)!=0||v==0;3", 0x6101, "|(((v>>9)&1)<<12)|(((v>>4)&1)<<6)|(((v>>6)&1)<<5)|(((v>>7)&3)<<3)|(((v>>5)&1)<<2)")
!Cz("C.ADDI4SPN", "cd,SP,!v", "v<=0||v>1020||(v&3)!=0;3", 0x0000, "|(((v>>4)&3)<<11)|(((v>>6)&15)<<7)|(((v>>2)&1)<<6)|(((v>>3)&1)<<5)|((cd-8)<<2)")
.func clui(rd, v)
n = v & 63
.if v >= 1 && v <= 31 .then
.elif v >= 0xfffe1 && v <= 0xfffff .then
.elif v >= -31 && v <= -1 .then
.else
.raise 3
.return
.endif
.if rd == 0 || rd == 2 .then
.raise 5
.return
.endif
z = 0x6001 | (((n >> 5) & 1) << 12) | (rd << 7) | ((n & 31) << 2)
.return [z & 0xff, (z >> 8) & 0xff]
.endfunc
C.LUI d,!v :: .call clui(d,v)
!Cz("C.SLLI", "d,!v", "v<1||v>63||d==0;10", 0x0002, "|(((v>>5)&1)<<12)|(d<<7)|((v&31)<<2)")
!Cz("C.SRLI", "cs,!v", "v<1||v>63;10", 0x8001, "|(((v>>5)&1)<<12)|((cs-8)<<7)|((v&31)<<2)")
!Cz("C.SRAI", "cs,!v", "v<1||v>63;10", 0x8401, "|(((v>>5)&1)<<12)|((cs-8)<<7)|((v&31)<<2)")
!Cz("C.ANDI", "cs,!v", "v<-32||v>31;3", 0x8801, "|(((v>>5)&1)<<12)|((cs-8)<<7)|((v&31)<<2)")
!def Cab(nm, base) {
!Cz(nm, "cs,ct", "", base, "|((cs-8)<<7)|((ct-8)<<2)")
}
!Cab("C.SUB", 0x8c01)
!Cab("C.XOR", 0x8c21)
!Cab("C.OR", 0x8c41)
!Cab("C.AND", 0x8c61)
!Cab("C.SUBW", 0x9c01)
!Cab("C.ADDW", 0x9c21)
!Cz("C.MV", "d,t", "d==0||t==0;5", 0x8002, "|(d<<7)|(t<<2)")
!Cz("C.ADD", "d,t", "d==0||t==0;5", 0x9002, "|(d<<7)|(t<<2)")
!Cz("C.JR", "s", "s==0;5", 0x8002, "|(s<<7)")
!Cz("C.JALR", "s", "s==0;5", 0x9002, "|(s<<7)")
!Cz("C.EBREAK", "", "", 0x9002, "")
!Cz("C.UNIMP", "", "", 0x0000, "")
UNIMP :: .call w4(0xc0001073)

/* jumps and branches */
.reloc::v::rvc_jump
C.J !v :: (v-$$)>2046||(v-$$)<-2048||((v-$$)&1)!=0;2 :: .call w2(0xa001|((((v-$$)>>11)&1)<<12)|((((v-$$)>>4)&1)<<11)|((((v-$$)>>8)&3)<<9)|((((v-$$)>>10)&1)<<8)|((((v-$$)>>6)&1)<<7)|((((v-$$)>>7)&1)<<6)|((((v-$$)>>1)&7)<<3)|((((v-$$)>>5)&1)<<2))
.clrreloc::v
.reloc::v::rvc_branch
C.BEQZ cs,!v :: (v-$$)>254||(v-$$)<-256||((v-$$)&1)!=0;2 :: .call w2(0xc001|((((v-$$)>>8)&1)<<12)|((((v-$$)>>3)&3)<<10)|((cs-8)<<7)|((((v-$$)>>6)&3)<<5)|((((v-$$)>>1)&3)<<3)|((((v-$$)>>5)&1)<<2))
C.BNEZ cs,!v :: (v-$$)>254||(v-$$)<-256||((v-$$)&1)!=0;2 :: .call w2(0xe001|((((v-$$)>>8)&1)<<12)|((((v-$$)>>3)&3)<<10)|((cs-8)<<7)|((((v-$$)>>6)&3)<<5)|((((v-$$)>>1)&3)<<3)|((((v-$$)>>5)&1)<<2))
.clrreloc::v

/* Zcb */
!Cz("C.LBU", "cd,!v(cs)", "v<0||v>3;8", 0x8000, "|((cs-8)<<7)|((v&1)<<6)|(((v>>1)&1)<<5)|((cd-8)<<2)")
!Cz("C.LBU", "cd,(cs)", "", 0x8000, "|((cs-8)<<7)|((cd-8)<<2)")
