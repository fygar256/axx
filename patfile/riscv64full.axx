/* ===================================================================
/* V: the vector extension 1.0
/*
/* vd, vs (= vs2) and vt (= vs1) are the vector register variables.
/* An operation that may be masked is written twice: without a mask
/* (vm = 1) and with the ,v0.t operand (vm = 0). In the instructions
/* that name the operands "vd,vs1,vs2" (vmacc, vmadd, vnmsac ...) the
/* order of the source text is kept, as the GNU assembler has it.
/* =================================================================== */

/* vsetvli / vsetivli: vtype is sew[,lmul][,ta|tu][,ma|mu] or a number */
!def lmname(l) {
!if l == 0 !then {
!return "M1"
} !elif l == 1 !then {
!return "M2"
} !elif l == 2 !then {
!return "M4"
} !elif l == 3 !then {
!return "M8"
} !elif l == 4 !then {
!return "MF2"
} !elif l == 5 !then {
!return "MF4"
}
!return "MF8"
}
!def lmval(l) {
!if l <= 3 !then {
!return l
}
!return 11 - l
}
.sub::vtype
!def vtt() {
!local s = 0
!local l = 0
!local t = 0
!local m = 0
!local lt = ""
!local lv = 0
!local tt = ""
!local tv = 0
!local mt = ""
!local mv = 0
!while s < 4 {
!set l = -1
!while l < 7 {
!set lt = ""
!set lv = 0
!if l >= 0 !then {
!set lt = "," + lmname(l)
!set lv = lmval(l)
}
!set t = 0
!while t < 3 {
!set tt = ""
!set tv = 0
!if t == 1 !then {
!set tt = ",TU"
}
!if t == 2 !then {
!set tt = ",TA"
!set tv = 1
}
!set m = 0
!while m < 3 {
!set mt = ""
!set mv = 0
!if m == 1 !then {
!set mt = ",MU"
}
!if m == 2 !then {
!set mt = ",MA"
!set mv = 1
}
E!{8 << s}!{lt}!{tt}!{mt}::!{(mv << 7) | (tv << 6) | (s << 3) | lv}
!set m = m + 1
}
!set t = t + 1
}
!set l = l + 1
}
!set s = s + 1
}
}
!vtt()
!n::n
.endsub
VSETVLI d,s,!S{{vtype}}z :: z<0||z>2047;3 :: .call w4(0x00007057|(z<<20)|(s<<15)|(d<<7))
VSETIVLI d,!v,!S{{vtype}}z :: v<0||v>31||z<0||z>1023;3 :: .call w4(0xc0007057|(z<<20)|(v<<15)|(d<<7))
VSETVL d,s,t :: .call w4(0x80007057|(t<<20)|(s<<15)|(d<<7))

/* Vm: nm ops (vm = 1) and nm ops,v0.t (vm = 0), with an error list */
!def Vme(nm, ops, er, base, fx) {
!Z(nm, ops, er, base | (1 << 25), fx)
!Z(nm, ops + ",V0.T", er, base, fx)
}

/* ---- loads and stores -------------------------------------------- */
!def wcode(e) {
!if e == 8 !then {
!return 0
} !elif e == 16 !then {
!return 5
} !elif e == 32 !then {
!return 6
}
!return 7
}
/* kind u: (rs1)   s: (rs1),rs2   x: (rs1),vs2. vmfix 1 = never masked */
!def Vmem(nm, op, w, mop, lumop, nf, kind, vmfix) {
!local b = op | (w << 12) | ((nf - 1) << 29) | (mop << 26) | (lumop << 20)
!local ops = "vd,(s)"
!local fx = "|(s<<15)|(vd<<7)"
!if kind == "s" !then {
!set ops = "vd,(s),t"
!set fx = "|(t<<20)|(s<<15)|(vd<<7)"
}
!if kind == "x" !then {
!set ops = "vd,(s),vs"
!set fx = "|(vs<<20)|(s<<15)|(vd<<7)"
}
!if vmfix == 1 !then {
!Z(nm, ops, "", b | (1 << 25), fx)
} !else {
!Vme(nm, ops, "", b, fx)
}
}
!def vmems() {
!local e = 8
!local w = 0
!local nf = 2
!local en = ""
!while e <= 64 {
!set w = wcode(e)
!set en = str(e)
!Vmem("VLE" + en + ".V", 0x07, w, 0, 0, 1, "u", 0)
!Vmem("VLE" + en + "FF.V", 0x07, w, 0, 0x10, 1, "u", 0)
!Vmem("VSE" + en + ".V", 0x27, w, 0, 0, 1, "u", 0)
!Vmem("VLSE" + en + ".V", 0x07, w, 2, 0, 1, "s", 0)
!Vmem("VSSE" + en + ".V", 0x27, w, 2, 0, 1, "s", 0)
!Vmem("VLUXEI" + en + ".V", 0x07, w, 1, 0, 1, "x", 0)
!Vmem("VLOXEI" + en + ".V", 0x07, w, 3, 0, 1, "x", 0)
!Vmem("VSUXEI" + en + ".V", 0x27, w, 1, 0, 1, "x", 0)
!Vmem("VSOXEI" + en + ".V", 0x27, w, 3, 0, 1, "x", 0)
!set nf = 2
!while nf <= 8 {
!local ns = str(nf)
!Vmem("VLSEG" + ns + "E" + en + ".V", 0x07, w, 0, 0, nf, "u", 0)
!Vmem("VLSEG" + ns + "E" + en + "FF.V", 0x07, w, 0, 0x10, nf, "u", 0)
!Vmem("VSSEG" + ns + "E" + en + ".V", 0x27, w, 0, 0, nf, "u", 0)
!Vmem("VLSSEG" + ns + "E" + en + ".V", 0x07, w, 2, 0, nf, "s", 0)
!Vmem("VSSSEG" + ns + "E" + en + ".V", 0x27, w, 2, 0, nf, "s", 0)
!Vmem("VLUXSEG" + ns + "EI" + en + ".V", 0x07, w, 1, 0, nf, "x", 0)
!Vmem("VLOXSEG" + ns + "EI" + en + ".V", 0x07, w, 3, 0, nf, "x", 0)
!Vmem("VSUXSEG" + ns + "EI" + en + ".V", 0x27, w, 1, 0, nf, "x", 0)
!Vmem("VSOXSEG" + ns + "EI" + en + ".V", 0x27, w, 3, 0, nf, "x", 0)
!set nf = nf + 1
}
!set nf = 1
!while nf <= 8 {
!Vmem("VL" + str(nf) + "RE" + en + ".V", 0x07, w, 0, 8, nf, "u", 1)
!set nf = nf * 2
}
!set e = e * 2
}
!set nf = 1
!while nf <= 8 {
!Vmem("VL" + str(nf) + "R.V", 0x07, 0, 0, 8, nf, "u", 1)
!Vmem("VS" + str(nf) + "R.V", 0x27, 0, 0, 8, nf, "u", 1)
!set nf = nf * 2
}
!Vmem("VLM.V", 0x07, 0, 0, 0x0b, 1, "u", 1)
!Vmem("VSM.V", 0x27, 0, 0, 0x0b, 1, "u", 1)
}
!vmems()

/* ---- arithmetic -------------------------------------------------- */
/* Vg: nm+sfx with funct6 f6 and funct3 f3, operand kind:
/*   v  vd,vs,vt      x  vd,vs,s       i  vd,vs,simm5    u  vd,vs,uimm5
/*   f  vd,vs,fs      V  vd,vt,vs      X  vd,s,vs        F  vd,fs,vs
/* (V X F are the vd,vs1,vs2 order of the multiply-add group) */
!def Vg(nm, sfx, f6, f3, kind) {
!local b = (f6 << 26) | (f3 << 12) | 0x57
!if kind == "v" !then {
!Vme(nm + sfx, "vd,vs,vt", "", b, "|(vs<<20)|(vt<<15)|(vd<<7)")
} !elif kind == "x" !then {
!Vme(nm + sfx, "vd,vs,s", "", b, "|(vs<<20)|(s<<15)|(vd<<7)")
} !elif kind == "i" !then {
!Vme(nm + sfx, "vd,vs,!v", "v<-16||v>15;3", b, "|(vs<<20)|((v&31)<<15)|(vd<<7)")
} !elif kind == "u" !then {
!Vme(nm + sfx, "vd,vs,!v", "v<0||v>31;3", b, "|(vs<<20)|(v<<15)|(vd<<7)")
} !elif kind == "f" !then {
!Vme(nm + sfx, "vd,vs,fs", "", b, "|(vs<<20)|(fs<<15)|(vd<<7)")
} !elif kind == "V" !then {
!Vme(nm + sfx, "vd,vs,vt", "", b, "|(vt<<20)|(vs<<15)|(vd<<7)")
} !elif kind == "X" !then {
!Vme(nm + sfx, "vd,s,vs", "", b, "|(vs<<20)|(s<<15)|(vd<<7)")
} !else {
!Vme(nm + sfx, "vd,fs,vs", "", b, "|(vs<<20)|(fs<<15)|(vd<<7)")
}
}
/* integer group: V X I (signed) / V X U (shifts) / V X / X I ... */
!def Vvxi(nm, f6) {
!Vg(nm, ".VV", f6, 0, "v")
!Vg(nm, ".VX", f6, 4, "x")
!Vg(nm, ".VI", f6, 3, "i")
}
!def Vvxu(nm, f6) {
!Vg(nm, ".VV", f6, 0, "v")
!Vg(nm, ".VX", f6, 4, "x")
!Vg(nm, ".VI", f6, 3, "u")
}
!def Vvx(nm, f6) {
!Vg(nm, ".VV", f6, 0, "v")
!Vg(nm, ".VX", f6, 4, "x")
}
!def Vxi(nm, f6) {
!Vg(nm, ".VX", f6, 4, "x")
!Vg(nm, ".VI", f6, 3, "i")
}
!def Vxu(nm, f6) {
!Vg(nm, ".VX", f6, 4, "x")
!Vg(nm, ".VI", f6, 3, "u")
}
/* narrowing: .WV .WX .WI */
!def Vwn(nm, f6) {
!Vg(nm, ".WV", f6, 0, "v")
!Vg(nm, ".WX", f6, 4, "x")
!Vg(nm, ".WI", f6, 3, "u")
}
/* mask group, multiply, widening (OPMVV / OPMVX) */
!def Vmm(nm, f6) {
!Vg(nm, ".VV", f6, 2, "v")
!Vg(nm, ".VX", f6, 6, "x")
}
!def Vmw(nm, f6) {
!Vg(nm, ".WV", f6, 2, "v")
!Vg(nm, ".WX", f6, 6, "x")
}
!def Vmac(nm, f6) {
!Vg(nm, ".VV", f6, 2, "V")
!Vg(nm, ".VX", f6, 6, "X")
}
/* floating point (OPFVV / OPFVF) */
!def Vff(nm, f6) {
!Vg(nm, ".VV", f6, 1, "v")
!Vg(nm, ".VF", f6, 5, "f")
}
!def Vfw(nm, f6) {
!Vg(nm, ".WV", f6, 1, "v")
!Vg(nm, ".WF", f6, 5, "f")
}
!def Vfmac(nm, f6) {
!Vg(nm, ".VV", f6, 1, "V")
!Vg(nm, ".VF", f6, 5, "F")
}
/* unary: nm vd,vs with the vs1 field fixed */
!def Vun(nm, f6, f3, c) {
!Vme(nm, "vd,vs", "", (f6 << 26) | (f3 << 12) | (c << 15) | 0x57, "|(vs<<20)|(vd<<7)")
}
/* never masked */
!def Vnm(nm, ops, f6, f3, fx) {
!Z(nm, ops, "", (f6 << 26) | (1 << 25) | (f3 << 12) | 0x57, fx)
}

!Vvxi("VADD", 0x00)
!Vvx("VSUB", 0x02)
