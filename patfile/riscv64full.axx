!def csrops(nm, f3) {
!Z(nm, "d,!S{{csr}}c,s", "c>4095||c<0;3", (f3 << 12) | 0x73, "|(c<<20)|(s<<15)|(d<<7)")
!Z(nm + "I", "d,!S{{csr}}c,!v", "c>4095||c<0||v>31||v<0;3", ((f3 + 4) << 12) | 0x73, "|(c<<20)|(v<<15)|(d<<7)")
}
!csrops("CSRRW", 1)
!csrops("CSRRS", 2)
!csrops("CSRRC", 3)
