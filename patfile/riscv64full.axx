/* Zcmop: c.mop.1, c.mop.3 ... c.mop.15 */
!def cmop() {
!local n = 1
!while n < 16 {
C.MOP.!{n} :: .call w2(0x!{0x6081 | (((n - 1) / 2) << 8):04x})
!set n = n + 2
}
}
!cmop()

/* Zcmt: the jump table instructions */
!Cz("CM.JT", "!v", "v<0||v>31;3", 0xa002, "|(v<<2)")
!Cz("CM.JALT", "!v", "v<32||v>255;3", 0xa002, "|(v<<2)")

/* Zcmp: push, pop and the move pairs. The register list is written
/* {ra}, {ra,s0}, {ra,s0-s1} ... {ra,s0-s11}; its number is rlist. */
.sub::rl
!def rltab() {
!local n = 4
!while n < 16 {
!local t = "{RA"
!if n == 5 !then {
!set t = "{RA,S0"
}
!if n == 15 !then {
!set t = "{RA,S0-S11"
} !elif n > 5 !then {
!set t = "{RA,S0-S" + str(n - 5)
}
!{t}}::!{n}
!set n = n + 1
}
}
!rltab()
.endsub
/* the stack adjustment base of each rlist (RV64), then 4 steps of 16 */
.func cmpp(base, rl, adj, push)
t = [16, 16, 32, 32, 48, 48, 64, 64, 80, 80, 96, 112]
bs = t[rl - 4]
a = adj
.if push != 0 .then
a = -adj
.endif
.if a < bs || a > bs + 48 || (a & 15) != 0 .then
.raise 3
.return
.endif
z = base | (rl << 4) | (((a - bs) >> 4) << 2)
.return [z & 0xff, (z >> 8) & 0xff]
.endfunc
CM.PUSH !S{{rl}}r,!v :: .call cmpp(0xb802,r,v,1)
CM.POP !S{{rl}}r,!v :: .call cmpp(0xba02,r,v,0)
CM.POPRETZ !S{{rl}}r,!v :: .call cmpp(0xbc02,r,v,0)
CM.POPRET !S{{rl}}r,!v :: .call cmpp(0xbe02,r,v,0)
/* cm.mva01s / cm.mvsa01 take two of s0-s7 (x8 x9 x18-x23) */
.func cmmv(base, a, b)
ca = a - 16
.if a < 10 .then
ca = a - 8
.endif
cb = b - 16
.if b < 10 .then
cb = b - 8
.endif
z = base | (ca << 7) | (cb << 2)
.return [z & 0xff, (z >> 8) & 0xff]
.endfunc
.setsym::SREG::S0,S1,S2,S3,S4,S5,S6,S7,X8,X9,X18,X19,X20,X21,X22,X23,FP
.check::m1::SREG
.check::m2::SREG
CM.MVA01S m1,m2 :: .call cmmv(0xac62,m1,m2)
CM.MVSA01 m1,m2 :: m1==m2;5 :: .call cmmv(0xac22,m1,m2)

