!amob("AMOMAXU", 0x1c)
!amob("AMOCAS", 0x05)
C.SSPUSH X1 :: .call w2(0x6081)
C.SSPUSH RA :: .call w2(0x6081)
C.SSPOPCHK X5 :: .call w2(0x6281)
C.SSPOPCHK T0 :: .call w2(0x6281)

