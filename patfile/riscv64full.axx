/* Other spellings the assemblers accept
/* =================================================================== */
!Z("FMV.X.S", "d,fs", "", (0x1c << 27) | (0 << 25) | 0x53, "|(fs<<15)|(d<<7)")
!Z("FMV.S.X", "fd,s", "", (0x1e << 27) | (0 << 25) | 0x53, "|(s<<15)|(fd<<7)")
!Z("JR", "!v(s)", E12(), 0x67, "|((v&0xfff)<<20)|(s<<15)")
!Z("JALR", "!v(s)", E12(), 0x67 | (1 << 7), "|((v&0xfff)<<20)|(s<<15)")
/* the names the vector extension had before 1.0 */
!Vme("VPOPC.M", "d,vs", "", (0x10 << 26) | (2 << 12) | (0x10 << 15) | 0x57, "|(vs<<20)|(d<<7)")
!Vmk("VMANDNOT", 0x18)
!Vmk("VMORNOT", 0x1c)
!Vg("VFREDSUM", ".VS", 0x01, 1, "v")
!Vg("VFWREDSUM", ".VS", 0x31, 1, "v")
