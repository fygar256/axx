!Vg("VWREDSUMU", ".VS", 0x30, 0, "v")
!Vg("VWREDSUM", ".VS", 0x31, 0, "v")
/* carry and merge: the mask v0 is a written operand, vm = 0 */
!def Vcy(nm, f6, withi) {
!local b = (f6 << 26) | 0x57
!Z(nm + ".VVM", "vd,vs,vt,V0", "", b, "|(vs<<20)|(vt<<15)|(vd<<7)")
!Z(nm + ".VXM", "vd,vs,s,V0", "", b | (4 << 12), "|(vs<<20)|(s<<15)|(vd<<7)")
!if withi == 1 !then {
!Z(nm + ".VIM", "vd,vs,!v,V0", "v<-16||v>15;3", b | (3 << 12), "|(vs<<20)|((v&31)<<15)|(vd<<7)")
}
}
!Vcy("VADC", 0x10, 1)
!Vcy("VSBC", 0x12, 0)
!Vcy("VMADC", 0x11, 1)
!Vcy("VMSBC", 0x13, 0)
!Vcy("VMERGE", 0x17, 1)
!Vnm("VMADC.VV", "vd,vs,vt", 0x11, 0, "|(vs<<20)|(vt<<15)|(vd<<7)")
!Vnm("VMADC.VX", "vd,vs,s", 0x11, 4, "|(vs<<20)|(s<<15)|(vd<<7)")
!Vnm("VMADC.VI", "vd,vs,!v", 0x11, 3, "|(vs<<20)|((v&31)<<15)|(vd<<7)")
!Vnm("VMSBC.VV", "vd,vs,vt", 0x13, 0, "|(vs<<20)|(vt<<15)|(vd<<7)")
!Vnm("VMSBC.VX", "vd,vs,s", 0x13, 4, "|(vs<<20)|(s<<15)|(vd<<7)")
!Vnm("VMV.V.V", "vd,vt", 0x17, 0, "|(vt<<15)|(vd<<7)")
!Vnm("VMV.V.X", "vd,s", 0x17, 4, "|(s<<15)|(vd<<7)")
!Z("VMV.V.I", "vd,!v", "v<-16||v>15;3", (0x17 << 26) | (1 << 25) | (3 << 12) | 0x57, "|((v&31)<<15)|(vd<<7)")
!Z("VFMERGE.VFM", "vd,vs,fs,V0", "", (0x17 << 26) | (5 << 12) | 0x57, "|(vs<<20)|(fs<<15)|(vd<<7)")
!Vnm("VFMV.V.F", "vd,fs", 0x17, 5, "|(fs<<15)|(vd<<7)")
!def vmvr() {
!local n = 1
!while n <= 8 {
!Z("VMV" + str(n) + "R.V", "vd,vs", "", (0x27 << 26) | (1 << 25) | (3 << 12) | 0x57 | ((n - 1) << 15), "|(vs<<20)|(vd<<7)")
!set n = n * 2
}
}
!vmvr()

