!Vme("VNEG.V", "vd,vs", "", (0x03 << 26) | (4 << 12) | 0x57, "|(vs<<20)|(vd<<7)")
!Vme("VNOT.V", "vd,vs", "", (0x0b << 26) | (3 << 12) | (31 << 15) | 0x57, "|(vs<<20)|(vd<<7)")
