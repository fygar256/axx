/* ===================================================================
/* riscv64full.axx -- RISC-V (RV64) pattern file for axx, full coverage
/*
/* A superset of riscv64.axx, in the same style: the macro layer writes
/* the regular tables, the mini language does the encodings that no
/* single expression can state (li, the scattered B / J fields, the
/* vector configuration). The syntax is that of the GNU / LLVM
/* assemblers; an instruction can be written in either case with any
/* spacing, and a comment starts with ';' (as in every axx source).
/*
/* Coverage
/*   RV64I (and the RV32I subset)   every instruction of the base set;
/*                   FENCE with its pred/succ sets, FENCE.TSO, PAUSE,
/*                   ECALL, EBREAK, FENCE.I (Zifencei); Zicsr with the
/*                   CSR names of the user, supervisor, hypervisor,
/*                   machine and debug levels or a number
/*   M               MUL / DIV / REM and the W forms
/*   A               LR / SC / AMO, .W .D (and Zabha .B .H), each with
/*                   the .aq / .rl / .aqrl suffixes; Zacas (AMOCAS
/*                   .W .D .Q); Zawrs
/*   F D Q Zfh Zfa   loads and stores, arithmetic with the optional
/*                   rounding-mode operand, fused multiply-add,
/*                   conversions, compares, classify, moves, the
/*                   Zfhmin / Zfbfmin conversions, Zfa (FLI, FMINM,
/*                   FMAXM, FROUND, FROUNDNX, FLEQ, FLTQ, FCVTMOD.W.D)
/*   C               the RVC set of RV64 with the double precision
/*                   loads and stores (Zca, Zcd), Zcb, Zcmp, Zcmt, Zcmop
/*   B and K         Zba Zbb Zbc Zbs, Zbkb Zbkc Zbkx, and the scalar
/*                   cryptography Zknd Zkne Zknh Zksed Zksh
/*   Zicond, Zicbom / Zicboz / Zicbop, Zihintntl, Zimop, Zicfiss and
/*   Zicfilp (SSPUSH, SSPOPCHK, SSRDP, SSAMOSWAP, LPAD)
/*   Privileged      SRET MRET MNRET DRET WFI, SFENCE.VMA and the
/*                   Svinval group, the H extension (HFENCE.*, HINVAL.*,
/*                   HLV.*, HLVX.*, HSV.*)
/*   V               the vector extension 1.0: vsetvli / vsetivli /
/*                   vsetvl; unit-stride, strided, indexed, segment,
/*                   fault-only-first, mask and whole-register loads and
/*                   stores; integer, fixed point, floating point,
/*                   widening, narrowing, reduction, mask, permutation
/*                   and conversion operations, with the optional v0.t
/*                   mask; Zvbb, Zvbc, Zvkg, Zvkned, Zvknha / Zvknhb,
/*                   Zvksed, Zvksh, Zvfbfmin, Zvfbfwma
/*   Pseudo          nop, li (any 64-bit constant), mv, not, neg, negw,
/*                   sext.w, zext.b / .h / .w, seqz, snez, sltz, sgtz,
/*                   beqz ... bleu, j, jr, jalr, ret, call, tail, jump,
/*                   la, lla, the global load and store forms (lw a0,sym
/*                   / sw a0,sym,t0 / flw ft0,sym,t0 ...), csrr / csrw /
/*                   csrs / csrc and their immediate forms, rdcycle,
/*                   rdtime, rdinstret, frcsr ... fsflagsi, fmv.s /
/*                   fabs.s / fneg.s (.d .h .q), fgt / fge, vmv.v.*,
/*                   vneg, vnot, vfneg, vfabs, vmmv, vmclr, vmset,
/*                   vmnot, vncvt, vwcvt, vmsgt.vv ... vmsgeu.vi, and
/*                   the pre-1.0 vector names (vpopc.m, vmandnot.mm ...)
/*
/* Not covered
/*   - the RV32-only forms (the *H CSRs, rdcycleh, zip / unzip, fmvh.x.d,
/*     fmvp.d.x, c.jal, c.flw, c.fsw ...);
/*   - Zfinx / Zdinx / Zhinx (floating point in the integer registers);
/*   - vmsge.vx and vmsgeu.vx, which GNU as expands to two instructions;
/*   - the GOT / TLS pseudos lga, la.tls.ie, la.tls.gd, tls_le ... and
/*     %tprel_add, whose relocation pairs cannot be written as one row;
/*   - the vendor extensions (Xthead*, Xventana*, ...).
/*
/* Registers. x0-x31, the ABI names (zero ra sp gp tp t0-t6 s0-s11 fp
/* a0-a7), f0-f31, the floating point ABI names (ft0-ft11 fs0-fs11
/* fa0-fa7) and v0-v31. They are pattern-file symbols, so an assembly
/* label may not share a name with one (a label called f1 or v2 is
/* refused; give labels longer names).
/*
/* Compressed instructions are only ever written explicitly (c.addi,
/* c.lw ...). Nothing is compressed on its own, as with
/* `.option norvc`, and a branch is never relaxed or inverted.
/*
/* Data directives. DB, HALF (2 bytes), WORD and DWORD (4 bytes), QUAD
/* (8 bytes), FLOAT and DOUBLE. DWORD stays 4 bytes as in riscv64.axx.
/* A symbol in WORD / DWORD / QUAD gets R_RISCV_32 / R_RISCV_64.
/*
/* ELF output (-o). The relocation types of the RISC-V psABI that an
/* instruction can carry are declared below and every operand that can
/* hold a symbol is typed with .reloc, so an object links with GNU ld
/* and LLD: BRANCH, JAL, CALL_PLT, PCREL_HI20 / LO12_I / LO12_S, HI20,
/* LO12_I / LO12_S, GOT_HI20, TLS_GOT_HI20, TLS_GD_HI20, TPREL_HI20,
/* TPREL_LO12_I / LO12_S, RVC_BRANCH and RVC_JUMP.
/*
/* Limits of a one-row-one-instruction model
/*   - R_RISCV_RELAX is not emitted, so a linker does not relax.
/*   - %pcrel_lo(label) names the label of the AUIPC. In the object the
/*     relocation is right; in a flat binary (-b) its field is 0.
/*   - la / lla and the global load / store forms work out the
/*     pc-relative offset themselves, so they are exact for a target in
/*     the same section (or in a flat binary), and not for a symbol of
/*     another section or an external one. There, write the explicit
/*     auipc + addi / %pcrel_hi / %pcrel_lo pair, which carries the
/*     relocations. call, tail and jump are one relocation over the
/*     auipc + jalr pair and work for an external symbol.
/*   - li of a label or an expression is encoded once the value is
/*     known, so its length can differ between the passes.
/*   - li chooses the same instruction sequence as LLVM for nearly every
/*     constant; where it differs (LLVM splits a last out-of-range addi
/*     in two) the sequence is as short or one instruction longer, and
/*     always loads the same value.
/*
/* Verification. Every row was assembled with LLVM's llvm-mc (version
/* 18, RISC-V target, every extension enabled) and with axx, over many
/* operand choices (every register file, the limits of every immediate,
/* every rounding mode, every aq / rl combination, every EEW and segment
/* count, masked and unmasked), and the bytes are identical. With -o the
/* relocation entries (offset, type, symbol, addend) and the linked
/* image (ld.lld) are identical to those of llvm-mc, except that LLVM
/* turns a conditional branch to an external symbol into an inverted
/* branch plus a jal, where this file, like GNU as, writes R_RISCV_BRANCH.
/* The C (caxx) and Python (axx.py) implementations give identical
/* output. What the LLVM version above does not know was written from
/* the specifications and is not checked against an assembler: the Q
/* instructions (checked against the D encodings with the format field
/* changed), Zabha, vwsll, mnret, c.ntl.*, c.sspush and c.sspopchk. See
/* riscv64full.s (the rows) and riscv64full_reloc.s (every relocation).
/*
/* Assemble and link with:
/*   axx riscv64full.axx prog.s -o out.o
/*   ld -m elf64lriscv -o out out.o
/* =================================================================== */

.bits::8
.elfmachine::243::RISC-V
.elfclass::64
.elfrela::1
/* .elfheader::flags::5 would mark RVC + the double-float ABI. It is left
/* at 0 so the object mixes with any other; set it for your own ABI. */

.error::2::"branch or jump target out of range, or not a multiple of 2"
.error::3::"immediate value out of range"
.error::5::"register out of range for this instruction"
.error::8::"displacement out of range or not suitably aligned"
.error::10::"shift amount, mask or field value out of range"

/* --- relocation types of the RISC-V psABI ------------------------- */
/*     name             number width pc-relative                      */
.elftype::branch::16::4::1          /* R_RISCV_BRANCH                  */
.elftype::jal::17::4::1             /* R_RISCV_JAL                     */
.elftype::call::19::8::1            /* R_RISCV_CALL_PLT (auipc + jalr)  */
.elftype::got_hi20::20::4::1        /* R_RISCV_GOT_HI20                */
.elftype::tls_got_hi20::21::4::1    /* R_RISCV_TLS_GOT_HI20            */
.elftype::tls_gd_hi20::22::4::1     /* R_RISCV_TLS_GD_HI20             */
.elftype::pcrel_hi20::23::4::1      /* R_RISCV_PCREL_HI20              */
.elftype::pcrel_lo12_i::24::4::1    /* R_RISCV_PCREL_LO12_I            */
.elftype::pcrel_lo12_s::25::4::1    /* R_RISCV_PCREL_LO12_S            */
.elftype::hi20::26::4               /* R_RISCV_HI20  (lui)             */
.elftype::lo12_i::27::4             /* R_RISCV_LO12_I                  */
.elftype::lo12_s::28::4             /* R_RISCV_LO12_S                  */
.elftype::tprel_hi20::29::4         /* R_RISCV_TPREL_HI20              */
.elftype::tprel_lo12_i::30::4       /* R_RISCV_TPREL_LO12_I            */
.elftype::tprel_lo12_s::31::4       /* R_RISCV_TPREL_LO12_S            */
.elftype::rvc_branch::44::2::1      /* R_RISCV_RVC_BRANCH              */
.elftype::rvc_jump::45::2::1        /* R_RISCV_RVC_JUMP                */

/* --- which bits of the instruction the linker writes -------------- */
.elffield::hi20::0xfffff000
.elffield::got_hi20::0xfffff000
.elffield::tls_got_hi20::0xfffff000
.elffield::tls_gd_hi20::0xfffff000
.elffield::pcrel_hi20::0xfffff000
.elffield::tprel_hi20::0xfffff000
.elffield::jal::0xfffff000            /* J-type, scattered           */
.elffield::lo12_i::0xfff00000         /* I-type imm[11:0]            */
.elffield::pcrel_lo12_i::0xfff00000
.elffield::tprel_lo12_i::0xfff00000
.elffield::lo12_s::0xfe000f80         /* S-type, split               */
.elffield::pcrel_lo12_s::0xfe000f80
.elffield::tprel_lo12_s::0xfe000f80
.elffield::branch::0xfe000f80         /* B-type, split               */
.elffield::rvc_branch::0x1c7c         /* CB-type, scattered          */
.elffield::rvc_jump::0x1ffc           /* CJ-type, scattered          */
/* a call is two words: auipc's U field, then jalr's I field, read as
/* one little-endian 8-byte integer */
.elffield::call::0xfff00000fffff000

/* --- data references (the built-in table already has these) ------- */
.elfwidth::8::abs64            /* R_RISCV_64                      */
.elfwidth::4::abs32            /* R_RISCV_32                      */
.elfwidth::2::0                /* no absolute 16-bit type exists  */
.elfwidth::1::0                /* no absolute 8-bit type exists   */
.elfextern::abs64
.elfdwarf::abs64

/* ===================================================================
/* Registers
/* =================================================================== */
!def regs(p, n) {
!local i = 0
!while i <= n {
.setsym::!{p}!{i}::!{i}
!set i = i + 1
}
}
!regs("X", 31)
!regs("F", 31)
!regs("V", 31)
.setsym::ZERO::0
.setsym::RA::1
.setsym::SP::2
.setsym::GP::3
.setsym::TP::4
.setsym::T0::5
.setsym::T1::6
.setsym::T2::7
.setsym::S0::8
.setsym::FP::8
.setsym::S1::9
!def aregs(p, base, n) {
!local i = 0
!while i <= n {
.setsym::!{p}!{i}::!{base + i}
!set i = i + 1
}
}
!aregs("A", 10, 7)           /* a0..a7   -> 10..17                   */
!aregs("FT", 0, 7)           /* ft0..ft7 -> f0..f7                   */
!aregs("FA", 10, 7)          /* fa0..fa7 -> f10..f17                 */
/* s2..s11 -> 18..27 (s0 = fp and s1 are 8 and 9, set above) */
!def sregs() {
!local i = 2
!while i <= 11 {
.setsym::S!{i}::!{16 + i}
.setsym::FS!{i}::!{16 + i}
!set i = i + 1
}
}
!sregs()
.setsym::FS0::8
.setsym::FS1::9
.setsym::T3::28
.setsym::T4::29
.setsym::T5::30
.setsym::T6::31
.setsym::FT8::28
.setsym::FT9::29
.setsym::FT10::30
.setsym::FT11::31

/* The register classes, as sets (section 3.6.2), and the variable
/* names that carry them. A variable name alone decides which register
/* file an operand takes:
/*   d s t        integer rd rs1 rs2
/*   fd fs ft fu  floating point rd rs1 rs2 rs3
/*   vd vs vt     vector vd vs2 vs1 (see the V section)
/*   cd cs ct     compressed integer x8-x15 (rd' rs1' rs2')
/*   cfd cft      compressed floating point f8-f15 */
!def regset(nm, p, n, abi) {
!local i = 0
!local l = ""
!while i <= n {
!if i > 0 !then {
!set l = l + ","
}
!set l = l + p + str(i)
!set i = i + 1
}
.setsym::!{nm}::!{l}!{abi}
}
!regset("XN", "X", 31, "")
!regset("FN", "F", 31, "")
!regset("VN", "V", 31, "")
.setsym::XABI::ZERO,RA,SP,GP,TP,T0,T1,T2,S0,FP,S1,A0,A1,A2,A3,A4,A5,A6,A7,S2,S3,S4,S5,S6,S7,S8,S9,S10,S11,T3,T4,T5,T6
.setsym::FABI::FT0,FT1,FT2,FT3,FT4,FT5,FT6,FT7,FS0,FS1,FA0,FA1,FA2,FA3,FA4,FA5,FA6,FA7,FS2,FS3,FS4,FS5,FS6,FS7,FS8,FS9,FS10,FS11,FT8,FT9,FT10,FT11
.setsym::GPR::XN,XABI
.setsym::FPR::FN,FABI
.setsym::CGPR::X8,X9,X10,X11,X12,X13,X14,X15,S0,FP,S1,A0,A1,A2,A3,A4,A5
.setsym::CFPR::F8,F9,F10,F11,F12,F13,F14,F15,FS0,FS1,FA0,FA1,FA2,FA3,FA4,FA5
.check::d::GPR
.check::s::GPR
.check::t::GPR
.check::fd::FPR
.check::fs::FPR
.check::ft::FPR
.check::fu::FPR
.check::vd::VN
.check::vs::VN
.check::vt::VN
.check::cd::CGPR
.check::cs::CGPR
.check::ct::CGPR
.check::cfd::CFPR
.check::cft::CFPR

/* ===================================================================
/* Word emitters (mini language, section 3.15)
/*
/* w4: a 32-bit word, little endian. w2: a 16-bit word.
/* b4 / j4: the scattered B-type and J-type words.
/* =================================================================== */
.func w4(z)
.return [z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff]
.endfunc

.func w2(z)
.return [z & 0xff, (z >> 8) & 0xff]
.endfunc

/* B-type: imm[12|10:5] | rs2 | rs1 | funct3 | imm[4:1|11] | opcode */
.func b4(off, rs2, rs1, f3)
z = (((off >> 12) & 1) << 31) | (((off >> 5) & 0x3f) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (((off >> 1) & 0xf) << 8) | (((off >> 11) & 1) << 7) | 0x63
.return [z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff]
.endfunc

/* J-type: imm[20|10:1|11|19:12] | rd | opcode */
.func j4(off, rd)
z = (((off >> 20) & 1) << 31) | (((off >> 1) & 0x3ff) << 21) | (((off >> 11) & 1) << 20) | (((off >> 12) & 0xff) << 12) | (rd << 7) | 0x6f
.return [z & 0xff, (z >> 8) & 0xff, (z >> 16) & 0xff, (z >> 24) & 0xff]
.endfunc

/* two words: auipc / lui style first word, then a second word */
.func w8(a, b)
.emit(a & 0xff, (a >> 8) & 0xff, (a >> 16) & 0xff, (a >> 24) & 0xff)
.emit(b & 0xff, (b >> 8) & 0xff, (b >> 16) & 0xff, (b >> 24) & 0xff)
.return
.endfunc

/* pc-relative pair: auipc rd,%pcrel_hi(off) ; second word with
/* the %pcrel_lo(off) in its I-type field (second = base word without
/* the immediate; rs/rd already in it). op2 is a function of the
/* low 12 bits: second | ((off & 0xfff) << 20) for I-type,
/* S-type split for a store. */
.func pair_i(off, rd, second)
a = 0x00000017 | ((((off + 0x800) >> 12) & 0xfffff) << 12) | (rd << 7)
b = second | ((off & 0xfff) << 20)
.emit(a & 0xff, (a >> 8) & 0xff, (a >> 16) & 0xff, (a >> 24) & 0xff)
.emit(b & 0xff, (b >> 8) & 0xff, (b >> 16) & 0xff, (b >> 24) & 0xff)
.return
.endfunc

.func pair_s(off, rt, second)
a = 0x00000017 | ((((off + 0x800) >> 12) & 0xfffff) << 12) | (rt << 7)
b = second | (((off >> 5) & 0x7f) << 25) | ((off & 0x1f) << 7)
.emit(a & 0xff, (a >> 8) & 0xff, (a >> 16) & 0xff, (a >> 24) & 0xff)
.emit(b & 0xff, (b >> 8) & 0xff, (b >> 16) & 0xff, (b >> 24) & 0xff)
.return
.endfunc

/* li: the constant materialisation LLVM and GNU use for RV64.
/* lseq returns the sequence as pairs [kind, imm, kind, imm ...]:
/*   kind 0 LUI   1 ADDI   2 ADDIW   3 SLLI   4 SRLI
/* li4 turns one into words; the sequence starts from the value
/* split into a low 12 bits and a (shifted) remainder, and is tried
/* again from the value with its trailing zeros removed and from -1
/* shifted right, keeping the shortest. */
.func lseq(val)
r = []
lo = ((val & 0xfff) ^ 0x800) - 0x800
.if val >= -2147483648 && val <= 2147483647 .then
hi = ((val + 0x800) >> 12) & 0xfffff
n = 0
.if hi != 0 .then
r[n] = 0
r[n + 1] = hi
n = n + 2
.endif
.if lo != 0 || hi == 0 .then
r[n] = 1
.if hi != 0 .then
r[n] = 2
.endif
r[n + 1] = lo
.endif
.return r
.endif
hi52 = (val + 0x800) >> 12
sh = 12
.while (hi52 & 1) == 0
hi52 = hi52 >> 1
sh = sh + 1
.endwhile
.if sh > 12 && (hi52 < -2048 || hi52 > 2047) .then
t = hi52 << 12
.if t >= -2147483648 && t <= 2147483647 .then
sh = sh - 12
hi52 = t
.endif
.endif
r = .call lseq(hi52)
n = .len(r)
r[n] = 3
r[n + 1] = sh
.if lo != 0 .then
r[n + 2] = 1
r[n + 3] = lo
.endif
.return r
.endfunc

.func li4(rd, val)
val = ((val & 0xffffffffffffffff) ^ 0x8000000000000000) - 0x8000000000000000
q = .call lseq(val)
.if (val & 0xfff) != 0 && (val & 1) == 0 && .len(q) >= 4 .then
tz = 0
.while ((val >> tz) & 1) == 0
tz = tz + 1
.endwhile
sv = val >> tz
q2 = .call lseq(sv)
q2[.len(q2)] = 3
q2[.len(q2)] = tz
.if .len(q2) < .len(q) || (sv >= -32 && sv <= 31) .then
q = q2
.endif
.endif
.if val > 0 && .len(q) > 4 .then
lz = 0
.while ((val >> (63 - lz)) & 1) == 0
lz = lz + 1
.endwhile
sv = (((val << lz) & 0xffffffffffffffff) | ((1 << lz) - 1))
sv = (sv ^ 0x8000000000000000) - 0x8000000000000000
q2 = .call lseq(sv)
q2[.len(q2)] = 4
q2[.len(q2)] = lz
.if .len(q2) < .len(q) .then
q = q2
.endif
.endif
rs = 0
.for i in range(.len(q) / 2)
kd = q[i * 2]
im = q[i * 2 + 1]
.if kd == 0 .then
w = (im << 12) | (rd << 7) | 0x37
.elif kd == 1 .then
w = ((im & 0xfff) << 20) | (rs << 15) | (rd << 7) | 0x13
.elif kd == 2 .then
w = ((im & 0xfff) << 20) | (rs << 15) | (rd << 7) | 0x1b
.elif kd == 3 .then
w = (im << 20) | (rs << 15) | (1 << 12) | (rd << 7) | 0x13
.else
w = (im << 20) | (rs << 15) | (5 << 12) | (rd << 7) | 0x13
.endif
.emit(w & 0xff, (w >> 8) & 0xff, (w >> 16) & 0xff, (w >> 24) & 0xff)
rs = rd
.next
.return
.endfunc

/* ===================================================================
/* Row generators (macro layer, section 7)
/*
/* Z emits one row: nm, the operand text, the error list, the constant
/* part of the word, and the operand fields or'ed into it.
/* =================================================================== */
!def Z(nm, ops, er, base, fx) {
!local head = nm
!if ops != "" !then {
!set head = nm + " " + ops
}
!if er == "" !then {
!{head} :: .call w4(0x!{base:08x}!{fx})
} !else {
!{head} :: !{er} :: .call w4(0x!{base:08x}!{fx})
}
}

/* the range tests */
!def E12() {
!return "v>2047||v<-2048;3"
}
!def EBR() {
!return "(v-$$)>4094||(v-$$)<-4096||((v-$$)&1)!=0;2"
}
!def EJ() {
!return "(v-$$)>1048574||(v-$$)<-1048576||((v-$$)&1)!=0;2"
}

/* R-type: nm d,s,t */
!def Rr(nm, f7, f3, op) {
!Z(nm, "d,s,t", "", (f7 << 25) | (f3 << 12) | op, "|(t<<20)|(s<<15)|(d<<7)")
}

/* I-type arithmetic: plain, %lo, %pcrel_lo, %tprel_lo */
!def Ri(nm, f3, op) {
!local b = (f3 << 12) | op
!Z(nm, "d,s,!v", E12(), b, "|((v&0xfff)<<20)|(s<<15)|(d<<7)")
.reloc::v::lo12_i
!Z(nm, "d,s,%LO(!v)", "", b, "|((v&0xfff)<<20)|(s<<15)|(d<<7)")
.clrreloc::v
.reloc::v::pcrel_lo12_i
!Z(nm, "d,s,%PCREL_LO(!v)", "", b, "|((v&0)<<20)|(s<<15)|(d<<7)")
.clrreloc::v
.reloc::v::tprel_lo12_i
!Z(nm, "d,s,%TPREL_LO(!v)", "", b, "|((v&0xfff)<<20)|(s<<15)|(d<<7)")
.clrreloc::v
}

/* shift by an immediate: bits is 6 (RV64) or 5 (the W forms) */
!def Rsh(nm, hi, f3, op, bits) {
!Z(nm, "d,s,!v", "v<0||v>" + str((1 << bits) - 1) + ";10", (hi << 20) | (f3 << 12) | op, "|(v<<20)|(s<<15)|(d<<7)")
}

/* loads: rd is d for the integer file, fd for the floating one */
!def ldm(nm, f3, op, rd) {
!local b = (f3 << 12) | op
!Z(nm, rd + ",!v(s)", "v>2047||v<-2048;8", b, "|((v&0xfff)<<20)|(s<<15)|(" + rd + "<<7)")
!Z(nm, rd + ",(s)", "", b, "|(s<<15)|(" + rd + "<<7)")
.reloc::v::lo12_i
!Z(nm, rd + ",%LO(!v)(s)", "", b, "|((v&0xfff)<<20)|(s<<15)|(" + rd + "<<7)")
.clrreloc::v
.reloc::v::pcrel_lo12_i
!Z(nm, rd + ",%PCREL_LO(!v)(s)", "", b, "|((v&0)<<20)|(s<<15)|(" + rd + "<<7)")
.clrreloc::v
.reloc::v::tprel_lo12_i
!Z(nm, rd + ",%TPREL_LO(!v)(s)", "", b, "|((v&0xfff)<<20)|(s<<15)|(" + rd + "<<7)")
.clrreloc::v
}

/* stores: rt is t for the integer file, ft for the floating one */
!def stm(nm, f3, op, rt) {
!local b = (f3 << 12) | op
!local sp = "|(((v>>5)&0x7f)<<25)|((v&0x1f)<<7)|(" + rt + "<<20)|(s<<15)"
!Z(nm, rt + ",!v(s)", "v>2047||v<-2048;8", b, sp)
!Z(nm, rt + ",(s)", "", b, "|(s<<15)|(" + rt + "<<20)")
.reloc::v::lo12_s
!Z(nm, rt + ",%LO(!v)(s)", "", b, sp)
.clrreloc::v
.reloc::v::pcrel_lo12_s
!Z(nm, rt + ",%PCREL_LO(!v)(s)", "", b, "|((v&0)<<7)|(s<<15)|(" + rt + "<<20)")
.clrreloc::v
.reloc::v::tprel_lo12_s
!Z(nm, rt + ",%TPREL_LO(!v)(s)", "", b, sp)
.clrreloc::v
}

/* conditional branches. Bc: nm s,t,target. Bs: the operands swapped
/* (bgt, ble ...). Bz: against zero, side 0 = rs1, side 1 = rs2. */
!def Bc(nm, f3) {
.reloc::v::branch
!{nm} s,t,!v :: !{EBR()} :: .call b4(v-$$,t,s,!{f3})
.clrreloc::v
}
!def Bs(nm, f3) {
.reloc::v::branch
!{nm} s,t,!v :: !{EBR()} :: .call b4(v-$$,s,t,!{f3})
.clrreloc::v
}
!def Bz(nm, f3, side) {
.reloc::v::branch
!if side == 0 !then {
!{nm} s,!v :: !{EBR()} :: .call b4(v-$$,0,s,!{f3})
} !else {
!{nm} s,!v :: !{EBR()} :: .call b4(v-$$,s,0,!{f3})
}
.clrreloc::v
}

/* ===================================================================
/* RV32I / RV64I
/* =================================================================== */

/* -- U-type: lui / auipc, and the modifiers ------------------------ */
.reloc::v::hi20
LUI d,%HI(!v) :: .call w4(0x37|((((v+0x800)>>12)&0xfffff)<<12)|(d<<7))
.clrreloc::v
.reloc::v::tprel_hi20
LUI d,%TPREL_HI(!v) :: .call w4(0x37|((((v+0x800)>>12)&0xfffff)<<12)|(d<<7))
.clrreloc::v
.reloc::v::pcrel_hi20
AUIPC d,%PCREL_HI(!v) :: .call w4(0x17|((((v-$$+0x800)>>12)&0xfffff)<<12)|(d<<7))
.clrreloc::v
.reloc::v::got_hi20
AUIPC d,%GOT_PCREL_HI(!v) :: .call w4(0x17|((v&0)<<12)|(d<<7))
.clrreloc::v
.reloc::v::tls_got_hi20
AUIPC d,%TLS_IE_PCREL_HI(!v) :: .call w4(0x17|((v&0)<<12)|(d<<7))
.clrreloc::v
.reloc::v::tls_gd_hi20
AUIPC d,%TLS_GD_PCREL_HI(!v) :: .call w4(0x17|((v&0)<<12)|(d<<7))
.clrreloc::v
LUI d,!v :: v>1048575||v<-524288;3 :: .call w4(0x37|((v&0xfffff)<<12)|(d<<7))
AUIPC d,!v :: v>1048575||v<-524288;3 :: .call w4(0x17|((v&0xfffff)<<12)|(d<<7))

/* -- jumps --------------------------------------------------------- */
.reloc::v::jal
JAL d,!v :: !{EJ()} :: .call j4(v-$$,d)
JAL !v :: !{EJ()} :: .call j4(v-$$,1)
J !v :: !{EJ()} :: .call j4(v-$$,0)
.clrreloc::v
!Z("JALR", "d,!v(s)", E12(), 0x67, "|((v&0xfff)<<20)|(s<<15)|(d<<7)")
!Z("JALR", "d,s,!v", E12(), 0x67, "|((v&0xfff)<<20)|(s<<15)|(d<<7)")
!Z("JALR", "d,(s)", "", 0x67, "|(s<<15)|(d<<7)")
!Z("JALR", "d,s", "", 0x67, "|(s<<15)|(d<<7)")
!Z("JALR", "s", "", 0x67 | (1 << 7), "|(s<<15)")
.reloc::v::lo12_i
!Z("JALR", "d,%LO(!v)(s)", "", 0x67, "|((v&0xfff)<<20)|(s<<15)|(d<<7)")
.clrreloc::v
.reloc::v::pcrel_lo12_i
!Z("JALR", "d,%PCREL_LO(!v)(s)", "", 0x67, "|((v&0)<<20)|(s<<15)|(d<<7)")
.clrreloc::v
!Z("JR", "s", "", 0x67, "|(s<<15)")
!Z("RET", "", "", 0x00008067, "")

/* -- branches ------------------------------------------------------ */
!Bc("BEQ", 0)
!Bc("BNE", 1)
!Bc("BLT", 4)
!Bc("BGE", 5)
!Bc("BLTU", 6)
!Bc("BGEU", 7)
!Bs("BGT", 4)
!Bs("BLE", 5)
!Bs("BGTU", 6)
!Bs("BLEU", 7)
!Bz("BEQZ", 0, 0)
!Bz("BNEZ", 1, 0)
!Bz("BLTZ", 4, 0)
!Bz("BGEZ", 5, 0)
!Bz("BGTZ", 4, 1)
!Bz("BLEZ", 5, 1)

/* -- loads and stores ---------------------------------------------- */
!ldm("LB", 0, 0x03, "d")
!ldm("LH", 1, 0x03, "d")
!ldm("LW", 2, 0x03, "d")
!ldm("LD", 3, 0x03, "d")
!ldm("LBU", 4, 0x03, "d")
!ldm("LHU", 5, 0x03, "d")
!ldm("LWU", 6, 0x03, "d")
!stm("SB", 0, 0x23, "t")
!stm("SH", 1, 0x23, "t")
!stm("SW", 2, 0x23, "t")
!stm("SD", 3, 0x23, "t")

/* -- OP-IMM / OP-IMM-32 -------------------------------------------- */
!Ri("ADDI", 0, 0x13)
!Ri("SLTI", 2, 0x13)
!Ri("SLTIU", 3, 0x13)
!Ri("XORI", 4, 0x13)
!Ri("ORI", 6, 0x13)
!Ri("ANDI", 7, 0x13)
!Ri("ADDIW", 0, 0x1b)
!Rsh("SLLI", 0x000, 1, 0x13, 6)
!Rsh("SRLI", 0x000, 5, 0x13, 6)
!Rsh("SRAI", 0x400, 5, 0x13, 6)
!Rsh("SLLIW", 0x000, 1, 0x1b, 5)
!Rsh("SRLIW", 0x000, 5, 0x1b, 5)
!Rsh("SRAIW", 0x400, 5, 0x1b, 5)

/* -- OP / OP-32 ---------------------------------------------------- */
!Rr("ADD", 0x00, 0, 0x33)
!Rr("SUB", 0x20, 0, 0x33)
!Rr("SLL", 0x00, 1, 0x33)
!Rr("SLT", 0x00, 2, 0x33)
!Rr("SLTU", 0x00, 3, 0x33)
!Rr("XOR", 0x00, 4, 0x33)
!Rr("SRL", 0x00, 5, 0x33)
!Rr("SRA", 0x20, 5, 0x33)
!Rr("OR", 0x00, 6, 0x33)
!Rr("AND", 0x00, 7, 0x33)
!Rr("ADDW", 0x00, 0, 0x3b)
!Rr("SUBW", 0x20, 0, 0x3b)
!Rr("SLLW", 0x00, 1, 0x3b)
!Rr("SRLW", 0x00, 5, 0x3b)
!Rr("SRAW", 0x20, 5, 0x3b)

/* -- fences and system --------------------------------------------- */
/* the predecessor / successor sets: any non-empty subset of iorw */
.sub::fs
!def fsub() {
!local m = 1
!while m < 16 {
!local nm = ""
!if (m & 8) != 0 !then {
!set nm = nm + "I"
}
!if (m & 4) != 0 !then {
!set nm = nm + "O"
}
!if (m & 2) != 0 !then {
!set nm = nm + "R"
}
!if (m & 1) != 0 !then {
!set nm = nm + "W"
}
!{nm}::!{m}
!set m = m + 1
}
}
!fsub()
.endsub
FENCE !S{{fs}}p,!S{{fs}}q :: .call w4(0x0f|(p<<24)|(q<<20))
FENCE :: .call w4(0x0ff0000f)
FENCE.TSO :: .call w4(0x8330000f)
FENCE.I :: .call w4(0x0000100f)
PAUSE :: .call w4(0x0100000f)
ECALL :: .call w4(0x00000073)
EBREAK :: .call w4(0x00100073)
NOP :: .call w4(0x00000013)

/* -- pseudo-instructions of the base set --------------------------- */
!Z("MV", "d,s", "", 0x13, "|(s<<15)|(d<<7)")
!Z("NOT", "d,s", "", 0xfff04013, "|(s<<15)|(d<<7)")
!Z("NEG", "d,t", "", 0x40000033, "|(t<<20)|(d<<7)")
!Z("NEGW", "d,t", "", 0x4000003b, "|(t<<20)|(d<<7)")
!Z("SEXT.W", "d,s", "", 0x1b, "|(s<<15)|(d<<7)")
!Z("ZEXT.B", "d,s", "", 0x0ff07013, "|(s<<15)|(d<<7)")
!Z("SEQZ", "d,s", "", 0x00103013, "|(s<<15)|(d<<7)")
!Z("SNEZ", "d,t", "", 0x00003033, "|(t<<20)|(d<<7)")
!Z("SLTZ", "d,s", "", 0x2033, "|(s<<15)|(d<<7)")
!Z("SGTZ", "d,t", "", 0x2033, "|(t<<20)|(d<<7)")
LI d,!v :: .call li4(d,v)

/* -- call, tail, la: pc-relative pairs ------------------------------ */
/* call: auipc ra,%pcrel_hi(t) ; jalr ra,%pcrel_lo(t)(ra) -- two words,
/* covered by one R_RISCV_CALL_PLT over the 8-byte pair. call d,t uses
/* d as the link register, tail uses t1 and does not link. */
.func call8(off, rd, rt)
a = 0x00000017 | ((((off + 0x800) >> 12) & 0xfffff) << 12) | (rt << 7)
b = 0x00000067 | ((off & 0xfff) << 20) | (rt << 15) | (rd << 7)
.emit(a & 0xff, (a >> 8) & 0xff, (a >> 16) & 0xff, (a >> 24) & 0xff)
.emit(b & 0xff, (b >> 8) & 0xff, (b >> 16) & 0xff, (b >> 24) & 0xff)
.return
.endfunc
.reloc::v::call
CALL !v :: .call call8(v-$$,1,1)
CALL d,!v :: .call call8(v-$$,d,d)
TAIL !v :: .call call8(v-$$,0,6)
JUMP !v,s :: .call call8(v-$$,0,s)
.clrreloc::v
/* la / lla: auipc + addi, the offset worked out here */
LA d,!v :: .call pair_i(v-$$,d,0x13|(d<<15)|(d<<7))
LLA d,!v :: .call pair_i(v-$$,d,0x13|(d<<15)|(d<<7))
/* the global load / store forms: auipc + load, auipc + store */
!def gl(nm, f3, op, rd) {
!{nm} !{rd},!v :: .call pair_i(v-$$,!{rd},0x!{(f3 << 12) | op:x}|(!{rd}<<15)|(!{rd}<<7))
}
!def gs(nm, f3, op, rt) {
!{nm} !{rt},!v,s :: .call pair_s(v-$$,s,0x!{(f3 << 12) | op:x}|(s<<15)|(!{rt}<<20))
}
!gl("LB", 0, 0x03, "d")
!gl("LH", 1, 0x03, "d")
!gl("LW", 2, 0x03, "d")
!gl("LD", 3, 0x03, "d")
!gl("LBU", 4, 0x03, "d")
!gl("LHU", 5, 0x03, "d")
!gl("LWU", 6, 0x03, "d")
!gs("SB", 0, 0x23, "t")
!gs("SH", 1, 0x23, "t")
!gs("SW", 2, 0x23, "t")
!gs("SD", 3, 0x23, "t")

/* ===================================================================
/* M: multiply and divide
/* =================================================================== */
!Rr("MUL", 0x01, 0, 0x33)
!Rr("MULH", 0x01, 1, 0x33)
!Rr("MULHSU", 0x01, 2, 0x33)
!Rr("MULHU", 0x01, 3, 0x33)
!Rr("DIV", 0x01, 4, 0x33)
!Rr("DIVU", 0x01, 5, 0x33)
!Rr("REM", 0x01, 6, 0x33)
!Rr("REMU", 0x01, 7, 0x33)
!Rr("MULW", 0x01, 0, 0x3b)
!Rr("DIVW", 0x01, 4, 0x3b)
!Rr("DIVUW", 0x01, 5, 0x3b)
!Rr("REMW", 0x01, 6, 0x3b)
!Rr("REMUW", 0x01, 7, 0x3b)

/* ===================================================================
/* A: atomics. nm, nm.aq, nm.rl, nm.aqrl, each with (rs1) or 0(rs1)
/* =================================================================== */
!def amo1(nm, f5, f3, lr) {
!local sfx = ""
!local a = 0
!while a < 4 {
!if a == 0 !then {
!set sfx = ""
} !elif a == 1 !then {
!set sfx = ".RL"
} !elif a == 2 !then {
!set sfx = ".AQ"
} !else {
!set sfx = ".AQRL"
}
!if lr == 1 !then {
!Z(nm + sfx, "d,(s)", "", (f5 << 27) | (f3 << 12) | 0x2f | (a << 25), "|(s<<15)|(d<<7)")
!Z(nm + sfx, "d,!v(s)", "v!=0;3", (f5 << 27) | (f3 << 12) | 0x2f | (a << 25), "|(s<<15)|(d<<7)")
} !else {
!Z(nm + sfx, "d,t,(s)", "", (f5 << 27) | (f3 << 12) | 0x2f | (a << 25), "|(t<<20)|(s<<15)|(d<<7)")
!Z(nm + sfx, "d,t,!v(s)", "v!=0;3", (f5 << 27) | (f3 << 12) | 0x2f | (a << 25), "|(t<<20)|(s<<15)|(d<<7)")
}
!set a = a + 1
}
}
!def amo(nm, f5) {
!amo1(nm + ".W", f5, 2, 0)
!amo1(nm + ".D", f5, 3, 0)
}
!amo1("LR.W", 0x02, 2, 1)
!amo1("LR.D", 0x02, 3, 1)
!amo("SC", 0x03)
!amo("AMOSWAP", 0x01)
!amo("AMOADD", 0x00)
!amo("AMOXOR", 0x04)
!amo("AMOAND", 0x0c)
!amo("AMOOR", 0x08)
!amo("AMOMIN", 0x10)
!amo("AMOMAX", 0x14)
!amo("AMOMINU", 0x18)
!amo("AMOMAXU", 0x1c)

