!Vfmac("VFWMACCBF16", 0x3b)
!def amob(nm, f5) {
!amo1(nm + ".B", f5, 0, 0)
!amo1(nm + ".H", f5, 1, 0)
}
!amob("AMOSWAP", 0x01)
!amob("AMOADD", 0x00)
