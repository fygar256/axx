!Vme("VWCVTU.X.X.V", "vd,vs", "", (0x30 << 26) | (6 << 12) | 0x57, "|(vs<<20)|(vd<<7)")
/* the greater-than forms, written as the swapped less-than ones */
!def Vsw(nm, f6) {
!Vme(nm, "vd,vs,vt", "", (f6 << 26) | 0x57, "|(vt<<20)|(vs<<15)|(vd<<7)")
}
!Vsw("VMSGT.VV", 0x1b)
!Vsw("VMSGTU.VV", 0x1a)
!Vsw("VMSGE.VV", 0x1d)
!Vsw("VMSGEU.VV", 0x1c)
!Vme("VMFGT.VV", "vd,vs,vt", "", (0x1b << 26) | (1 << 12) | 0x57, "|(vt<<20)|(vs<<15)|(vd<<7)")
!Vme("VMFGE.VV", "vd,vs,vt", "", (0x19 << 26) | (1 << 12) | 0x57, "|(vt<<20)|(vs<<15)|(vd<<7)")
/* vmslt.vi vd,vs,imm is vmsle.vi vd,vs,imm-1, and so on */
!def Vdec(nm, f6) {
!Vme(nm, "vd,vs,!v", "v<-15||v>16;3", (f6 << 26) | (3 << 12) | 0x57, "|(vs<<20)|(((v-1)&31)<<15)|(vd<<7)")
}
!Vdec("VMSLT.VI", 0x1d)
!Vdec("VMSLTU.VI", 0x1c)
!Vdec("VMSGE.VI", 0x1f)
!Vdec("VMSGEU.VI", 0x1e)

/* ===================================================================
/* Vector bit manipulation and cryptography: Zvbb, Zvbc, Zvkg, Zvkned,
/* Zvknha / Zvknhb, Zvksed, Zvksh
/* =================================================================== */
!Vg("VANDN", ".VV", 0x01, 0, "v")
!Vg("VANDN", ".VX", 0x01, 4, "x")
