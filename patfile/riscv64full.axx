!def mops() {
!local n = 0
!while n < 32 {
MOP.R.!{n} d,s :: .call w4(0x!{0x81c04073 | (((n >> 4) & 1) << 30) | (((n >> 2) & 3) << 26) | ((n & 3) << 20):08x}|(s<<15)|(d<<7))
!if n < 8 !then {
MOP.RR.!{n} d,s,t :: .call w4(0x!{0x82004073 | (((n >> 2) & 1) << 30) | ((n & 3) << 26):08x}|(t<<20)|(s<<15)|(d<<7))
}
!set n = n + 1
}
}
!mops()
