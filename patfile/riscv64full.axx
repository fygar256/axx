/* Zacas: compare-and-swap; the quad form takes even register pairs */
!amo1("AMOCAS.W", 0x05, 2, 0)
!amo1("AMOCAS.D", 0x05, 3, 0)
!def amoq() {
!local a = 0
!local sfx = ""
!while a < 4 {
!if a == 0 !then {
!set sfx = ""
} !elif a == 1 !then {
!set sfx = ".RL"
} !elif a == 2 !then {
!set sfx = ".AQ"
} !else {
!set sfx = ".AQRL"
}
!Z("AMOCAS.Q" + sfx, "d,t,(s)", "(d&1)!=0||(t&1)!=0;5", (0x05 << 27) | (4 << 12) | 0x2f | (a << 25), "|(t<<20)|(s<<15)|(d<<7)")
!set a = a + 1
}
}
!amoq()
