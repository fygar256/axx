/* ===================================================================
/* Later and small extensions: Zfbfmin / Zvfbfmin / Zvfbfwma (bf16),
/* Zabha (byte and halfword atomics), c.sspush / c.sspopchk (Zicfiss)
/* =================================================================== */
!Fm("FCVT.BF16.S", "fd,fs", 0x44800053, "|(fs<<15)|(fd<<7)")
!Fm("FCVT.S.BF16", "fd,fs", 0x40600053, "|(fs<<15)|(fd<<7)")
