/*  ==================================================================
/*  expcap.axx -- どの捕捉子でも {{.exp()}} が綴りを出すこと
/*
/*  Technical_Manual 3.18 のテスト。`!L` だけでなく、小文字変数・`!`・
/*  `!!`・`!F`・`!D`・`!Q`・`!E`・`!S{{表}}`・`!Y集合[変数]` のどれで
/*  拾っても、変数は値と一緒にソースに書かれていたままの綴りを覚え、
/*  `{{.exp(<変数>)}}` がそれを出すことを確かめる。あわせて
/*    - 停止文字 `\,` は綴りに含まれないこと
/*    - 前後の空白は落ちること
/*    - `!S{{表}}` の綴りはエントリのパターンが当たった範囲全体であること
/*      （入れ子でも、外側の範囲が内側を含むこと）
/*    - `[[ ]]` の中で拾わなかった回は空文字になること
/*  を確かめる。paxx と caxx が同じバイト列を出すことも確かめる。
/*  ==================================================================

.bits::8
.textmode

.setsym::B::0
.setsym::C::1
.setsym::D::2
.setsym::A0::0x01
.setsym::A1::0x02
.setsym::A2::0x04
.setsym::rn::[AX,BX,CX,DX]

/*  小文字変数（シンボル）。値と綴りの両方を使う。 */
.check::r::B,C,D
.check::r2::B,C,D
MOV r,r2      :: "mov {{.exp(r)}}<-{{.exp(r2)}} ; {{.hex(r)}},{{.hex(r2)}}"

/*  `!` は式。停止文字は綴りに入らない。 */
EXPR !a       :: "expr [{{.exp(a)}}] = {{.hex(a)}}"
STOP !a\,!b   :: "stop [{{.exp(a)}}] [{{.exp(b)}}] = {{.hex(a+b)}}"

/*  `!!` は因子。続く `+1` は因子に含まれない。 */
FACT !!a+1    :: "fact [{{.exp(a)}}] = {{.hex(a)}}"

/*  浮動小数点の 3 種。 */
FLT !Ff       :: "flt [{{.exp(f)}}] = {{.hex(f)}}"
DBL !Dd       :: "dbl [{{.exp(d)}}] = {{.hex(d)}}"
QAD !Qq       :: "qad [{{.exp(q)}}]"

/*  `!E` は列挙リスト。綴りはリスト全体。 */
.enum::e::A0,A1,A2::A0|A1|A2
PUSH !Ee,-(SP) :: "push [{{.exp(e)}}] = {{.hex(e)}}"

/*  `!Y` は集合の項目。値は項目番号、綴りは書かれた名前。 */
SEL !Yrn[k]   :: "sel [{{.exp(k)}}] = {{.hex(k)}}"

/*  `!L` は今までどおり。 */
JMP !Ll       :: "jmp [{{.exp(l)}}]"

/*  `!S{{表}}` は当たったエントリの範囲全体。値はエントリの値。 */
LD!S{{sz}}s !a :: "ld [{{.exp(s)}}] = {{.hex(s)}} [{{.exp(a)}}]"
.sub::sz
.B::1
.W::2
.endsub

/*  入れ子。外側の綴りは内側の範囲を含む。 */
NEST !S{{outer}}o :: "nest [{{.exp(o)}}] = {{.hex(o)}} [{{.exp(i)}}] = {{.hex(i)}}"
.sub::outer
X!S{{inner}}i::i
Y!S{{inner}}i::i+0x40
.endsub
.sub::inner
1::0x01
2::0x02
.endsub

/*  表のエントリが式で終わり、その後ろに停止文字が来る形。 */
PAIR !S{{ex}}x\,!b :: "pair [{{.exp(x)}}] [{{.exp(c)}}] [{{.exp(b)}}]"
.sub::ex
#!c::0x80
.endsub

/*  `[[ ]]` の中で拾わなかった回は空文字。 */
OPT !a[[,!b]] :: "opt [{{.exp(a)}}] [{{.exp(b)}}]"
