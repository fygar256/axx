LGS d,[b+!o]     ::  ::  0x48|((d&8)>>1)|((b&8)>>3),0x0f,0xb5,0x80|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]

/* LSS d,[mem] — r64 と SS を一括ロード */
LSS d,[b+r*!!h]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb2,(((b&7)==5)?0x40:0)|0x04|((d&7)<<3),(@h-1)<<6|((r&7)<<3)|(b&7),@@[((b&7)==5),0x00]
