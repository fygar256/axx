/* ====================== x87 FPU ====================== */

/* =========================================================
   v9.0 追加: x87 FPU 完全版 (D8-DF エスケープ)
   変数 d: ST インデックス (ST0-ST7 = 0-7)
   SIZE: DWORD=m32  QWORD=m64  TBYTE=m80  WORD=m16
   ========================================================= */

/* ===== FLD (浮動小数点ロード) ===== */
FLD ST0        ::  ::  0xd9,0xc0
FLD ST1        ::  ::  0xd9,0xc1
FLD ST2        ::  ::  0xd9,0xc2
FLD ST3        ::  ::  0xd9,0xc3
FLD ST4        ::  ::  0xd9,0xc4
FLD ST5        ::  ::  0xd9,0xc5
FLD ST6        ::  ::  0xd9,0xc6
FLD ST7        ::  ::  0xd9,0xc7
FLD DWORD [b]      ::  ::  ;((b&8)?0x41:0),0xd9,(((b&7)==5)?0x40:0)|0x0|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
FLD DWORD [b+!o]B  ::  ::  ;((b&8)?0x41:0),0xd9,0x40|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
