/* ====================== REP/REPE/REPNE プレフィクス構文 ====================== */
/* axxはプレフィクスを独立命令として扱う */
REP MOVSB               ::  ::  0xf3,0xa4
REP MOVSW               ::  ::  0xf3,0x66,0xa5
REP MOVSD               ::  ::  0xf3,0xa5
REP MOVSQ               ::  ::  0xf3,0x48,0xa5
REP STOSB               ::  ::  0xf3,0xaa
REP STOSW               ::  ::  0xf3,0x66,0xab
REP STOSD               ::  ::  0xf3,0xab
REP STOSQ               ::  ::  0xf3,0x48,0xab
REP LODSB               ::  ::  0xf3,0xac
REP LODSW               ::  ::  0xf3,0x66,0xad
REP LODSD               ::  ::  0xf3,0xad
REP LODSQ               ::  ::  0xf3,0x48,0xad
REPE CMPSB              ::  ::  0xf3,0xa6
REPE CMPSW              ::  ::  0xf3,0x66,0xa7
REPE CMPSD              ::  ::  0xf3,0xa7
REPE CMPSQ              ::  ::  0xf3,0x48,0xa7
REPNE CMPSB             ::  ::  0xf2,0xa6
REPNE CMPSW             ::  ::  0xf2,0x66,0xa7
REPNE CMPSD             ::  ::  0xf2,0xa7
REPNE CMPSQ             ::  ::  0xf2,0x48,0xa7
REPE SCASB              ::  ::  0xf3,0xae
REPE SCASW              ::  ::  0xf3,0x66,0xaf
REPE SCASD              ::  ::  0xf3,0xaf
REPE SCASQ              ::  ::  0xf3,0x48,0xaf
