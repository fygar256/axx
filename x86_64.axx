   セグメントオーバーライドプレフィックスバイト:
     ES=0x26  CS=0x2E  SS=0x36  DS=0x3E  FS=0x64  GS=0x65

   構文: MOV dest, SEG:[base+disp]  /  MOV SEG:[base+disp], src
   パターン変数:
     d = ロード先 64bit レジスタ
     s = ストア元 64bit レジスタ
     b = ベースレジスタ (0–15)
     r = インデックスレジスタ (SIB 用)
     o = ディスプレースメント

   ★ SEG:[...] という構文は既存の [b] 等と構造が異なるため
     ファイル末尾への追加で競合は発生しない ★

   注: 64ビットモードでは FS:/GS: のみ CPU がアドレス変換に使用。
       CS:/SS:/DS:/ES: はプレフィックスは許容されるが CPU に無視される。

   使用例:
     MOV RAX, FS:[RBX]           ; TLS ベースアドレスロード
     MOV GS:[RCX+0x28], RAX      ; GS 相対ストア
     MOV RDX, FS:[RSP+!offset]B  ; FS 相対 disp8 ロード
   ========================================================= */

/* ================================================================
   C [v10簡約]: MOV p:[mem] / MOV [mem],p / DWORD/WORD/BYTE/imm  全6セグ統合
   prefix = (p<4)?(0x26|(p<<3)):(0x60|(p&7))
     ES=0x26 CS=0x2e SS=0x36 DS=0x3e (p=0-3: 算術式)
     FS=0x64 GS=0x65                 (p=4-5: 0x60|(p&7))
   ================================================================ */
.check::p::ES,CS,SS,DS,FS,GS
   ================================================================ */

/* RSP/R12: rm=4 → SIB 必須 (SIB=0x24: scale=0,index=none,base=RSP/R12) */
MOV d,p:[b+r*!!h]     ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,(((b&7)==5)?0x40:0)|0x04|((d&7)<<3),((@h-1)<<6|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV d,p:[b+r*1+!o]  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,p:[b+r*2+!o]  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((2-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,p:[b+r*4+!o]  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((3-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV d,p:[b+r*8+!o]  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x84|((d&7)<<3),((4-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
/* RBP/R13: mod=00,rm=5 = RIP相対 → mod=01,disp8=0 を使用 */
/* 汎用 [b] — disp なし */
MOV d,p:[b]         ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((b&8)>>3),0x8b,(((b&7)==5)?0x40:0)|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
/* disp8 形式 */
MOV d,p:[b+r*1+!o]B ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,p:[b+r*2+!o]B ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((2-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,p:[b+r*4+!o]B ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((3-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,p:[b+r*8+!o]B ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((r&8)>>2)|((b&8)>>3),0x8b,0x44|((d&7)<<3),((4-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV d,p:[b+!o]B     ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((b&8)>>3),0x8b,0x40|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
/* disp32 形式 */
MOV d,p:[b+!o]      ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((d&8)>>1)|((b&8)>>3),0x8b,0x80|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]
/* SIB 形式: [b+r*scale]  scale=1/2/4/8  (ModRM.rm=4, SIBバイト使用) */

MOV p:[b+r*!!h],s     ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,(((b&7)==5)?0x40:0)|0x04|((s&7)<<3),((@h-1)<<6|((r&7)<<3)|(b&7)),@@[((b&7)==5),0x00]
MOV p:[b+r*1+!o],s  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x84|((s&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV p:[b+r*2+!o],s  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x84|((s&7)<<3),((2-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV p:[b+r*4+!o],s  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x84|((s&7)<<3),((3-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV p:[b+r*8+!o],s  ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x84|((s&7)<<3),((4-1)<<6|((r&7)<<3)|(b&7)),@@[4,*(o,%%)]
MOV p:[b],s         ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((b&8)>>3),0x89,(((b&7)==5)?0x40:0)|((s&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
MOV p:[b+r*1+!o]B,s ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x44|((s&7)<<3),((1-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV p:[b+r*2+!o]B,s ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x44|((s&7)<<3),((2-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV p:[b+r*4+!o]B,s ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x44|((s&7)<<3),((3-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV p:[b+r*8+!o]B,s ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((r&8)>>2)|((b&8)>>3),0x89,0x44|((s&7)<<3),((4-1)<<6|((r&7)<<3)|(b&7)),(o&0xff)
MOV p:[b+!o]B,s     ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((b&8)>>3),0x89,0x40|((s&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
MOV p:[b+!o],s      ::  ::  (p<4)?(0x26|(p<<3)):(0x60|(p&7)),0x48|((s&8)>>1)|((b&8)>>3),0x89,0x80|((s&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]
/* SIB ストア */

/* ================================================================
   CS: セグメントオーバーライドプレフィックス = 0x2e
   ================================================================ */

/* RSP/R12: rm=4 → SIB 必須 (SIB=0x24: scale=0,index=none,base=RSP/R12) */
/* RBP/R13: mod=00,rm=5 = RIP相対 → mod=01,disp8=0 を使用 */
/* 汎用 [b] — disp なし */
/* disp8 形式 */
/* disp32 形式 */
/* SIB 形式: [b+r*scale]  scale=1/2/4/8  (ModRM.rm=4, SIBバイト使用) */

/* SIB ストア */

/* ================================================================
   SS: セグメントオーバーライドプレフィックス = 0x36
   ================================================================ */

/* RSP/R12: rm=4 → SIB 必須 (SIB=0x24: scale=0,index=none,base=RSP/R12) */
/* RBP/R13: mod=00,rm=5 = RIP相対 → mod=01,disp8=0 を使用 */
/* 汎用 [b] — disp なし */
/* disp8 形式 */
/* disp32 形式 */
/* SIB 形式: [b+r*scale]  scale=1/2/4/8  (ModRM.rm=4, SIBバイト使用) */

/* SIB ストア */

/* ================================================================
   DS: セグメントオーバーライドプレフィックス = 0x3e
   ================================================================ */

/* RSP/R12: rm=4 → SIB 必須 (SIB=0x24: scale=0,index=none,base=RSP/R12) */
/* RBP/R13: mod=00,rm=5 = RIP相対 → mod=01,disp8=0 を使用 */
/* 汎用 [b] — disp なし */
/* disp8 形式 */
/* disp32 形式 */
/* SIB 形式: [b+r*scale]  scale=1/2/4/8  (ModRM.rm=4, SIBバイト使用) */

/* SIB ストア */

/* ================================================================
   FS: セグメントオーバーライドプレフィックス = 0x64
   ================================================================ */

/* --- MOV r64, FS:[mem]  64ビットロード (プレフィックス=0x64, REX.W=1, opcode=0x8B) --- */
/* RSP/R12: rm=4 → SIB 必須 (SIB=0x24: scale=0,index=none,base=RSP/R12) */
/* RBP/R13: mod=00,rm=5 = RIP相対 → mod=01,disp8=0 を使用 */
/* 汎用 [b] — disp なし */
/* disp8 形式 */
/* disp32 形式 */
/* SIB 形式: [b+r*scale]  scale=1/2/4/8  (ModRM.rm=4, SIBバイト使用) */

/* --- MOV FS:[mem], s  64ビットストア (プレフィックス=0x64, REX.W=1, opcode=0x89) --- */
/* SIB ストア */

/* ================================================================
   GS: セグメントオーバーライドプレフィックス = 0x65
   ================================================================ */

/* RSP/R12: rm=4 → SIB 必須 (SIB=0x24: scale=0,index=none,base=RSP/R12) */
/* RBP/R13: mod=00,rm=5 = RIP相対 → mod=01,disp8=0 を使用 */
/* 汎用 [b] — disp なし */
/* disp8 形式 */
/* disp32 形式 */
/* SIB 形式: [b+r*scale]  scale=1/2/4/8  (ModRM.rm=4, SIBバイト使用) */

/* SIB ストア */

/* =========================================================
   LFS / LGS / LSS — ファーポインタロード (64ビット)
   0F B4/B5/B2 /r  (REX.W=1 で 64ビット汎用レジスタにロード)
   メモリ配置: [mem+0..7]=r64, [mem+8..9]=sreg
   ========================================================= */
/* LFS d,[mem] — r64 と FS を一括ロード */
LFS d,[b+r*!!h]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,(((b&7)==5)?0x40:0)|0x04|((d&7)<<3),(@h-1)<<6|((r&7)<<3)|(b&7),@@[((b&7)==5),0x00]
LFS d,[b+r*1+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x84|((d&7)<<3),(1-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LFS d,[b+r*2+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x84|((d&7)<<3),(2-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LFS d,[b+r*4+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x84|((d&7)<<3),(3-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LFS d,[b+r*8+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x84|((d&7)<<3),(4-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LFS d,[b]        ::  ::  0x48|((d&8)>>1)|((b&8)>>3),0x0f,0xb4,(((b&7)==5)?0x40:0)|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[((b&7)==5),0x00]
LFS d,[b+r*1+!o]B        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x44|((d&7)<<3),(1-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LFS d,[b+r*2+!o]B        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x44|((d&7)<<3),(2-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LFS d,[b+r*4+!o]B        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x44|((d&7)<<3),(3-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LFS d,[b+r*8+!o]B        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb4,0x44|((d&7)<<3),(4-1)<<6|((r&7)<<3)|(b&7),(o&0xff)
LFS d,[b+!o]B    ::  ::  0x48|((d&8)>>1)|((b&8)>>3),0x0f,0xb4,0x40|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),(o&0xff)
LFS d,[b+!o]     ::  ::  0x48|((d&8)>>1)|((b&8)>>3),0x0f,0xb4,0x80|((d&7)<<3)|(b&7),;(((b&7)==4)?0x24:0),@@[4,*(o,%%)]

/* LGS d,[mem] — r64 と GS を一括ロード */
LGS d,[b+r*!!h]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb5,(((b&7)==5)?0x40:0)|0x04|((d&7)<<3),(@h-1)<<6|((r&7)<<3)|(b&7),@@[((b&7)==5),0x00]
LGS d,[b+r*1+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb5,0x84|((d&7)<<3),(1-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LGS d,[b+r*2+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb5,0x84|((d&7)<<3),(2-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
LGS d,[b+r*4+!o]        ::  ::0x48|((d&8)>>1)|((b&8)>>3)|((r&8)>>2),0x0f,0xb5,0x84|((d&7)<<3),(3-1)<<6|((r&7)<<3)|(b&7),@@[4,*(o,%%)]
