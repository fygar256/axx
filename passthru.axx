/*  ==================================================================
/*  passthru.axx -- .passthru と .eol のテスト
/*
/*  Technical_Manual 3.16 / 3.17 のテスト。書き換える行と素通しする行が
/*  混ざったソースで、1行が1行として出ることと、paxx と caxx が同じバイト列
/*  を出すことを確かめる。テンプレートには `\n` を書いていない — 行末の改行
/*  は .eol が付ける。
/*  ==================================================================

.bits::8
.passthru
.eol

.map::r::AX,BX,CX
.setsym::rn::[AX,BX,CX]

MOV r,!e::"LD {{rn[r]}},0x{{.hex(e)}}"
MOV r,r2::"LD {{rn[r]}},{{rn[r2]}}"
NOP::"NOP"
