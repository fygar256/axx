/*  ==================================================================
/*  endsub.axx -- `.sub` ブロックの終わりを `.endsub` でも書けること
/*
/*  Technical_Manual 3.7.2 のテスト。`.sub … .return` と
/*  `.sub … .endsub` が同じ意味であることと、両方を同じパターン
/*  ファイルに混ぜて書けることを、paxx と caxx の両方で確かめる。
/*  `.func … .endfunc` と綴りをそろえたいときのための別名である。
/*  ==================================================================

.bits::8

/*  `.endsub` で閉じるサブテーブル。 */
MOV!S{{sub1}}x A,!e :: 0x01,x<<8,x,e<<8,e
.sub::sub1
R1::0x01,0x01
R2::0x02,0x02
R3::0x03,0x03
.endsub

/*  同じパターンファイルの中で `.return` でも閉じられる。 */
ADD!S{{sub2}}y :: 0x20|y
.sub::sub2
X::0
Y::1
.return

/*  入れ子（参照による）も、外側を `.endsub`、内側を `.return` で
/*  閉じて同じに動く。 */
LD!S{{outer}}a :: 0x10,a
.sub::outer
A!S{{inner}}b::b
B!S{{inner}}b::b+0x40
.endsub
.sub::inner
1::0x01
2::0x02
.return

/*  エントリパターン自身の捕捉も、閉じ方に関係なく効く。 */
CNT!S{{digits}}n :: 0x30|n
.sub::digits
D!n::n
.endsub
