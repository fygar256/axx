#!/bin/sh
# axx.fs を caxx (caxx.c) と突き合わせる（test1 と同じコマンド列を使う別のスクリプト）。
#   ./cmp_forth            全部
#   ./cmp_forth 5 12       test1 の caxx 行のうち 5〜12 番目だけ
#   FORTH_ONLY=1 ./cmp_forth ...   期待値（caxx の結果）を作り直さない
# 期待値は $CMP_CACHE（既定 /tmp/cmp_forth_cache）に貯める。
R=$(cd "$(dirname "$0")" && pwd)
P=$R/patfile; S=$R/asmsrc
C=${CMP_CACHE:-/tmp/cmp_forth_cache_c}
D=${CMP_WORK:-/tmp/cmp_forth_work}
FROM=${1:-1}; TO=${2:-100000}
mkdir -p $C
grep '^caxx' $R/test1 > $C/cmds.txt
n=0; ok=0; ng=0
while IFS= read -r line; do
  n=$((n+1))
  [ $n -lt $FROM ] && continue
  [ $n -gt $TO ] && break
  for impl in py fs; do
    [ $impl = py ] && [ -d $C/$n/py ] && continue
    [ $impl = fs ] && [ -n "$PY_ONLY" ] && continue
    rm -rf $D; mkdir -p $D; cd $D
    export IMPL=$impl
    caxx() {
      if [ "$IMPL" = py ]; then /tmp/caxx "$@"
      else timeout ${CMP_TIMEOUT:-600} gforth $R/${AXXFS:-axx.fs} "$@"; fi
    }
    export P S
    { eval "$line"; } >/dev/null 2>&1 </dev/null
    mkdir -p $C/$n; rm -rf $C/$n/$impl; cp -r $D $C/$n/$impl
    cd $R
  done
  [ -n "$PY_ONLY" ] && { echo "py   $n"; continue; }
  if diff -r -q $C/$n/py $C/$n/fs >/dev/null 2>&1; then ok=$((ok+1)); echo "ok   $n: $line"
  else ng=$((ng+1)); echo "FAIL $n: $line"; fi
done < $C/cmds.txt
echo "ok=$ok ng=$ng"
