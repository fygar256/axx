/*  ==================================================================
/*  echo.axx -- 本文行に書く `.echo`
/*
/*  Technical_Manual 3.14.1 のテスト。パターンファイルの本文に書いた
/*  `.echo` が paxx と caxx で同じ行を標準エラーへ出すことを確かめる。
/*  ==================================================================

.bits::8
.setsym::N::7
.setsym::y::R0,R1,R2

/*  文字列と式を混ぜて書ける。式は 256bit 符号つき 10 進で出る。 */
.echo("head", 1+2, "#N=", #N, 0-5)

/*  逃げ記号は \\ \" \n \t の4つ。行は `::` で分解しないので、文字列の
/*  中の `::` はそのまま出る。 */
.echo("tab:\there", "q:\"", "bs:\\", "colon::ok")

/*  項目を書かなければ空行。 */
.echo()

MOV !e::.call mov(e)

/*  書いた位置は回数に関わらない。照合は一番具体的なパターンを選ぶために表を
/*  走査しきるので、この行もソース1行につき1回出る。 */
.echo("past MOV")

NOP::0x00

/*  ミニ言語の `.echo` は同じ体裁で出る（`.func` の本体に書くもの）。 */
.func mov(n)
.echo("mini", n)
.emit(0x88, n)
.endfunc
