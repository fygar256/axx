.bits::big::8
/* ============================================================
/* m68k.axx -- Motorola MC68000 full pattern file for axx
/*
/* Syntax : Motorola standard.  Case insensitive.
/* Endian : big endian (all words emitted high byte first).
/*
/* Addressing modes and their notation
/*   Dn                 data register direct
/*   An / SP            address register direct
/*   (An)               address register indirect
/*   (An)+              postincrement
/*   -(An)              predecrement
/*   d16(An)            displacement
/*   d8(An,Dn.W/.L)     indexed, data register index
/*   d8(An,An.W/.L)     indexed, address register index
/*   (xxx).W            absolute short
/*   (xxx).L            absolute long
/*   d16(PC)            program counter with displacement
/*   d8(PC,Rn.W/.L)     program counter with index
/*   #<data>            immediate
/*
/* Absolute addressing must be written with the parentheses and the
/* explicit .W / .L suffix, so that it can never be confused with a
/* displacement or with immediate data.
/* ============================================================

/* ---------------- registers ---------------- */
.setsym::D0::0
.setsym::D1::1
.setsym::D2::2
.setsym::D3::3
.setsym::D4::4
.setsym::D5::5
.setsym::D6::6
.setsym::D7::7
.setsym::A0::0
.setsym::A1::1
.setsym::A2::2
.setsym::A3::3
.setsym::A4::4
.setsym::A5::5
.setsym::A6::6
.setsym::A7::7
.setsym::SP::7

/* Variable roles
/*   a,b = An     d,s = Dn
/*   i = index Dn (source EA)     j = index An (source EA)
/*   k = index Dn (dest EA)       l = index An (dest EA)
/*   f = source displacement/address     g = dest displacement/address
/*   e = immediate / branch target       n = quick value, vector, bit no. */
.check::a::A0,A1,A2,A3,A4,A5,A6,A7,SP
.check::b::A0,A1,A2,A3,A4,A5,A6,A7,SP
.check::d::D0,D1,D2,D3,D4,D5,D6,D7
.check::s::D0,D1,D2,D3,D4,D5,D6,D7
.check::i::D0,D1,D2,D3,D4,D5,D6,D7
.check::j::A0,A1,A2,A3,A4,A5,A6,A7,SP
.check::k::D0,D1,D2,D3,D4,D5,D6,D7
.check::l::A0,A1,A2,A3,A4,A5,A6,A7,SP

/* ============================================================
/* Effective address emitters.
/*   H  : text before the <ea>  (mnemonic and any leading operand)
/*   T  : text after  the <ea>  (trailing operand)
/*   OP : base opword with the EA field zero, as an expression
/*   IM : bytes emitted directly after the opword (immediate data)
/*   TB : bytes emitted after the EA extension (a second EA's extension)
/* Order is the one the 68000 uses: opword, immediate, extension.
/*
/* Variables: a=An  d=Dn  f=displacement/address  i=index Dn  j=index An
/* ============================================================ */

!def EA_DN(H, T, OP, IM, TB = "") {
!{H} d!{T} ::  :: (!{OP}|0x00|d)>>8,(!{OP}|0x00|d)!{IM}!{TB}
}
!def EA_AN(H, T, OP, IM, TB = "") {
!{H} a!{T} ::  :: (!{OP}|0x08|a)>>8,(!{OP}|0x08|a)!{IM}!{TB}
}
!def EA_MA(H, T, OP, IM, TB = "") {
!{H} (a)!{T} ::  :: (!{OP}|0x10|a)>>8,(!{OP}|0x10|a)!{IM}!{TB}
!{H} (a)+!{T} ::  :: (!{OP}|0x18|a)>>8,(!{OP}|0x18|a)!{IM}!{TB}
!{H} -(a)!{T} ::  :: (!{OP}|0x20|a)>>8,(!{OP}|0x20|a)!{IM}!{TB}
!{H} !f(a)!{T} :: f>32767;3,f<-32768;3 :: (!{OP}|0x28|a)>>8,(!{OP}|0x28|a)!{IM},f>>8,f!{TB}
!{H} !f(a,i.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(i<<4),f!{TB}
!{H} !f(a,i.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x08|(i<<4)),f!{TB}
!{H} !f(a,j.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x80|(j<<4)),f!{TB}
!{H} !f(a,j.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x88|(j<<4)),f!{TB}
!{H} (!f).W!{T} :: f>65535;3,f<-32768;3 :: (!{OP}|0x38)>>8,(!{OP}|0x38)!{IM},f>>8,f!{TB}
!{H} (!f).L!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
!{H} !f!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
}
!def EA_CTLM(H, T, OP, IM, TB = "") {
!{H} (a)!{T} ::  :: (!{OP}|0x10|a)>>8,(!{OP}|0x10|a)!{IM}!{TB}
!{H} !f(a)!{T} :: f>32767;3,f<-32768;3 :: (!{OP}|0x28|a)>>8,(!{OP}|0x28|a)!{IM},f>>8,f!{TB}
!{H} !f(a,i.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(i<<4),f!{TB}
!{H} !f(a,i.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x08|(i<<4)),f!{TB}
!{H} !f(a,j.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x80|(j<<4)),f!{TB}
!{H} !f(a,j.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x88|(j<<4)),f!{TB}
!{H} (!f).W!{T} :: f>65535;3,f<-32768;3 :: (!{OP}|0x38)>>8,(!{OP}|0x38)!{IM},f>>8,f!{TB}
!{H} (!f).L!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
!{H} !f!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
}
!def EA_PC(H, T, OP, IM, TB = "") {
!{H} !f(PC)!{T} ::  :: (!{OP}|0x3A)>>8,(!{OP}|0x3A)!{IM},(f-($$+2))>>8,(f-($$+2))!{TB}
!{H} !f(PC,i.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(i<<4),(f-($$+2))!{TB}
!{H} !f(PC,i.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x08|(i<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x80|(j<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x88|(j<<4)),(f-($$+2))!{TB}
}
!def EA_IMB(H, T, OP, IM, TB = "") {
!{H} #!f!{T} :: f>255;3,f<-128;3 :: (!{OP}|0x3C)>>8,(!{OP}|0x3C)!{IM},0x00,f!{TB}
}
!def EA_IMW(H, T, OP, IM, TB = "") {
!{H} #!f!{T} :: f>65535;3,f<-32768;3 :: (!{OP}|0x3C)>>8,(!{OP}|0x3C)!{IM},f>>8,f!{TB}
}
!def EA_IML(H, T, OP, IM, TB = "") {
!{H} #!f!{T} ::  :: (!{OP}|0x3C)>>8,(!{OP}|0x3C)!{IM},f>>24,f>>16,f>>8,f!{TB}
}
!def EA_DALT(H, T, OP, IM, TB = "") {
!{H} d!{T} ::  :: (!{OP}|0x00|d)>>8,(!{OP}|0x00|d)!{IM}!{TB}
!{H} (a)!{T} ::  :: (!{OP}|0x10|a)>>8,(!{OP}|0x10|a)!{IM}!{TB}
!{H} (a)+!{T} ::  :: (!{OP}|0x18|a)>>8,(!{OP}|0x18|a)!{IM}!{TB}
!{H} -(a)!{T} ::  :: (!{OP}|0x20|a)>>8,(!{OP}|0x20|a)!{IM}!{TB}
!{H} !f(a)!{T} :: f>32767;3,f<-32768;3 :: (!{OP}|0x28|a)>>8,(!{OP}|0x28|a)!{IM},f>>8,f!{TB}
