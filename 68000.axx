!EA_ALLL("MOVEA.L", ",b", "(0x2040|(b<<9))", "", "")

/* ================= immediate to <ea> ================= */
!EA_DALT("ORI.B #!e,", "", "0x0000", ",0x00,e", "")
!EA_DALT("ORI.W #!e,", "", "0x0040", ",e>>8,e", "")
!EA_DALT("ORI.L #!e,", "", "0x0080", ",e>>24,e>>16,e>>8,e", "")
!EA_DALT("ANDI.B #!e,", "", "0x0200", ",0x00,e", "")
!EA_DALT("ANDI.W #!e,", "", "0x0240", ",e>>8,e", "")
!EA_DALT("ANDI.L #!e,", "", "0x0280", ",e>>24,e>>16,e>>8,e", "")
!EA_DALT("SUBI.B #!e,", "", "0x0400", ",0x00,e", "")
!EA_DALT("SUBI.W #!e,", "", "0x0440", ",e>>8,e", "")
!EA_DALT("SUBI.L #!e,", "", "0x0480", ",e>>24,e>>16,e>>8,e", "")
!EA_DALT("ADDI.B #!e,", "", "0x0600", ",0x00,e", "")
!EA_DALT("ADDI.W #!e,", "", "0x0640", ",e>>8,e", "")
!EA_DALT("ADDI.L #!e,", "", "0x0680", ",e>>24,e>>16,e>>8,e", "")
!EA_DALT("EORI.B #!e,", "", "0x0A00", ",0x00,e", "")
!EA_DALT("EORI.W #!e,", "", "0x0A40", ",e>>8,e", "")
!EA_DALT("EORI.L #!e,", "", "0x0A80", ",e>>24,e>>16,e>>8,e", "")
!EA_DALT("CMPI.B #!e,", "", "0x0C00", ",0x00,e", "")
!EA_DALT("CMPI.W #!e,", "", "0x0C40", ",e>>8,e", "")
!EA_DALT("CMPI.L #!e,", "", "0x0C80", ",e>>24,e>>16,e>>8,e", "")
ORI #!e,CCR :: :: 0x00,0x3C,0x00,e
ORI #!e,SR :: :: 0x00,0x7C,e>>8,e
ANDI #!e,CCR :: :: 0x02,0x3C,0x00,e
ANDI #!e,SR :: :: 0x02,0x7C,e>>8,e
EORI #!e,CCR :: :: 0x0A,0x3C,0x00,e
EORI #!e,SR :: :: 0x0A,0x7C,e>>8,e

/* ================= ADDQ / SUBQ / MOVEQ ================= */
!EA_DALT("ADDQ.B #!n,", "", "(0x5000|((n&7)<<9))", "", "")
!EA_DALT("ADDQ.W #!n,", "", "(0x5040|((n&7)<<9))", "", "")
ADDQ.W #!n, a :: n>8;3,n<1;3 :: (0x5040|((n&7)<<9)|0x08|a)>>8,(0x5040|((n&7)<<9)|0x08|a)
!EA_DALT("ADDQ.L #!n,", "", "(0x5080|((n&7)<<9))", "", "")
ADDQ.L #!n, a :: n>8;3,n<1;3 :: (0x5080|((n&7)<<9)|0x08|a)>>8,(0x5080|((n&7)<<9)|0x08|a)
!EA_DALT("SUBQ.B #!n,", "", "(0x5100|((n&7)<<9))", "", "")
!EA_DALT("SUBQ.W #!n,", "", "(0x5140|((n&7)<<9))", "", "")
SUBQ.W #!n, a :: n>8;3,n<1;3 :: (0x5140|((n&7)<<9)|0x08|a)>>8,(0x5140|((n&7)<<9)|0x08|a)
!EA_DALT("SUBQ.L #!n,", "", "(0x5180|((n&7)<<9))", "", "")
SUBQ.L #!n, a :: n>8;3,n<1;3 :: (0x5180|((n&7)<<9)|0x08|a)>>8,(0x5180|((n&7)<<9)|0x08|a)
MOVEQ #!e,s :: e>127;3,e<-128;3 :: (0x7000|(s<<9))>>8,(e&0xff)

/* ================= MOVE ================= */
!EA_DATAB("MOVE.B", ",s", "(0x1000|((s<<9)))", "", "")
!EA_DATAB("MOVE.B", ",(b)", "(0x1000|((b<<9)|0x080))", "", "")
!EA_DATAB("MOVE.B", ",(b)+", "(0x1000|((b<<9)|0x0C0))", "", "")
!EA_DATAB("MOVE.B", ",-(b)", "(0x1000|((b<<9)|0x100))", "", "")
!EA_DATAB("MOVE.B", ",!g(b)", "(0x1000|((b<<9)|0x140))", "", ",g>>8,g")
!EA_DATAB("MOVE.B", ",!g(b,k.W)", "(0x1000|((b<<9)|0x180))", "", ",(k<<4),g")
!EA_DATAB("MOVE.B", ",!g(b,k.L)", "(0x1000|((b<<9)|0x180))", "", ",(0x08|(k<<4)),g")
!EA_DATAB("MOVE.B", ",!g(b,l.W)", "(0x1000|((b<<9)|0x180))", "", ",(0x80|(l<<4)),g")
!EA_DATAB("MOVE.B", ",!g(b,l.L)", "(0x1000|((b<<9)|0x180))", "", ",(0x88|(l<<4)),g")
!EA_DATAB("MOVE.B", ",(!g).W", "(0x1000|(0x1C0))", "", ",g>>8,g")
!EA_DATAB("MOVE.B", ",(!g).L", "(0x1000|(0x3C0))", "", ",g>>24,g>>16,g>>8,g")
!EA_ALLW("MOVE.W", ",s", "(0x3000|((s<<9)))", "", "")
!EA_ALLW("MOVE.W", ",(b)", "(0x3000|((b<<9)|0x080))", "", "")
!EA_ALLW("MOVE.W", ",(b)+", "(0x3000|((b<<9)|0x0C0))", "", "")
!EA_ALLW("MOVE.W", ",-(b)", "(0x3000|((b<<9)|0x100))", "", "")
!EA_ALLW("MOVE.W", ",!g(b)", "(0x3000|((b<<9)|0x140))", "", ",g>>8,g")
!EA_ALLW("MOVE.W", ",!g(b,k.W)", "(0x3000|((b<<9)|0x180))", "", ",(k<<4),g")
!EA_ALLW("MOVE.W", ",!g(b,k.L)", "(0x3000|((b<<9)|0x180))", "", ",(0x08|(k<<4)),g")
!EA_ALLW("MOVE.W", ",!g(b,l.W)", "(0x3000|((b<<9)|0x180))", "", ",(0x80|(l<<4)),g")
!EA_ALLW("MOVE.W", ",!g(b,l.L)", "(0x3000|((b<<9)|0x180))", "", ",(0x88|(l<<4)),g")
!EA_ALLW("MOVE.W", ",(!g).W", "(0x3000|(0x1C0))", "", ",g>>8,g")
!EA_ALLW("MOVE.W", ",(!g).L", "(0x3000|(0x3C0))", "", ",g>>24,g>>16,g>>8,g")
