.check::x::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::y::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::z::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::a::A0,A1,A2,A3,A4,A5,A6,A7,SP

!def MOVEM_ST(SZ, OP) {
MOVEM.!{SZ} k l m n o p q r s t u v w x y z,(a) :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|(0x10|(8-@a)))>>8,(!{OP}|(0x10|(8-@a))),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)
MOVEM.!{SZ} k l m n o p q r s t u v w x y z,-(a) :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|(0x20|(8-@a)))>>8,(!{OP}|(0x20|(8-@a))),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)
MOVEM.!{SZ} k l m n o p q r s t u v w x y z,!f(a) :: f>32767;3,f<-32768;3,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|(0x28|(8-@a)))>>8,(!{OP}|(0x28|(8-@a))),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),f>>8,f
MOVEM.!{SZ} k l m n o p q r s t u v w x y z,(!f).W :: f>65535;3,f<-32768;3,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|0x38)>>8,(!{OP}|0x38),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),f>>8,f
MOVEM.!{SZ} k l m n o p q r s t u v w x y z,(!f).L :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|0x39)>>8,(!{OP}|0x39),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),f>>24,f>>16,f>>8,f
}

