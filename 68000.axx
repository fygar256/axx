ABCD s,d :: :: (0xC100|(d<<9)|s)>>8,(0xC100|(d<<9)|s)
ABCD -(a),-(b) :: :: (0xC100|(b<<9)|0x08|a)>>8,(0xC100|(b<<9)|0x08|a)
ABCD.B s,d :: :: (0xC100|(d<<9)|s)>>8,(0xC100|(d<<9)|s)
ABCD.B -(a),-(b) :: :: (0xC100|(b<<9)|0x08|a)>>8,(0xC100|(b<<9)|0x08|a)
