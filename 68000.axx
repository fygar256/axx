!EA_DATAW("AND.W", ",s", "(0xC040|(s<<9))", "", "")
!EA_DATAL("AND.L", ",s", "(0xC080|(s<<9))", "", "")
!EA_DATAB("OR.B", ",s", "(0x8000|(s<<9))", "", "")
!EA_DATAW("OR.W", ",s", "(0x8040|(s<<9))", "", "")
!EA_DATAL("OR.L", ",s", "(0x8080|(s<<9))", "", "")
