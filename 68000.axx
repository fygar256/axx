!{H} !f(a,j.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x88|(j<<4)),f!{TB}
!{H} (!f).W!{T} :: f>65535;3,f<-32768;3 :: (!{OP}|0x38)>>8,(!{OP}|0x38)!{IM},f>>8,f!{TB}
!{H} (!f).L!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
!{H} !f(PC)!{T} ::  :: (!{OP}|0x3A)>>8,(!{OP}|0x3A)!{IM},(f-($$+2))>>8,(f-($$+2))!{TB}
!{H} !f(PC,i.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(i<<4),(f-($$+2))!{TB}
!{H} !f(PC,i.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x08|(i<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x80|(j<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x88|(j<<4)),(f-($$+2))!{TB}
!{H} #!f!{T} ::  :: (!{OP}|0x3C)>>8,(!{OP}|0x3C)!{IM},f>>24,f>>16,f>>8,f!{TB}
!{H} !f!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
}
!def EA_CTL(H, T, OP, IM, TB = "") {
!{H} (a)!{T} ::  :: (!{OP}|0x10|a)>>8,(!{OP}|0x10|a)!{IM}!{TB}
!{H} !f(a)!{T} :: f>32767;3,f<-32768;3 :: (!{OP}|0x28|a)>>8,(!{OP}|0x28|a)!{IM},f>>8,f!{TB}
!{H} !f(a,i.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(i<<4),f!{TB}
!{H} !f(a,i.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x08|(i<<4)),f!{TB}
!{H} !f(a,j.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x80|(j<<4)),f!{TB}
!{H} !f(a,j.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x88|(j<<4)),f!{TB}
!{H} (!f).W!{T} :: f>65535;3,f<-32768;3 :: (!{OP}|0x38)>>8,(!{OP}|0x38)!{IM},f>>8,f!{TB}
!{H} (!f).L!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
!{H} !f(PC)!{T} ::  :: (!{OP}|0x3A)>>8,(!{OP}|0x3A)!{IM},(f-($$+2))>>8,(f-($$+2))!{TB}
!{H} !f(PC,i.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(i<<4),(f-($$+2))!{TB}
!{H} !f(PC,i.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x08|(i<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x80|(j<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x88|(j<<4)),(f-($$+2))!{TB}
!{H} !f!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
}

!def EA_CTLPI(H, T, OP, IM, TB = "") {
!{H} (a)+!{T} ::  :: (!{OP}|0x18|a)>>8,(!{OP}|0x18|a)!{IM}!{TB}
!{H} (a)!{T} ::  :: (!{OP}|0x10|a)>>8,(!{OP}|0x10|a)!{IM}!{TB}
!{H} !f(a)!{T} :: f>32767;3,f<-32768;3 :: (!{OP}|0x28|a)>>8,(!{OP}|0x28|a)!{IM},f>>8,f!{TB}
!{H} !f(a,i.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(i<<4),f!{TB}
!{H} !f(a,i.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x08|(i<<4)),f!{TB}
!{H} !f(a,j.W)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x80|(j<<4)),f!{TB}
!{H} !f(a,j.L)!{T} :: f>127;3,f<-128;3 :: (!{OP}|0x30|a)>>8,(!{OP}|0x30|a)!{IM},(0x88|(j<<4)),f!{TB}
!{H} (!f).W!{T} :: f>65535;3,f<-32768;3 :: (!{OP}|0x38)>>8,(!{OP}|0x38)!{IM},f>>8,f!{TB}
!{H} (!f).L!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
!{H} !f(PC)!{T} ::  :: (!{OP}|0x3A)>>8,(!{OP}|0x3A)!{IM},(f-($$+2))>>8,(f-($$+2))!{TB}
!{H} !f(PC,i.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(i<<4),(f-($$+2))!{TB}
!{H} !f(PC,i.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x08|(i<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.W)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x80|(j<<4)),(f-($$+2))!{TB}
!{H} !f(PC,j.L)!{T} ::  :: (!{OP}|0x3B)>>8,(!{OP}|0x3B)!{IM},(0x88|(j<<4)),(f-($$+2))!{TB}
!{H} !f!{T} ::  :: (!{OP}|0x39)>>8,(!{OP}|0x39)!{IM},f>>24,f>>16,f>>8,f!{TB}
}

/* ------------------------------------------------------------
/* Notes on notation
/*
/*  absolute       (xxx).W / (xxx).L must carry the parentheses and the
/*                 explicit size, so it can never be mistaken for a
/*                 displacement.  A bare label or expression is taken as
/*                 absolute long:      JSR  routine
/*  PC relative    the operand is the TARGET, not the displacement; the
/*                 assembler works the displacement out:
/*                                     MOVE.W table(PC),D0
/*  branches       .S selects the 8 bit form, .W and the bare mnemonic
/*                 select the 16 bit form.  There is no automatic
/*                 relaxation, so an out of range .S is reported.
/*  MOVEM          the register list is written as a 16 bit mask:
/*                     MOVEM.L #0x3F00,-(SP)   saves D2-D7
/*                     MOVEM.L (SP)+,#0x00FC   restores them
/*                 remember the mask runs the other way round for -(An).
/*  ADDQ/SUBQ      #1..#8 ; #8 is encoded as 0 by the assembler.
/*  sizes          .B .W .L as usual.  Instructions with only one legal
/*                 size (ABCD, TAS, Scc, EXG, SWAP ...) accept the bare
/*                 mnemonic and, where it is customary, the sized form.
/* ------------------------------------------------------------ */







/* ================= single effective address ================= */
!EA_DALT("CLR.B", "", "0x4200", "", "")
!EA_DALT("CLR.W", "", "0x4240", "", "")
!EA_DALT("CLR.L", "", "0x4280", "", "")
!EA_DALT("NEG.B", "", "0x4400", "", "")
!EA_DALT("NEG.W", "", "0x4440", "", "")
!EA_DALT("NEG.L", "", "0x4480", "", "")
!EA_DALT("NEGX.B", "", "0x4000", "", "")
!EA_DALT("NEGX.W", "", "0x4040", "", "")
!EA_DALT("NEGX.L", "", "0x4080", "", "")
!EA_DALT("NOT.B", "", "0x4600", "", "")
!EA_DALT("NOT.W", "", "0x4640", "", "")
!EA_DALT("NOT.L", "", "0x4680", "", "")
!EA_DALT("TST.B", "", "0x4A00", "", "")
!EA_DALT("TST.W", "", "0x4A40", "", "")
!EA_DALT("TST.L", "", "0x4A80", "", "")
!EA_DALT("NBCD", "", "0x4800", "", "")
!EA_DALT("TAS", "", "0x4AC0", "", "")

/* ================= control addressing ================= */
!EA_CTL("JMP", "", "0x4EC0", "", "")
!EA_CTL("JSR", "", "0x4E80", "", "")
!EA_CTL("PEA", "", "0x4840", "", "")
!EA_CTL("LEA", ",b", "(0x41C0|(b<<9))", "", "")

/* ================= <ea>,Dn  and  Dn,<ea> ================= */
!EA_DATAB("ADD.B", ",s", "(0xD000|(s<<9))", "", "")
!EA_ALLW("ADD.W", ",s", "(0xD040|(s<<9))", "", "")
!EA_ALLL("ADD.L", ",s", "(0xD080|(s<<9))", "", "")
!EA_DATAB("SUB.B", ",s", "(0x9000|(s<<9))", "", "")
