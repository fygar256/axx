!EA_MALT("SUB.W s,", "", "(0x9140|(s<<9))", "", "")
!EA_MALT("SUB.L s,", "", "(0x9180|(s<<9))", "", "")
!EA_MALT("AND.B s,", "", "(0xC100|(s<<9))", "", "")
!EA_MALT("AND.W s,", "", "(0xC140|(s<<9))", "", "")
!EA_MALT("AND.L s,", "", "(0xC180|(s<<9))", "", "")
!EA_MALT("OR.B s,", "", "(0x8100|(s<<9))", "", "")
!EA_MALT("OR.W s,", "", "(0x8140|(s<<9))", "", "")
!EA_MALT("OR.L s,", "", "(0x8180|(s<<9))", "", "")
!EA_DALT("EOR.B s,", "", "(0xB100|(s<<9))", "", "")
!EA_DALT("EOR.W s,", "", "(0xB140|(s<<9))", "", "")
!EA_DALT("EOR.L s,", "", "(0xB180|(s<<9))", "", "")

/* ================= <ea>,An ================= */
!EA_ALLW("ADDA.W", ",b", "(0xD0C0|(b<<9))", "", "")
!EA_ALLL("ADDA.L", ",b", "(0xD1C0|(b<<9))", "", "")
!EA_ALLW("SUBA.W", ",b", "(0x90C0|(b<<9))", "", "")
!EA_ALLL("SUBA.L", ",b", "(0x91C0|(b<<9))", "", "")
