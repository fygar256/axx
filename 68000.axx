/* ================= ADDX / SUBX / ABCD / SBCD / CMPM ================= */
ADDX.B s,d :: :: (0xD100|(d<<9)|s)>>8,(0xD100|(d<<9)|s)
ADDX.B -(a),-(b) :: :: (0xD100|(b<<9)|0x08|a)>>8,(0xD100|(b<<9)|0x08|a)
ADDX.W s,d :: :: (0xD140|(d<<9)|s)>>8,(0xD140|(d<<9)|s)
