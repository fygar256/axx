ADDX.L s,d :: :: (0xD180|(d<<9)|s)>>8,(0xD180|(d<<9)|s)
ADDX.L -(a),-(b) :: :: (0xD180|(b<<9)|0x08|a)>>8,(0xD180|(b<<9)|0x08|a)
