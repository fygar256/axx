CMPM.W (a)+,(b)+ :: :: (0xB148|(b<<9)|0x08|a)>>8,(0xB148|(b<<9)|0x08|a)
CMPM.L (a)+,(b)+ :: :: (0xB188|(b<<9)|0x08|a)>>8,(0xB188|(b<<9)|0x08|a)

/* ================= MOVEM, numeric mask form ================= */
!EA_MALT("MOVEM.W #!e,", "", "0x4880", ",e>>8,e", "")
!EA_CTLPI("MOVEM.W", ",#!g", "0x4C80", ",g>>8,g", "")
!EA_MALT("MOVEM.L #!e,", "", "0x48C0", ",e>>8,e", "")
!EA_CTLPI("MOVEM.L", ",#!g", "0x4CC0", ",g>>8,g", "")

/* ================= MOVEP ================= */
MOVEP.W !e(a),s :: :: (0x0108|(s<<9)|0x100|a)>>8,(0x0108|(s<<9)|0x100|a),e>>8,e
MOVEP.L !e(a),s :: :: (0x0108|(s<<9)|0x140|a)>>8,(0x0108|(s<<9)|0x140|a),e>>8,e
MOVEP.W s,!e(a) :: :: (0x0108|(s<<9)|0x180|a)>>8,(0x0108|(s<<9)|0x180|a),e>>8,e
MOVEP.L s,!e(a) :: :: (0x0108|(s<<9)|0x1C0|a)>>8,(0x0108|(s<<9)|0x1C0|a),e>>8,e

/* ================= miscellaneous ================= */
NOP :: :: 0x4E,0x71
RTS :: :: 0x4E,0x75
RTE :: :: 0x4E,0x73
RTR :: :: 0x4E,0x77
TRAPV :: :: 0x4E,0x76
RESET :: :: 0x4E,0x70
ILLEGAL :: :: 0x4A,0xFC
STOP #!e :: :: 0x4E,0x72,e>>8,e
TRAP #!n :: n>15;3,n<0;3 :: 0x4E,(0x40|(n&15))
LINK a,#!e :: e>32767;3,e<-32768;3 :: 0x4E,(0x50|a),e>>8,e
UNLK a :: :: 0x4E,(0x58|a)
SWAP s :: :: 0x48,(0x40|s)
EXT.W s :: :: 0x48,(0x80|s)
EXT.L s :: :: 0x48,(0xC0|s)
EXG s,d :: :: (0xC140|(s<<9)|d)>>8,(0xC140|(s<<9)|d)
EXG a,b :: :: (0xC148|(a<<9)|b)>>8,(0xC148|(a<<9)|b)
EXG s,b :: :: (0xC188|(s<<9)|b)>>8,(0xC188|(s<<9)|b)
EXG a,d :: :: (0xC188|(d<<9)|a)>>8,(0xC188|(d<<9)|a)

/* ================= MOVEM with a register list =================
/* The register list is 16 optional operands: k..z, each constrained by
/* .check to a register name and each allowed to be omitted (the `""`
/* entry in the list).  An omitted operand stays unassigned (0), so the
/* mask is just the OR of all 16 and one pattern covers every list
/* length 1..16.  This replaces the old 352 explicit patterns (one per
/* length x <ea>) with 22, so a MOVEM line is matched ~16x faster.
/* [[ ]] is still unusable here: 16 optional groups is 2**16 matches.
/*
/* Load (mem->regs, normal mask D0=bit0..A7=bit15):
/*   (An)+  (An)  d16(An)  (xxx).W  (xxx).L  d16(PC)
/* Store (regs->mem, reversed mask for -(An) transfer order):
/*   (An)  -(An)  d16(An)  (xxx).W  (xxx).L
/* Indexed modes: use the numeric-mask form MOVEM.L #mask,<ea>.
/* Base An recovered with @: (@a-9) normal, (8-@a) reversed.
/* An empty register list is rejected by the (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0 guard.
/* ============================================================ */

/* --- load: normal mask --- */
.setsym::D0::0x0001
.setsym::D1::0x0002
.setsym::D2::0x0004
.setsym::D3::0x0008
.setsym::D4::0x0010
.setsym::D5::0x0020
.setsym::D6::0x0040
.setsym::D7::0x0080
.setsym::A0::0x0100
.setsym::A1::0x0200
.setsym::A2::0x0400
.setsym::A3::0x0800
.setsym::A4::0x1000
.setsym::A5::0x2000
.setsym::A6::0x4000
.setsym::A7::0x8000
.setsym::SP::0x8000
.check::k::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::l::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::m::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::n::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::o::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::p::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::q::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::r::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::s::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::t::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::u::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::v::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::w::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::x::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::y::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::z::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::a::A0,A1,A2,A3,A4,A5,A6,A7,SP

!def MOVEM_LD(SZ, OP) {
MOVEM.!{SZ} (a)+,k l m n o p q r s t u v w x y z :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|(0x18|(@a-9)))>>8,(!{OP}|(0x18|(@a-9))),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)
MOVEM.!{SZ} (a),k l m n o p q r s t u v w x y z :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|(0x10|(@a-9)))>>8,(!{OP}|(0x10|(@a-9))),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)
MOVEM.!{SZ} !f(a),k l m n o p q r s t u v w x y z :: f>32767;3,f<-32768;3,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|(0x28|(@a-9)))>>8,(!{OP}|(0x28|(@a-9))),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),f>>8,f
MOVEM.!{SZ} (!f).W,k l m n o p q r s t u v w x y z :: f>65535;3,f<-32768;3,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|0x38)>>8,(!{OP}|0x38),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),f>>8,f
MOVEM.!{SZ} (!f).L,k l m n o p q r s t u v w x y z :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|0x39)>>8,(!{OP}|0x39),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),f>>24,f>>16,f>>8,f
MOVEM.!{SZ} !f(PC),k l m n o p q r s t u v w x y z :: (k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)==0;5 :: (!{OP}|0x3A)>>8,(!{OP}|0x3A),(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z)>>8,(k|l|m|n|o|p|q|r|s|t|u|v|w|x|y|z),(f-($$+2))>>8,(f-($$+2))
}

!MOVEM_LD("W", "0x4C80")
!MOVEM_LD("L", "0x4CC0")

/* --- store: reversed mask --- */
.setsym::D0::0x8000
.setsym::D1::0x4000
.setsym::D2::0x2000
.setsym::D3::0x1000
.setsym::D4::0x0800
.setsym::D5::0x0400
.setsym::D6::0x0200
.setsym::D7::0x0100
.setsym::A0::0x0080
.setsym::A1::0x0040
.setsym::A2::0x0020
.setsym::A3::0x0010
.setsym::A4::0x0008
.setsym::A5::0x0004
.setsym::A6::0x0002
.setsym::A7::0x0001
.setsym::SP::0x0001
.check::k::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::l::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::m::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::n::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::o::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::p::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::q::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::r::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
.check::s::D0,D1,D2,D3,D4,D5,D6,D7,A0,A1,A2,A3,A4,A5,A6,A7,SP,""
