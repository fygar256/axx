/* ================= branches =================
/* The bare mnemonic is relaxed automatically: p is the displacement and q is
/* 1 when the 8 bit form is usable (in range, and non zero -- a zero
/* displacement byte is what selects the extension word).  @@[0,..] emits
/* nothing, so the two extension bytes vanish when the short form wins, while
/* a legitimate 0x00 byte is still emitted.  axx re-runs its relaxation passes
/* until the sizes settle.  .S and .W force a size. */
BRA.S !e :: (e-($$+2))>127;2,(e-($$+2))<-128;2,(e-($$+2))==0;2 :: 0x60,(e-($$+2))
BRA.W !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: 0x60,0x00,(e-($$+2))>>8,(e-($$+2))
BRA !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: ;(p:=e-($$+2))*0,;(q:=(p>=-128)&&(p<=127)&&(p!=0))*0,0x60,(q?p:0),@@[q?0:1,p>>8],@@[q?0:1,p]
BSR.S !e :: (e-($$+2))>127;2,(e-($$+2))<-128;2,(e-($$+2))==0;2 :: 0x61,(e-($$+2))
BSR.W !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: 0x61,0x00,(e-($$+2))>>8,(e-($$+2))
BSR !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: ;(p:=e-($$+2))*0,;(q:=(p>=-128)&&(p<=127)&&(p!=0))*0,0x61,(q?p:0),@@[q?0:1,p>>8],@@[q?0:1,p]
BHI.S !e :: (e-($$+2))>127;2,(e-($$+2))<-128;2,(e-($$+2))==0;2 :: 0x62,(e-($$+2))
BHI.W !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: 0x62,0x00,(e-($$+2))>>8,(e-($$+2))
BHI !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: ;(p:=e-($$+2))*0,;(q:=(p>=-128)&&(p<=127)&&(p!=0))*0,0x62,(q?p:0),@@[q?0:1,p>>8],@@[q?0:1,p]
BLS.S !e :: (e-($$+2))>127;2,(e-($$+2))<-128;2,(e-($$+2))==0;2 :: 0x63,(e-($$+2))
BLS.W !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: 0x63,0x00,(e-($$+2))>>8,(e-($$+2))
BLS !e :: (e-($$+2))>32767;2,(e-($$+2))<-32768;2 :: ;(p:=e-($$+2))*0,;(q:=(p>=-128)&&(p<=127)&&(p!=0))*0,0x63,(q?p:0),@@[q?0:1,p>>8],@@[q?0:1,p]
